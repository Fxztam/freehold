module JsonStringifySmoke

type Person is record
    name: String
    age: Integer
    active: Boolean
end record

procedure main()
is
    let person: Person = Person {
        name: "Ada",
        age: 37,
        active: true
    }
    let text: String = Json.stringify(person)
    check text = "{\"name\":\"Ada\",\"age\":37,\"active\":true}"
end main

end JsonStringifySmoke
