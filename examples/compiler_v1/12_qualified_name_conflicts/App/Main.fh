module App.Main

import Std.IO
import Domestic.Orders
import Partner.Orders

procedure main()
is
    let domestic_id: Integer = Domestic.Orders.order_id(1200)
    let partner_id: Integer = Partner.Orders.order_id(900)
    check domestic_id = 1200
    check partner_id = 1000
    call Std.IO.logf("domestic order = ${}", domestic_id)
    call Std.IO.logf("domestic city = ${}", Domestic.Orders.city_label(1200))
    call Std.IO.logf("partner order = ${}", partner_id)
    call Std.IO.logf("partner city = ${}", Partner.Orders.city_label(900))
end main

end App.Main