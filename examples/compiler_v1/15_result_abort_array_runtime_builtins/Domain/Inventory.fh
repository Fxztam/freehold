module Domain.Inventory

import Domain.Types exposing StockItem, Warehouse, make_stock_item, make_warehouse

error StockMissing

function build_item(sku: String, quantity: Integer, warehouse_id: Integer, warehouse_label: String) returns StockItem
requires String.instr(sku, "SKU") >= 0, quantity >= 0, warehouse_id > 0, String.instr(warehouse_label, "") = 0
ensures result.sku = sku, result.quantity = quantity, result.warehouse.id = warehouse_id, result.warehouse.label = warehouse_label
is
    let warehouse: Warehouse = make_warehouse(warehouse_id, warehouse_label)
    let item: StockItem = make_stock_item(sku, quantity, warehouse)
    return item
end build_item

function load_stock(seed: Integer) returns Result<Array<StockItem, 3>, StockMissing>
requires seed > 0, seed >= 1
ensures success, value[0].quantity >= seed, value[1].warehouse.id = value[0].warehouse.id, value[2].warehouse.id = 2, String.instr(value[0].sku, "SKU") >= 0, String.instr(value[0].warehouse.label, "north") >= 0
is
    let primary: StockItem = build_item("SKU-001", seed + 2, 1, "north")
    let secondary: StockItem = build_item("SKU-002", seed + 3, 1, "north")
    let overflow: StockItem = build_item("SKU-003", seed + 4, 2, "south")
    return ok [primary, secondary, overflow]
end load_stock

function read_item(seed: Integer) returns StockItem
requires seed > 0
aborts StockMissing
ensures result.quantity >= seed
is
    if seed = 0 then
        abort StockMissing
    end if
    let item: StockItem = build_item("SKU-READ", seed + 5, 3, "direct")
    return item
end read_item

end Domain.Inventory