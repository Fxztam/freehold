module App.Main

import Util.Helper exposing assert_val

function min<T>(a: T, b: T) returns T
requires T is Comparable
is
    if a < b then
        return a
    else
        return b
    end if
end min

procedure main()
is
    let x: Integer = min(10, 20)
    let y: Double = min(45.5, 12.3)
    check x = 10
    check y = 12.3

    call assert_val(x)
    call Util.Helper.assert_val(y)
end main

end App.Main
