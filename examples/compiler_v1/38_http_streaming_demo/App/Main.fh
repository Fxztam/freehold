module App.Main

import Std.IO
import Std.Connect.Common exposing Endpoint, ConnectError, localhost_http
import Std.Connect.Http exposing Client, Request, ServerHandle, RequestContext, StreamResponse, new_client, new_request, serve, accept_request, respond_stream, open_stream, stop_server

async function server_worker(server: ServerHandle) returns Integer
is
    let accepted: Result<RequestContext, ConnectError> = await accept_request(server)
    if accepted.ok = false then
        call Std.IO.log("Stream server failed to accept")
        return 1
    end if
    let stream_channel: Channel<String> = channel<String>(8)
    let tx: Sender<String> = channel_sender<String>(stream_channel)
    let rx: Receiver<String> = channel_receiver<String>(stream_channel)
    let queued_a: Boolean = await channel_send<String>(tx, "event-1")
    let queued_b: Boolean = await channel_send<String>(tx, "event-2")
    let queued_c: Boolean = await channel_send<String>(tx, "event-3")
    let sent: Boolean = await respond_stream(accepted.value, 200, "text/plain", 3, rx)
    if sent then
        return 0
    else
        return 1
    end if
end server_worker

async function client_worker(client: Client) returns Integer
is
    let request: Request = new_request("GET", "/events")
    let opened: Result<StreamResponse, ConnectError> = await open_stream(client, request)
    if opened.ok = false then
        call Std.IO.log("Stream client failed to open")
        return 1
    end if
    if opened.value.status_code != 200 then
        call Std.IO.log("Stream client got wrong status")
        return 1
    end if
    if opened.value.chunk_count != 3 then
        call Std.IO.log("Stream client got wrong chunk count")
        return 1
    end if
    let chunk_a: String = await channel_receive<String>(opened.value.chunks)
    let chunk_b: String = await channel_receive<String>(opened.value.chunks)
    let chunk_c: String = await channel_receive<String>(opened.value.chunks)
    call Std.IO.log(String.concat("stream chunk: ", chunk_a))
    call Std.IO.log(String.concat("stream chunk: ", chunk_b))
    call Std.IO.log(String.concat("stream chunk: ", chunk_c))
    let assembled: String = String.concat(chunk_a, String.concat("|", String.concat(chunk_b, String.concat("|", chunk_c))))
    call Std.IO.log(String.concat("stream assembled: ", assembled))
    return 0
end client_worker

async function run_demo() returns Integer
is
    let endpoint: Endpoint = localhost_http(8108, "")
    let serve_result: Result<ServerHandle, ConnectError> = serve(endpoint)
    if serve_result.ok = false then
        call Std.IO.log("HTTP streaming server failed to bind")
        return 1
    end if
    let server: ServerHandle = serve_result.value
    let client: Client = new_client(endpoint)

    scope demo_scope do
        spawn
            let server_handle: JoinHandle<Integer> = demo_scope.spawn<Integer>(server_worker(server))
            let client_handle: JoinHandle<Integer> = demo_scope.spawn<Integer>(client_worker(client))
        join
            let server_status: Integer = await demo_scope.join<Integer>(server_handle)
            let client_status: Integer = await demo_scope.join<Integer>(client_handle)
            call stop_server(server)
            if client_status = 0 and server_status = 0 then
                call Std.IO.log("Native HTTP streaming delivered 3 chunks")
            end if
        result
            return server_status + client_status
    end scope
end run_demo

async procedure main()
is
    let status: Integer = await run_demo()
    if status = 0 then
        call Std.IO.log("Native HTTP streaming demo finished successfully")
    else
        call Std.IO.log("Native HTTP streaming demo finished with failure")
    end if
end main

end App.Main
