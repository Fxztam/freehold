module Domain.Orders

import Domain.Types exposing Address, Customer, Order, make_address, make_customer, make_order

error NotFound

function build_order(id: Integer) returns Order
is
    let destination: Address = make_address(42, "Berlin")
    let customer: Customer = make_customer(1001, "Ada", destination)
    return make_order(id, customer, destination)
end build_order

function load_order(id: Integer) returns Result<Order, NotFound>
requires id > 0
ensures success, value.id = id, value.customer.address.city_id = value.destination.city_id
is
    return ok build_order(id)
end load_order

end Domain.Orders