module App.Main

import Std.IO
import Std.Connect.Common exposing Endpoint, ConnectError, new_endpoint
import Std.Connect.Grpc exposing Client, ServerHandle, Call, StreamHandle, new_client, serve, accept_stream, respond_stream, open_stream, stop_server
import App.Contract exposing WatchRequest, WatchEvent

async function handle_stream(server: ServerHandle) returns Integer
is
    let accepted: Result<Call, ConnectError> = await accept_stream(server)
    if accepted.ok = false then
        call Std.IO.log("gRPC server failed to accept stream")
        return 1
    end if
    let pending: Call = accepted.value
    let parsed: Result<WatchRequest, SchemaError> = Json.parse<WatchRequest>(pending.payload)
    if parsed.ok = false then
        call Std.IO.log("gRPC server received malformed watch request")
        return 1
    end if
    let events_channel: Channel<String> = channel<String>(3)
    let events_sender: Sender<String> = channel_sender<String>(events_channel)
    let events_receiver: Receiver<String> = channel_receiver<String>(events_channel)
    let e1: Boolean = await channel_send<String>(events_sender, Json.stringify(WatchEvent { sequence: 1, message: "tick-1" }))
    let e2: Boolean = await channel_send<String>(events_sender, Json.stringify(WatchEvent { sequence: 2, message: "tick-2" }))
    let e3: Boolean = await channel_send<String>(events_sender, Json.stringify(WatchEvent { sequence: 3, message: "tick-3" }))
    let sent: Boolean = await respond_stream(pending, 3, events_receiver)
    if sent then
        return 0
    else
        return 1
    end if
end handle_stream

async function server_worker(server: ServerHandle) returns Integer
is
    let status: Integer = await handle_stream(server)
    return status
end server_worker

async function client_worker(client: Client) returns Integer
is
    let request: WatchRequest = WatchRequest { topic: "prices" }
    let stream_result: Result<StreamHandle, ConnectError> = await open_stream(client, "Watch", Json.stringify(request))
    if stream_result.ok = false then
        call Std.IO.log("gRPC Watch open_stream failed")
        return 1
    end if
    let handle: StreamHandle = stream_result.value
    if handle.message_count != 3 then
        call Std.IO.log("gRPC Watch returned unexpected message count")
        return 1
    end if
    let raw1: String = await channel_receive<String>(handle.messages)
    let raw2: String = await channel_receive<String>(handle.messages)
    let raw3: String = await channel_receive<String>(handle.messages)
    let p1: Result<WatchEvent, SchemaError> = Json.parse<WatchEvent>(raw1)
    let p2: Result<WatchEvent, SchemaError> = Json.parse<WatchEvent>(raw2)
    let p3: Result<WatchEvent, SchemaError> = Json.parse<WatchEvent>(raw3)
    if p1.ok = false or p2.ok = false or p3.ok = false then
        call Std.IO.log("gRPC Watch received malformed event")
        return 1
    end if
    let total: Integer = p1.value.sequence + p2.value.sequence + p3.value.sequence
    if total != 6 then
        call Std.IO.log("gRPC Watch event sequence sum mismatch")
        return 1
    end if
    call Std.IO.log("gRPC Watch streamed 3 events")
    return 0
end client_worker

async function run_demo() returns Integer
is
    let endpoint: Endpoint = new_endpoint("grpc", "127.0.0.1", 50552, "")
    let serve_result: Result<ServerHandle, ConnectError> = serve(endpoint)
    if serve_result.ok = false then
        call Std.IO.log("gRPC server failed to bind")
        return 1
    end if
    let server: ServerHandle = serve_result.value
    let client: Client = new_client(endpoint)

    scope demo_scope do
        spawn
            let server_handle: JoinHandle<Integer> = demo_scope.spawn<Integer>(server_worker(server))
            let client_handle: JoinHandle<Integer> = demo_scope.spawn<Integer>(client_worker(client))
        join
            let server_status: Integer = await demo_scope.join<Integer>(server_handle)
            let client_status: Integer = await demo_scope.join<Integer>(client_handle)
            call stop_server(server)
            if client_status = 0 and server_status = 0 then
                call Std.IO.log("Native gRPC server handled Watch stream")
            end if
        result
            return server_status + client_status
    end scope
end run_demo

async procedure main()
is
    let status: Integer = await run_demo()
    if status = 0 then
        call Std.IO.log("Native gRPC server-stream demo finished successfully")
    else
        call Std.IO.log("Native gRPC server-stream demo finished with failure")
    end if
end main

end App.Main
