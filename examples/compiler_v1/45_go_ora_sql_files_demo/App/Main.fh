module App.Main

import File exposing read_to_string
import Std.IO
import Std.Env exposing getenv
import Std.Crypto exposing CryptoError, KeePassXCCredential, keepassxc_entry_credential
import Std.Oracle exposing OracleDemoRow, OracleError, conn_from_wallet_tns, exec_sql_wallet_timeout, ping_wallet_timeout, query_demo_rows_wallet_timeout, query_rows_wallet_timeout, query_scalar_wallet_timeout

-- Oracle SQL-file demo.
--
-- Required environment variables:
--   ORACLE_SQL_DIR=examples/compiler_v1/45_go_ora_sql_files_demo/sql
--
-- Username/password are loaded read-only from KeePassXC entry TEST_DEMO in
-- the OracleAccounts profile/database. Wallet_Location from that entry points
-- to the folder containing tnsnames.ora.
--
-- SQL and PL/SQL live in .sql files and are loaded at runtime via
-- File.read_to_string before being executed through the Oracle FFI.
function sql_path(sql_dir: String, file_name: String) returns String
is
    return String.concat(String.concat(sql_dir, "/"), file_name)
end sql_path

function run_exec_file(wallet_conn: String, wallet_path: String, sql_dir: String, file_name: String, label: String, timeout_seconds: Integer) returns Boolean
is
    let path: String = sql_path(sql_dir, file_name)
    let loaded: Result<String, String> = read_to_string(path)
    if loaded.ok = false then
        call Std.IO.logf("read SQL file failed: ${}", loaded.error)
        return false
    end if

    let executed: Result<String, OracleError> = exec_sql_wallet_timeout(wallet_conn, wallet_path, loaded.value, timeout_seconds)
    if executed.ok = false then
        call Std.IO.logf("execute SQL file failed: ${}", String.error_text(executed.error))
        return false
    end if

    call Std.IO.logf("executed SQL file: ${}", label)
    return true
end run_exec_file

function run_demo() returns Integer
is
    let timeout_seconds: Integer = 10

    let sql_dir: String = getenv("ORACLE_SQL_DIR")
    if sql_dir = "" then
        call Std.IO.log("ORACLE_SQL_DIR is missing")
        return 1
    end if

    let oracle_credentials: Result<KeePassXCCredential, CryptoError> = keepassxc_entry_credential("OracleAccounts", "./OracleAccounts.dbx", "TEST_DEMO")
    if oracle_credentials.ok = false then
        call Std.IO.logf("Oracle TEST_DEMO credential lookup failed: ${}", String.error_text(oracle_credentials.error))
        return 1
    end if
    call Std.IO.logf("Oracle credentials loaded from KeePassXC for username = ${}", oracle_credentials.value.username)
    let wallet_path: String = oracle_credentials.value.wallet_location
    call Std.IO.log("Oracle wallet location loaded from KeePassXC")

    let wallet_conn_result: Result<String, OracleError> = conn_from_wallet_tns(wallet_path, oracle_credentials.value.username, oracle_credentials.value.password)
    if wallet_conn_result.ok = false then
        call Std.IO.logf("Oracle connection URL build from tnsnames.ora failed: ${}", String.error_text(wallet_conn_result.error))
        return 1
    end if
    let wallet_conn: String = wallet_conn_result.value

    let wallet_ping: String = ping_wallet_timeout(wallet_conn, wallet_path, timeout_seconds)
    if wallet_ping != "" then
        call Std.IO.logf("Oracle wallet ping failed: ${}", wallet_ping)
        return 1
    end if
    call Std.IO.log("Oracle wallet ping succeeded")

    let time_sql_path: String = sql_path(sql_dir, "select_time.sql")
    let time_sql: Result<String, String> = read_to_string(time_sql_path)
    if time_sql.ok = false then
        call Std.IO.logf("read select_time.sql failed: ${}", time_sql.error)
        return 1
    end if

    let wallet_scalar: Result<String, OracleError> = query_scalar_wallet_timeout(wallet_conn, wallet_path, time_sql.value, timeout_seconds)
    if wallet_scalar.ok = false then
        call Std.IO.logf("Oracle select_time.sql failed: ${}", String.error_text(wallet_scalar.error))
        return 1
    end if
    call Std.IO.logf("Oracle wallet database time = ${}", wallet_scalar.value)

    if run_exec_file(wallet_conn, wallet_path, sql_dir, "drop_table.sql", "drop_table.sql", timeout_seconds) = false then
        return 1
    end if

    if run_exec_file(wallet_conn, wallet_path, sql_dir, "create_table.sql", "create_table.sql", timeout_seconds) = false then
        return 1
    end if

    if run_exec_file(wallet_conn, wallet_path, sql_dir, "insert_alpha.sql", "insert_alpha.sql", timeout_seconds) = false then
        return 1
    end if

    if run_exec_file(wallet_conn, wallet_path, sql_dir, "insert_beta.sql", "insert_beta.sql", timeout_seconds) = false then
        return 1
    end if

    let select_rows_path: String = sql_path(sql_dir, "select_rows.sql")
    let select_rows: Result<String, String> = read_to_string(select_rows_path)
    if select_rows.ok = false then
        call Std.IO.logf("read select_rows.sql failed: ${}", select_rows.error)
        return 1
    end if

    let rows: Result<String, OracleError> = query_rows_wallet_timeout(wallet_conn, wallet_path, select_rows.value, 20, timeout_seconds)
    if rows.ok = false then
        call Std.IO.logf("Oracle select_rows.sql failed: ${}", String.error_text(rows.error))
        return 1
    end if
    call Std.IO.logf("Oracle SQL-file rows:\n${}", rows.value)

    let typed_rows_result: Result<Array<OracleDemoRow, 2>, OracleError> = query_demo_rows_wallet_timeout(wallet_conn, wallet_path, select_rows.value, timeout_seconds)
    if typed_rows_result.ok = false then
        call Std.IO.logf("Oracle typed rows from SQL file failed: ${}", String.error_text(typed_rows_result.error))
        return 1
    end if

    let typed_rows: Array<OracleDemoRow, 2> = typed_rows_result.value
    let row_index: Integer = 0
    while row_index < 2
    invariant row_index >= 0
    invariant row_index <= 2
    variant 2 - row_index
    do
        let row: OracleDemoRow = typed_rows[row_index]
        let row_text: String = String.template("typed SQL-file row id=${id}, name=${name}, amount=${amount}", id: row.id, name: row.name, amount: row.amount)
        call Std.IO.log(row_text)
        row_index := row_index + 1
    end while

    return 0
end run_demo

procedure main()
is
    let status: Integer = run_demo()
    if status = 0 then
        call Std.IO.log("go-ora SQL-file demo finished successfully")
    else
        call Std.IO.log("go-ora SQL-file demo finished with failure")
    end if
end main

end App.Main