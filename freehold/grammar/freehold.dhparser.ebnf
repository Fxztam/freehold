@ whitespace = /\s*/
@ comment    = /--[^\n]*(?:\n|$)|\/\*(?:.|\n)*?\*\//
@ literalws = right

start = ~ module_decl { import_decl } { declaration } module_end EOF
EOF = /$/

module_decl = ~ "module" ~ qualified_name
module_end  = ~ "end" ~ qualified_name
qualified_name = IDENT { ~ "." ~ IDENT }

import_decl = ~ "import" qualified_name [ exposing_clause ]
exposing_clause = "exposing" exposing_list
exposing_list = IDENT { "," IDENT }

declaration = record_type_decl | type_decl | error_decl | service_decl | function_decl | procedure_decl

record_type_decl = ~ "type" IDENT [ type_param_list ] "is" "record" record_field { record_field } "end" "record"
type_param_list = "<" IDENT { "," IDENT } ">"
record_field = IDENT ":" type_ref [ proto_field_id ]
proto_field_id = "proto" INTEGER_LITERAL

type_decl = ~ "type" IDENT "is" base_type [ range_decl ]
range_decl = "range" NUMBER_LITERAL ".." NUMBER_LITERAL
error_decl = ~ "error" IDENT

base_type = BASE_TYPE
type_ref = ( BASE_TYPE | IDENT ) [ type_arg_list ]
type_arg_list = "<" type_ref { "," type_ref } ">"
return_type = array_type | result_type | type_ref

result_payload_type = array_type | result_type | type_ref
result_type = "Result" "<" result_payload_type "," type_ref ">"
array_type = "Array" "<" type_ref "," INTEGER_LITERAL ">"

function_decl = ~ [ async_marker ] "function" IDENT [ type_param_list ] "(" [ param_list ] ")" "returns" return_type [ contract_block ] "is" { stmt } "end" IDENT
async_marker = "async"
procedure_decl = ~ "procedure" IDENT [ type_param_list ] "(" [ param_list ] ")" [ contract_block ] "is" { stmt } "end" IDENT
service_decl = ~ "service" IDENT "is" rpc_decl { rpc_decl } "end" IDENT
rpc_decl = ~ "rpc" IDENT "(" IDENT ":" type_ref ")" ":" type_ref

param_list = param { "," param }
param = IDENT ":" type_ref

contract_block = { requires_clause } { aborts_clause } { ensures_clause }
requires_clause = "requires" constraint_list
constraint_list = constraint { "," constraint }
constraint = IDENT "is" IDENT | expr
aborts_clause = "aborts" IDENT [ "when" expr ]
ensures_clause = "ensures" expr_list

stmt = let_stmt | return_stmt | abort_stmt | if_stmt | while_stmt | case_stmt | scope_stmt | check_stmt | call_stmt | field_assign_stmt | assign_stmt
let_stmt = ~ "let" IDENT ":" return_type "=" expr
field_assign_stmt = ~ FIELD_PATH ":=" expr
assign_stmt = ~ IDENT ":=" expr
return_stmt = ~ "return" return_value
abort_stmt = ~ "abort" IDENT
return_value = "ok" expr | "error" IDENT | expr
check_stmt = ~ "check" expr
call_stmt = ~ "call" qualified_name [ type_arg_list ] "(" [ arg_list ] ")"

if_stmt = ~ "if" expr "then" then_block [ "else" else_block ] "end" "if"
then_block = { stmt }
else_block = { stmt }

while_stmt = ~ "while" expr invariant_clause { invariant_clause } [ variant_clause ] "do" loop_block "end" "while"
loop_block = { stmt }
invariant_clause = ~ "invariant" expr
variant_clause = ~ "variant" expr

case_stmt = ~ "case" expr "is" case_branch { case_branch } default_branch "end" "case"
case_branch = ~ "when" expr "=>" case_block
default_branch = ~ "default" "=>" case_block
case_block = { stmt }

scope_stmt = ~ "scope" IDENT "do" scope_spawn_block scope_join_block scope_result_block "end" "scope"
scope_spawn_block = ~ "spawn" { stmt }
scope_join_block = ~ "join" { stmt }
scope_result_block = ~ "result" { stmt }

arg_list = call_arg { "," call_arg }
call_arg = named_arg | expr
expr_list = expr { "," expr }
named_arg_list = named_arg { "," named_arg }
named_arg = IDENT ":" expr

expr = ~ ( quantifier_expr | logic_or )
quantifier_expr = "for" ( "all" | "some" | "each" ) IDENT "in" logic_or ".." logic_or "=>" expr
logic_or = logic_and { "or" logic_and }
logic_and = equality { "and" equality }
equality = comparison { ( "!=" | "=" ) comparison }
comparison = sum { ( "<=" | ">=" | "<" | ">" ) sum }
sum = product { ( "+" | "-" ) product }
product = unary { ( "*" | "/" ) unary }
unary = "await" unary | "-" unary | "not" unary | postfix_expr

postfix_expr = primary { postfix }
postfix = [ type_arg_list ] "(" [ arg_list ] ")" | "[" expr "]" | "." member_name
member_name = IDENT | "spawn" | "join" | "value" | "error"

primary = STRING_LITERAL
     | DOUBLE_LITERAL
     | INTEGER_LITERAL
     | array_literal
     | "scope" "(" [ arg_list ] ")"
     | IDENT type_arg_list "(" [ arg_list ] ")"
     | IDENT "{" named_arg_list "}"
     | type_ref "{" named_arg_list "}"
     | IDENT
     | "(" expr ")"
     | "true" | "false" | "success" | "failure" | "value" | "error"

atom = postfix_expr

field_path = FIELD_PATH
array_literal = "[" [ arg_list ] "]"

BASE_TYPE = "Integer" | "Boolean" | "Double" | "String" | "BigInteger" | "BigFloat"
DOUBLE_LITERAL = /-?(?:[0-9]+\.[0-9]+)/~
NUMBER_LITERAL = DOUBLE_LITERAL | INTEGER_LITERAL
INTEGER_LITERAL = /-?[0-9]+/~
IDENT = /(?!module\b|import\b|exposing\b|type\b|is\b|record\b|error\b|function\b|procedure\b|service\b|rpc\b|proto\b|returns\b|requires\b|aborts\b|ensures\b|let\b|return\b|abort\b|ok\b|if\b|then\b|else\b|end\b|while\b|invariant\b|variant\b|do\b|case\b|when\b|default\b|call\b|check\b|and\b|or\b|not\b|async\b|await\b|scope\b|spawn\b|join\b|true\b|false\b|success\b|failure\b|value\b|for\b|all\b|some\b|each\b|in\b)[A-Za-z_][A-Za-z0-9_]*/~
FIELD_PATH = /(?!module\b|import\b|exposing\b|type\b|is\b|record\b|error\b|function\b|procedure\b|service\b|rpc\b|proto\b|returns\b|requires\b|aborts\b|ensures\b|let\b|return\b|abort\b|ok\b|if\b|then\b|else\b|end\b|while\b|invariant\b|variant\b|do\b|case\b|when\b|default\b|call\b|check\b|and\b|or\b|not\b|async\b|await\b|scope\b|spawn\b|join\b|true\b|false\b|success\b|failure\b|value\b|for\b|all\b|some\b|each\b|in\b)[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+/~
STRING_LITERAL = /"[^"\\]*(?:\\.[^"\\]*)*"/~