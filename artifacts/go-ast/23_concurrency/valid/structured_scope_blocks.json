  "source_snippet": "module Concurrency.StructuredScopeBlocks\r\n\r\ntype Invoice is record\r\n    id: Integer\r\nend record\r\n\r\ntype Customer is record\r\n    id: Integer\r\nend record\r\n\r\nasync function load_invoice(id: Integer) returns Invoice\r\nis\r\n    return Invoice { id: id }\r\nend load_invoice\r\n\r\nasync function load_customer(id: Integer) returns Customer\r\nis\r\n    return Customer { id: id }\r\nend load_customer\r\n\r\nfunction render_invoice(invoice: Invoice, customer: Customer) returns Integer\r\nis\r\n    return invoice.id + customer.id\r\nend render_invoice\r\n\r\nasync function handle(id: Integer) returns Integer\r\nis\r\n    scope request_scope do\r\n        spawn\r\n            let invoice_handle: JoinHandle\u003cInvoice\u003e = request_scope.spawn\u003cInvoice\u003e(load_invoice(id))\r\n            let customer_handle: JoinHandle\u003cCustomer\u003e = request_scope.spawn\u003cCustomer\u003e(load_customer(id))\r\n        join\r\n            let invoice: Invoice = await request_scope.join\u003cInvoice\u003e(invoice_handle)\r\n            let customer: Customer = await request_scope.join\u003cCustomer\u003e(customer_handle)\r\n        result\r\n            return render_invoice(invoice, customer)\r\n    end scope\r\nend handle\r\n\r\nend Concurrency.StructuredScopeBlocks\r\n",
