  "source_snippet": "module Matrix.CaseRecordValues\r\n\r\ntype Account is record\r\n    id: Integer\r\n    active: Boolean\r\nend record\r\n\r\nfunction choose(kind: Integer) returns Account\r\nis\r\n    case kind is\r\n        when 1 =\u003e\r\n            return Account { id: 1, active: true }\r\n        when 2 =\u003e\r\n            return Account { id: 2, active: false }\r\n        default =\u003e\r\n            return Account { id: 0, active: false }\r\n    end case\r\nend choose\r\n\r\nprocedure main()\r\nis\r\n    let selected: Account = choose(1)\r\n    check selected.id = 1\r\nend main\r\n\r\nend Matrix.CaseRecordValues",
