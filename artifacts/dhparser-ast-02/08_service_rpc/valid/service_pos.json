  "parse_ok": true,
  "source_snippet": "-- ============================================================\n-- test-08-service_pos.fh  -  Service/RPC PASS-Tests (SVC-01..04)\n-- ============================================================\nmodule Test.Service.Pos\n\ntype PointRequest is record\n    id: Integer proto 1\nend record\n\ntype PrefixRequest is record\n    prefix: String proto 1\nend record\n\ntype ValueRequest is record\n    val: Integer proto 1\nend record\n\ntype CreatePointRequest is record\n    n: Integer proto 1\nend record\n\ntype PointMessage is record\n    x: Integer proto 1\n    y: Integer proto 2\nend record\n\ntype LabeledMessage is record\n    name: String proto 1\n    amount: Integer proto 2\nend record\n\ntype CountLabelsResponse is record\n    count: Integer proto 1\nend record\n\ntype SafePointResponse is record\n    success_flag: Boolean proto 1\n    point: PointMessage proto 2\n    error_text: String proto 3\nend record\n\n-- SVC-01/02: Service mit einem RPC\nservice PointService is\n    rpc GetPoint(request: PointRequest): PointMessage\nend PointService\n\n-- SVC-01/02: Service mit mehreren RPCs\nservice LabelService is\n    rpc GetLabeled(request: PointRequest):  LabeledMessage\n    rpc CountLabels(request: PrefixRequest): CountLabelsResponse\n    rpc FindByValue(request: ValueRequest):  LabeledMessage\nend LabelService\n\n-- SVC-02: RPC mit explizitem Safe-Response-Record\nservice SafeService is\n    rpc FindPoint(request: PointRequest):       SafePointResponse\n    rpc CreatePoint(request: CreatePointRequest): SafePointResponse\nend SafeService\n\nend Test.Service.Pos\n",
