module test_array_quantifiers

function verify_quantifiers(arr: Array<Integer, 3>) returns Boolean
is
    let all_positive: Boolean = for all I in 0..2 => arr[I] >= 0
    let some_non_negative: Boolean = for some I in 0..2 => arr[I] = 0
    return all_positive and some_non_negative
end verify_quantifiers

end test_array_quantifiers

