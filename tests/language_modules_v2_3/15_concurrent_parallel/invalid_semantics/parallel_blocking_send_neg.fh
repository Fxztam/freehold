module ConcurrentParallelBlockingSendNeg

async function Worker(sender: Sender<Integer>, val: Integer) returns Boolean
is
    let ok_val: Boolean = await channel_send<Integer>(sender, val)
    return ok_val
end Worker

async procedure Main()
is
    let chan: Channel<Integer> = channel<Integer>(8)
    let sender: Sender<Integer> = channel_sender<Integer>(chan)

    parallel (limit = 2)
    do
        -- Spawning Worker which transitively calls blocking 'channel_send' inside a parallel pool
        let first: JoinHandle<Boolean> = spawn Worker(sender, 42)
        let first_done: Boolean = await first
    end parallel
end Main

end ConcurrentParallelBlockingSendNeg