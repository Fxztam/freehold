module RuntimeAssertions.Pos

type RangeType is Integer range 5..10

function check_pos(val: Integer) returns Boolean
requires val = 2
is
    let x: RangeType = 7
    let arr: Array<Integer, 3> = [1, 2, 3]
    let idx: Integer = 1
    check val = 2
    return true
end check_pos

end RuntimeAssertions.Pos
