module MonomorphizedInferenceAndConstraintsPos

function min_val<T>(a: T, b: T) returns T
requires T is Comparable
is
    if a < b then
        return a
    end if
    return b
end min_val

function add_val<T>(a: T, b: T) returns T
requires T is Numeric
is
    return a + b
end add_val

procedure log_and_swap<T>(a: T, b: T)
requires T is Comparable
is
    let temp: T = a
    let first: T = b
    let second: T = temp
end log_and_swap

procedure main()
is
    let x: Integer = min_val(10, 20)
    let y: Double = min_val(3.14, 2.71)
    let z: Integer = add_val(40, 2)
    let w: Double = add_val(1.5, 2.5)

    call log_and_swap(10, 20)
    call log_and_swap(3.14, 2.71)
end main

end MonomorphizedInferenceAndConstraintsPos
