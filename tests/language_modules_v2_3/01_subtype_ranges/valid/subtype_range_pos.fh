module SubtypeRangePos
type Percent is Integer range 0..100
type Index is Integer range 1..10

function check_bound(p: Percent) returns Percent
is
    let x: Percent = p
    return x
end check_bound

function process_index(idx: Index) returns Integer
is
    let val: Integer = idx
    return val
end process_index

type Scale is Double range 0.0..1.0

function process_scale(s: Scale) returns Double
is
    let val: Double = s
    return val
end process_scale
end SubtypeRangePos
