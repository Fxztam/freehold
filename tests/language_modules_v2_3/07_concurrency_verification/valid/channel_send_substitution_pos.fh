module Concurrency.ChannelSendSubstitutionPos

async function verify_send_with_substitution() returns Integer
is
    let chan: Channel<Integer> = channel<Integer>(8) with invariant for all X in 0 .. 0 => X >= 0
    let sender: Sender<Integer> = channel_sender<Integer>(chan)
    let payload: Integer = 5

    let sent: Boolean = await channel_send<Integer>(sender, payload)
    return 0
end verify_send_with_substitution

end Concurrency.ChannelSendSubstitutionPos
