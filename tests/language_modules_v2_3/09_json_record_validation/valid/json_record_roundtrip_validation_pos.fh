module JsonRecordRoundtripValidationPos

type Address is record
    city: String
    zip: ZipCode
end record

type ZipCode is Integer range 10000..99999

type Person is record
    first_name: String @json("firstName")
    address: Address
    tags: Array<String, 2>
    active: Boolean
end record

procedure main()
is
    let text: String = "{\"firstName\":\"Ada\",\"address\":{\"city\":\"London\",\"zip\":12345},\"tags\":[\"math\",\"code\"],\"active\":true}"
    let parsed: Result<Person, SchemaError> = Json.parse<Person>(text)
    check parsed.ok
    check parsed.value.first_name = "Ada"
    check parsed.value.address.city = "London"
    check parsed.value.address.zip = 12345
    let encoded: String = Json.stringify(parsed.value)
    check encoded = text
    let bad_zip_text: String = "{\"firstName\":\"Ada\",\"address\":{\"city\":\"London\",\"zip\":999},\"tags\":[\"math\",\"code\"],\"active\":true}"
    let bad_zip: Result<Person, SchemaError> = Json.parse<Person>(bad_zip_text)
    check bad_zip.ok = false
end main

end JsonRecordRoundtripValidationPos