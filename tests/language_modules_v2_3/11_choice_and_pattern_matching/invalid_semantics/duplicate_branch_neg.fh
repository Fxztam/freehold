module DuplicateBranchNeg

choice Option<T> =
    Some(val: T)
  | None
end Option

procedure test(opt: Option<Integer>)
is
    let val: Integer = 0
    case opt is
        | Some(v) =>
            val := v
        | Some(x) =>
            val := x
        | None =>
            val := 0
    end case
end test

end DuplicateBranchNeg