module UnknownConstructorNeg

choice Option<T> =
    Some(val: T)
  | None
end Option

procedure test(opt: Option<Integer>)
is
    let val: Integer = 0
    case opt is
        | InvalidConstructor(v) =>
            val := v
        | None =>
            val := 0
    end case
end test

end UnknownConstructorNeg