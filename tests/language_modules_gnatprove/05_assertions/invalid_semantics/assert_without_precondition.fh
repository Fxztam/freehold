module test_assertions.assert_without_precondition

type Int is Integer range -2147483648..2147483647

function assert_twice_bad(x: Int) returns Boolean
is
    check x > 0
    check x > 0
    return true
end assert_twice_bad

procedure main()
is
    let res: Boolean = assert_twice_bad(10)
end main

end test_assertions.assert_without_precondition