module test_assertions.assert_precondition

type Int is Integer range -2147483648..2147483647

function assert_twice_good(x: Int) returns Boolean
requires x > 0
is
    check x > 0
    check x > 0
    return true
end assert_twice_good

procedure main()
is
    let res: Boolean = assert_twice_good(10)
end main

end test_assertions.assert_precondition