module Neg_Alias_Two_Mutable_Parameters

record Cell
    value: Integer
end Cell

procedure add_to_both(left: Cell, right: Cell)
modifies left.value, right.value
do
    left.value := left.value + 1
    right.value := right.value + 1
end add_to_both

procedure main()
let c: Cell = Cell(value = 0)
call add_to_both(c, c)
end main

end Neg_Alias_Two_Mutable_Parameters
