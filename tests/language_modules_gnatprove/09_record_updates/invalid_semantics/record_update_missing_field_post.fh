module test_record_updates.record_update_missing_field_post

type Int is Integer range -2147483648..2147483647

type Account is record
    balance: Int
    limit: Int
end record

function unsafe_deposit(acc: Account, amount: Int) returns Boolean
modifies acc.balance, acc.limit
requires amount >= 0
requires acc.balance <= 2147483647 - amount
ensures acc.balance = old(acc.balance) + amount
ensures acc.limit = old(acc.limit)
is
    acc.balance := acc.balance + amount
    acc.limit := acc.limit + 1
    return true
end unsafe_deposit

procedure main()
is
    let acc: Account = Account { balance: 100, limit: 1000 }
    let res: Boolean = unsafe_deposit(acc, 50)
end main

end test_record_updates.record_update_missing_field_post