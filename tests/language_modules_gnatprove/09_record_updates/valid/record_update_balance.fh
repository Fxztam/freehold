module test_record_updates.record_update_balance

type Int is Integer range -2147483648..2147483647

type Account is record
    balance: Int
    limit: Int
end record

function deposit(acc: Account, amount: Int) returns Boolean
modifies acc.balance
requires amount >= 0
requires acc.balance <= 2147483647 - amount
ensures acc.balance = old(acc.balance) + amount
ensures acc.limit = old(acc.limit)
is
    acc.balance := acc.balance + amount
    return true
end deposit

procedure main()
is
    let acc: Account = Account { balance: 100, limit: 1000 }
    let res: Boolean = deposit(acc, 50)
    check acc.balance = 150
    check acc.limit = 1000
end main

end test_record_updates.record_update_balance