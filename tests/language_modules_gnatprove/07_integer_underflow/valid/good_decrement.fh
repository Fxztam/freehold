module test_integer_underflow.good_decrement

type Int is Integer range -2147483648..2147483647

function good_decrement(x: Int) returns Int
requires x > -2147483648
ensures result = x - 1
is
    return x - 1
end good_decrement

procedure main()
is
    let x: Int = good_decrement(41)
    check x = 40
end main

end test_integer_underflow.good_decrement