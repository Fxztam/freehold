module test_basic_addition.neg_addition_naive_pre_overflows

type Int is Integer range -2147483648..2147483647

function addition(x: Int, y: Int) returns Int
requires x + y >= -2147483648
requires x + y <= 2147483647
ensures result = x + y
is
    return x + y
end addition

procedure main()
is
    let z: Int = addition(2147483647, 1)
end main

end test_basic_addition.neg_addition_naive_pre_overflows