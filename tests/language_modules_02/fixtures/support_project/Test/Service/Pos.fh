-- ============================================================
-- test-08-service_pos.fh  -  Service/RPC PASS-Tests (SVC-01..04)
-- ============================================================
module Test.Service.Pos

type PointRequest is record
    id: Integer proto 1
end record

type PrefixRequest is record
    prefix: String proto 1
end record

type ValueRequest is record
    val: Integer proto 1
end record

type CreatePointRequest is record
    n: Integer proto 1
end record

type PointMessage is record
    x: Integer proto 1
    y: Integer proto 2
end record

type LabeledMessage is record
    name: String proto 1
    amount: Integer proto 2
end record

type CountLabelsResponse is record
    count: Integer proto 1
end record

type SafePointResponse is record
    success_flag: Boolean proto 1
    point: PointMessage proto 2
    error_text: String proto 3
end record

-- SVC-01/02: Service mit einem RPC
service PointService is
    rpc GetPoint(request: PointRequest): PointMessage
end PointService

-- SVC-01/02: Service mit mehreren RPCs
service LabelService is
    rpc GetLabeled(request: PointRequest):  LabeledMessage
    rpc CountLabels(request: PrefixRequest): CountLabelsResponse
    rpc FindByValue(request: ValueRequest):  LabeledMessage
end LabelService

-- SVC-02: RPC mit explizitem Safe-Response-Record
service SafeService is
    rpc FindPoint(request: PointRequest):       SafePointResponse
    rpc CreatePoint(request: CreatePointRequest): SafePointResponse
end SafeService

end Test.Service.Pos
