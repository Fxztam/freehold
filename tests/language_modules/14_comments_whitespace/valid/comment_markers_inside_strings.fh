module CommentMarkersInsideStrings

function text() returns String
    ensures result = "not -- a comment and not /* a block */"
is
    return "not -- a comment and not /* a block */"
end text

procedure main()
is
    let text_value: String = text()
    check text_value = "not -- a comment and not /* a block */"
end main

end CommentMarkersInsideStrings