module Concurrency.RuntimeCoreTypes

type RuntimeBundle is record
    executor: Executor
    scope: Scope
    handle: JoinHandle<Integer>
    channel: Channel<String>
    sender: Sender<String>
    receiver: Receiver<String>
end record

function pass_handle(handle: JoinHandle<Integer>) returns JoinHandle<Integer>
is
    return handle
end pass_handle

function pass_channel(channel: Channel<String>) returns Channel<String>
is
    return channel
end pass_channel

end Concurrency.RuntimeCoreTypes