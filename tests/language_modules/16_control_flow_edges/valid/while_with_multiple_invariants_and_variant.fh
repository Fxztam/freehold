module Matrix.WhileInvariantsVariant

procedure main()
is
    let amount: Integer = 3
    let seen: Integer = 0
    while amount > 0
        invariant amount >= 0
        invariant seen >= 0
        invariant amount + seen = 3
        variant amount
    do
        amount := amount - 1
        seen := seen + 1
    end while
    check seen = 3
end main

end Matrix.WhileInvariantsVariant