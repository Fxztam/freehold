module Partner.Reports

import Partner.Shared exposing Address, Order, NotFound, make_address, make_order

type PartnerReport is record
    order: Order
    depot: Address
end record

function find_partner(seed: Integer) returns Result<PartnerReport, NotFound>
requires seed > 0
ensures value.order.address.city_id = 7
is
    let depot: Address = make_address(7, "Hamburg")
    let order: Order = make_order(seed + 100, depot)
    return ok PartnerReport { order: order, depot: depot }
end find_partner

function load_partner(seed: Integer) returns PartnerReport
requires seed > 0
is
    let outcome: Result<PartnerReport, NotFound> = find_partner(seed)
    return outcome.value
end load_partner

end Partner.Reports