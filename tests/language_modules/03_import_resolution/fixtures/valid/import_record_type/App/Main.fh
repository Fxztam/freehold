module App.Main

import Domain.Types exposing Account, make_account, is_valid

function account_ok(account: Account) returns Boolean
    ensures result = (account.id = 1)
is
    return account.id = 1
end account_ok

procedure main()
is
    let account: Account = make_account()
    check account_ok(account)
    check is_valid(account)
end main

end App.Main
