module Domain.Types

type Account is record
    id: Integer
end record

function make_account() returns Account
    ensures result.id = 1
is
    return Account { id: 1 }
end make_account

function is_valid(account: Account) returns Boolean
    ensures result = (account.id = 1)
is
    return account.id = 1
end is_valid

end Domain.Types
