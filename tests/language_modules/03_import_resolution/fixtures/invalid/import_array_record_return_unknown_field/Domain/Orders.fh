module Domain.Orders

import Domain.Types exposing Address, Customer, Order, make_address, make_customer, make_order

function load_orders(id: Integer) returns Array<Order, 2>
is
    let address: Address = make_address(42)
    let customer: Customer = make_customer(1001, address)
    return [make_order(id, customer), make_order(id + 1, customer)]
end load_orders

end Domain.Orders
