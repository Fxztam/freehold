module GrpcIdl.DuplicateProtoFieldId

type UserRequest is record
    id: String proto 1
    email: String proto 1
end record

type UserReply is record
    name: String proto 1
end record

service UserService is
    rpc GetUser(request: UserRequest): UserReply
end UserService

end GrpcIdl.DuplicateProtoFieldId
