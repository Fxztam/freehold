module App.Main

import Big

function accumulate(terms: Integer) returns BigInteger
    requires terms = 3
    ensures result = Big.fromInteger(6)
is
    let total: BigInteger = Big.fromInteger(0)
    let i: Integer = 0

    while i < terms
        invariant i >= 0
        invariant i <= terms
        invariant terms = 3
        invariant (i = 0 and total = Big.fromInteger(0)) or (i = 1 and total = Big.fromInteger(1)) or (i = 2 and total = Big.fromInteger(3)) or (i = 3 and total = Big.fromInteger(6))
        variant terms - i
    do
        let next_i: Integer = i + 1
        let next_big: BigInteger = Big.fromInteger(next_i)
        total := Big.addInt(total, next_big)
        i := next_i
    end while

    return total
end accumulate

procedure main()
is
    let terms: Integer = 3
    let total: BigInteger = accumulate(terms)
    check Big.toString(total) = "6"
end main

end App.Main