module Matrix.BigNumberExpression

import Big

procedure main()
is
    let base: BigInteger = Big.int("21")
    let doubled: BigInteger = Big.mulInt(base, Big.fromInteger(2))
    let message: String = String.template("answer=${}", Big.toString(doubled))
    check String.instr(message, "42") >= 0
end main

end Matrix.BigNumberExpression