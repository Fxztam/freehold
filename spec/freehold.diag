schema freehold.diag.v1

range FH-SYN-0001..0999 parse syntax
range FH-SEM-1000..1999 semantic semantic
range FH-TYP-2000..2999 semantic type
range FH-CON-3000..3999 semantic contract
range FH-ABT-3000..3999 semantic abort open
range FH-CON-3100..3199 semantic concurrency open
range FH-TPL-4000..4099 semantic template open
range FH-RES-4100..4199 semantic result open
range FH-JSON-4200..4299 semantic json open
range FH-REC-4300..4399 semantic record open
range FH-GRPC-4400..4499 semantic grpc open
range FH-GEN-5000..5099 semantic generic open
range FH-BLD-9000..9999 build tooling

# Current parser diagnostics from go-frontend/internal/diagnostic/catalog.go.

diag FH-SYN-0002 expected_identifier
severity error
phase parse
category syntax
message "Expected an identifier."
expected "identifier"
hint "Use a non-keyword name here."
end

diag FH-SYN-0003 missing_module_declaration
severity error
phase parse
category syntax
message "Expected a module declaration."
expected "module"
hint "A Freehold file must start with a module declaration."
end

diag FH-SYN-0004 missing_end
severity error
phase parse
category syntax
message "Expected an end marker."
expected "end"
hint "Close the current declaration or block with the matching end clause."
end

diag FH-SYN-0005 expected_type_annotation_colon
severity error
phase parse
category syntax
message "Expected ':' for a type annotation."
expected ":"
hint "Use ':' in declarations such as 'let x: Integer = 1'; ':=' is used for assignment."
end

diag FH-SYN-0006 invalid_contract_order
severity error
phase parse
category syntax
message "Expected requires clauses before ensures clauses."
expected "requires clauses before ensures clauses"
hint "Place all requires clauses before ensures clauses in a contract block."
end

diag FH-SYN-0007 expected_declaration
severity error
phase parse
category syntax
message "Expected a declaration."
expected "import, type, error, function, or procedure"
hint "Use import, type, error, function, or procedure at module level."
end

diag FH-SYN-0008 missing_case_default
severity error
phase parse
category syntax
message "Expected a default case branch."
expected "default"
hint "Every case statement must include a default branch."
end

diag FH-SYN-0009 missing_while_invariant
severity error
phase parse
category syntax
message "Expected a while invariant."
expected "invariant"
hint "Every while loop must declare at least one invariant before do."
end

diag FH-SYN-0010 unterminated_block_comment
severity error
phase parse
category syntax
message "Unterminated block comment."
expected "*/"
hint "Close the block comment with */."
end

diag FH-SYN-0011 expected_statement
severity error
phase parse
category syntax
message "Expected a statement."
expected "statement"
hint "Use let, return, check, call, assignment, if, while, or case in a statement block."
end

diag FH-SYN-0012 expected_assignment_or_call
severity error
phase parse
category syntax
message "Expected assignment or call statement."
expected ":= or call"
hint "An identifier-led statement must be an assignment with ':=' or a procedure call."
end

diag FH-SYN-0013 expected_number
severity error
phase parse
category syntax
message "Expected a number literal."
expected "number"
hint "Use an integer or double literal here."
end

diag FH-SYN-0014 missing_return_type
severity error
phase parse
category syntax
message "Expected a function return type."
expected "type"
hint "Add a type name after 'returns'."
end

diag FH-SYN-0015 expected_expression
severity error
phase parse
category syntax
message "Expected an expression."
expected "expression"
hint "Use a literal, identifier, call, parenthesized expression, or unary expression here."
end

diag FH-SYN-0016 unterminated_string
severity error
phase parse
category syntax
message "Unterminated string literal."
expected "double quote"
hint "Close the string literal with a double quote."
end

diag FH-SYN-0017 invalid_number_literal
severity error
phase parse
category syntax
message "Invalid number literal."
expected "number"
hint "Use digits with at most one decimal point and digits on both sides of the decimal point."
end

diag FH-SYN-0018 missing_parameter_colon
severity error
phase parse
category syntax
message "Expected ':' after a parameter name."
expected ":"
hint "Write parameters as 'name: Type'."
end

diag FH-SYN-0019 missing_end_function
severity error
phase parse
category syntax
message "Expected 'end' for a function declaration."
expected "end"
hint "Close the function body with 'end <function-name>'."
end

diag FH-SYN-0020 missing_end_procedure
severity error
phase parse
category syntax
message "Expected 'end' for a procedure declaration."
expected "end"
hint "Close the procedure body with 'end <procedure-name>'."
end

diag FH-SYN-0021 missing_end_if
severity error
phase parse
category syntax
message "Expected 'end if'."
expected "end if"
hint "Close the if statement with 'end if'."
end

diag FH-SYN-0022 missing_end_while
severity error
phase parse
category syntax
message "Expected 'end while'."
expected "end while"
hint "Close the while statement with 'end while'."
end

diag FH-SYN-0023 missing_end_case
severity error
phase parse
category syntax
message "Expected 'end case'."
expected "end case"
hint "Close the case statement with 'end case'."
end

diag FH-SYN-0999 expected_token
severity error
phase parse
category syntax
message "Expected a different token."
expected "expected token"
hint "Check the syntax around this token."
end

