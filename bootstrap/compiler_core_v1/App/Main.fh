        aborts_type: ""
    }
    let stmts_array: Array<StmtNode, 64> = [
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt,
        mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt, mock_stmt
    ]
    let flow_sum: FlowSummary = analyze_stmt_flow(mock_stmt, stmts_array, 0, 1)
    call Std.IO.logf("flow.return_possible = ${}", flow_sum.normal_return_possible)
    call Std.IO.logf("flow.exit_guaranteed = ${}", flow_sum.guaranteed_exit)
    let whyml_test: String = to_lower("TEST")
    call Std.IO.logf("whyml.to_lower = ${}", whyml_test)
    let dummy_type: IrType = IrType {
        kind: "PRIMITIVE",
        name: "Integer",
        element_type_idx: -1,
        array_size: 0,
        has_range: false,
        min_value: 0,
        max_value: 0
    }
    call Std.IO.logf("ir.type.name = ${}", dummy_type.name)

    let mock_expr: ExprNode = ExprNode {
        span: mock_span,
        kind: "LITERAL",
        literal_kind: "Integer",
        text: "42",
        op: "",
        left_node_idx: -1,
        right_node_idx: -1,
        routine_name: "",
        arg0_idx: -1,
        arg1_idx: -1,
        arg_count: 0,
        invariant_idx: -1
    }
    let exprs_array: Array<ExprNode, 64> = [
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr,
        mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr, mock_expr
    ]
    let mock_stmt_let: StmtNode = StmtNode {
        span: mock_span,
        kind: "LET",
        var_name: "x",
        var_type: "Integer",
        expr_idx: 0,
        cond_expr_idx: -1,
        then_block_start_idx: -1,
        then_block_len: 0,
        else_block_start_idx: -1,
        else_block_len: 0,
        routine_name: "",
        aborts_type: ""
    }
    let stmts_array_let: Array<StmtNode, 64> = [
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let,
        mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let, mock_stmt_let
    ]
    -- let mock_routine: IrRoutine = Compiler.Core.Lowering.lower_routine("test_routine", stmts_array_let, exprs_array, 0, 1)
    -- let blocks_arr: Array<IrBasicBlock, 32> = mock_routine.blocks
    -- let block: IrBasicBlock = blocks_arr[0]
    -- call Std.IO.logf("lowering.routine.instruction_count = ${}", block.instruction_count)

    let args: Array<String, 10> = System.args()
    if args[0] = "--build-exe" or args[0] = "build-exe" then
        let entry_file: String = args[1]
        let out_dir: String = args[2]
        let exe_name: String = args[3]
        if entry_file != "" and out_dir != "" then
            call Std.IO.logf("compiler_core_v1 running native build-exe for: ${}", entry_file)

            let entry_module: String = "App.Main"
            let entry_src_res: Result<String, String> = File.read_to_string(entry_file)
            if entry_src_res.ok then
                let entry_p: GeneralParser = init_general_parser(entry_file, entry_src_res.value)
                let entry_mod_res: ParserIdentifierResult = parse_module_decl(entry_p)
                if entry_mod_res.parser.has_error = false then
                    entry_module := entry_mod_res.node.name
                end if
            end if

            call Std.IO.logf("compiler_core_v1 scanned entry module: ${}", entry_module)
            let scan_state: ScannerState = scan_all_dependencies(entry_file, entry_module)
            call Std.IO.logf("compiler_core_v1 found ${} dependencies", scan_state.count)

            let deps_arr: Array<String, 32> = scan_state.deps
            let dep_idx: Integer = 0
            while dep_idx < scan_state.count invariant dep_idx >= 0 do
                call Std.IO.logf("  dependency: ${}", deps_arr[dep_idx])
                dep_idx := dep_idx + 1
            end while

            let go_mod_content: String = "module freehold.local\n\ngo 1.22\n"
            let go_mod_path: String = String.concat(out_dir, "/go.mod")
            let write_mod_res: Result<Boolean, String> = File.write_string(go_mod_path, go_mod_content)
            if write_mod_res.ok then
                call Std.IO.logf("compiler_core_v1 wrote go.mod to ${}", go_mod_path)
            else
                call Std.IO.logf("compiler_core_v1 failed to write go.mod: ${}", write_mod_res.value)
            end if

            let tidy_cmd: String = String.template("go -C ${dir} mod tidy", dir: out_dir)
            call Std.IO.logf("compiler_core_v1 executing: ${}", tidy_cmd)
            let tidy_exit: Integer = System.run_command(tidy_cmd)
            call Std.IO.logf("compiler_core_v1 go mod tidy exited with: ${}", tidy_exit)

            if exe_name != "" then
                let build_cmd: String = String.template("go -C ${dir} build -trimpath -o ${exe} ./cmd/${exe}", dir: out_dir, exe: exe_name)
                call Std.IO.logf("compiler_core_v1 executing: ${}", build_cmd)
                let build_exit: Integer = System.run_command(build_cmd)
                call Std.IO.logf("compiler_core_v1 go build exited with: ${}", build_exit)
            end if
        else
            call Std.IO.log("compiler_core_v1 build-exe usage: --build-exe <entry.fh> <output_dir> [executable_name]")
        end if
    else
        if args[0] != "" then
            call Std.IO.logf("compiler_core_v1 processing CLI file: ${}", args[0])
            let tokens: MiniModuleTokens = lex_mini_module(args[0], "Demo")
            let parsed: ParseResult = parse_mini_module_result(tokens)
            call Std.IO.logf("compiler_core_v1 CLI result: ${}", parse_result_summary(parsed))
        end if
    end if
end main

end App.Main
