procedure test_vm_concurrency_buffered()
is
    let dummy_span: SourceSpan = SourceSpan { source_name: "", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }
    let empty_type: IrType = IrType { kind: "", name: "", element_type_idx: -1, array_size: 0, has_range: false, min_value: 0, max_value: 0 }
    let types_val: Array<IrType, 10> = [
        empty_type, empty_type, empty_type, empty_type, empty_type,
        empty_type, empty_type, empty_type, empty_type, empty_type
    ]

    -- producer routine: sends 10 then 20 to _arg0 (sender)
    let p_inst0: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "v10",
        src_reg_left: "",
        src_reg_right: "",
        op: "",
        literal_value: "10",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let p_inst1: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "s1",
        src_reg_left: "_arg0",
        src_reg_right: "v10",
        op: "channel_send",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let p_inst2: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "v20",
        src_reg_left: "",
        src_reg_right: "",
        op: "",
        literal_value: "20",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let p_inst3: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "s2",
