        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d7 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d8 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d9 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d10 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d11 := res.item
