type PopResult is record
    item: String
    rest: String
end record

type ScannerState is record
    deps: Array<String, 32>
    count: Integer
end record

function pop_first(list: String) returns PopResult
is
    let len: Integer = String.length(list)
    if len <= 2 then
        return PopResult { item: "", rest: "" }
    end if
    let sub: String = String.substr(list, 1, len - 1)
    let idx: Integer = String.instr(sub, ",")
    if idx = -1 then
        return PopResult { item: "", rest: "" }
    else
        let item: String = String.substr(list, 1, idx)
        let rest: String = String.substr(list, 1 + idx, len - 1 - idx)
        return PopResult { item: item, rest: rest }
    end if
end pop_first

function extract_word(text: String, start: Integer) returns String
is
    let len: Integer = String.length(text)
    let i: Integer = start
    let word: String = ""
    while i < len invariant i >= 0 do
        let char: String = String.substr(text, i, 1)
        if char = " " or char = "\r" or char = "\n" or char = "\t" or char = ";" then
            return word
        else
            word := String.concat(word, char)
        end if
        i := i + 1
    end while
    return word
end extract_word

function scan_imports(source: String, current_deps: String) returns String
is
    let current_source: String = source
    let deps: String = current_deps

    let loop_flag: Boolean = true
    while loop_flag invariant String.length(deps) >= 0 do
        let pos: Integer = String.instr(current_source, "import ")
        if pos = -1 then
            loop_flag := false
        else
            let is_start: Boolean = false
            if pos = 0 then
                is_start := true
            else
                let prev: String = String.substr(current_source, pos - 1, 1)
                if prev = "\n" or prev = "\r" then
                    is_start := true
                end if
            end if

            if is_start then
                let mod_name: String = extract_word(current_source, pos + 7)
                if mod_name != "" then
                    let search_pattern: String = String.template(",${name},", name: mod_name)
                    if String.instr(deps, search_pattern) = -1 then
                        deps := String.concat(deps, String.concat(mod_name, ","))
                    end if
                end if
            end if

            let len: Integer = String.length(current_source)
            let next_start: Integer = pos + 7
            if next_start >= len then
                loop_flag := false
            else
                current_source := String.substr(current_source, next_start, len - next_start)
            end if
        end if
    end while
    return deps
end scan_imports

function get_directory_path(file_path: String) returns String
is
    let len: Integer = String.length(file_path)
    let last_slash: Integer = -1
    let i: Integer = 0
    while i < len invariant i >= 0 do
        let char: String = String.substr(file_path, i, 1)
        if char = "/" or char = "\\" then
            last_slash := i
        end if
        i := i + 1
    end while

    if last_slash = -1 then
        return ""
    else
        return String.substr(file_path, 0, last_slash + 1)
    end if
end get_directory_path

function go_up_directories(dir_path: String, levels: Integer) returns String
is
    let current: String = dir_path
    let l: Integer = 0
    while l < levels invariant l >= 0 do
        let curr_len: Integer = String.length(current)
        if curr_len > 0 then
            let last_char: String = String.substr(current, curr_len - 1, 1)
            if last_char = "/" or last_char = "\\" then
                current := String.substr(current, 0, curr_len - 1)
            end if
        end if

        let new_len: Integer = String.length(current)
        let last_slash: Integer = -1
        let i: Integer = 0
        while i < new_len invariant i >= 0 do
            let char: String = String.substr(current, i, 1)
            if char = "/" or char = "\\" then
                last_slash := i
            end if
            i := i + 1
        end while

        if last_slash = -1 then
            current := ""
        else
            current := String.substr(current, 0, last_slash + 1)
        end if

        l := l + 1
    end while
    return current
end go_up_directories

function count_dots(name: String) returns Integer
is
    let len: Integer = String.length(name)
    let count: Integer = 0
    let i: Integer = 0
    while i < len invariant i >= 0 do
        if String.substr(name, i, 1) = "." then
            count := count + 1
        end if
        i := i + 1
    end while
    return count
end count_dots

function scan_all_dependencies(entry_file: String, entry_module: String) returns ScannerState
is
    let root_dir: String = go_up_directories(get_directory_path(entry_file), count_dots(entry_module))

    let visited: String = ","
    let pending: String = String.template(",${name},", name: entry_module)

    let loop_flag: Boolean = true
    while String.length(pending) > 1 invariant String.length(pending) >= 0 do
        let pop_res: PopResult = pop_first(pending)
        pending := pop_res.rest
        let current_mod: String = pop_res.item

        let visited_pattern: String = String.template(",${name},", name: current_mod)
        if String.instr(visited, visited_pattern) = -1 then
            visited := String.concat(visited, String.concat(current_mod, ","))
        end if

        let relative_path: String = String.replace(current_mod, ".", "/")
        let file_path: String = String.concat(root_dir, relative_path)
        file_path := String.concat(file_path, ".fh")

        let file_res: Result<String, String> = File.read_to_string(file_path)
        if file_res.ok then
            let new_deps: String = scan_imports(file_res.value, ",")

            let temp_deps: String = new_deps
            while String.length(temp_deps) > 1 invariant String.length(temp_deps) >= 0 do
                let dep_pop: PopResult = pop_first(temp_deps)
                temp_deps := dep_pop.rest
                let dep_name: String = dep_pop.item

                if dep_name != "System" and dep_name != "File" and dep_name != "Std.IO" and dep_name != "Math" and dep_name != "Big" then
                    let in_visited: Boolean = String.instr(visited, String.template(",${name},", name: dep_name)) >= 0
                    let in_pending: Boolean = String.instr(pending, String.template(",${name},", name: dep_name)) >= 0
                    if in_visited = false and in_pending = false then
                        pending := String.concat(pending, String.concat(dep_name, ","))
                    end if
                end if
            end while
        end if
    end while

    let d0: String = ""
    let d1: String = ""
    let d2: String = ""
    let d3: String = ""
    let d4: String = ""
    let d5: String = ""
    let d6: String = ""
    let d7: String = ""
    let d8: String = ""
    let d9: String = ""
    let d10: String = ""
    let d11: String = ""
    let d12: String = ""
    let d13: String = ""
    let d14: String = ""
    let d15: String = ""
    let d16: String = ""
    let d17: String = ""
    let d18: String = ""
    let d19: String = ""
    let d20: String = ""
    let d21: String = ""
    let d22: String = ""
    let d23: String = ""
    let d24: String = ""
    let d25: String = ""
    let d26: String = ""
    let d27: String = ""
    let d28: String = ""
    let d29: String = ""
    let d30: String = ""
    let d31: String = ""

    let temp: String = visited
    let count: Integer = 0

    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d0 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d1 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d2 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d3 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d4 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d5 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d6 := res.item
