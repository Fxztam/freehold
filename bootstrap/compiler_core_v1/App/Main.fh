module App.Main

import Compiler.Core.Ast exposing IdentifierNode, LiteralNode, ModuleNode, ModuleWithFunctionNode, ModuleWithImportNode, ModuleWithImportReferenceNode, ModuleWithProcedureNode, ModuleWithRecordNode, ModuleWithRecordLiteralNode, ModuleWithReturnNode, ModuleWithCallNode, NestedCallStmtNode, ModuleWithNestedCallNode, LoweredCallNode, ModuleWithLoweredCallsNode, identifier_key, literal_text, make_identifier_node, make_literal_node, make_module_node, module_key, module_text, module_with_import_reference_text, module_with_record_literal_text, module_with_return_text, module_with_call_text, module_with_nested_call_text, module_with_lowered_calls_text
import Compiler.Core.Diagnostics exposing Diagnostic, diagnostic_key, diagnostic_text, make_diagnostic, make_unknown_exposed_symbol_diagnostic
import Compiler.Core.Fixtures exposing CompilerFixtureResult, evaluate_fixture
import Compiler.Core.Lexer exposing MiniFunctionModuleTokens, MiniImportModuleTokens, MiniImportReferenceModuleTokens, MiniModuleTokens, MiniProcedureModuleTokens, MiniRecordModuleTokens, MiniRecordLiteralModuleTokens, MiniReturnStmtModuleTokens, MiniCallModuleTokens, MiniNestedCallModuleTokens, lex_mini_function_module, lex_mini_import_module, lex_mini_import_reference_module, lex_mini_import_reference_module_pair, lex_mini_module, lex_mini_module_pair, lex_mini_procedure_module, lex_mini_record_module, lex_mini_record_literal_module, lex_mini_return_stmt_module, lex_mini_call_module, lex_mini_nested_call_module, mini_function_module_lexer_summary, mini_function_module_token_count, mini_import_module_lexer_summary, mini_import_module_token_count, mini_import_reference_module_lexer_summary, mini_import_reference_module_token_count, mini_module_lexer_summary, mini_module_token_count, mini_procedure_module_lexer_summary, mini_procedure_module_token_count, mini_record_module_lexer_summary, mini_record_module_token_count, mini_record_literal_module_lexer_summary, mini_record_literal_module_token_count, mini_return_stmt_module_lexer_summary, mini_return_stmt_module_token_count, mini_call_module_lexer_summary, mini_call_module_token_count, mini_nested_call_module_lexer_summary, mini_nested_call_module_token_count
import Compiler.Core.Names exposing GoPackagePath, ModuleName, SymbolName, exported_go_name, make_module_name, make_symbol_name, module_to_go_package
import Compiler.Core.ParseResult exposing ParseError, ParseResult, make_parse_error, parse_error_result, parse_ok, parse_result_summary
import Compiler.Core.Parser exposing mini_function_module_parser_summary, mini_import_module_parser_summary, mini_import_reference_module_parser_summary, mini_module_parser_summary, mini_procedure_module_parser_summary, mini_record_module_parser_summary, mini_record_literal_module_parser_summary, mini_return_stmt_module_parser_summary, mini_call_module_parser_summary, mini_nested_call_module_parser_summary, parse_mini_function_module, parse_mini_function_module_result, parse_mini_import_module, parse_mini_import_module_result, parse_mini_import_reference_module, parse_mini_import_reference_module_result, parse_mini_module, parse_mini_module_result, parse_mini_procedure_module, parse_mini_procedure_module_result, parse_mini_record_module, parse_mini_record_module_result, parse_mini_record_literal_module, parse_mini_record_literal_module_result, parse_mini_return_stmt_module, parse_mini_return_stmt_module_result, parse_mini_call_module, parse_mini_call_module_result, parse_mini_nested_call_module, parse_mini_nested_call_module_result, parsed_module_name
import Compiler.Core.Resolve exposing ResolveResult, resolve_mini_import_reference_module, resolve_result_summary
import Compiler.Core.Token exposing SourceSpan, Token, TokenKind, make_source_span, make_token, make_token_kind, token_key, token_text
import Compiler.Core.Transform exposing canonicalize_import_references, normalize_record_literal, wrap_return_stmt, lower_abort_propagation, flatten_nested_call

import Std.IO

function build_sample_diagnostic() returns Diagnostic
is
    let module_name: ModuleName = make_module_name("Compiler.Core.Names")
    let symbol_name: SymbolName = make_symbol_name("module_to_go_package")
    return make_diagnostic("FH-BLD-9001", "package path is stable", module_name, symbol_name)
end build_sample_diagnostic

procedure main()
is
    let diagnostic: Diagnostic = build_sample_diagnostic()
    let module_name: ModuleName = make_module_name("Compiler.Core.Names")
    let symbol_name: SymbolName = make_symbol_name("module_to_go_package")
    let package_path: GoPackagePath = module_to_go_package(module_name)
    let exported: String = exported_go_name(symbol_name)

    call Std.IO.logf("stage3.package = ${}", package_path.path)
    call Std.IO.logf("stage3.export = ${}", exported)
    call Std.IO.logf("stage3.diag.key = ${}", diagnostic_key(diagnostic))
    call Std.IO.logf("stage3.diag.text = ${}", diagnostic_text(diagnostic))

    let names_fixture: CompilerFixtureResult = evaluate_fixture("Compiler.Core.Names", "module_to_go_package", "FH-BLD-9001", "package path is stable")
    let diagnostics_fixture: CompilerFixtureResult = evaluate_fixture("Compiler.Core.Diagnostics", "diagnostic_text", "FH-BLD-9002", "diagnostic text is stable")

    call Std.IO.logf("fixture.names.package = ${}", names_fixture.package_path)
    call Std.IO.logf("fixture.names.export = ${}", names_fixture.exported_name)
    call Std.IO.logf("fixture.names.diag = ${}", names_fixture.diagnostic_text)
    call Std.IO.logf("fixture.diagnostics.package = ${}", diagnostics_fixture.package_path)
    call Std.IO.logf("fixture.diagnostics.export = ${}", diagnostics_fixture.exported_name)
    call Std.IO.logf("fixture.diagnostics.diag = ${}", diagnostics_fixture.diagnostic_text)

    let module_kind: TokenKind = make_token_kind("KeywordModule")
    let module_span: SourceSpan = make_source_span("mini_module.fh", 1, 1, 1, 7)
    let module_token: Token = make_token(module_kind, module_span, "module")

    call Std.IO.logf("token.kind = ${}", module_token.kind.name)
    call Std.IO.logf("token.key = ${}", token_key(module_token))
    call Std.IO.logf("token.text = ${}", token_text(module_token))

    let module_identifier_span: SourceSpan = make_source_span("mini_module.fh", 1, 8, 1, 12)
    let module_identifier: IdentifierNode = make_identifier_node(module_identifier_span, "Demo")
    let module_node: ModuleNode = make_module_node(module_span, module_identifier)
    let literal_span: SourceSpan = make_source_span("mini_module.fh", 2, 1, 2, 8)
    let literal_node: LiteralNode = make_literal_node(literal_span, "String", "hello")

    call Std.IO.logf("ast.identifier = ${}", identifier_key(module_identifier))
    call Std.IO.logf("ast.literal = ${}", literal_text(literal_node))
    call Std.IO.logf("ast.module.key = ${}", module_key(module_node))
    call Std.IO.logf("ast.module.text = ${}", module_text(module_node))

    let mini_tokens: MiniModuleTokens = lex_mini_module("mini_module.fh", "Demo")
    let mismatch_tokens: MiniModuleTokens = lex_mini_module_pair("mini_module.fh", "Demo", "Other")
    let record_tokens: MiniRecordModuleTokens = lex_mini_record_module("mini_record_module.fh", "Demo", "X")
    let function_tokens: MiniFunctionModuleTokens = lex_mini_function_module("mini_function_module.fh", "Demo", "answer")
    let procedure_tokens: MiniProcedureModuleTokens = lex_mini_procedure_module("mini_procedure_module.fh", "Demo", "run")
    let import_tokens: MiniImportModuleTokens = lex_mini_import_module("mini_import_module.fh", "Demo", "Demo.Support", "answer")
    let import_reference_tokens: MiniImportReferenceModuleTokens = lex_mini_import_reference_module("mini_import_reference_module.fh", "Demo", "Demo.Support", "answer", "use")
    let missing_import_reference_tokens: MiniImportReferenceModuleTokens = lex_mini_import_reference_module_pair("mini_import_reference_missing.fh", "Demo", "Demo.Support", "answer", "use", "missing")
    let record_literal_tokens: MiniRecordLiteralModuleTokens = lex_mini_record_literal_module("mini_record_literal.fh", "Demo", "Point", "y", "2", "x", "1")
    let return_tokens: MiniReturnStmtModuleTokens = lex_mini_return_stmt_module("mini_return.fh", "Demo", "ok", "100", "some_err")
    let call_tokens: MiniCallModuleTokens = lex_mini_call_module("mini_call.fh", "Demo", "foo", "arg", "SomeError")
    let nested_call_tokens: MiniNestedCallModuleTokens = lex_mini_nested_call_module("mini_nested_call.fh", "Demo", "y", "foo", "bar", "z")


    call Std.IO.logf("lexer.count = ${}", mini_module_token_count(mini_tokens))
    call Std.IO.logf("lexer.first = ${}", token_text(mini_tokens.module_keyword))
    call Std.IO.logf("lexer.name = ${}", token_text(mini_tokens.module_name))
    call Std.IO.logf("lexer.end = ${}", token_text(mini_tokens.end_keyword))
    call Std.IO.logf("lexer.summary = ${}", mini_module_lexer_summary(mini_tokens))
    call Std.IO.logf("lexer.record.count = ${}", mini_record_module_token_count(record_tokens))
    call Std.IO.logf("lexer.record.summary = ${}", mini_record_module_lexer_summary(record_tokens))
    call Std.IO.logf("lexer.function.count = ${}", mini_function_module_token_count(function_tokens))
    call Std.IO.logf("lexer.function.summary = ${}", mini_function_module_lexer_summary(function_tokens))
    call Std.IO.logf("lexer.procedure.count = ${}", mini_procedure_module_token_count(procedure_tokens))
    call Std.IO.logf("lexer.procedure.summary = ${}", mini_procedure_module_lexer_summary(procedure_tokens))
    call Std.IO.logf("lexer.import.count = ${}", mini_import_module_token_count(import_tokens))
    call Std.IO.logf("lexer.import.summary = ${}", mini_import_module_lexer_summary(import_tokens))
    call Std.IO.logf("lexer.import_ref.count = ${}", mini_import_reference_module_token_count(import_reference_tokens))
    call Std.IO.logf("lexer.import_ref.summary = ${}", mini_import_reference_module_lexer_summary(import_reference_tokens))
    call Std.IO.logf("lexer.import_ref.missing.summary = ${}", mini_import_reference_module_lexer_summary(missing_import_reference_tokens))
    call Std.IO.logf("lexer.record_literal.summary = ${}", mini_record_literal_module_lexer_summary(record_literal_tokens))
    call Std.IO.logf("lexer.return.summary = ${}", mini_return_stmt_module_lexer_summary(return_tokens))
    call Std.IO.logf("lexer.call.count = ${}", mini_call_module_token_count(call_tokens))
    call Std.IO.logf("lexer.call.summary = ${}", mini_call_module_lexer_summary(call_tokens))
    call Std.IO.logf("lexer.nested_call.count = ${}", mini_nested_call_module_token_count(nested_call_tokens))
    call Std.IO.logf("lexer.nested_call.summary = ${}", mini_nested_call_module_lexer_summary(nested_call_tokens))


    let parsed_module: ModuleNode = parse_mini_module(mini_tokens)
    let parsed_result: ParseResult = parse_mini_module_result(mini_tokens)
    let mismatch_result: ParseResult = parse_mini_module_result(mismatch_tokens)
    let parsed_record_module: ModuleWithRecordNode = parse_mini_record_module(record_tokens)
    let parsed_record_result: ParseResult = parse_mini_record_module_result(record_tokens)
    let parsed_function_module: ModuleWithFunctionNode = parse_mini_function_module(function_tokens)
    let parsed_function_result: ParseResult = parse_mini_function_module_result(function_tokens)
    let parsed_procedure_module: ModuleWithProcedureNode = parse_mini_procedure_module(procedure_tokens)
    let parsed_procedure_result: ParseResult = parse_mini_procedure_module_result(procedure_tokens)
    let parsed_import_module: ModuleWithImportNode = parse_mini_import_module(import_tokens)
    let parsed_import_result: ParseResult = parse_mini_import_module_result(import_tokens)
    let parsed_import_reference_module: ModuleWithImportReferenceNode = parse_mini_import_reference_module(import_reference_tokens)
    let parsed_import_reference_result: ParseResult = parse_mini_import_reference_module_result(import_reference_tokens)
    let missing_import_reference_module: ModuleWithImportReferenceNode = parse_mini_import_reference_module(missing_import_reference_tokens)
    let missing_import_reference_result: ParseResult = parse_mini_import_reference_module_result(missing_import_reference_tokens)
    let missing_import_reference_diagnostic: Diagnostic = make_unknown_exposed_symbol_diagnostic(missing_import_reference_tokens.import_module_name.lexeme, missing_import_reference_tokens.return_symbol.lexeme)
    let resolved_import_reference: ResolveResult = resolve_mini_import_reference_module(parsed_import_reference_module)
    let resolved_missing_import_reference: ResolveResult = resolve_mini_import_reference_module(missing_import_reference_module)
    let canonicalized_import_reference: ModuleWithImportReferenceNode = canonicalize_import_references(parsed_import_reference_module)
    let parsed_record_literal_module: ModuleWithRecordLiteralNode = parse_mini_record_literal_module(record_literal_tokens)
    let parsed_return_module: ModuleWithReturnNode = parse_mini_return_stmt_module(return_tokens)
    let parsed_call_module: ModuleWithCallNode = parse_mini_call_module(call_tokens)
    let parsed_call_result: ParseResult = parse_mini_call_module_result(call_tokens)
    let normalized_record_literal_module: ModuleWithRecordLiteralNode = normalize_record_literal(parsed_record_literal_module)
    let wrapped_return_module: ModuleWithReturnNode = wrap_return_stmt(parsed_return_module)
    let lowered_call_module: ModuleWithReturnNode = lower_abort_propagation(parsed_call_module)
    let parsed_nested_call_module: ModuleWithNestedCallNode = parse_mini_nested_call_module(nested_call_tokens)
    let parsed_nested_call_result: ParseResult = parse_mini_nested_call_module_result(nested_call_tokens)
    let flattened_nested_call_module: ModuleWithLoweredCallsNode = flatten_nested_call(parsed_nested_call_module)


    call Std.IO.logf("parser.module = ${}", parsed_module_name(parsed_module))
    call Std.IO.logf("parser.summary = ${}", mini_module_parser_summary(parsed_module))
    call Std.IO.logf("parser.result = ${}", parse_result_summary(parsed_result))
    call Std.IO.logf("parser.mismatch = ${}", parse_result_summary(mismatch_result))
    call Std.IO.logf("parser.record.summary = ${}", mini_record_module_parser_summary(parsed_record_module))
    call Std.IO.logf("parser.record.result = ${}", parse_result_summary(parsed_record_result))
    call Std.IO.logf("parser.function.summary = ${}", mini_function_module_parser_summary(parsed_function_module))
    call Std.IO.logf("parser.function.result = ${}", parse_result_summary(parsed_function_result))
    call Std.IO.logf("parser.procedure.summary = ${}", mini_procedure_module_parser_summary(parsed_procedure_module))
    call Std.IO.logf("parser.procedure.result = ${}", parse_result_summary(parsed_procedure_result))
    call Std.IO.logf("parser.import.summary = ${}", mini_import_module_parser_summary(parsed_import_module))
    call Std.IO.logf("parser.import.result = ${}", parse_result_summary(parsed_import_result))
    call Std.IO.logf("parser.import_ref.summary = ${}", mini_import_reference_module_parser_summary(parsed_import_reference_module))
    call Std.IO.logf("parser.import_ref.result = ${}", parse_result_summary(parsed_import_reference_result))
    call Std.IO.logf("parser.import_ref.missing = ${}", parse_result_summary(missing_import_reference_result))
    call Std.IO.logf("diag.import_ref.unknown = ${}", diagnostic_text(missing_import_reference_diagnostic))
    call Std.IO.logf("resolver.import_ref.result = ${}", resolve_result_summary(resolved_import_reference))
    call Std.IO.logf("resolver.import_ref.unknown = ${}", resolve_result_summary(resolved_missing_import_reference))
    call Std.IO.logf("transform.import_ref.canonical = ${}", module_with_import_reference_text(canonicalized_import_reference))
    call Std.IO.logf("transform.record_literal.normalized = ${}:${} = ${}, ${} = ${}", normalized_record_literal_module.record_literal.type_name.name, normalized_record_literal_module.record_literal.field0_name.name, normalized_record_literal_module.record_literal.field0_value.text, normalized_record_literal_module.record_literal.field1_name.name, normalized_record_literal_module.record_literal.field1_value.text)
    call Std.IO.logf("transform.return_stmt.wrapped = ${}", wrapped_return_module.return_stmt.kind)
    call Std.IO.logf("parser.call.summary = ${}", mini_call_module_parser_summary(parsed_call_module))
    call Std.IO.logf("parser.call.result = ${}", parse_result_summary(parsed_call_result))
    call Std.IO.logf("transform.call.lowered = ${}:${}", lowered_call_module.return_stmt.kind, lowered_call_module.return_stmt.error_ref.name)
    call Std.IO.logf("parser.nested_call.summary = ${}", mini_nested_call_module_parser_summary(parsed_nested_call_module))
    call Std.IO.logf("parser.nested_call.result = ${}", parse_result_summary(parsed_nested_call_result))
    call Std.IO.logf("transform.nested_call.flattened = ${}", module_with_lowered_calls_text(flattened_nested_call_module))


    let ok_result: ParseResult = parse_ok(parsed_module)
    let mismatch_error_span: SourceSpan = make_source_span("mini_module.fh", 2, 5, 2, 10)
    let mismatch_error: ParseError = make_parse_error("FH-PARSE-0001", "end module name mismatch: expected Demo, got Other", mismatch_error_span)
    let error_result: ParseResult = parse_error_result(mismatch_error, parsed_module)

    call Std.IO.logf("parse.ok = ${}", parse_result_summary(ok_result))
    call Std.IO.logf("parse.error = ${}", parse_result_summary(error_result))
end main

end App.Main