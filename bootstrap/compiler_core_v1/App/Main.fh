    }

    call Std.IO.logf("VM Nested Call: Starting Scheduler...")
    let final_state: VmState = execute_scheduler(routines, 3, main_routine, heap)
    call Std.IO.logf("VM Nested Call: Final Return Value Kind = ${}, IntVal = ${}", final_state.frame.return_value.kind, final_state.frame.return_value.int_val)
    if final_state.frame.return_value.int_val != 7 then
        call Std.IO.logf("ERROR: VM Nested Call E2E test failed! Expected 7, got ${}", final_state.frame.return_value.int_val)
    else
        call Std.IO.logf("SUCCESS: VM Nested Call E2E test passed!")
    end if
end test_vm_nested_call

procedure test_vm_runtime_assertions()
is
    let dummy_span: SourceSpan = SourceSpan { source_name: "", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }
    let empty_type: IrType = IrType { kind: "", name: "", element_type_idx: -1, array_size: 0, has_range: false, min_value: 0, max_value: 0 }
    let subtype_with_range: IrType = IrType { kind: "PRIMITIVE", name: "MySubtype", element_type_idx: -1, array_size: 0, has_range: true, min_value: 5, max_value: 10 }
    let types_val: Array<IrType, 10> = [
        empty_type, subtype_with_range, empty_type, empty_type, empty_type,
        empty_type, empty_type, empty_type, empty_type, empty_type
