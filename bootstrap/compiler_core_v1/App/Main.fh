    if final_state.frame.return_value.int_val != 15 then
        call Std.IO.logf("ERROR: VM Concurrency E2E test failed! Expected 15, got ${}", final_state.frame.return_value.int_val)
    else
        call Std.IO.logf("SUCCESS: VM Concurrency E2E test passed!")
    end if
end test_vm_concurrency

