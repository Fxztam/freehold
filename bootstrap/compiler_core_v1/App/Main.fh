    let initial_frame: ActivationFrame = ActivationFrame {
        registers: [
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
        ],
        register_count: 0,
        current_block_label: "entry",
        ip: 0,
        return_value: VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
        has_returned: false
    }

    let state: VmState = VmState { heap: heap, frame: initial_frame }
    state := execute_instruction(inst_assign1, state, dummy_routine)
    state := execute_instruction(inst_sqrt, state, dummy_routine)
    state := execute_instruction(inst_assign2, state, dummy_routine)
    state := execute_instruction(inst_big_int, state, dummy_routine)
    state := execute_instruction(inst_big_add, state, dummy_routine)

    let r2_val: VmValue = get_register(state.frame, "r2")
    let r5_val: VmValue = get_register(state.frame, "r5")

    if r2_val.str_val != "3" and r2_val.str_val != "3.0" and r2_val.str_val != "3.000000" and r2_val.str_val != "3.000000000000000000000000000000" then
        call Std.IO.logf("ERROR: VM unit test Math.sqrt failed, got ${}", r2_val.str_val)
    end if
    if r5_val.str_val != "2000000000000000000000000000000" then
        call Std.IO.logf("ERROR: VM unit test Big.addInt failed, got ${}", r5_val.str_val)
    end if
end test_vm_builtins

procedure test_vm_e2e()
