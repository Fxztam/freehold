procedure test_vm_concurrency()
is
    let dummy_span: SourceSpan = SourceSpan { source_name: "", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }
    let empty_type: IrType = IrType { kind: "", name: "", element_type_idx: -1, array_size: 0, has_range: false, min_value: 0, max_value: 0 }
    let types_val: Array<IrType, 10> = [
        empty_type, empty_type, empty_type, empty_type, empty_type,
        empty_type, empty_type, empty_type, empty_type, empty_type
    ]

    -- Let's construct worker routine
    let w_inst0: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "val",
        src_reg_left: "_arg0",
        src_reg_right: "",
        op: "channel_receive",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let w_inst1: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "BINARY_OP",
        dest_reg: "res",
        src_reg_left: "val",
        src_reg_right: "",
        op: "+",
        literal_value: "10",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let w_inst2: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "send_res",
        src_reg_left: "_arg1",
        src_reg_right: "res",
        op: "channel_send",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let w_block: IrBasicBlock = IrBasicBlock {
        label: "entry",
        instructions: [
            w_inst0, w_inst1, w_inst2, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0,
            w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0, w_inst0
        ],
        instruction_count: 3,
        terminator_kind: "RETURN",
        target_block_label: "",
        true_block_label: "",
        false_block_label: "",
        return_reg: "res",
        abort_error: ""
    }

    let dummy_block: IrBasicBlock = w_block -- safe fallback

    let worker_routine: IrRoutine = IrRoutine {
        name: "worker",
        entry_block: "entry",
        blocks: [
            w_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block
        ],
        block_count: 1,
        types: types_val,
        type_count: 0
    }

    -- Let's construct main routine
    let m_inst0: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "ch1_cap",
        src_reg_left: "",
        src_reg_right: "",
        op: "",
        literal_value: "1",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst1: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "ch1",
        src_reg_left: "ch1_cap",
        src_reg_right: "",
        op: "channel",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst2: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "ch2",
        src_reg_left: "ch1_cap",
        src_reg_right: "",
        op: "channel",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst3: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "snd1",
        src_reg_left: "ch1",
        src_reg_right: "",
        op: "channel_sender",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst4: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "rcv1",
        src_reg_left: "ch1",
        src_reg_right: "",
        op: "channel_receiver",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst5: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "snd2",
        src_reg_left: "ch2",
        src_reg_right: "",
        op: "channel_sender",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }
    let m_inst6: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "rcv2",
        src_reg_left: "ch2",
        src_reg_right: "",
        op: "channel_receiver",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
