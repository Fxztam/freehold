    call Std.IO.logf("VM Deadlock Buffer Exhaustion Check: Starting Scheduler...")
    let final_state: VmState = execute_scheduler(routines, 2, main_routine, heap)
    call Std.IO.logf("VM Deadlock Buffer Exhaustion Check: Scheduler Finished.")
end test_vm_concurrency_buffer_exhaustion_deadlock

procedure test_vm_nested_call()
is
    let dummy_span: SourceSpan = SourceSpan { source_name: "", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }
    let empty_type: IrType = IrType { kind: "", name: "", element_type_idx: -1, array_size: 0, has_range: false, min_value: 0, max_value: 0 }
    let types_val: Array<IrType, 10> = [
        empty_type, empty_type, empty_type, empty_type, empty_type,
        empty_type, empty_type, empty_type, empty_type, empty_type
    ]

    -- add_one(x): returns x + 1
    let add1_inst: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "BINARY_OP",
        dest_reg: "res",
        src_reg_left: "_arg0",
        src_reg_right: "",
        op: "+",
        literal_value: "1",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let add1_block: IrBasicBlock = IrBasicBlock {
        label: "entry",
        instructions: [
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst,
            add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst, add1_inst
        ],
        instruction_count: 1,
        terminator_kind: "RETURN",
        target_block_label: "",
        true_block_label: "",
        false_block_label: "",
        return_reg: "res",
        abort_error: ""
    }

    let dummy_block: IrBasicBlock = add1_block

    let add_one_routine: IrRoutine = IrRoutine {
        name: "add_one",
        entry_block: "entry",
        blocks: [
            add1_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block
        ],
        block_count: 1,
        types: types_val,
        type_count: 0
    }

    -- add_two(x): y = add_one(x); z = add_one(y); return z
    let add2_inst0: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL",
        dest_reg: "y",
        src_reg_left: "_arg0",
        src_reg_right: "",
        op: "add_one",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let add2_inst1: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL",
        dest_reg: "z",
        src_reg_left: "y",
        src_reg_right: "",
        op: "add_one",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let add2_block: IrBasicBlock = IrBasicBlock {
        label: "entry",
        instructions: [
            add2_inst0, add2_inst1, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0,
            add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0, add2_inst0
        ],
        instruction_count: 2,
        terminator_kind: "RETURN",
        target_block_label: "",
        true_block_label: "",
        false_block_label: "",
        return_reg: "z",
        abort_error: ""
    }

    let add_two_routine: IrRoutine = IrRoutine {
        name: "add_two",
        entry_block: "entry",
        blocks: [
            add2_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block
        ],
        block_count: 1,
        types: types_val,
        type_count: 0
    }

    -- main(): five = 5; seven = add_two(five); return seven
    let m_inst0: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL_HOST",
        dest_reg: "five",
        src_reg_left: "",
        src_reg_right: "",
        op: "",
        literal_value: "5",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let m_inst1: IrInstruction = IrInstruction {
        span: dummy_span,
        kind: "CALL",
        dest_reg: "seven",
        src_reg_left: "five",
        src_reg_right: "",
        op: "add_two",
        literal_value: "",
        type_idx: 0,
        field_name: "",
        index_reg: ""
    }

    let main_block: IrBasicBlock = IrBasicBlock {
        label: "entry",
        instructions: [
            m_inst0, m_inst1, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0,
            m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0, m_inst0
        ],
        instruction_count: 2,
        terminator_kind: "RETURN",
        target_block_label: "",
        true_block_label: "",
        false_block_label: "",
        return_reg: "seven",
        abort_error: ""
    }

    let main_routine: IrRoutine = IrRoutine {
        name: "main",
        entry_block: "entry",
        blocks: [
            main_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block
        ],
        block_count: 1,
        types: types_val,
        type_count: 0
    }

    let routines: Array<IrRoutine, 10> = [
        main_routine, add_one_routine, add_two_routine, add_one_routine,
        add_one_routine, add_one_routine, add_one_routine, add_one_routine,
        add_one_routine, add_one_routine
    ]

    let empty_obj: VmHeapObject = VmHeapObject {
        kind: "FREE",
        field_names: [ "", "", "", "", "", "", "", "", "", "" ],
        field_values: [
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
        ],
        field_count: 0,
        elements: [
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
