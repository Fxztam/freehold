        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d22 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d23 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d24 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d25 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d26 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d27 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d28 := res.item
        temp := res.rest
        count := count + 1
    end if
    if String.length(temp) > 1 then
        let res: PopResult = pop_first(temp)
        d29 := res.item
        temp := res.rest
