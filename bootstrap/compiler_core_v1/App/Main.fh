            empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj
        ],
        object_count: 1
    }

    let dummy_block: IrBasicBlock = IrBasicBlock {
        label: "",
        instructions: [
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid,
            inst_assign_valid, inst_assign_valid, inst_assign_valid, inst_assign_valid
        ],
        instruction_count: 0,
        terminator_kind: "",
        target_block_label: "",
        true_block_label: "",
        false_block_label: "",
        return_reg: "",
        abort_error: ""
    }

    let dummy_routine: IrRoutine = IrRoutine {
        name: "",
        entry_block: "",
        blocks: [
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block,
            dummy_block, dummy_block, dummy_block, dummy_block
        ],
        block_count: 0,
        types: types_val,
        type_count: 2
    }

    -- 1. Test range check PASS
    let state_valid: VmState = VmState { heap: heap, frame: initial_frame }
    let res_valid: VmState = execute_instruction(inst_assign_valid, state_valid, dummy_routine)
    if res_valid.frame.has_returned or res_valid.frame.ip = 999999 then
        call Std.IO.logf("ERROR: VM Range Check positive test failed! Subtype range [5..10] should accept 7.")
    else
        call Std.IO.logf("SUCCESS: VM Range Check positive test passed (7 accepted).")
    end if

    -- 2. Test range check FAIL (invalid value 11)
    let res_invalid: VmState = execute_instruction(inst_assign_invalid, state_valid, dummy_routine)
    if res_invalid.frame.has_returned and res_invalid.frame.ip = 999999 then
        call Std.IO.logf("SUCCESS: VM Range Check negative test passed (11 correctly rejected).")
    else
        call Std.IO.logf("ERROR: VM Range Check negative test failed! Subtype range [5..10] did not reject 11.")
    end if

    -- 3. Test array bounds check FAIL (index 3 out of bounds for size 3)
    let res_bounds: VmState = execute_instruction(inst_load_invalid, state_valid, dummy_routine)
    if res_bounds.frame.has_returned and res_bounds.frame.ip = 999999 then
        call Std.IO.logf("SUCCESS: VM Array Bounds Check negative test passed (correctly rejected).")
    else
        call Std.IO.logf("ERROR: VM Array Bounds Check negative test failed!")
    end if

    -- 4. Test CHECK instruction FAIL
    let res_check: VmState = execute_instruction(inst_check_failed, state_valid, dummy_routine)
    if res_check.frame.has_returned and res_check.frame.ip = 999999 then
        call Std.IO.logf("SUCCESS: VM CHECK assertion negative test passed (correctly rejected).")
    else
        call Std.IO.logf("ERROR: VM CHECK assertion negative test failed!")
    end if
end test_vm_runtime_assertions

procedure test_vm_dynamic_ir_loader()
is
    let json_content: String = "{\"routines\":[{\"name\":\"add_one\",\"blocks\":[{\"label\":\"entry\",\"insts\":[{\"op\":\"+\",\"dest\":\"res\",\"arg0\":\"_arg0\",\"arg1\":\"1\"},{\"op\":\"RET\",\"dest\":\"\",\"arg0\":\"res\",\"arg1\":\"\"}]}]},{\"name\":\"main\",\"blocks\":[{\"label\":\"entry\",\"insts\":[{\"op\":\"ASSIGN\",\"dest\":\"five\",\"arg0\":\"5\",\"arg1\":\"\"},{\"op\":\"CALL\",\"dest\":\"six\",\"arg0\":\"add_one\",\"arg1\":\"five\"},{\"op\":\"RET\",\"dest\":\"\",\"arg0\":\"six\",\"arg1\":\"\"}]}]}]}"
    let proj: LoadedProject = load_project_ir(json_content)

    call Std.IO.logf("VM Dynamic IR Loader: Parsed ${} routines.", proj.routine_count)
    if proj.routine_count = 2 then
        let manifest_content: String = "{\"entry_module\":\"Demo\",\"entry_routine\":\"main\"}"
        let manifest: ProjectManifest = parse_manifest(manifest_content)
        call Std.IO.logf("VM Dynamic IR Loader: Manifest entry module = ${}, entry routine = ${}", manifest.entry_module, manifest.entry_routine)

        if manifest.entry_routine = "main" then
            let routines: Array<IrRoutine, 10> = proj.routines
            let main_routine: IrRoutine = routines[0]
            let found_main: Boolean = false
            let r_idx: Integer = 0
            while r_idx < proj.routine_count invariant r_idx >= 0 do
                let current_rot: IrRoutine = routines[r_idx]
                if current_rot.name = manifest.entry_routine then
                    main_routine := current_rot
                    found_main := true
                end if
                r_idx := r_idx + 1
            end while

            if found_main then

                let empty_obj: VmHeapObject = VmHeapObject {
                    kind: "",
                    field_names: [
                        "", "", "", "", "", "", "", "", "", ""
                    ],
                    field_values: [
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    ],
                    field_count: 0,
                    elements: [
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    ],
                    element_count: 0
                }

                let heap: VmHeap = VmHeap {
                    objects: [
                        empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj,
                        empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj,
                        empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj,
                        empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj, empty_obj
                    ],
                    object_count: 0
                }

                call Std.IO.logf("VM Dynamic IR Loader: Starting Scheduler E2E execution...")
                let final_state: VmState = execute_scheduler(routines, 2, main_routine, heap)
                call Std.IO.logf("VM Dynamic IR Loader: Scheduler execution finished. Result IntVal = ${}", final_state.frame.return_value.int_val)

                if final_state.frame.return_value.int_val != 6 then
                    call Std.IO.logf("ERROR: VM Dynamic IR Loader E2E Execution failed! Expected 6, got ${}", final_state.frame.return_value.int_val)
                else
                    call Std.IO.logf("SUCCESS: VM Dynamic IR Loader E2E Execution passed!")
                end if
            else
                call Std.IO.logf("ERROR: VM Dynamic IR Loader test failed! Main routine not found.")
            end if
        else
            call Std.IO.logf("ERROR: VM Dynamic IR Loader manifest test failed! Expected entry_routine 'main', got '${}'", manifest.entry_routine)
        end if
    else
        call Std.IO.logf("ERROR: VM Dynamic IR Loader test failed! Expected 2 routines, got ${}", proj.routine_count)
    end if
end test_vm_dynamic_ir_loader

procedure main()
is
    call test_vm_builtins()
    call test_vm_e2e()
    call test_vm_concurrency()
    call test_vm_concurrency_deadlock()
    call test_vm_concurrency_buffered()
    call test_vm_concurrency_buffer_exhaustion_deadlock()
    call test_vm_nested_call()
    call test_vm_runtime_assertions()
    call test_vm_dynamic_ir_loader()
    let diagnostic: Diagnostic = build_sample_diagnostic()

    let module_name: ModuleName = make_module_name("Compiler.Core.Names")
    let symbol_name: SymbolName = make_symbol_name("module_to_go_package")
    let package_path: GoPackagePath = module_to_go_package(module_name)
    let exported: String = exported_go_name(symbol_name)

    call Std.IO.logf("stage3.package = ${}", package_path.path)
    call Std.IO.logf("stage3.export = ${}", exported)
    call Std.IO.logf("stage3.diag.key = ${}", diagnostic_key(diagnostic))
    call Std.IO.logf("stage3.diag.text = ${}", diagnostic_text(diagnostic))

    let names_fixture: CompilerFixtureResult = evaluate_fixture("Compiler.Core.Names", "module_to_go_package", "FH-BLD-9001", "package path is stable")
    let diagnostics_fixture: CompilerFixtureResult = evaluate_fixture("Compiler.Core.Diagnostics", "diagnostic_text", "FH-BLD-9002", "diagnostic text is stable")

    call Std.IO.logf("fixture.names.package = ${}", names_fixture.package_path)
    call Std.IO.logf("fixture.names.export = ${}", names_fixture.exported_name)
    call Std.IO.logf("fixture.names.diag = ${}", names_fixture.diagnostic_text)
    call Std.IO.logf("fixture.diagnostics.package = ${}", diagnostics_fixture.package_path)
    call Std.IO.logf("fixture.diagnostics.export = ${}", diagnostics_fixture.exported_name)
    call Std.IO.logf("fixture.diagnostics.diag = ${}", diagnostics_fixture.diagnostic_text)

    let module_kind: TokenKind = make_token_kind("KeywordModule")
    let module_span: SourceSpan = make_source_span("bootstrap/compiler_core_v1/fixtures/mini_module.fh", 1, 1, 1, 7)
    let module_token: Token = make_token(module_kind, module_span, "module")

    call Std.IO.logf("token.kind = ${}", module_token.kind.name)
    call Std.IO.logf("token.key = ${}", token_key(module_token))
    call Std.IO.logf("token.text = ${}", token_text(module_token))

    let module_identifier_span: SourceSpan = make_source_span("bootstrap/compiler_core_v1/fixtures/mini_module.fh", 1, 8, 1, 12)
    let module_identifier: IdentifierNode = make_identifier_node(module_identifier_span, "Demo")
    let module_node: ModuleNode = make_module_node(module_span, module_identifier)
    let literal_span: SourceSpan = make_source_span("bootstrap/compiler_core_v1/fixtures/mini_module.fh", 2, 1, 2, 8)
    let literal_node: LiteralNode = make_literal_node(literal_span, "String", "hello")

    call Std.IO.logf("ast.identifier = ${}", identifier_key(module_identifier))
    call Std.IO.logf("ast.literal = ${}", literal_text(literal_node))
    call Std.IO.logf("ast.module.key = ${}", module_key(module_node))
    call Std.IO.logf("ast.module.text = ${}", module_text(module_node))

    let mini_tokens: MiniModuleTokens = lex_mini_module("bootstrap/compiler_core_v1/fixtures/mini_module.fh", "Demo")
    let mismatch_tokens: MiniModuleTokens = lex_mini_module_pair("bootstrap/compiler_core_v1/fixtures/mini_module_mismatch.fh", "Demo", "Other")
    let record_tokens: MiniRecordModuleTokens = lex_mini_record_module("bootstrap/compiler_core_v1/fixtures/mini_record_module.fh", "Demo", "X")
    let function_tokens: MiniFunctionModuleTokens = lex_mini_function_module("bootstrap/compiler_core_v1/fixtures/mini_function_module.fh", "Demo", "answer")
    let procedure_tokens: MiniProcedureModuleTokens = lex_mini_procedure_module("bootstrap/compiler_core_v1/fixtures/mini_procedure_module.fh", "Demo", "run")
    let import_tokens: MiniImportModuleTokens = lex_mini_import_module("bootstrap/compiler_core_v1/fixtures/mini_import_module.fh", "Demo", "Demo.Support", "answer")
    let import_reference_tokens: MiniImportReferenceModuleTokens = lex_mini_import_reference_module("bootstrap/compiler_core_v1/fixtures/mini_import_reference_module.fh", "Demo", "Demo.Support", "answer", "use")
    let missing_import_reference_tokens: MiniImportReferenceModuleTokens = lex_mini_import_reference_module_pair("bootstrap/compiler_core_v1/fixtures/mini_import_reference_missing.fh", "Demo", "Demo.Support", "answer", "use", "missing")
    let record_literal_tokens: MiniRecordLiteralModuleTokens = lex_mini_record_literal_module("bootstrap/compiler_core_v1/fixtures/mini_record_literal.fh", "Demo", "Point", "y", "2", "x", "1")
    let return_tokens: MiniReturnStmtModuleTokens = lex_mini_return_stmt_module("bootstrap/compiler_core_v1/fixtures/mini_return.fh", "Demo", "ok", "100", "some_err")
    let call_tokens: MiniCallModuleTokens = lex_mini_call_module("bootstrap/compiler_core_v1/fixtures/mini_call.fh", "Demo", "foo", "arg", "SomeError")
    let nested_call_tokens: MiniNestedCallModuleTokens = lex_mini_nested_call_module("bootstrap/compiler_core_v1/fixtures/mini_nested_call.fh", "Demo", "y", "foo", "bar", "z")
    let subtype_range_tokens: MiniSubtypeRangeModuleTokens = lex_mini_subtype_range_module("bootstrap/compiler_core_v1/fixtures/mini_subtype_range.fh", "Demo", "Percent")


    call Std.IO.logf("lexer.count = ${}", mini_module_token_count(mini_tokens))
    call Std.IO.logf("lexer.first = ${}", token_text(mini_tokens.module_keyword))
    call Std.IO.logf("lexer.name = ${}", token_text(mini_tokens.module_name))
    call Std.IO.logf("lexer.end = ${}", token_text(mini_tokens.end_keyword))
    call Std.IO.logf("lexer.summary = ${}", mini_module_lexer_summary(mini_tokens))
    call Std.IO.logf("lexer.record.count = ${}", mini_record_module_token_count(record_tokens))
    call Std.IO.logf("lexer.record.summary = ${}", mini_record_module_lexer_summary(record_tokens))
    call Std.IO.logf("lexer.function.count = ${}", mini_function_module_token_count(function_tokens))
    call Std.IO.logf("lexer.function.summary = ${}", mini_function_module_lexer_summary(function_tokens))
    call Std.IO.logf("lexer.procedure.count = ${}", mini_procedure_module_token_count(procedure_tokens))
    call Std.IO.logf("lexer.procedure.summary = ${}", mini_procedure_module_lexer_summary(procedure_tokens))
    call Std.IO.logf("lexer.import.count = ${}", mini_import_module_token_count(import_tokens))
    call Std.IO.logf("lexer.import.summary = ${}", mini_import_module_lexer_summary(import_tokens))
    call Std.IO.logf("lexer.import_ref.count = ${}", mini_import_reference_module_token_count(import_reference_tokens))
    call Std.IO.logf("lexer.import_ref.summary = ${}", mini_import_reference_module_lexer_summary(import_reference_tokens))
    call Std.IO.logf("lexer.import_ref.missing.summary = ${}", mini_import_reference_module_lexer_summary(missing_import_reference_tokens))
    call Std.IO.logf("lexer.record_literal.summary = ${}", mini_record_literal_module_lexer_summary(record_literal_tokens))
    call Std.IO.logf("lexer.return.summary = ${}", mini_return_stmt_module_lexer_summary(return_tokens))
    call Std.IO.logf("lexer.call.count = ${}", mini_call_module_token_count(call_tokens))
    call Std.IO.logf("lexer.call.summary = ${}", mini_call_module_lexer_summary(call_tokens))
    call Std.IO.logf("lexer.nested_call.count = ${}", mini_nested_call_module_token_count(nested_call_tokens))
    call Std.IO.logf("lexer.nested_call.summary = ${}", mini_nested_call_module_lexer_summary(nested_call_tokens))
    call Std.IO.logf("lexer.subtype_range.count = ${}", mini_subtype_range_module_token_count(subtype_range_tokens))
    call Std.IO.logf("lexer.subtype_range.summary = ${}", mini_subtype_range_module_lexer_summary(subtype_range_tokens))


    let parsed_module: ModuleNode = parse_mini_module(mini_tokens)
    let parsed_result: ParseResult = parse_mini_module_result(mini_tokens)
    let mismatch_result: ParseResult = parse_mini_module_result(mismatch_tokens)
    let parsed_record_module: ModuleWithRecordNode = parse_mini_record_module(record_tokens)
    let parsed_record_result: ParseResult = parse_mini_record_module_result(record_tokens)
    let parsed_subtype_range_module: ModuleWithTypeDeclNode = parse_mini_subtype_range_module(subtype_range_tokens)
    let parsed_subtype_range_result: ParseResult = parse_mini_subtype_range_module_result(subtype_range_tokens)
    let parsed_function_module: ModuleWithFunctionNode = parse_mini_function_module(function_tokens)
    let parsed_function_result: ParseResult = parse_mini_function_module_result(function_tokens)
    let parsed_procedure_module: ModuleWithProcedureNode = parse_mini_procedure_module(procedure_tokens)
    let parsed_procedure_result: ParseResult = parse_mini_procedure_module_result(procedure_tokens)
    let parsed_import_module: ModuleWithImportNode = parse_mini_import_module(import_tokens)
    let parsed_import_result: ParseResult = parse_mini_import_module_result(import_tokens)
    let parsed_import_reference_module: ModuleWithImportReferenceNode = parse_mini_import_reference_module(import_reference_tokens)
    let parsed_import_reference_result: ParseResult = parse_mini_import_reference_module_result(import_reference_tokens)
    let missing_import_reference_module: ModuleWithImportReferenceNode = parse_mini_import_reference_module(missing_import_reference_tokens)
    let missing_import_reference_result: ParseResult = parse_mini_import_reference_module_result(missing_import_reference_tokens)
    let missing_import_reference_diagnostic: Diagnostic = make_unknown_exposed_symbol_diagnostic(missing_import_reference_tokens.import_module_name.lexeme, missing_import_reference_tokens.return_symbol.lexeme)
    let resolved_import_reference: ResolveResult = resolve_mini_import_reference_module(parsed_import_reference_module)
    let resolved_missing_import_reference: ResolveResult = resolve_mini_import_reference_module(missing_import_reference_module)
    let canonicalized_import_reference: ModuleWithImportReferenceNode = canonicalize_import_references(parsed_import_reference_module)
    let parsed_record_literal_module: ModuleWithRecordLiteralNode = parse_mini_record_literal_module(record_literal_tokens)
    let parsed_return_module: ModuleWithReturnNode = parse_mini_return_stmt_module(return_tokens)
    let parsed_call_module: ModuleWithCallNode = parse_mini_call_module(call_tokens)
    let parsed_call_result: ParseResult = parse_mini_call_module_result(call_tokens)
    let normalized_record_literal_module: ModuleWithRecordLiteralNode = normalize_record_literal(parsed_record_literal_module)
    let wrapped_return_module: ModuleWithReturnNode = wrap_return_stmt(parsed_return_module)
    let lowered_call_module: ModuleWithReturnNode = lower_abort_propagation(parsed_call_module)
    let parsed_nested_call_module: ModuleWithNestedCallNode = parse_mini_nested_call_module(nested_call_tokens)
    let parsed_nested_call_result: ParseResult = parse_mini_nested_call_module_result(nested_call_tokens)
    let flattened_nested_call_module: ModuleWithLoweredCallsNode = flatten_nested_call(parsed_nested_call_module)


    call Std.IO.logf("parser.module = ${}", parsed_module_name(parsed_module))
    call Std.IO.logf("parser.summary = ${}", mini_module_parser_summary(parsed_module))
    call Std.IO.logf("parser.result = ${}", parse_result_summary(parsed_result))
    call Std.IO.logf("parser.mismatch = ${}", parse_result_summary(mismatch_result))
    call Std.IO.logf("parser.record.summary = ${}", mini_record_module_parser_summary(parsed_record_module))
