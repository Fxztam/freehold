    call Std.IO.logf("parser.import.summary = ${}", mini_import_module_parser_summary(parsed_import_module))
    call Std.IO.logf("parser.import.result = ${}", parse_result_summary(parsed_import_result))
    call Std.IO.logf("parser.import_ref.summary = ${}", mini_import_reference_module_parser_summary(parsed_import_reference_module))
    call Std.IO.logf("parser.import_ref.result = ${}", parse_result_summary(parsed_import_reference_result))
    call Std.IO.logf("parser.import_ref.missing = ${}", parse_result_summary(missing_import_reference_result))
    call Std.IO.logf("diag.import_ref.unknown = ${}", diagnostic_text(missing_import_reference_diagnostic))
    call Std.IO.logf("resolver.import_ref.result = ${}", resolve_result_summary(resolved_import_reference))
    call Std.IO.logf("resolver.import_ref.unknown = ${}", resolve_result_summary(resolved_missing_import_reference))
    call Std.IO.logf("transform.import_ref.canonical = ${}", module_with_import_reference_text(canonicalized_import_reference))
    call Std.IO.logf("transform.record_literal.normalized = ${}:${} = ${}, ${} = ${}", normalized_record_literal_module.record_literal.type_name.name, normalized_record_literal_module.record_literal.field0_name.name, normalized_record_literal_module.record_literal.field0_value.text, normalized_record_literal_module.record_literal.field1_name.name, normalized_record_literal_module.record_literal.field1_value.text)
    call Std.IO.logf("transform.return_stmt.wrapped = ${}", wrapped_return_module.return_stmt.kind)
    call Std.IO.logf("parser.call.summary = ${}", mini_call_module_parser_summary(parsed_call_module))
    call Std.IO.logf("parser.call.result = ${}", parse_result_summary(parsed_call_result))
    call Std.IO.logf("transform.call.lowered = ${}:${}", lowered_call_module.return_stmt.kind, lowered_call_module.return_stmt.error_ref.name)
    call Std.IO.logf("parser.nested_call.summary = ${}", mini_nested_call_module_parser_summary(parsed_nested_call_module))
    call Std.IO.logf("parser.nested_call.result = ${}", parse_result_summary(parsed_nested_call_result))
    call Std.IO.logf("transform.nested_call.flattened = ${}", module_with_lowered_calls_text(flattened_nested_call_module))
    let json_ir: String = emit_json_ir(flattened_nested_call_module)
    let binary_ir: String = emit_binary_ir(flattened_nested_call_module)
    call Std.IO.logf("transform.nested_call.json_ir = ${}", json_ir)
    call Std.IO.logf("transform.nested_call.binary_ir = ${}", binary_ir)


    let ok_result: ParseResult = parse_ok(parsed_module)
    let mismatch_error_span: SourceSpan = make_source_span("mini_module.fh", 2, 5, 2, 10)
    let mismatch_error: ParseError = make_parse_error("FH-PARSE-0001", "end module name mismatch: expected Demo, got Other", mismatch_error_span)
    let error_result: ParseResult = parse_error_result(mismatch_error, parsed_module)

    call Std.IO.logf("parse.ok = ${}", parse_result_summary(ok_result))
    call Std.IO.logf("parse.error = ${}", parse_result_summary(error_result))

    let demo_imports: Array<String, 10> = [ "fmt", "", "", "", "", "", "", "", "", "" ]
    let header: String = emit_module_header("Demo", demo_imports, 1)
    call Std.IO.logf("codegen.header = ${}", header)
    let build_status: Integer = System.run_command("go version")
    call Std.IO.logf("toolchain.run = ${}", build_status)

    -- Phase 5: Verification Engine - Proof Obligation (PO) & SMT check
    let dummy_span: SourceSpan = make_source_span("main.fh", 1, 1, 1, 1)
    let node_x: ExprNode = make_expr_node(dummy_span, "VAR", "", "x", "", -1, -1, "", -1, -1, 0, -1)
    let node_0: ExprNode = make_expr_node(dummy_span, "LITERAL", "Integer", "0", "", -1, -1, "", -1, -1, 0, -1)
    let node_pre: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", ">", 0, 1, "", -1, -1, 0, -1)
    let node_1: ExprNode = make_expr_node(dummy_span, "LITERAL", "Integer", "1", "", -1, -1, "", -1, -1, 0, -1)
    let node_add: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", "+", 0, 3, "", -1, -1, 0, -1)
    let node_post: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", ">", 4, 3, "", -1, -1, 0, -1)

    let exprs: Array<ExprNode, 64> = [
        node_x, node_0, node_pre, node_1, node_add, node_post,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0
    ]

    let ver_res: Result<Boolean, VerificationFailed> = verify_contract(exprs, 2, 5)
    if ver_res.ok then
        call Std.IO.logf("verifier.result = ${}", ver_res.value)
    else
        call Std.IO.logf("verifier.error = VerificationFailed")
    end if

    -- Subtype Range Verification check
    let node_p: ExprNode = make_expr_node(dummy_span, "VAR", "", "p", "", -1, -1, "", -1, -1, 0, -1)
    let node_min: ExprNode = make_expr_node(dummy_span, "LITERAL", "Integer", "0", "", -1, -1, "", -1, -1, 0, -1)
    let node_max: ExprNode = make_expr_node(dummy_span, "LITERAL", "Integer", "100", "", -1, -1, "", -1, -1, 0, -1)
    let node_ge: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", ">=", 0, 1, "", -1, -1, 0, -1)
    let node_le: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", "<=", 0, 2, "", -1, -1, 0, -1)
    let node_pre_range: ExprNode = make_expr_node(dummy_span, "BINARY_OP", "", "", "and", 3, 4, "", -1, -1, 0, -1)

    let range_exprs: Array<ExprNode, 64> = [
        node_p, node_min, node_max, node_ge, node_le, node_pre_range, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0, node_0,
        node_0, node_0, node_0, node_0
    ]

    let range_ver_res: Result<Boolean, VerificationFailed> = verify_subtype_range(range_exprs, 5, 0, "0", "100")
    if range_ver_res.ok then
        call Std.IO.logf("verifier.subtype_range.valid = ${}", range_ver_res.value)
    else
        call Std.IO.logf("verifier.subtype_range.valid = VerificationFailed")
    end if

    let range_ver_fail_res: Result<Boolean, VerificationFailed> = verify_subtype_range(range_exprs, 5, 0, "50", "100")
    if range_ver_fail_res.ok then
        call Std.IO.logf("verifier.subtype_range.invalid = ${}", range_ver_fail_res.value)
    else
        call Std.IO.logf("verifier.subtype_range.invalid = VerificationFailed")
    end if

    let mock_span: SourceSpan = make_source_span("bootstrap/compiler_core_v1/fixtures/mini_module.fh", 1, 1, 1, 1)
    let mock_stmt: StmtNode = StmtNode {
        span: mock_span,
        kind: "RETURN",
        var_name: "",
        var_type: "",
        expr_idx: 0,
        cond_expr_idx: 0,
        then_block_start_idx: 0,
        then_block_len: 0,
        else_block_start_idx: 0,
