module Compiler.Core.Codegen

import Compiler.Core.Ast exposing ModuleNode, RecordTypeNode, FunctionNode, ProcedureNode, ImportNode, ImportReferenceNode, FunctionImportReferenceNode, RecordLiteralNode, ReturnStmtNode, CallStmtNode, NestedCallStmtNode, LoweredCallNode, ExprNode, StmtNode

function to_lower(s: String) returns String
is
    let res: String = ""
    let len: Integer = String.length(s)
    let i: Integer = 0
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lower: String = "abcdefghijklmnopqrstuvwxyz"
    while i < len invariant i >= 0 do
        let c: String = String.substr(s, i, 1)
        let idx: Integer = String.instr(upper, c)
        if idx >= 0 then
            let lc: String = String.substr(lower, idx, 1)
            res := String.template("${prev}${c}", prev: res, c: lc)
        else
            res := String.template("${prev}${c}", prev: res, c: c)
        end if
        i := i + 1
    end while
    return res
end to_lower

function go_package_name(module_name: String) returns String
is
    let name: String = to_lower(module_name)
    return String.replace(name, ".", "_")
end go_package_name

function go_type(fh_type: String) returns String
is
    if fh_type = "Integer" then
        return "int64"
    end if
    if fh_type = "String" then
        return "string"
    end if
    if fh_type = "Boolean" then
        return "bool"
    end if
    if fh_type = "Double" then
        return "float64"
    end if
    if fh_type = "SourceSpan" then
        return "compiler_core_token.SourceSpan"
    end if
    if fh_type = "IdentifierNode" then
        return "IdentifierNode"
    end if
    if fh_type = "LiteralNode" then
        return "LiteralNode"
    end if
    if fh_type = "ModuleNode" then
        return "ModuleNode"
    end if
    if fh_type = "RecordTypeNode" then
        return "RecordTypeNode"
    end if
    if fh_type = "ImportNode" then
        return "ImportNode"
    end if
    if fh_type = "ImportReferenceNode" then
        return "ImportReferenceNode"
    end if
    if fh_type = "FunctionImportReferenceNode" then
        return "FunctionImportReferenceNode"
    end if
    if fh_type = "RecordLiteralNode" then
        return "RecordLiteralNode"
    end if
    if fh_type = "ReturnStmtNode" then
        return "ReturnStmtNode"
    end if
    if fh_type = "CallStmtNode" then
        return "CallStmtNode"
    end if
    if fh_type = "NestedCallStmtNode" then
        return "NestedCallStmtNode"
    end if
    if fh_type = "LoweredCallNode" then
        return "LoweredCallNode"
    end if
    return fh_type
end go_type

function emit_module_header(module_name: String, imports: Array<String, 10>, import_count: Integer) returns String
is
    let pkg: String = go_package_name(module_name)
    let code: String = String.template("// Code generated by Freehold Go codegen V1; DO NOT EDIT.\npackage ${pkg}\n\nimport (\n", pkg: pkg)
    
    let i: Integer = 0
    while i < import_count invariant i >= 0 do
        if i >= 0 and i < 10 then
            let imp: String = imports[i]
            code := String.template("${prev}\t\\\"${imp}\\\"\n", prev: code, imp: imp)
        end if
        i := i + 1
    end while
    code := String.template("${prev})\n\n", prev: code)
    return code
end emit_module_header

function emit_record_decl(
    name: String,
    fields: Array<String, 10>,
    field_types: Array<String, 10>,
    field_count: Integer
) returns String
is
    let ob: String = "{"
    let cb: String = "}"
    let code: String = String.template("type ${name} struct ${ob}\n", name: name, ob: ob)
    let i: Integer = 0
    while i < field_count invariant i >= 0 do
        if i >= 0 and i < 10 then
            let f_name: String = fields[i]
            let f_type: String = go_type(field_types[i])
            let f_tag: String = to_lower(f_name)
            code := String.template("${prev}\t${name} ${type} `json:\\\"${tag}\\\"`\n", prev: code, name: f_name, type: f_type, tag: f_tag)
        end if
        i := i + 1
    end while
    code := String.template("${prev}${cb}\n\n", prev: code, cb: cb)
    return code
end emit_record_decl

function emit_expr(kind: String, text: String, op: String, left: String, right: String) returns String
is
    if kind = "LITERAL" then
        return text
    end if
    if kind = "IDENTIFIER" then
        return text
    end if
    if kind = "BINARY" then
        return String.template("(${left} ${op} ${right})", left: left, op: op, right: right)
    end if
    return text
end emit_expr

function emit_stmt(kind: String, var_name: String, var_type: String, expr: String) returns String
is
    if kind = "LET" then
        let gtype: String = go_type(var_type)
        return String.template("\tvar ${name} ${type} = ${expr}\n", name: var_name, type: gtype, expr: expr)
    end if
    if kind = "ASSIGN" then
        return String.template("\t${name} = ${expr}\n", name: var_name, expr: expr)
    end if
    if kind = "RETURN" then
        return String.template("\treturn ${expr}\n", expr: expr)
    end if
    return ""
end emit_stmt

end Compiler.Core.Codegen
