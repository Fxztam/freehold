module Compiler.Core.Codegen

import Compiler.Core.Ast exposing ModuleNode, RecordTypeNode, FunctionNode, ProcedureNode, ImportNode, ImportReferenceNode, FunctionImportReferenceNode, RecordLiteralNode, ReturnStmtNode, CallStmtNode, NestedCallStmtNode, LoweredCallNode, ExprNode, StmtNode

function to_lower(s: String) returns String
is
    let res: String = ""
    let len: Integer = String.length(s)
    let i: Integer = 0
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lower: String = "abcdefghijklmnopqrstuvwxyz"
    while i < len invariant i >= 0 do
        let c: String = String.substr(s, i, 1)
        let idx: Integer = String.instr(upper, c)
        if idx >= 0 then
            let lc: String = String.substr(lower, idx, 1)
            res := String.template("${prev}${c}", prev: res, c: lc)
        else
            res := String.template("${prev}${c}", prev: res, c: c)
        end if
        i := i + 1
    end while
    return res
end to_lower

function go_package_name(module_name: String) returns String
is
    let name: String = to_lower(module_name)
    return String.replace(name, ".", "_")
end go_package_name

function go_type(fh_type: String) returns String
is
    if fh_type = "Integer" then
        return "int64"
    end if
    if fh_type = "String" then
        return "string"
    end if
    if fh_type = "Boolean" then
        return "bool"
    end if
    if fh_type = "Double" then
        return "float64"
    end if
    if fh_type = "SourceSpan" then
        return "compiler_core_token.SourceSpan"
    end if
    if fh_type = "IdentifierNode" then
        return "IdentifierNode"
    end if
    if fh_type = "LiteralNode" then
        return "LiteralNode"
    end if
    if fh_type = "ModuleNode" then
        return "ModuleNode"
    end if
    if fh_type = "RecordTypeNode" then
        return "RecordTypeNode"
    end if
    if fh_type = "ImportNode" then
        return "ImportNode"
    end if
    if fh_type = "ImportReferenceNode" then
        return "ImportReferenceNode"
    end if
    if fh_type = "FunctionImportReferenceNode" then
        return "FunctionImportReferenceNode"
    end if
    if fh_type = "RecordLiteralNode" then
        return "RecordLiteralNode"
    end if
    if fh_type = "ReturnStmtNode" then
        return "ReturnStmtNode"
    end if
    if fh_type = "CallStmtNode" then
        return "CallStmtNode"
    end if
    if fh_type = "NestedCallStmtNode" then
        return "NestedCallStmtNode"
    end if
    if fh_type = "LoweredCallNode" then
        return "LoweredCallNode"
    end if
    return fh_type
end go_type

function emit_module_header(module_name: String, imports: Array<String, 10>, import_count: Integer) returns String
is
    let pkg: String = go_package_name(module_name)
    let code: String = String.template("// Code generated by Freehold Go codegen V1; DO NOT EDIT.\npackage ${pkg}\n\nimport (\n", pkg: pkg)
    
    let i: Integer = 0
    while i < import_count invariant i >= 0 do
        if i >= 0 and i < 10 then
            let imp: String = imports[i]
            code := String.template("${prev}\t\\\"${imp}\\\"\n", prev: code, imp: imp)
        end if
        i := i + 1
    end while
    code := String.template("${prev})\n\n", prev: code)
    return code
end emit_module_header

function emit_record_decl(
    name: String,
    fields: Array<String, 10>,
    field_types: Array<String, 10>,
    field_count: Integer
) returns String
is
    let ob: String = "{"
    let cb: String = "}"
    let code: String = String.template("type ${name} struct ${ob}\n", name: name, ob: ob)
    let i: Integer = 0
    while i < field_count invariant i >= 0 do
        if i >= 0 and i < 10 then
            let f_name: String = fields[i]
            let f_type: String = go_type(field_types[i])
            let f_tag: String = to_lower(f_name)
            code := String.template("${prev}\t${name} ${type} `json:\\\"${tag}\\\"`\n", prev: code, name: f_name, type: f_type, tag: f_tag)
        end if
        i := i + 1
    end while
    code := String.template("${prev}${cb}\n\n", prev: code, cb: cb)
    return code
end emit_record_decl

function emit_expr(kind: String, text: String, op: String, left: String, right: String) returns String
is
    if kind = "LITERAL" then
        return text
    end if
    if kind = "IDENTIFIER" then
        return text
    end if
    if kind = "BINARY" then
        return String.template("(${left} ${op} ${right})", left: left, op: op, right: right)
    end if
    return text
end emit_expr

function emit_stmt(kind: String, var_name: String, var_type: String, expr: String) returns String
is
    if kind = "LET" then
        let gtype: String = go_type(var_type)
        return String.template("\tvar ${name} ${type} = ${expr}\n", name: var_name, type: gtype, expr: expr)
    end if
    if kind = "ASSIGN" then
        return String.template("\t${name} = ${expr}\n", name: var_name, expr: expr)
    end if
    if kind = "RETURN" then
        return String.template("\treturn ${expr}\n", expr: expr)
    end if
    return ""
end emit_stmt

function emit_websocket_helpers() returns String
is
    let code: String = ""
    code := String.concat(code, "var (\n")
    code := String.concat(code, "\tlisteners = make(map[string]net.Listener)\n")
    code := String.concat(code, "\tlistenersMu sync.Mutex\n")
    code := String.concat(code, "\tserverCounter int64\n")
    code := String.concat(code, ")\n\n")
    code := String.concat(code, "func registerListener(l net.Listener) string {\n")
    code := String.concat(code, "\tlistenersMu.Lock()\n")
    code := String.concat(code, "\tdefer listenersMu.Unlock()\n")
    code := String.concat(code, "\tserverCounter++\n")
    code := String.concat(code, "\tid := fmt.Sprintf(\"server-%d\", serverCounter)\n")
    code := String.concat(code, "\tlisteners[id] = l\n")
    code := String.concat(code, "\treturn id\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func getListener(id string) net.Listener {\n")
    code := String.concat(code, "\tlistenersMu.Lock()\n")
    code := String.concat(code, "\tdefer listenersMu.Unlock()\n")
    code := String.concat(code, "\treturn listeners[id]\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func removeListener(id string) {\n")
    code := String.concat(code, "\tlistenersMu.Lock()\n")
    code := String.concat(code, "\tdefer listenersMu.Unlock()\n")
    code := String.concat(code, "\tif l, ok := listeners[id]; ok {\n")
    code := String.concat(code, "\t\t_ = l.Close()\n")
    code := String.concat(code, "\t\tdelete(listeners, id)\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func readFrame(r io.Reader) (byte, []byte, error) {\n")
    code := String.concat(code, "\theader := make([]byte, 2)\n")
    code := String.concat(code, "\tif _, err := io.ReadFull(r, header); err != nil {\n")
    code := String.concat(code, "\t\treturn 0, nil, err\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\topcode := header[0] & 0x0F\n")
    code := String.concat(code, "\tmasked := (header[1] & 0x80) != 0\n")
    code := String.concat(code, "\tpayloadLen := int64(header[1] & 0x7F)\n")
    code := String.concat(code, "\tif payloadLen == 126 {\n")
    code := String.concat(code, "\t\tlenBytes := make([]byte, 2)\n")
    code := String.concat(code, "\t\tif _, err := io.ReadFull(r, lenBytes); err != nil {\n")
    code := String.concat(code, "\t\t\treturn 0, nil, err\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tpayloadLen = int64(lenBytes[0])<<8 | int64(lenBytes[1])\n")
    code := String.concat(code, "\t} else if payloadLen == 127 {\n")
    code := String.concat(code, "\t\tlenBytes := make([]byte, 8)\n")
    code := String.concat(code, "\t\tif _, err := io.ReadFull(r, lenBytes); err != nil {\n")
    code := String.concat(code, "\t\t\treturn 0, nil, err\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tpayloadLen = 0\n")
    code := String.concat(code, "\t\tfor i := 0; i < 8; i++ {\n")
    code := String.concat(code, "\t\t\tpayloadLen = (payloadLen << 8) | int64(lenBytes[i])\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tmaskKey := make([]byte, 4)\n")
    code := String.concat(code, "\tif masked {\n")
    code := String.concat(code, "\t\tif _, err := io.ReadFull(r, maskKey); err != nil {\n")
    code := String.concat(code, "\t\t\treturn 0, nil, err\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tpayload := make([]byte, payloadLen)\n")
    code := String.concat(code, "\tif _, err := io.ReadFull(r, payload); err != nil {\n")
    code := String.concat(code, "\t\treturn 0, nil, err\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tif masked {\n")
    code := String.concat(code, "\t\tfor i := int64(0); i < payloadLen; i++ {\n")
    code := String.concat(code, "\t\t\tpayload[i] ^= maskKey[i%4]\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\treturn opcode, payload, nil\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func writeFrame(w io.Writer, opcode byte, payload []byte, mask bool) error {\n")
    code := String.concat(code, "\tvar header []byte\n")
    code := String.concat(code, "\tfirstByte := byte(0x80) | opcode\n")
    code := String.concat(code, "\theader = append(header, firstByte)\n")
    code := String.concat(code, "\tlength := len(payload)\n")
    code := String.concat(code, "\tvar lenByte byte\n")
    code := String.concat(code, "\tif mask {\n")
    code := String.concat(code, "\t\tlenByte = 0x80\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tif length < 126 {\n")
    code := String.concat(code, "\t\tlenByte |= byte(length)\n")
    code := String.concat(code, "\theader = append(header, lenByte)\n")
    code := String.concat(code, "\t} else if length <= 65535 {\n")
    code := String.concat(code, "\t\tlenByte |= 126\n")
    code := String.concat(code, "\t\theader = append(header, lenByte, byte(length>>8), byte(length))\n")
    code := String.concat(code, "\t} else {\n")
    code := String.concat(code, "\t\tlenByte |= 127\n")
    code := String.concat(code, "\t\theader = append(header, lenByte)\n")
    code := String.concat(code, "\t\tfor i := 7; i >= 0; i-- {\n")
    code := String.concat(code, "\t\t\theader = append(header, byte(length>>(i*8)))\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tif mask {\n")
    code := String.concat(code, "\t\tmaskKey := []byte{0x12, 0x34, 0x56, 0x78}\n")
    code := String.concat(code, "\t\theader = append(header, maskKey...)\n")
    code := String.concat(code, "\t\tmaskedPayload := make([]byte, length)\n")
    code := String.concat(code, "\t\tfor i := 0; i < length; i++ {\n")
    code := String.concat(code, "\t\t\tmaskedPayload[i] = payload[i] ^ maskKey[i%4]\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tpayload = maskedPayload\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tif _, err := w.Write(header); err != nil {\n")
    code := String.concat(code, "\t\treturn err\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\tif _, err := w.Write(payload); err != nil {\n")
    code := String.concat(code, "\t\treturn err\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "\treturn nil\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func wsReadLoop(conn net.Conn, inChan chan string) {\n")
    code := String.concat(code, "\tdefer func() {\n")
    code := String.concat(code, "\t\tdefer func() { _ = recover() }()\n")
    code := String.concat(code, "\t\tclose(inChan)\n")
    code := String.concat(code, "\t}()\n")
    code := String.concat(code, "\tdefer conn.Close()\n")
    code := String.concat(code, "\tfor {\n")
    code := String.concat(code, "\t\topcode, payload, err := readFrame(conn)\n")
    code := String.concat(code, "\t\tif err != nil {\n")
    code := String.concat(code, "\t\t\tbreak\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tif opcode == 8 {\n")
    code := String.concat(code, "\t\t\tbreak\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tif opcode == 1 {\n")
    code := String.concat(code, "\t\t\tinChan <- string(payload)\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "}\n\n")
    code := String.concat(code, "func wsWriteLoop(conn net.Conn, outChan chan string, mask bool) {\n")
    code := String.concat(code, "\tdefer conn.Close()\n")
    code := String.concat(code, "\tfor {\n")
    code := String.concat(code, "\t\tmsg, ok := <-outChan\n")
    code := String.concat(code, "\t\tif !ok {\n")
    code := String.concat(code, "\t\t\t_ = writeFrame(conn, 8, nil, mask)\n")
    code := String.concat(code, "\t\t\tbreak\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t\tif err := writeFrame(conn, 1, []byte(msg), mask); err != nil {\n")
    code := String.concat(code, "\t\t\tbreak\n")
    code := String.concat(code, "\t\t}\n")
    code := String.concat(code, "\t}\n")
    code := String.concat(code, "}\n\n")
    return code
end emit_websocket_helpers

function emit_websocket_routine(routine_name: String) returns String
is
    let code: String = ""
    if routine_name = "connect" then
        code := String.concat(code, "func Connect(ctx context.Context, urlStr string) ResultConnectionWebSocketError {\n")
        code := String.concat(code, "\tu, err := url.Parse(urlStr)\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\thost := u.Host\n")
        code := String.concat(code, "\tif !strings.Contains(host, \":\") {\n")
        code := String.concat(code, "\t\thost = host + \":80\"\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tconn, err := net.Dial(\"tcp\", host)\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tkey := \"dGhlIHNhbXBsZSBub25jZQ==\"\n")
        code := String.concat(code, "\tpath := u.Path\n")
        code := String.concat(code, "\tif path == \"\" {\n")
        code := String.concat(code, "\t\tpath = \"/\"\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\treq := \"GET \" + path + \" HTTP/1.1\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Host: \" + u.Host + \"\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Upgrade: websocket\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Connection: Upgrade\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Sec-WebSocket-Key: \" + key + \"\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Sec-WebSocket-Version: 13\\r\\n\\r\\n\"\n")
        code := String.concat(code, "\t_, err = conn.Write([]byte(req))\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tresp, err := http.ReadResponse(bufio.NewReader(conn), nil)\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tif resp.StatusCode != 101 {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: \"unexpected status: \" + resp.Status}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tinChan := make(chan string, 64)\n")
        code := String.concat(code, "\toutChan := make(chan string, 64)\n")
        code := String.concat(code, "\tgo wsReadLoop(conn, inChan)\n")
        code := String.concat(code, "\tgo wsWriteLoop(conn, outChan, true)\n")
        code := String.concat(code, "\treturn ResultConnectionWebSocketError{\n")
        code := String.concat(code, "\t\tOk: true,\n")
        code := String.concat(code, "\t\tValue: Connection{\n")
        code := String.concat(code, "\t\t\tId:       urlStr,\n")
        code := String.concat(code, "\t\t\tIncoming: inChan,\n")
        code := String.concat(code, "\t\t\tOutgoing: outChan,\n")
        code := String.concat(code, "\t\t},\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "}\n\n")
    end if
    
    if routine_name = "listen" then
        code := String.concat(code, "func Listen(addr string) ResultServerWebSocketError {\n")
        code := String.concat(code, "\tl, err := net.Listen(\"tcp\", addr)\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\treturn ResultServerWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tid := registerListener(l)\n")
        code := String.concat(code, "\treturn ResultServerWebSocketError{\n")
        code := String.concat(code, "\t\tOk: true,\n")
        code := String.concat(code, "\t\tValue: Server{Id: id},\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "}\n\n")
    end if
    
    if routine_name = "accept" then
        code := String.concat(code, "func Accept(ctx context.Context, server Server) ResultConnectionWebSocketError {\n")
        code := String.concat(code, "\tl := getListener(server.Id)\n")
        code := String.concat(code, "\tif l == nil {\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: \"server listener not found\"}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tconn, err := l.Accept()\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tr := bufio.NewReader(conn)\n")
        code := String.concat(code, "\treq, err := http.ReadRequest(r)\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tkey := req.Header.Get(\"Sec-WebSocket-Key\")\n")
        code := String.concat(code, "\tif key == \"\" {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: \"missing Sec-WebSocket-Key\"}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\th := sha1.New()\n")
        code := String.concat(code, "\t_, _ = h.Write([]byte(key + \"258EAFA5-E914-47DA-95CA-C5AB0DC85B11\"))\n")
        code := String.concat(code, "\tacceptKey := base64.StdEncoding.EncodeToString(h.Sum(nil))\n")
        code := String.concat(code, "\tresp := \"HTTP/1.1 101 Switching Protocols\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Upgrade: websocket\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Connection: Upgrade\\r\\n\" +\n")
        code := String.concat(code, "\t\t\"Sec-WebSocket-Accept: \" + acceptKey + \"\\r\\n\\r\\n\"\n")
        code := String.concat(code, "\t_, err = conn.Write([]byte(resp))\n")
        code := String.concat(code, "\tif err != nil {\n")
        code := String.concat(code, "\t\tconn.Close()\n")
        code := String.concat(code, "\t\treturn ResultConnectionWebSocketError{Ok: false, Error: err.Error()}\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "\tinChan := make(chan string, 64)\n")
        code := String.concat(code, "\toutChan := make(chan string, 64)\n")
        code := String.concat(code, "\tgo wsReadLoop(conn, inChan)\n")
        code := String.concat(code, "\tgo wsWriteLoop(conn, outChan, false)\n")
        code := String.concat(code, "\treturn ResultConnectionWebSocketError{\n")
        code := String.concat(code, "\t\tOk: true,\n")
        code := String.concat(code, "\t\tValue: Connection{\n")
        code := String.concat(code, "\t\t\tId:       conn.RemoteAddr().String(),\n")
        code := String.concat(code, "\t\t\tIncoming: inChan,\n")
        code := String.concat(code, "\t\t\tOutgoing: outChan,\n")
        code := String.concat(code, "\t\t},\n")
        code := String.concat(code, "\t}\n")
        code := String.concat(code, "}\n\n")
    end if
    
    if routine_name = "close" then
        code := String.concat(code, "func Close(conn Connection) {\n")
        code := String.concat(code, "\tdefer func() {\n")
        code := String.concat(code, "\t\t_ = recover()\n")
        code := String.concat(code, "\t}()\n")
        code := String.concat(code, "\tclose(conn.Outgoing)\n")
        code := String.concat(code, "}\n\n")
    end if
    
    return code
end emit_websocket_routine

end Compiler.Core.Codegen
