module Compiler.Core.Resolve

import Compiler.Core.Diagnostics exposing Diagnostic, diagnostic_text, make_unknown_exposed_symbol_diagnostic, make_type_mismatch_diagnostic, make_unknown_field_diagnostic, make_shadowing_diagnostic, make_unknown_variable_diagnostic, make_array_bounds_diagnostic, make_diagnostic
import Compiler.Core.Ast exposing ModuleWithImportReferenceNode, ExprNode, StmtNode
import Compiler.Core.Names exposing ModuleName, SymbolName

type ResolveStatus is record
    name: String
end record

type ResolveResult is record
    status: ResolveStatus
    module_name: String
    symbol_name: String
    issue: Diagnostic
end record

type ExprResolveResult is record
    resolved_type: String
    issue: Diagnostic
end record

type RecordField is record
    name: String
    type_ref: String
end record

type RecordSymbol is record
    name: String
    qualified_name: String
    first_field_idx: Integer
    field_count: Integer
end record

type ParamSymbol is record
    name: String
    type_ref: String
end record

type RoutineSymbol is record
    name: String
    qualified_name: String
    first_param_idx: Integer
    param_count: Integer
    return_type: String
    is_async: Boolean
end record

type VarSymbol is record
    name: String
    type_ref: String
    scope_depth: Integer
end record

function make_resolve_status(name: String) returns ResolveStatus
requires String.instr(name, "") = 0
ensures result.name = name
is
    return ResolveStatus { name: name }
end make_resolve_status

function resolve_ok(import_module_full: String, symbol_raw: String) returns ResolveResult
requires String.instr(import_module_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.status.name = "ok", result.module_name = import_module_full, result.symbol_name = symbol_raw
is
    let status: ResolveStatus = make_resolve_status("ok")
    let empty_module: ModuleName = ModuleName { full: import_module_full }
    let empty_symbol: SymbolName = SymbolName { raw: symbol_raw }
    let empty_issue: Diagnostic = Diagnostic { code: "", message: "", module_name: empty_module, symbol_name: empty_symbol }
    return ResolveResult { status: status, module_name: import_module_full, symbol_name: symbol_raw, issue: empty_issue }
end resolve_ok

function resolve_error(issue: Diagnostic, import_module_full: String, symbol_raw: String) returns ResolveResult
requires String.instr(issue.code, "FH-") = 0, String.instr(import_module_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.status.name = "error", result.issue.code = issue.code, result.module_name = import_module_full, result.symbol_name = symbol_raw
is
    let status: ResolveStatus = make_resolve_status("error")
    return ResolveResult { status: status, module_name: import_module_full, symbol_name: symbol_raw, issue: issue }
end resolve_error

function expr_ok(type_ref: String) returns ExprResolveResult
requires String.instr(type_ref, "") = 0
ensures result.resolved_type = type_ref, result.issue.code = ""
is
    let empty_mod: ModuleName = ModuleName { full: "" }
    let empty_sym: SymbolName = SymbolName { raw: "" }
    let empty_issue: Diagnostic = Diagnostic { code: "", message: "", module_name: empty_mod, symbol_name: empty_sym }
    return ExprResolveResult { resolved_type: type_ref, issue: empty_issue }
end expr_ok

function expr_error(issue: Diagnostic, fallback_type: String) returns ExprResolveResult
requires String.instr(issue.code, "FH-") = 0, String.instr(fallback_type, "") = 0
ensures result.resolved_type = fallback_type, result.issue.code = issue.code
is
    return ExprResolveResult { resolved_type: fallback_type, issue: issue }
end expr_error

function resolve_mini_import_reference_module(ast_node: ModuleWithImportReferenceNode) returns ResolveResult
requires String.instr(ast_node.import_decl.module_name.name, "") = 0, String.instr(ast_node.routine.return_symbol.symbol_name.name, "") = 0
ensures result.module_name = ast_node.import_decl.module_name.name, result.symbol_name = ast_node.routine.return_symbol.symbol_name.name
is
    if ast_node.import_decl.exposed_name.name = ast_node.routine.return_symbol.symbol_name.name then
        return resolve_ok(ast_node.import_decl.module_name.name, ast_node.routine.return_symbol.symbol_name.name)
    else
        let issue: Diagnostic = make_unknown_exposed_symbol_diagnostic(ast_node.import_decl.module_name.name, ast_node.routine.return_symbol.symbol_name.name)
        return resolve_error(issue, ast_node.import_decl.module_name.name, ast_node.routine.return_symbol.symbol_name.name)
    end if
end resolve_mini_import_reference_module

function resolve_result_summary(resolve_result: ResolveResult) returns String
requires String.instr(resolve_result.status.name, "") = 0
ensures String.instr(result, resolve_result.status.name) = 0
is
    if resolve_result.status.name = "ok" then
        return String.template("ok:${module_name}.${symbol}", module_name: resolve_result.module_name, symbol: resolve_result.symbol_name)
    else
        return String.template("error:${diagnostic}", diagnostic: diagnostic_text(resolve_result.issue))
    end if
end resolve_result_summary

function lookup_record(records: Array<RecordSymbol, 64>, record_count: Integer, name: String) returns RecordSymbol
requires record_count >= 0, record_count <= 64, String.instr(name, "") = 0
is
    let i: Integer = 0
    let found: RecordSymbol = records[0]
    while i < record_count invariant i >= 0 and i <= record_count do
        let rec: RecordSymbol = records[i]
        if rec.name = name or rec.qualified_name = name then
            found := rec
        end if
        i := i + 1
    end while
    return found
end lookup_record

function lookup_routine(routines: Array<RoutineSymbol, 64>, routine_count: Integer, name: String) returns RoutineSymbol
requires routine_count >= 0, routine_count <= 64, String.instr(name, "") = 0
is
    let i: Integer = 0
    let found: RoutineSymbol = routines[0]
    while i < routine_count invariant i >= 0 and i <= routine_count do
        let rt: RoutineSymbol = routines[i]
        if rt.name = name or rt.qualified_name = name then
            found := rt
        end if
        i := i + 1
    end while
    return found
end lookup_routine

function has_declared_type(declared_types: Array<String, 32>, type_count: Integer, name: String) returns Boolean
requires type_count >= 0, type_count <= 32, String.instr(name, "") = 0
ensures result = true or result = false
is
    let i: Integer = 0
    let found: Boolean = false
    while i < type_count invariant i >= 0 and i <= type_count do
        let ty: String = declared_types[i]
        if ty = name then
            found := true
        end if
        i := i + 1
    end while
    return found
end has_declared_type

function has_declared_error(declared_errors: Array<String, 32>, error_count: Integer, name: String) returns Boolean
requires error_count >= 0, error_count <= 32, String.instr(name, "") = 0
ensures result = true or result = false
is
    let i: Integer = 0
    let found: Boolean = false
    while i < error_count invariant i >= 0 and i <= error_count do
        let err: String = declared_errors[i]
        if err = name then
            found := true
        end if
        i := i + 1
    end while
    return found
end has_declared_error

function lookup_local_var(locals: Array<VarSymbol, 128>, local_count: Integer, name: String) returns VarSymbol
requires local_count >= 0, local_count <= 128, String.instr(name, "") = 0
is
    let i: Integer = local_count - 1
    let found: VarSymbol = VarSymbol { name: "", type_ref: "", scope_depth: 0 }
    while i >= 0 invariant i >= -1 and i < local_count do
        let v: VarSymbol = locals[i]
        if v.name = name then
            found := v
            i := -1
        else
            i := i - 1
        end if
    end while
    return found
end lookup_local_var


function resolve_expr(
    expr: ExprNode,
    exprs: Array<ExprNode, 64>,
    locals: Array<VarSymbol, 128>,
    local_count: Integer,
    mod_full: String,
    sym_raw: String
) returns ExprResolveResult
requires local_count >= 0, local_count <= 128, String.instr(expr.kind, "") = 0, String.instr(mod_full, "") = 0, String.instr(sym_raw, "") = 0
ensures String.instr(result.resolved_type, "") = 0
is
    if expr.kind = "LITERAL" then
        return expr_ok(expr.literal_kind)
    else
        if expr.kind = "IDENTIFIER" then
            let v: VarSymbol = lookup_local_var(locals, local_count, expr.text)
            if v.name != "" then
                return expr_ok(v.type_ref)
            else
                if expr.text = "true" or expr.text = "false" then
                    return expr_ok("Boolean")
                else
                    let issue: Diagnostic = make_unknown_variable_diagnostic(expr.text, mod_full, sym_raw)
                    return expr_error(issue, "UnknownType")
                end if
            end if
        else
            if expr.kind = "UNARY_OP" then
                if expr.left_node_idx >= 0 and expr.left_node_idx < 64 then
                    let operand: ExprNode = exprs[expr.left_node_idx]
                    let res_op: ExprResolveResult = resolve_expr(operand, exprs, locals, local_count, mod_full, sym_raw)
                    if res_op.issue.code != "" then
                        return res_op
                    else
                        if expr.op = "not" then
                            if res_op.resolved_type = "Boolean" then
                                return expr_ok("Boolean")
                            else
                                let issue: Diagnostic = make_type_mismatch_diagnostic("Boolean", res_op.resolved_type, mod_full, sym_raw)
                                return expr_error(issue, "Boolean")
                            end if
                        else
                            return res_op
                        end if
                    end if
                else
                    let empty_mod: ModuleName = ModuleName { full: mod_full }
                    let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                    let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid unary operand index", empty_mod, empty_sym)
                    return expr_error(issue, "UnknownType")
                end if
            else
                if expr.kind = "BINARY_OP" then
                    if expr.left_node_idx >= 0 and expr.left_node_idx < 64 and expr.right_node_idx >= 0 and expr.right_node_idx < 64 then
                        let left: ExprNode = exprs[expr.left_node_idx]
                        let right: ExprNode = exprs[expr.right_node_idx]
                        let res_l: ExprResolveResult = resolve_expr(left, exprs, locals, local_count, mod_full, sym_raw)
                        if res_l.issue.code != "" then
                            return res_l
                        else
                            let res_r: ExprResolveResult = resolve_expr(right, exprs, locals, local_count, mod_full, sym_raw)
                            if res_r.issue.code != "" then
                                return res_r
                            else
                                if expr.op = "and" or expr.op = "or" then
                                    if res_l.resolved_type = "Boolean" and res_r.resolved_type = "Boolean" then
                                        return expr_ok("Boolean")
                                    else
                                        let issue: Diagnostic = make_type_mismatch_diagnostic("Boolean", res_l.resolved_type, mod_full, sym_raw)
                                        return expr_error(issue, "Boolean")
                                    end if
                                else
                                    if expr.op = "=" or expr.op = "!=" or expr.op = "<" or expr.op = "<=" or expr.op = ">" or expr.op = ">=" then
                                        if res_l.resolved_type != res_r.resolved_type then
                                            let issue: Diagnostic = make_type_mismatch_diagnostic(res_l.resolved_type, res_r.resolved_type, mod_full, sym_raw)
                                            return expr_error(issue, "Boolean")
                                        else
                                            return expr_ok("Boolean")
                                        end if
                                    else
                                        if res_l.resolved_type = "Double" or res_r.resolved_type = "Double" then
                                            return expr_ok("Double")
                                        else
                                            return expr_ok(res_l.resolved_type)
                                        end if
                                    end if
                                end if
                            end if
                        end if
                    else
                        let empty_mod: ModuleName = ModuleName { full: mod_full }
                        let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                        let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid binary operands indices", empty_mod, empty_sym)
                        return expr_error(issue, "UnknownType")
                    end if
                else
                    if expr.kind = "CALL" then
                        if expr.routine_name = "channel" then
                            if expr.invariant_idx >= 0 and expr.invariant_idx < 64 then
                                let inv_expr: ExprNode = exprs[expr.invariant_idx]
                                let res_inv: ExprResolveResult = resolve_expr(inv_expr, exprs, locals, local_count, mod_full, sym_raw)
                                if res_inv.issue.code != "" then
                                    return res_inv
                                else
                                    if res_inv.resolved_type != "Boolean" then
                                        let issue: Diagnostic = make_type_mismatch_diagnostic("Boolean", res_inv.resolved_type, mod_full, sym_raw)
                                        return expr_error(issue, "TypeError")
                                    end if
                                end if
                            end if
                            return expr_ok(expr.literal_kind)
                        else
                            if expr.routine_name = "answer" then
                                return expr_ok("Integer")
                            else
                                return expr_ok("UnknownType")
                            end if
                        end if
                    else
                        return expr_ok("UnknownType")
                    end if
                end if
            end if
        end if
    end if
end resolve_expr

function resolve_stmt(
    stmt: StmtNode,
    exprs: Array<ExprNode, 64>,
    locals: Array<VarSymbol, 128>,
    local_count: Integer,
    mod_full: String,
    sym_raw: String
) returns ResolveResult
requires local_count >= 0, local_count <= 128, String.instr(stmt.kind, "") = 0, String.instr(mod_full, "") = 0, String.instr(sym_raw, "") = 0
ensures String.instr(result.status.name, "") = 0, result.module_name = mod_full, result.symbol_name = sym_raw
is
    if stmt.kind = "LET" then
        let existing: VarSymbol = lookup_local_var(locals, local_count, stmt.var_name)
        if existing.name != "" then
            let issue: Diagnostic = make_shadowing_diagnostic(stmt.var_name, mod_full, sym_raw)
            return resolve_error(issue, mod_full, sym_raw)
        else
            if stmt.expr_idx >= 0 and stmt.expr_idx < 64 then
                let ex: ExprNode = exprs[stmt.expr_idx]
                let res_expr: ExprResolveResult = resolve_expr(ex, exprs, locals, local_count, mod_full, sym_raw)
                if res_expr.issue.code != "" then
                    return resolve_error(res_expr.issue, mod_full, sym_raw)
                else
                    if res_expr.resolved_type = stmt.var_type then
                        return resolve_ok(mod_full, sym_raw)
                    else
                        let issue: Diagnostic = make_type_mismatch_diagnostic(stmt.var_type, res_expr.resolved_type, mod_full, sym_raw)
                        return resolve_error(issue, mod_full, sym_raw)
                    end if
                end if
            else
                let empty_mod: ModuleName = ModuleName { full: mod_full }
                let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid let expr index", empty_mod, empty_sym)
                return resolve_error(issue, mod_full, sym_raw)
            end if
        end if
    else
        if stmt.kind = "ASSIGN" then
            let v_assign: VarSymbol = lookup_local_var(locals, local_count, stmt.var_name)
            if v_assign.name = "" then
                let issue: Diagnostic = make_unknown_variable_diagnostic(stmt.var_name, mod_full, sym_raw)
                return resolve_error(issue, mod_full, sym_raw)
            else
                if stmt.expr_idx >= 0 and stmt.expr_idx < 64 then
                    let ex_assign: ExprNode = exprs[stmt.expr_idx]
                    let res_expr_assign: ExprResolveResult = resolve_expr(ex_assign, exprs, locals, local_count, mod_full, sym_raw)
                    if res_expr_assign.issue.code != "" then
                        return resolve_error(res_expr_assign.issue, mod_full, sym_raw)
                    else
                        if res_expr_assign.resolved_type = v_assign.type_ref then
                            return resolve_ok(mod_full, sym_raw)
                        else
                            let issue: Diagnostic = make_type_mismatch_diagnostic(v_assign.type_ref, res_expr_assign.resolved_type, mod_full, sym_raw)
                            return resolve_error(issue, mod_full, sym_raw)
                        end if
                    end if
                else
                    let empty_mod: ModuleName = ModuleName { full: mod_full }
                    let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                    let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid assign expr index", empty_mod, empty_sym)
                    return resolve_error(issue, mod_full, sym_raw)
                end if
            end if
        else
            if stmt.kind = "IF" then
                if stmt.cond_expr_idx >= 0 and stmt.cond_expr_idx < 64 then
                    let cond_ex: ExprNode = exprs[stmt.cond_expr_idx]
                    let res_cond: ExprResolveResult = resolve_expr(cond_ex, exprs, locals, local_count, mod_full, sym_raw)
                    if res_cond.issue.code != "" then
                        return resolve_error(res_cond.issue, mod_full, sym_raw)
                    else
                        if res_cond.resolved_type = "Boolean" then
                            return resolve_ok(mod_full, sym_raw)
                        else
                            let issue: Diagnostic = make_type_mismatch_diagnostic("Boolean", res_cond.resolved_type, mod_full, sym_raw)
                            return resolve_error(issue, mod_full, sym_raw)
                        end if
                    end if
                else
                    let empty_mod: ModuleName = ModuleName { full: mod_full }
                    let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                    let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid if condition index", empty_mod, empty_sym)
                    return resolve_error(issue, mod_full, sym_raw)
                end if
            else
                if stmt.kind = "WHILE" then
                    if stmt.cond_expr_idx >= 0 and stmt.cond_expr_idx < 64 then
                        let cond_ex_while: ExprNode = exprs[stmt.cond_expr_idx]
                        let res_cond_while: ExprResolveResult = resolve_expr(cond_ex_while, exprs, locals, local_count, mod_full, sym_raw)
                        if res_cond_while.issue.code != "" then
                            return resolve_error(res_cond_while.issue, mod_full, sym_raw)
                        else
                            if res_cond_while.resolved_type = "Boolean" then
                                return resolve_ok(mod_full, sym_raw)
                            else
                                let issue: Diagnostic = make_type_mismatch_diagnostic("Boolean", res_cond_while.resolved_type, mod_full, sym_raw)
                                return resolve_error(issue, mod_full, sym_raw)
                            end if
                        end if
                    else
                        let empty_mod: ModuleName = ModuleName { full: mod_full }
                        let empty_sym: SymbolName = SymbolName { raw: sym_raw }
                        let issue: Diagnostic = make_diagnostic("FH-TYP-2007", "invalid while condition index", empty_mod, empty_sym)
                        return resolve_error(issue, mod_full, sym_raw)
                    end if
                else
                    return resolve_ok(mod_full, sym_raw)
                end if
            end if
        end if
    end if
end resolve_stmt

type ExportedSymbol is record
    module_name: String
    symbol_name: String
    symbol_kind: String
    type_ref: String
end record

function lookup_exported_symbol(exports: Array<ExportedSymbol, 64>, export_count: Integer, mod_name: String, sym_name: String) returns ExportedSymbol
requires export_count >= 0, export_count <= 64, String.instr(mod_name, "") = 0, String.instr(sym_name, "") = 0
ensures String.instr(result.module_name, "") = 0
is
    let i: Integer = 0
    let found: ExportedSymbol = ExportedSymbol { module_name: "", symbol_name: "", symbol_kind: "", type_ref: "" }
    while i < export_count invariant i >= 0 and i <= export_count do
        let exp: ExportedSymbol = exports[i]
        if exp.module_name = mod_name and exp.symbol_name = sym_name then
            found := exp
        end if
        i := i + 1
    end while
    return found
end lookup_exported_symbol

function resolve_import_exposing(
    import_module: String,
    exposed_symbol: String,
    exports: Array<ExportedSymbol, 64>,
    export_count: Integer
) returns Boolean
requires export_count >= 0, export_count <= 64, String.instr(import_module, "") = 0, String.instr(exposed_symbol, "") = 0
ensures result = true or result = false
is
    let sym: ExportedSymbol = lookup_exported_symbol(exports, export_count, import_module, exposed_symbol)
    if sym.module_name != "" then
        return true
    else
        return false
    end if
end resolve_import_exposing

function is_generic_type(type_name: String) returns Boolean
requires String.instr(type_name, "") = 0
ensures result = true or result = false
is
    let index: Integer = String.instr(type_name, "<")
    if index >= 0 then
        return true
    else
        return false
    end if
end is_generic_type

function monomorphize_generic_type(generic_type: String, param_name: String, concrete_type: String) returns String
requires String.instr(generic_type, "") = 0, String.instr(param_name, "") = 0, String.instr(concrete_type, "") = 0
ensures String.instr(result, "") = 0
is
    return String.replace(generic_type, param_name, concrete_type)
end monomorphize_generic_type

function is_channel_type(type_name: String) returns Boolean
requires String.instr(type_name, "") = 0
ensures result = true or result = false
is
    if String.instr(type_name, "Channel<") = 0 or String.instr(type_name, "Sender<") = 0 or String.instr(type_name, "Receiver<") = 0 then
        return true
    else
        return false
    end if
end is_channel_type

function get_channel_element_type(type_name: String) returns String
requires String.instr(type_name, "") = 0
ensures String.instr(result, "") = 0
is
    let start_idx: Integer = String.instr(type_name, "<")
    let end_idx: Integer = String.instr(type_name, ">")
    if start_idx >= 0 and end_idx > start_idx then
        return String.substr(type_name, start_idx + 1, end_idx - start_idx - 1)
    else
        return "UnknownType"
    end if
end get_channel_element_type

function resolve_service_rpc(rpc_name: String, request_type: String, response_type: String) returns Boolean
requires String.instr(rpc_name, "") = 0, String.instr(request_type, "") = 0, String.instr(response_type, "") = 0
ensures result = true or result = false
is
    -- In Freehold gRPC V1, RPC request/response must be record structures
    if String.instr(request_type, "Request") >= 0 or String.instr(request_type, "Message") >= 0 then
        if String.instr(response_type, "Response") >= 0 or String.instr(response_type, "Message") >= 0 or String.instr(response_type, "Result") >= 0 then
            return true
        else
            return false
        end if
    else
        return false
    end if
end resolve_service_rpc

function check_variable_shadowing(locals: Array<VarSymbol, 128>, local_count: Integer, name: String) returns Boolean
requires local_count >= 0, local_count <= 128, String.instr(name, "") = 0
ensures result = true or result = false
is
    let existing: VarSymbol = lookup_local_var(locals, local_count, name)
    if existing.name != "" then
        return true
    else
        return false
    end if
end check_variable_shadowing

function lookup_record_field(
    rec: RecordSymbol,
    field_name: String,
    fields: Array<RecordField, 256>
) returns String
requires rec.first_field_idx >= 0, rec.field_count >= 0, String.instr(field_name, "") = 0
is
    let i: Integer = rec.field_count - rec.field_count
    let found_type: String = ""
    while i < rec.field_count invariant i >= 0 and i <= rec.field_count do
        let idx: Integer = rec.first_field_idx + i
        if idx >= 0 and idx < 256 then
            let f: RecordField = fields[idx]
            if f.name = field_name then
                found_type := f.type_ref
            end if
        end if
        i := i + 1
    end while
    return found_type
end lookup_record_field

function type_check_record_literal(
    rec: RecordSymbol,
    fields: Array<RecordField, 256>,
    literal_fields: Array<String, 16>,
    literal_types: Array<String, 16>,
    literal_field_count: Integer,
    mod_full: String,
    sym_raw: String
) returns ResolveResult
requires rec.first_field_idx >= 0, rec.field_count >= 0, literal_field_count >= 0 and literal_field_count <= 16, String.instr(mod_full, "") = 0, String.instr(sym_raw, "") = 0
is
    let i: Integer = literal_field_count - literal_field_count
    while i < literal_field_count invariant i >= 0 and i <= literal_field_count do
        let fname: String = literal_fields[i]
        let ftype: String = literal_types[i]
        let expected_type: String = lookup_record_field(rec, fname, fields)
        if expected_type = "" then
            let issue: Diagnostic = make_unknown_field_diagnostic(rec.name, fname, mod_full, sym_raw)
            return resolve_error(issue, mod_full, sym_raw)
        else
            if expected_type != ftype then
                let issue: Diagnostic = make_type_mismatch_diagnostic(expected_type, ftype, mod_full, sym_raw)
                return resolve_error(issue, mod_full, sym_raw)
            end if
        end if
        i := i + 1
    end while
    return resolve_ok(mod_full, sym_raw)
end type_check_record_literal

function type_check_record_update(
    base_type: String,
    rec_type: String,
    mod_full: String,
    sym_raw: String
) returns ResolveResult
requires String.instr(base_type, "") = 0, String.instr(rec_type, "") = 0, String.instr(mod_full, "") = 0, String.instr(sym_raw, "") = 0
is
    if base_type != rec_type then
        let issue: Diagnostic = make_type_mismatch_diagnostic(rec_type, base_type, mod_full, sym_raw)
        return resolve_error(issue, mod_full, sym_raw)
    else
        return resolve_ok(mod_full, sym_raw)
    end if
end type_check_record_update

function parse_array_size(type_ref: String) returns Integer
requires String.instr(type_ref, "") = 0
is
    let comma_idx: Integer = String.instr(type_ref, ",")
    let close_idx: Integer = String.instr(type_ref, ">")
    if comma_idx >= 0 and close_idx > comma_idx then
        let size_str: String = String.substr(type_ref, comma_idx + 1, close_idx - comma_idx - 1)
        if String.instr(size_str, " ") = 0 then
            size_str := String.substr(size_str, 1, String.length(size_str) - 1)
        end if
        if size_str = "16" then return 16 end if
        if size_str = "32" then return 32 end if
        if size_str = "64" then return 64 end if
        if size_str = "128" then return 128 end if
        if size_str = "256" then return 256 end if
        return 0
    else
        return 0
    end if
end parse_array_size

function type_check_array_index(
    type_ref: String,
    index_val: Integer,
    mod_full: String,
    sym_raw: String
) returns ResolveResult
requires String.instr(type_ref, "") = 0, String.instr(mod_full, "") = 0, String.instr(sym_raw, "") = 0
is
    let size: Integer = parse_array_size(type_ref)
    if size > 0 then
        if index_val < 0 or index_val >= size then
            let issue: Diagnostic = make_array_bounds_diagnostic(index_val, size, mod_full, sym_raw)
            return resolve_error(issue, mod_full, sym_raw)
        else
            return resolve_ok(mod_full, sym_raw)
        end if
    else
        return resolve_ok(mod_full, sym_raw)
    end if
end type_check_array_index

end Compiler.Core.Resolve