    let arg_literal: LiteralNode = make_literal_node(tokens.argument.span, "String", tokens.argument.lexeme)
    let err_identifier: IdentifierNode = make_identifier_node(tokens.error_type.span, tokens.error_type.lexeme)
    let call_stmt: CallStmtNode = make_call_stmt_node(tokens.call_keyword.span, routine_identifier, arg_literal, err_identifier)

