requires tokens.module_keyword.lexeme = "module", tokens.call_keyword.lexeme = "call", tokens.open_paren.lexeme = "(", tokens.close_paren.lexeme = ")", tokens.aborts_keyword.lexeme = "aborts", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
