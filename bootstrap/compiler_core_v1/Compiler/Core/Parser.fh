function parse_mini_nested_call_module(tokens: MiniNestedCallModuleTokens) returns ModuleWithNestedCallNode
requires tokens.module_keyword.lexeme = "module", tokens.let_keyword.lexeme = "let", tokens.assign_symbol.lexeme = "=", tokens.open_paren0.lexeme = "(", tokens.open_paren1.lexeme = "(", tokens.close_paren1.lexeme = ")", tokens.close_paren0.lexeme = ")", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme, result.nested_call.var_name.name = tokens.var_name.lexeme
is
    let module_identifier: IdentifierNode = make_identifier_node(tokens.module_name.span, tokens.module_name.lexeme)
    let module_node: ModuleNode = make_module_node(tokens.module_keyword.span, module_identifier)

    let var_identifier: IdentifierNode = make_identifier_node(tokens.var_name.span, tokens.var_name.lexeme)
    let outer_identifier: IdentifierNode = make_identifier_node(tokens.outer_routine.span, tokens.outer_routine.lexeme)
    let inner_identifier: IdentifierNode = make_identifier_node(tokens.inner_routine.span, tokens.inner_routine.lexeme)
    let arg_literal: LiteralNode = make_literal_node(tokens.argument.span, "String", tokens.argument.lexeme)

    let nested_call: NestedCallStmtNode = make_nested_call_stmt_node(tokens.let_keyword.span, var_identifier, outer_identifier, inner_identifier, arg_literal)
    return make_module_with_nested_call_node(module_node, nested_call)
end parse_mini_nested_call_module

function parse_mini_nested_call_module_result(tokens: MiniNestedCallModuleTokens) returns ParseResult
requires tokens.module_keyword.lexeme = "module", tokens.let_keyword.lexeme = "let", tokens.assign_symbol.lexeme = "=", tokens.open_paren0.lexeme = "(", tokens.open_paren1.lexeme = "(", tokens.close_paren1.lexeme = ")", tokens.close_paren0.lexeme = ")", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme
is
    let parsed_module: ModuleWithNestedCallNode = parse_mini_nested_call_module(tokens)
    return parse_ok(parsed_module.module_node)
end parse_mini_nested_call_module_result


function parsed_module_name(module_node: ModuleNode) returns String
requires String.instr(module_node.name.name, "") = 0
ensures result = module_node.name.name
is
    return module_node.name.name
end parsed_module_name

