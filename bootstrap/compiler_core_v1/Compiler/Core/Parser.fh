    let routine: ProcedureNode = make_procedure_node(tokens.procedure_keyword.span, routine_identifier)
    return make_module_with_procedure_node(module_node, routine)
end parse_mini_procedure_module

function parse_mini_procedure_module_result(tokens: MiniProcedureModuleTokens) returns ParseResult
requires tokens.module_keyword.lexeme = "module", tokens.procedure_keyword.lexeme = "procedure", tokens.open_paren.lexeme = "(", tokens.close_paren.lexeme = ")", tokens.is_keyword.lexeme = "is", tokens.routine_end_keyword.lexeme = "end", tokens.module_end_keyword.lexeme = "end", tokens.routine_name.lexeme = tokens.routine_end_name.lexeme, tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme
is
    let parsed_module: ModuleWithProcedureNode = parse_mini_procedure_module(tokens)
    return parse_ok(parsed_module.module_node)
end parse_mini_procedure_module_result

function parse_mini_import_module(tokens: MiniImportModuleTokens) returns ModuleWithImportNode
requires tokens.import_keyword.lexeme = "import", tokens.exposing_keyword.lexeme = "exposing", tokens.module_keyword.lexeme = "module", tokens.end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme, result.import_decl.module_name.name = tokens.import_module_name.lexeme
is
    let import_module_identifier: IdentifierNode = make_identifier_node(tokens.import_module_name.span, tokens.import_module_name.lexeme)
    let exposed_identifier: IdentifierNode = make_identifier_node(tokens.exposed_name.span, tokens.exposed_name.lexeme)
    let import_decl: ImportNode = make_import_node(tokens.import_keyword.span, import_module_identifier, exposed_identifier)
    let module_identifier: IdentifierNode = make_identifier_node(tokens.module_name.span, tokens.module_name.lexeme)
    let module_node: ModuleNode = make_module_node(tokens.module_keyword.span, module_identifier)
    return make_module_with_import_node(module_node, import_decl)
end parse_mini_import_module

function parse_mini_import_module_result(tokens: MiniImportModuleTokens) returns ParseResult
requires tokens.import_keyword.lexeme = "import", tokens.exposing_keyword.lexeme = "exposing", tokens.module_keyword.lexeme = "module", tokens.end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme
is
    let parsed_module: ModuleWithImportNode = parse_mini_import_module(tokens)
    return parse_ok(parsed_module.module_node)
end parse_mini_import_module_result

function parse_mini_import_reference_module(tokens: MiniImportReferenceModuleTokens) returns ModuleWithImportReferenceNode
requires tokens.import_keyword.lexeme = "import", tokens.exposing_keyword.lexeme = "exposing", tokens.module_keyword.lexeme = "module", tokens.function_keyword.lexeme = "function", tokens.open_paren.lexeme = "(", tokens.close_paren.lexeme = ")", tokens.returns_keyword.lexeme = "returns", tokens.is_keyword.lexeme = "is", tokens.return_keyword.lexeme = "return", tokens.routine_end_keyword.lexeme = "end", tokens.module_end_keyword.lexeme = "end", tokens.routine_name.lexeme = tokens.routine_end_name.lexeme, tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme, result.routine.return_symbol.symbol_name.name = tokens.return_symbol.lexeme
is
    let import_module_identifier: IdentifierNode = make_identifier_node(tokens.import_module_name.span, tokens.import_module_name.lexeme)
    let exposed_identifier: IdentifierNode = make_identifier_node(tokens.exposed_name.span, tokens.exposed_name.lexeme)
    let import_decl: ImportNode = make_import_node(tokens.import_keyword.span, import_module_identifier, exposed_identifier)
    let module_identifier: IdentifierNode = make_identifier_node(tokens.module_name.span, tokens.module_name.lexeme)
    let module_node: ModuleNode = make_module_node(tokens.module_keyword.span, module_identifier)
    let routine_identifier: IdentifierNode = make_identifier_node(tokens.routine_name.span, tokens.routine_name.lexeme)
    let return_type_identifier: IdentifierNode = make_identifier_node(tokens.return_type.span, tokens.return_type.lexeme)
    let return_symbol_identifier: IdentifierNode = make_identifier_node(tokens.return_symbol.span, tokens.return_symbol.lexeme)
    let import_reference: ImportReferenceNode = make_import_reference_node(tokens.return_symbol.span, import_decl, return_symbol_identifier)
    let routine: FunctionImportReferenceNode = make_function_import_reference_node(tokens.function_keyword.span, routine_identifier, return_type_identifier, import_reference)
    return make_module_with_import_reference_node(module_node, import_decl, routine)
end parse_mini_import_reference_module

function parse_mini_import_reference_module_result(tokens: MiniImportReferenceModuleTokens) returns ParseResult
requires tokens.import_keyword.lexeme = "import", tokens.exposing_keyword.lexeme = "exposing", tokens.module_keyword.lexeme = "module", tokens.function_keyword.lexeme = "function", tokens.open_paren.lexeme = "(", tokens.close_paren.lexeme = ")", tokens.returns_keyword.lexeme = "returns", tokens.is_keyword.lexeme = "is", tokens.return_keyword.lexeme = "return", tokens.routine_end_keyword.lexeme = "end", tokens.module_end_keyword.lexeme = "end", tokens.routine_name.lexeme = tokens.routine_end_name.lexeme, tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme
is
    let parsed_module: ModuleWithImportReferenceNode = parse_mini_import_reference_module(tokens)
    return parse_ok(parsed_module.module_node)
end parse_mini_import_reference_module_result

function parse_mini_record_literal_module(tokens: MiniRecordLiteralModuleTokens) returns ModuleWithRecordLiteralNode
requires tokens.module_keyword.lexeme = "module", tokens.open_brace.lexeme = "{", tokens.close_brace.lexeme = "}", tokens.colon0.lexeme = ":", tokens.colon1.lexeme = ":", tokens.comma0.lexeme = ",", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme, result.record_literal.type_name.name = tokens.type_name.lexeme
is
    let module_identifier: IdentifierNode = make_identifier_node(tokens.module_name.span, tokens.module_name.lexeme)
    let module_node: ModuleNode = make_module_node(tokens.module_keyword.span, module_identifier)

    let type_identifier: IdentifierNode = make_identifier_node(tokens.type_name.span, tokens.type_name.lexeme)
    let f0_name_node: IdentifierNode = make_identifier_node(tokens.field0_name.span, tokens.field0_name.lexeme)
    let f0_value_node: LiteralNode = make_literal_node(tokens.field0_value.span, "String", tokens.field0_value.lexeme)
    let f1_name_node: IdentifierNode = make_identifier_node(tokens.field1_name.span, tokens.field1_name.lexeme)
    let f1_value_node: LiteralNode = make_literal_node(tokens.field1_value.span, "String", tokens.field1_value.lexeme)
    
    let dummy_span: SourceSpan = tokens.open_brace.span
    let dummy_id: IdentifierNode = make_identifier_node(dummy_span, "")
    let dummy_lit: LiteralNode = make_literal_node(dummy_span, "String", "")

    let record_literal: RecordLiteralNode = make_record_literal_node(
        tokens.type_name.span,
        type_identifier,
        f0_name_node,
        f0_value_node,
        f1_name_node,
        f1_value_node,
        dummy_id,
        dummy_lit,
        2
    )

    return make_module_with_record_literal_node(module_node, record_literal)
end parse_mini_record_literal_module

function parse_mini_record_literal_module_result(tokens: MiniRecordLiteralModuleTokens) returns ParseResult
requires tokens.module_keyword.lexeme = "module", tokens.open_brace.lexeme = "{", tokens.close_brace.lexeme = "}", tokens.colon0.lexeme = ":", tokens.colon1.lexeme = ":", tokens.comma0.lexeme = ",", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme
is
    let parsed_module: ModuleWithRecordLiteralNode = parse_mini_record_literal_module(tokens)
    return parse_ok(parsed_module.module_node)
end parse_mini_record_literal_module_result

function parse_mini_return_stmt_module(tokens: MiniReturnStmtModuleTokens) returns ModuleWithReturnNode
requires tokens.module_keyword.lexeme = "module", tokens.return_keyword.lexeme = "return", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
ensures result.module_node.name.name = tokens.module_name.lexeme, result.return_stmt.kind = tokens.return_kind.lexeme
is
    let module_identifier: IdentifierNode = make_identifier_node(tokens.module_name.span, tokens.module_name.lexeme)
    let module_node: ModuleNode = make_module_node(tokens.module_keyword.span, module_identifier)

    let val_node: LiteralNode = make_literal_node(tokens.val.span, "String", tokens.val.lexeme)
    let err_node: IdentifierNode = make_identifier_node(tokens.error_ref.span, tokens.error_ref.lexeme)
    let return_stmt: ReturnStmtNode = make_return_stmt_node(tokens.return_keyword.span, tokens.return_kind.lexeme, val_node, err_node)

    return make_module_with_return_node(module_node, return_stmt)
end parse_mini_return_stmt_module

function parse_mini_return_stmt_module_result(tokens: MiniReturnStmtModuleTokens) returns ParseResult
requires tokens.module_keyword.lexeme = "module", tokens.return_keyword.lexeme = "return", tokens.module_end_keyword.lexeme = "end", tokens.module_name.lexeme = tokens.module_end_name.lexeme
