type GeneralParser is record
    lexer: Lexer
    curr_tok: Token
    peek_tok: Token
    has_error: Boolean
    issue: ParseError
    source_name: String
end record

type ParserIdentifierResult is record
    parser: GeneralParser
    node: IdentifierNode
end record

type ParserImportResult is record
    parser: GeneralParser
    node: ImportNode
end record

type ParserRecordResult is record
    parser: GeneralParser
    node: RecordTypeNode
end record

type ParserProcedureResult is record
    parser: GeneralParser
    node: ProcedureNode
end record

type ParserFunctionNodeResult is record
    parser: GeneralParser
    is_import_ref: Boolean
    func_node: FunctionNode
    func_import_ref_node: FunctionImportReferenceNode
end record

type ParserExprResult is record
    parser: GeneralParser
    node: ExprNode
end record

type ParserStmtResult is record
    parser: GeneralParser
    node: StmtNode
end record


function init_general_parser(source_name: String, source: String) returns GeneralParser
requires String.instr(source_name, "") = 0, String.instr(source, "") = 0
ensures result.has_error = false and result.source_name = source_name
is
    let lex: Lexer = make_lexer(source_name, source)
    let res1: LexerResult = lex_next_token(lex)
    let res2: LexerResult = lex_next_token(res1.lexer)
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_err: ParseError = ParseError { code: "FH-PARSE-0000", message: "", span: empty_span }
    return GeneralParser {
        lexer: res2.lexer,
        curr_tok: res1.token,
        peek_tok: res2.token,
        has_error: false,
        issue: empty_err,
        source_name: source_name
    }
end init_general_parser

function advance_parser(p: GeneralParser) returns GeneralParser
requires String.instr(p.source_name, "") = 0
ensures result.source_name = p.source_name and result.has_error = p.has_error
is
    let res: LexerResult = lex_next_token(p.lexer)
    return GeneralParser {
        lexer: res.lexer,
        curr_tok: p.peek_tok,
        peek_tok: res.token,
        has_error: p.has_error,
        issue: p.issue,
        source_name: p.source_name
    }
end advance_parser

function expect_kind(p: GeneralParser, kind: String, err_code: String, err_msg: String) returns GeneralParser
requires String.instr(p.source_name, "") = 0, String.instr(kind, "") = 0, String.instr(err_code, "") = 0, String.instr(err_msg, "") = 0
ensures result.source_name = p.source_name
is
    if p.has_error then
        return p
    end if
    if p.curr_tok.kind.name = kind then
        return advance_parser(p)
    else
        let err: ParseError = make_parse_error(err_code, err_msg, p.curr_tok.span)
        return GeneralParser {
            lexer: p.lexer,
            curr_tok: p.curr_tok,
            peek_tok: p.peek_tok,
            has_error: true,
            issue: err,
            source_name: p.source_name
        }
    end if
end expect_kind

function is_literal_token(tok: Token) returns Boolean
requires String.instr(tok.kind.name, "") = 0
ensures result = true or result = false
is
    return tok.kind.name = "NumberLiteral" or tok.kind.name = "DoubleLiteral" or tok.kind.name = "StringLiteral" or tok.kind.name = "KeywordTrue" or tok.kind.name = "KeywordFalse"
end is_literal_token

function parse_identifier(p: GeneralParser) returns ParserIdentifierResult
requires String.instr(p.source_name, "") = 0
ensures result.parser.source_name = p.source_name
is
    if p.has_error then
        let empty_id_err: IdentifierNode = make_identifier_node(p.curr_tok.span, "")
        return ParserIdentifierResult { parser: p, node: empty_id_err }
    end if

    if p.curr_tok.kind.name = "Identifier" then
        let node: IdentifierNode = make_identifier_node(p.curr_tok.span, p.curr_tok.lexeme)
        let p_next: GeneralParser = advance_parser(p)
        return ParserIdentifierResult { parser: p_next, node: node }
    else
        let err_msg: String = String.template("Expected identifier, got ${lexeme}", lexeme: p.curr_tok.lexeme)
        let err: ParseError = make_parse_error("FH-PARSE-0002", err_msg, p.curr_tok.span)
        let p_err: GeneralParser = GeneralParser {
            lexer: p.lexer,
            curr_tok: p.curr_tok,
            peek_tok: p.peek_tok,
            has_error: true,
            issue: err,
            source_name: p.source_name
        }
        let empty_id_fail: IdentifierNode = make_identifier_node(p.curr_tok.span, "")
        return ParserIdentifierResult { parser: p_err, node: empty_id_fail }
    end if
end parse_identifier

function parse_type_ref(p: GeneralParser) returns ParserIdentifierResult
requires String.instr(p.source_name, "") = 0
ensures result.parser.source_name = p.source_name
is
    let res: ParserIdentifierResult = parse_identifier(p)
    if res.parser.has_error then
        return res
    end if

    let p_curr: GeneralParser = res.parser
    let full_name: String = res.node.name
    let last_span: SourceSpan = res.node.span

    if p_curr.curr_tok.kind.name = "LessThan" then
        let p_lt: GeneralParser = advance_parser(p_curr)
        let res_inner: ParserIdentifierResult = parse_type_ref(p_lt)
        if res_inner.parser.has_error then
            return res_inner
        end if
        let p_gt: GeneralParser = expect_kind(res_inner.parser, "GreaterThan", "FH-PARSE-0002", "Expected '>'")
        if p_gt.has_error then
            let empty_id_err: IdentifierNode = make_identifier_node(p.curr_tok.span, "")
            return ParserIdentifierResult { parser: p_gt, node: empty_id_err }
        end if
        full_name := String.template("${base}<${inner}>", base: full_name, inner: res_inner.node.name)
        last_span := p_gt.curr_tok.span
        p_curr := p_gt
    end if

    let combined_span: SourceSpan = make_source_span(p.source_name, res.node.span.start_line, res.node.span.start_column, last_span.end_line, last_span.end_column)
    let combined_node: IdentifierNode = make_identifier_node(combined_span, full_name)
    return ParserIdentifierResult { parser: p_curr, node: combined_node }
end parse_type_ref

function parse_dotted_identifier(p: GeneralParser) returns ParserIdentifierResult
requires String.instr(p.source_name, "") = 0
ensures result.parser.source_name = p.source_name
is
    let res: ParserIdentifierResult = parse_identifier(p)
    if res.parser.has_error then
        return res
    end if

    let p_curr: GeneralParser = res.parser
    let full_name: String = res.node.name
    let last_span: SourceSpan = res.node.span

    while p_curr.has_error = false and p_curr.curr_tok.kind.name = "Dot"
        invariant p_curr.has_error = true or p_curr.has_error = false
        invariant p_curr.source_name = p.source_name
    do
        let p_dot: GeneralParser = advance_parser(p_curr)
        let res_next: ParserIdentifierResult = parse_identifier(p_dot)
        if res_next.parser.has_error then
            p_curr := res_next.parser
        else
            full_name := String.template("${prev}.${next}", prev: full_name, next: res_next.node.name)
            last_span := res_next.node.span
            p_curr := res_next.parser
        end if
    end while

    let combined_span: SourceSpan = make_source_span(p.source_name, res.node.span.start_line, res.node.span.start_column, last_span.end_line, last_span.end_column)
    let combined_node: IdentifierNode = make_identifier_node(combined_span, full_name)
    return ParserIdentifierResult { parser: p_curr, node: combined_node }
end parse_dotted_identifier

function parse_module_decl(p: GeneralParser) returns ParserIdentifierResult
is
    let p1: GeneralParser = expect_kind(p, "KeywordModule", "FH-PARSE-0002", "Expected 'module'")
    return parse_dotted_identifier(p1)
end parse_module_decl

function parse_import_decl(p: GeneralParser) returns ParserImportResult
is
    let p1: GeneralParser = expect_kind(p, "KeywordImport", "FH-PARSE-0002", "Expected 'import'")
    let res_module: ParserIdentifierResult = parse_dotted_identifier(p1)
    let p2: GeneralParser = expect_kind(res_module.parser, "KeywordExposing", "FH-PARSE-0002", "Expected 'exposing'")
    let res_exposed: ParserIdentifierResult = parse_identifier(p2)
    let import_node: ImportNode = make_import_node(res_module.node.span, res_module.node, res_exposed.node)
    return ParserImportResult { parser: res_exposed.parser, node: import_node }
end parse_import_decl

function parse_record_decl(p: GeneralParser) returns ParserRecordResult
is
    let p1: GeneralParser = expect_kind(p, "KeywordType", "FH-PARSE-0002", "Expected 'type'")
    let res_name: ParserIdentifierResult = parse_identifier(p1)
    let p2: GeneralParser = expect_kind(res_name.parser, "KeywordIs", "FH-PARSE-0002", "Expected 'is'")
    let p3: GeneralParser = expect_kind(p2, "KeywordRecord", "FH-PARSE-0002", "Expected 'record'")
    let p4: GeneralParser = expect_kind(p3, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
    let p5: GeneralParser = expect_kind(p4, "KeywordRecord", "FH-PARSE-0002", "Expected 'record'")
    let rec_node: RecordTypeNode = make_record_type_node(res_name.node.span, res_name.node)
    return ParserRecordResult { parser: p5, node: rec_node }
end parse_record_decl

type ParserTypeDeclResult is record
    parser: GeneralParser
    node: TypeDeclNode
    is_record: Boolean
    record_node: RecordTypeNode
end record

function parse_type_decl(p: GeneralParser) returns ParserTypeDeclResult
is
    let p1: GeneralParser = expect_kind(p, "KeywordType", "FH-PARSE-0002", "Expected 'type'")
    let res_name: ParserIdentifierResult = parse_identifier(p1)
    let p2: GeneralParser = expect_kind(res_name.parser, "KeywordIs", "FH-PARSE-0002", "Expected 'is'")

    if p2.curr_tok.kind.name = "KeywordRecord" then
        let p3: GeneralParser = expect_kind(p2, "KeywordRecord", "FH-PARSE-0002", "Expected 'record'")
        let p4: GeneralParser = expect_kind(p3, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
        let p5: GeneralParser = expect_kind(p4, "KeywordRecord", "FH-PARSE-0002", "Expected 'record'")
        let rec_node: RecordTypeNode = make_record_type_node(res_name.node.span, res_name.node)

        let dummy_span: SourceSpan = res_name.node.span
        let dummy_ident: IdentifierNode = make_identifier_node(dummy_span, "")
        let dummy_type_decl: TypeDeclNode = make_type_decl_node(dummy_span, dummy_ident, dummy_ident, "0", "0")
        return ParserTypeDeclResult { parser: p5, node: dummy_type_decl, is_record: true, record_node: rec_node }
    else
        let res_base: ParserIdentifierResult = parse_identifier(p2)
        let p3: GeneralParser = expect_kind(res_base.parser, "KeywordRange", "FH-PARSE-0002", "Expected 'range'")

        let min_tok: Token = p3.curr_tok
        let p4: GeneralParser = expect_kind(p3, "NumberLiteral", "FH-PARSE-0002", "Expected number literal")

        let p5: GeneralParser = expect_kind(p4, "DoubleDot", "FH-PARSE-0002", "Expected '..'")

        let max_tok: Token = p5.curr_tok
        let p6: GeneralParser = expect_kind(p5, "NumberLiteral", "FH-PARSE-0002", "Expected number literal")

        let min_val: String = min_tok.lexeme
        let max_val: String = max_tok.lexeme

        let type_decl: TypeDeclNode = make_type_decl_node(res_name.node.span, res_name.node, res_base.node, min_val, max_val)

        let dummy_rec: RecordTypeNode = make_record_type_node(res_name.node.span, res_name.node)
        return ParserTypeDeclResult { parser: p6, node: type_decl, is_record: false, record_node: dummy_rec }
    end if
end parse_type_decl

function parse_procedure_decl(p: GeneralParser) returns ParserProcedureResult
is
    let p1: GeneralParser = expect_kind(p, "KeywordProcedure", "FH-PARSE-0002", "Expected 'procedure'")
    let res_name: ParserIdentifierResult = parse_identifier(p1)
    let p2: GeneralParser = expect_kind(res_name.parser, "OpenParen", "FH-PARSE-0002", "Expected '('")
    let p3: GeneralParser = expect_kind(p2, "CloseParen", "FH-PARSE-0002", "Expected ')'")
    let p4: GeneralParser = expect_kind(p3, "KeywordIs", "FH-PARSE-0002", "Expected 'is'")
    let p5: GeneralParser = expect_kind(p4, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
    let res_end_name: ParserIdentifierResult = parse_identifier(p5)
    let p6: GeneralParser = res_end_name.parser

    if p6.has_error = false and res_name.node.name != res_end_name.node.name then
        let err_msg: String = String.template("procedure end name mismatch: expected ${expected}, got ${actual}", expected: res_name.node.name, actual: res_end_name.node.name)
        let err: ParseError = make_parse_error("FH-PARSE-0001", err_msg, res_end_name.node.span)
        let p_err: GeneralParser = GeneralParser {
            lexer: p6.lexer,
            curr_tok: p6.curr_tok,
            peek_tok: p6.peek_tok,
            has_error: true,
            issue: err,
            source_name: p6.source_name
        }
        let proc_node_err: ProcedureNode = make_procedure_node(res_name.node.span, res_name.node)
        return ParserProcedureResult { parser: p_err, node: proc_node_err }
    end if

    let proc_node: ProcedureNode = make_procedure_node(res_name.node.span, res_name.node)
    return ParserProcedureResult { parser: p6, node: proc_node }
end parse_procedure_decl

function parse_function_decl(p: GeneralParser, import_decl: ImportNode) returns ParserFunctionNodeResult
is
    let empty_literal_span: SourceSpan = SourceSpan { source_name: p.source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_literal: LiteralNode = make_literal_node(empty_literal_span, "", "")
    let empty_id: IdentifierNode = make_identifier_node(empty_literal_span, "")
    let empty_func_node: FunctionNode = make_function_node(empty_literal_span, empty_id, empty_id, empty_literal)

    let dummy_import_module_id: IdentifierNode = make_identifier_node(empty_literal_span, "")
    let dummy_import: ImportNode = make_import_node(empty_literal_span, dummy_import_module_id, dummy_import_module_id)
    let dummy_import_ref: ImportReferenceNode = make_import_reference_node(empty_literal_span, dummy_import, empty_id)
    let empty_func_import_ref: FunctionImportReferenceNode = make_function_import_reference_node(empty_literal_span, empty_id, empty_id, dummy_import_ref)

    let p1: GeneralParser = expect_kind(p, "KeywordFunction", "FH-PARSE-0002", "Expected 'function'")
    let res_name: ParserIdentifierResult = parse_identifier(p1)
    let p2: GeneralParser = expect_kind(res_name.parser, "OpenParen", "FH-PARSE-0002", "Expected '('")
    let p3: GeneralParser = expect_kind(p2, "CloseParen", "FH-PARSE-0002", "Expected ')'")
    let p4: GeneralParser = expect_kind(p3, "KeywordReturns", "FH-PARSE-0002", "Expected 'returns'")
    let res_ret_type: ParserIdentifierResult = parse_identifier(p4)
    let p5: GeneralParser = expect_kind(res_ret_type.parser, "KeywordIs", "FH-PARSE-0002", "Expected 'is'")
    let p6: GeneralParser = expect_kind(p5, "KeywordReturn", "FH-PARSE-0002", "Expected 'return'")

    if p6.has_error then
        return ParserFunctionNodeResult { parser: p6, is_import_ref: false, func_node: empty_func_node, func_import_ref_node: empty_func_import_ref }
    end if

    let is_imp: Boolean = false
    let literal_node: LiteralNode = empty_literal
    let func_import_ref_node: FunctionImportReferenceNode = empty_func_import_ref
    let p7: GeneralParser = p6

    if is_literal_token(p6.curr_tok) then
        let lit_kind: String = "Integer"
        if p6.curr_tok.kind.name = "StringLiteral" then
            lit_kind := "String"
        else
            if p6.curr_tok.kind.name = "DoubleLiteral" then
                lit_kind := "Double"
            end if
        end if
        literal_node := make_literal_node(p6.curr_tok.span, lit_kind, p6.curr_tok.lexeme)
        p7 := advance_parser(p6)
    else
        is_imp := true
        let res_symbol: ParserIdentifierResult = parse_identifier(p6)
        let import_ref: ImportReferenceNode = make_import_reference_node(res_symbol.node.span, import_decl, res_symbol.node)
        func_import_ref_node := make_function_import_reference_node(p.curr_tok.span, res_name.node, res_ret_type.node, import_ref)
        p7 := res_symbol.parser
    end if

    let p8: GeneralParser = expect_kind(p7, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
    let res_end_name: ParserIdentifierResult = parse_identifier(p8)
    let p9: GeneralParser = res_end_name.parser

    if p9.has_error = false and res_name.node.name != res_end_name.node.name then
        let err_msg_func_mismatch: String = String.template("function end name mismatch: expected ${expected}, got ${actual}", expected: res_name.node.name, actual: res_end_name.node.name)
        let err_func_mismatch: ParseError = make_parse_error("FH-PARSE-0001", err_msg_func_mismatch, res_end_name.node.span)
        let p_err: GeneralParser = GeneralParser {
            lexer: p9.lexer,
            curr_tok: p9.curr_tok,
            peek_tok: p9.peek_tok,
            has_error: true,
            issue: err_func_mismatch,
            source_name: p9.source_name
        }
        return ParserFunctionNodeResult { parser: p_err, is_import_ref: is_imp, func_node: empty_func_node, func_import_ref_node: empty_func_import_ref }
    end if

    if is_imp then
        return ParserFunctionNodeResult { parser: p9, is_import_ref: true, func_node: empty_func_node, func_import_ref_node: func_import_ref_node }
    else
        let f_node: FunctionNode = make_function_node(p.curr_tok.span, res_name.node, res_ret_type.node, literal_node)
        return ParserFunctionNodeResult { parser: p9, is_import_ref: false, func_node: f_node, func_import_ref_node: empty_func_import_ref }
    end if
end parse_function_decl

function parse_general_module_result(source_name: String, source: String) returns ParseResult
is
    let p: GeneralParser = init_general_parser(source_name, source)
    let res_mod_id: ParserIdentifierResult = parse_module_decl(p)
    let p_mod: GeneralParser = res_mod_id.parser
    let module_node: ModuleNode = make_module_node(res_mod_id.node.span, res_mod_id.node)

    if p_mod.has_error then
        return parse_error_result(p_mod.issue, module_node)
    end if

    let p_curr: GeneralParser = p_mod
    let has_import: Boolean = false
    let import_node: ImportNode = ImportNode { span: res_mod_id.node.span, module_name: res_mod_id.node, exposed_name: res_mod_id.node }
    let has_record: Boolean = false
    let record_node: RecordTypeNode = make_record_type_node(res_mod_id.node.span, res_mod_id.node)
    let has_procedure: Boolean = false
    let procedure_node: ProcedureNode = make_procedure_node(res_mod_id.node.span, res_mod_id.node)
    let has_function: Boolean = false
    let is_func_import_ref: Boolean = false
    let func_node: FunctionNode = FunctionNode { span: res_mod_id.node.span, name: res_mod_id.node, return_type: res_mod_id.node, return_literal: LiteralNode { span: res_mod_id.node.span, literal_kind: "", text: "" } }
    let func_imp_ref_node: FunctionImportReferenceNode = FunctionImportReferenceNode { span: res_mod_id.node.span, name: res_mod_id.node, return_type: res_mod_id.node, return_symbol: ImportReferenceNode { span: res_mod_id.node.span, import_decl: import_node, symbol_name: res_mod_id.node } }

    while p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.curr_tok.kind.name != "EOF" and p_curr.has_error = false
        invariant p_curr.has_error = false or p_curr.has_error = true
    do
        if p_curr.curr_tok.kind.name = "KeywordImport" then
            let res_imp: ParserImportResult = parse_import_decl(p_curr)
            import_node := res_imp.node
            has_import := true
            p_curr := res_imp.parser
        else
            if p_curr.curr_tok.kind.name = "KeywordType" then
                let res_type: ParserTypeDeclResult = parse_type_decl(p_curr)
                if res_type.is_record then
                    record_node := res_type.record_node
                    has_record := true
                end if
                p_curr := res_type.parser
            else
                if p_curr.curr_tok.kind.name = "KeywordProcedure" then
                    let res_proc: ParserProcedureResult = parse_procedure_decl(p_curr)
                    procedure_node := res_proc.node
                    has_procedure := true
                    p_curr := res_proc.parser
                else
                    if p_curr.curr_tok.kind.name = "KeywordFunction" then
                        let res_func: ParserFunctionNodeResult = parse_function_decl(p_curr, import_node)
                        is_func_import_ref := res_func.is_import_ref
                        func_node := res_func.func_node
                        func_imp_ref_node := res_func.func_import_ref_node
                        has_function := true
                        p_curr := res_func.parser
                    else
                        let err_msg_decl: String = String.template("Expected declaration, got ${lexeme}", lexeme: p_curr.curr_tok.lexeme)
                        let err_decl: ParseError = make_parse_error("FH-PARSE-0002", err_msg_decl, p_curr.curr_tok.span)
                        p_curr := GeneralParser {
                            lexer: p_curr.lexer,
                            curr_tok: p_curr.curr_tok,
                            peek_tok: p_curr.peek_tok,
                            has_error: true,
                            issue: err_decl,
                            source_name: p_curr.source_name
                        }
                    end if
                end if
            end if
        end if
    end while

    if p_curr.has_error then
        return parse_error_result(p_curr.issue, module_node)
    end if

    let p_end: GeneralParser = expect_kind(p_curr, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
    let res_end_name: ParserIdentifierResult = parse_identifier(p_end)
    let p_final: GeneralParser = res_end_name.parser

    if p_final.has_error then
        return parse_error_result(p_final.issue, module_node)
    end if

    if res_mod_id.node.name != res_end_name.node.name then
        let err_msg_mismatch: String = String.template("end module name mismatch: expected ${expected}, got ${actual}", expected: res_mod_id.node.name, actual: res_end_name.node.name)
        let err_mismatch: ParseError = make_parse_error("FH-PARSE-0001", err_msg_mismatch, res_end_name.node.span)
        return parse_error_result(err_mismatch, module_node)
    end if

    return parse_ok(module_node)
end parse_general_module_result

function parse_primary(p: GeneralParser) returns ParserExprResult
is
    let empty_span: SourceSpan = SourceSpan { source_name: p.source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_expr: ExprNode = make_expr_node(empty_span, "ERROR", "", "", "", -1, -1, "", -1, -1, 0, -1)
    let lit_kind: String = "Integer"
    let node_lit: ExprNode = empty_expr
    let p_next: GeneralParser = p
    let node_id: ExprNode = empty_expr
    let p1: GeneralParser = p
    let res: ParserExprResult = ParserExprResult { parser: p, node: empty_expr }
    let p2: GeneralParser = p
    let err_msg: String = ""
    let err: ParseError = ParseError { code: "", message: "", span: empty_span }
    let p_err: GeneralParser = p

    if p.has_error then
        return ParserExprResult { parser: p, node: empty_expr }
    end if

    if is_literal_token(p.curr_tok) then
        if p.curr_tok.kind.name = "StringLiteral" then
            lit_kind := "String"
        else
            if p.curr_tok.kind.name = "DoubleLiteral" then
                lit_kind := "Double"
            else
                if p.curr_tok.kind.name = "KeywordTrue" or p.curr_tok.kind.name = "KeywordFalse" then
                    lit_kind := "Boolean"
                end if
            end if
        end if
        node_lit := make_expr_node(p.curr_tok.span, "LITERAL", lit_kind, p.curr_tok.lexeme, "", -1, -1, "", -1, -1, 0, -1)
        p_next := advance_parser(p)
        return ParserExprResult { parser: p_next, node: node_lit }
    else
        if p.curr_tok.kind.name = "Identifier" then
            if p.peek_tok.kind.name = "LessThan" then
                -- Parse generic call: name<T>(args)
                let start_tok: Token = p.curr_tok
                let routine_name: String = p.curr_tok.lexeme
                let p1_gen: GeneralParser = advance_parser(p) -- past identifier
                let p2_gen: GeneralParser = expect_kind(p1_gen, "LessThan", "FH-PARSE-0002", "Expected '<'")
                if p2_gen.has_error then
                    return ParserExprResult { parser: p2_gen, node: empty_expr }
                end if

                let p_type: GeneralParser = p2_gen
                let done_type: Boolean = false
                while not done_type
                    invariant done_type = true or done_type = false
                do
                    let res_type: ParserIdentifierResult = parse_identifier(p_type)
                    if res_type.parser.has_error then
                        return ParserExprResult { parser: res_type.parser, node: empty_expr }
                    end if
                    p_type := res_type.parser
                    if p_type.curr_tok.kind.name = "Comma" then
                        p_type := advance_parser(p_type)
                    else
                        done_type := true
                    end if
                end while

                let p3_gen: GeneralParser = expect_kind(p_type, "GreaterThan", "FH-PARSE-0002", "Expected '>'")
                if p3_gen.has_error then
                    return ParserExprResult { parser: p3_gen, node: empty_expr }
                end if
                let p4_gen: GeneralParser = expect_kind(p3_gen, "OpenParen", "FH-PARSE-0002", "Expected '('")
                if p4_gen.has_error then
                    return ParserExprResult { parser: p4_gen, node: empty_expr }
                end if

                let p_arg: GeneralParser = p4_gen
                let arg_count: Integer = 0
                if p_arg.curr_tok.kind.name != "CloseParen" then
                    let done_arg: Boolean = false
                    while not done_arg
                        invariant done_arg = true or done_arg = false
                    do
                        let res_a: ParserExprResult = parse_expr(p_arg)
                        if res_a.parser.has_error then
                            return res_a
                        end if
                        p_arg := res_a.parser
                        arg_count := arg_count + 1
                        if p_arg.curr_tok.kind.name = "Comma" then
                            p_arg := advance_parser(p_arg)
                        else
                            done_arg := true
                        end if
                    end while
                end if

                let close_tok: Token = p_arg.curr_tok
                let p5_gen: GeneralParser = expect_kind(p_arg, "CloseParen", "FH-PARSE-0002", "Expected ')'")
                if p5_gen.has_error then
                    return ParserExprResult { parser: p5_gen, node: empty_expr }
                end if

                let inv_node_idx: Integer = -1
                let p_final: GeneralParser = p5_gen
                if p5_gen.curr_tok.kind.name = "KeywordWith" then
                    let p6_gen: GeneralParser = advance_parser(p5_gen)
                    let p7_gen: GeneralParser = expect_kind(p6_gen, "KeywordInvariant", "FH-PARSE-0002", "Expected 'invariant'")
                    if p7_gen.has_error then
                        return ParserExprResult { parser: p7_gen, node: empty_expr }
                    end if
                    let res_inv: ParserExprResult = parse_expr(p7_gen)
                    if res_inv.parser.has_error then
                        return res_inv
                    end if
                    inv_node_idx := 0 -- Placeholder value; to be set correctly or checked
                    p_final := res_inv.parser
                end if

                let node_span: SourceSpan = make_source_span(p.source_name, start_tok.span.start_line, start_tok.span.start_column, close_tok.span.end_line, close_tok.span.end_column)
                let call_node: ExprNode = make_expr_node(node_span, "CALL", "", "", "", 0, -1, routine_name, 0, -1, arg_count, inv_node_idx)
                return ParserExprResult { parser: p_final, node: call_node }
            else
                node_id := make_expr_node(p.curr_tok.span, "IDENTIFIER", "", p.curr_tok.lexeme, "", -1, -1, "", -1, -1, 0, -1)
                p_next := advance_parser(p)
                return ParserExprResult { parser: p_next, node: node_id }
            end if
        else
            if p.curr_tok.kind.name = "OpenParen" then
                p1 := advance_parser(p)
                res := parse_expr(p1)
                p2 := expect_kind(res.parser, "CloseParen", "FH-PARSE-0002", "Expected ')'")
                return ParserExprResult { parser: p2, node: res.node }
            else
                err_msg := String.template("Expected primary expression, got ${lexeme}", lexeme: p.curr_tok.lexeme)
                err := make_parse_error("FH-PARSE-0003", err_msg, p.curr_tok.span)
                p_err := GeneralParser {
                    lexer: p.lexer,
                    curr_tok: p.curr_tok,
                    peek_tok: p.peek_tok,
                    has_error: true,
                    issue: err,
                    source_name: p.source_name
                }
                return ParserExprResult { parser: p_err, node: empty_expr }
            end if
        end if
    end if
end parse_primary

function parse_unary(p: GeneralParser) returns ParserExprResult
is
    let empty_span: SourceSpan = SourceSpan { source_name: p.source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_expr: ExprNode = make_expr_node(empty_span, "ERROR", "", "", "", -1, -1, "", -1, -1, 0, -1)
    let op_tok: Token = p.curr_tok
    let p1: GeneralParser = p
    let res: ParserExprResult = ParserExprResult { parser: p, node: empty_expr }
    let op: String = ""
    let node_un: ExprNode = empty_expr

    if p.has_error then
        return ParserExprResult { parser: p, node: empty_expr }
    end if

    if p.curr_tok.kind.name = "KeywordAwait" or p.curr_tok.kind.name = "KeywordNot" or p.curr_tok.kind.name = "Minus" then
        op_tok := p.curr_tok
        p1 := advance_parser(p)
        res := parse_unary(p1)
        op := op_tok.lexeme
        node_un := make_expr_node(op_tok.span, "UNARY_OP", "", "", op, 0, -1, "", -1, -1, 0, -1)
        return ParserExprResult { parser: res.parser, node: node_un }
    else
        return parse_primary(p)
    end if
end parse_unary

function parse_product(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_unary(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while (p_curr.curr_tok.kind.name = "Star" or p_curr.curr_tok.kind.name = "Slash") and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_unary(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", op_tok.lexeme, 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_product

function parse_sum(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_product(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while (p_curr.curr_tok.kind.name = "Plus" or p_curr.curr_tok.kind.name = "Minus") and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_product(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", op_tok.lexeme, 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_sum

function parse_comparison(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_sum(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while (p_curr.curr_tok.kind.name = "LessThan" or p_curr.curr_tok.kind.name = "GreaterThan" or p_curr.curr_tok.kind.name = "LessThanOrEqual" or p_curr.curr_tok.kind.name = "GreaterThanOrEqual") and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_sum(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", op_tok.lexeme, 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_comparison

function parse_equality(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_comparison(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while (p_curr.curr_tok.kind.name = "Equal" or p_curr.curr_tok.kind.name = "NotEqual") and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_comparison(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", op_tok.lexeme, 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_equality

function parse_and(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_equality(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while p_curr.curr_tok.kind.name = "KeywordAnd" and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_equality(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", "and", 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_and

function parse_or(p: GeneralParser) returns ParserExprResult
is
    let res_left: ParserExprResult = parse_and(p)
    let p_curr: GeneralParser = res_left.parser
    let left_node: ExprNode = res_left.node
    let op_tok: Token = p_curr.curr_tok
    let p1: GeneralParser = p_curr
    let res_right: ParserExprResult = ParserExprResult { parser: p_curr, node: left_node }

    while p_curr.curr_tok.kind.name = "KeywordOr" and p_curr.has_error = false
        invariant p_curr.has_error = true or p_curr.has_error = false
    do
        op_tok := p_curr.curr_tok
        p1 := advance_parser(p_curr)
        res_right := parse_and(p1)
        p_curr := res_right.parser
        left_node := make_expr_node(op_tok.span, "BINARY_OP", "", "", "or", 0, 0, "", -1, -1, 0, -1)
    end while
    return ParserExprResult { parser: p_curr, node: left_node }
end parse_or

function parse_expr(p: GeneralParser) returns ParserExprResult
requires String.instr(p.curr_tok.lexeme, "") = 0, String.instr(p.curr_tok.kind.name, "") = 0
ensures result.parser.has_error = true or result.parser.has_error = false
is
    return parse_or(p)
end parse_expr

function parse_stmt(p: GeneralParser) returns ParserStmtResult
requires String.instr(p.curr_tok.lexeme, "") = 0, String.instr(p.curr_tok.kind.name, "") = 0
ensures result.parser.has_error = true or result.parser.has_error = false
is
    let empty_span: SourceSpan = SourceSpan { source_name: p.source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_stmt: StmtNode = make_stmt_node(empty_span, "ERROR", "", "", -1, -1, -1, 0, -1, 0, "", "")
    let p_let1: GeneralParser = p
    let res_var: ParserIdentifierResult = ParserIdentifierResult { parser: p, node: IdentifierNode { span: empty_span, name: "" } }
    let p_let2: GeneralParser = p
    let res_type: ParserIdentifierResult = res_var
    let p_let3: GeneralParser = p
    let res_expr: ParserExprResult = ParserExprResult { parser: p, node: ExprNode { span: empty_span, kind: "", literal_kind: "", text: "", op: "", left_node_idx: 0, right_node_idx: 0, routine_name: "", arg0_idx: 0, arg1_idx: 0, arg_count: 0, invariant_idx: -1 } }
    let node_let: StmtNode = empty_stmt
    let p_if1: GeneralParser = p
    let res_cond: ParserExprResult = res_expr
    let p_if2: GeneralParser = p
    let p_curr: GeneralParser = p
    let res_stmt: ParserStmtResult = ParserStmtResult { parser: p, node: empty_stmt }
    let p_if3: GeneralParser = p
    let p_if4: GeneralParser = p
    let node_if: StmtNode = empty_stmt
    let p_wh1: GeneralParser = p
    let res_wcond: ParserExprResult = res_expr
    let p_inv_var: GeneralParser = p
    let res_inv: ParserExprResult = res_expr
    let p_wh3: GeneralParser = p
    let p_wh4: GeneralParser = p
    let p_wh5: GeneralParser = p
    let node_wh: StmtNode = empty_stmt
    let p_ret1: GeneralParser = p
    let node_ret: StmtNode = empty_stmt
    let p_ab1: GeneralParser = p
    let res_err: ParserIdentifierResult = res_var
    let node_ab: StmtNode = empty_stmt
    let p_ch1: GeneralParser = p
    let node_ch: StmtNode = empty_stmt
    let p_cl1: GeneralParser = p
    let res_name: ParserIdentifierResult = res_var
    let p_cl2: GeneralParser = p
    let res_arg: ParserExprResult = res_expr
    let p_cl3: GeneralParser = p
    let abort_type: String = ""
    let p_cl4: GeneralParser = p
    let res_ab: ParserIdentifierResult = res_var
    let node_cl: StmtNode = empty_stmt
    let p_cs1: GeneralParser = p
    let p_cs2: GeneralParser = p
    let res_val: ParserExprResult = res_expr
    let p_arrow: GeneralParser = p
    let p_arrow2: GeneralParser = p
    let p_cs3: GeneralParser = p
    let p_cs4: GeneralParser = p
    let node_cs: StmtNode = empty_stmt
    let p_sc1: GeneralParser = p
    let p_sc2: GeneralParser = p
    let p_sc3: GeneralParser = p
    let p_sc4: GeneralParser = p
    let node_sc: StmtNode = empty_stmt
    let res_avar: ParserIdentifierResult = res_var
    let p_as1: GeneralParser = p
    let res_aexpr: ParserExprResult = res_expr
    let node_assign: StmtNode = empty_stmt
    let err_msg: String = ""
    let err: ParseError = ParseError { code: "", message: "", span: empty_span }
    let p_err: GeneralParser = p

    if p.curr_tok.kind.name = "KeywordLet" then
        p_let1 := advance_parser(p)
        res_var := parse_identifier(p_let1)
        p_let2 := expect_kind(res_var.parser, "Colon", "FH-PARSE-0002", "Expected ':'")
        res_type := parse_type_ref(p_let2)
        p_let3 := expect_kind(res_type.parser, "Equal", "FH-PARSE-0002", "Expected '='")
        res_expr := parse_expr(p_let3)
        if res_expr.parser.has_error then
            return ParserStmtResult { parser: res_expr.parser, node: empty_stmt }
        end if
        node_let := make_stmt_node(p.curr_tok.span, "LET", res_var.node.name, res_type.node.name, 0, -1, -1, 0, -1, 0, "", "")
        return ParserStmtResult { parser: res_expr.parser, node: node_let }
    else
        if p.curr_tok.kind.name = "KeywordIf" then
            p_if1 := advance_parser(p)
            res_cond := parse_expr(p_if1)
            p_if2 := expect_kind(res_cond.parser, "KeywordThen", "FH-PARSE-0002", "Expected 'then'")

            p_curr := p_if2
            while p_curr.curr_tok.kind.name != "KeywordElse" and p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                invariant p_curr.has_error = true or p_curr.has_error = false
            do
                res_stmt := parse_stmt(p_curr)
                p_curr := res_stmt.parser
            end while

            if p_curr.curr_tok.kind.name = "KeywordElse" then
                p_curr := advance_parser(p_curr)
                while p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                    invariant p_curr.has_error = true or p_curr.has_error = false
                do
                    res_stmt := parse_stmt(p_curr)
                    p_curr := res_stmt.parser
                end while
            end if

            p_if3 := expect_kind(p_curr, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
            p_if4 := expect_kind(p_if3, "KeywordIf", "FH-PARSE-0002", "Expected 'if'")
            if p_if4.has_error then
                return ParserStmtResult { parser: p_if4, node: empty_stmt }
            end if
            node_if := make_stmt_node(p.curr_tok.span, "IF", "", "", -1, 0, -1, 0, -1, 0, "", "")
            return ParserStmtResult { parser: p_if4, node: node_if }
        else
            if p.curr_tok.kind.name = "KeywordWhile" then
                p_wh1 := advance_parser(p)
                res_wcond := parse_expr(p_wh1)
                p_curr := res_wcond.parser

                while (p_curr.curr_tok.kind.name = "KeywordInvariant" or p_curr.curr_tok.kind.name = "KeywordVariant") and p_curr.has_error = false
                    invariant p_curr.has_error = true or p_curr.has_error = false
                do
                    p_inv_var := advance_parser(p_curr)
                    res_inv := parse_expr(p_inv_var)
                    p_curr := res_inv.parser
                end while

                p_wh3 := expect_kind(p_curr, "KeywordDo", "FH-PARSE-0002", "Expected 'do'")

                p_curr := p_wh3
                while p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                    invariant p_curr.has_error = true or p_curr.has_error = false
                do
                    res_stmt := parse_stmt(p_curr)
                    p_curr := res_stmt.parser
                end while

                p_wh4 := expect_kind(p_curr, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
                p_wh5 := expect_kind(p_wh4, "KeywordWhile", "FH-PARSE-0002", "Expected 'while'")
                if p_wh5.has_error then
                    return ParserStmtResult { parser: p_wh5, node: empty_stmt }
                end if
                node_wh := make_stmt_node(p.curr_tok.span, "WHILE", "", "", -1, 0, -1, 0, -1, 0, "", "")
                return ParserStmtResult { parser: p_wh5, node: node_wh }
            else
                if p.curr_tok.kind.name = "KeywordReturn" then
                    p_ret1 := advance_parser(p)
                    p_curr := p_ret1
                    if p_curr.curr_tok.kind.name = "KeywordOk" or p_curr.curr_tok.kind.name = "KeywordError" then
                        p_curr := advance_parser(p_curr)
                    end if
                    res_expr := parse_expr(p_curr)
                    if res_expr.parser.has_error then
                        return ParserStmtResult { parser: res_expr.parser, node: empty_stmt }
                    end if
                    node_ret := make_stmt_node(p.curr_tok.span, "RETURN", "", "", 0, -1, -1, 0, -1, 0, "", "")
                    return ParserStmtResult { parser: res_expr.parser, node: node_ret }
                else
                    if p.curr_tok.kind.name = "KeywordAbort" then
                        p_ab1 := advance_parser(p)
                        res_err := parse_identifier(p_ab1)
                        if res_err.parser.has_error then
                            return ParserStmtResult { parser: res_err.parser, node: empty_stmt }
                        end if
                        node_ab := make_stmt_node(p.curr_tok.span, "ABORT", "", "", -1, -1, -1, 0, -1, 0, "", res_err.node.name)
                        return ParserStmtResult { parser: res_err.parser, node: node_ab }
                    else
                        if p.curr_tok.kind.name = "KeywordCheck" then
                            p_ch1 := advance_parser(p)
                            res_expr := parse_expr(p_ch1)
                            if res_expr.parser.has_error then
                                return ParserStmtResult { parser: res_expr.parser, node: empty_stmt }
                            end if
                            node_ch := make_stmt_node(p.curr_tok.span, "CHECK", "", "", -1, 0, -1, 0, -1, 0, "", "")
                            return ParserStmtResult { parser: res_expr.parser, node: node_ch }
                        else
                            if p.curr_tok.kind.name = "KeywordCall" then
                                p_cl1 := advance_parser(p)
                                res_name := parse_identifier(p_cl1)
                                p_cl2 := expect_kind(res_name.parser, "OpenParen", "FH-PARSE-0002", "Expected '('")
                                p_curr := p_cl2
                                while p_curr.curr_tok.kind.name != "CloseParen" and p_curr.has_error = false
                                    invariant p_curr.has_error = true or p_curr.has_error = false
                                do
                                    res_arg := parse_expr(p_curr)
                                    p_curr := res_arg.parser
                                    if p_curr.curr_tok.kind.name = "Comma" then
                                        p_curr := advance_parser(p_curr)
                                    end if
                                end while
                                p_cl3 := expect_kind(p_curr, "CloseParen", "FH-PARSE-0002", "Expected ')'")
                                abort_type := ""
                                if p_cl3.curr_tok.kind.name = "KeywordAborts" then
                                    p_cl4 := advance_parser(p_cl3)
                                    res_ab := parse_identifier(p_cl4)
                                    abort_type := res_ab.node.name
                                    p_curr := res_ab.parser
                                else
                                    p_curr := p_cl3
                                end if
                                if p_curr.has_error then
                                    return ParserStmtResult { parser: p_curr, node: empty_stmt }
                                end if
                                node_cl := make_stmt_node(p.curr_tok.span, "CALL", "", "", -1, -1, -1, 0, -1, 0, res_name.node.name, abort_type)
                                return ParserStmtResult { parser: p_curr, node: node_cl }
                            else
                                if p.curr_tok.kind.name = "KeywordCase" then
                                    p_cs1 := advance_parser(p)
                                    res_expr := parse_expr(p_cs1)
                                    p_cs2 := expect_kind(res_expr.parser, "KeywordIs", "FH-PARSE-0002", "Expected 'is'")
                                    p_curr := p_cs2
                                    while p_curr.curr_tok.kind.name = "KeywordWhen" and p_curr.has_error = false
                                        invariant p_curr.has_error = true or p_curr.has_error = false
                                    do
                                        p_curr := advance_parser(p_curr)
                                        res_val := parse_expr(p_curr)
                                        p_arrow := expect_kind(res_val.parser, "CaseArrow", "FH-PARSE-0002", "Expected '=>'")
                                        p_curr := p_arrow
                                        while p_curr.curr_tok.kind.name != "KeywordWhen" and p_curr.curr_tok.kind.name != "KeywordDefault" and p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                                            invariant p_curr.has_error = true or p_curr.has_error = false
                                        do
                                            res_stmt := parse_stmt(p_curr)
                                            p_curr := res_stmt.parser
                                        end while
                                    end while
                                    if p_curr.curr_tok.kind.name = "KeywordDefault" then
                                        p_curr := advance_parser(p_curr)
                                        p_arrow2 := expect_kind(p_curr, "CaseArrow", "FH-PARSE-0002", "Expected '=>'")
                                        p_curr := p_arrow2
                                        while p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                                            invariant p_curr.has_error = true or p_curr.has_error = false
                                        do
                                            res_stmt := parse_stmt(p_curr)
                                            p_curr := res_stmt.parser
                                        end while
                                    end if
                                    p_cs3 := expect_kind(p_curr, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
                                    p_cs4 := expect_kind(p_cs3, "KeywordCase", "FH-PARSE-0002", "Expected 'case'")
                                    if p_cs4.has_error then
                                        return ParserStmtResult { parser: p_cs4, node: empty_stmt }
                                    end if
                                    node_cs := make_stmt_node(p.curr_tok.span, "CASE", "", "", -1, 0, -1, 0, -1, 0, "", "")
                                    return ParserStmtResult { parser: p_cs4, node: node_cs }
                                else
                                    if p.curr_tok.kind.name = "KeywordScope" then
                                        p_sc1 := advance_parser(p)
                                        res_name := parse_identifier(p_sc1)
                                        p_sc2 := expect_kind(res_name.parser, "KeywordDo", "FH-PARSE-0002", "Expected 'do'")
                                        p_curr := p_sc2
                                        while (p_curr.curr_tok.kind.name = "KeywordSpawn" or p_curr.curr_tok.kind.name = "KeywordJoin" or p_curr.curr_tok.kind.name = "KeywordResult") and p_curr.has_error = false
                                            invariant p_curr.has_error = true or p_curr.has_error = false
                                        do
                                            p_curr := advance_parser(p_curr)
                                            while p_curr.curr_tok.kind.name != "KeywordSpawn" and p_curr.curr_tok.kind.name != "KeywordJoin" and p_curr.curr_tok.kind.name != "KeywordResult" and p_curr.curr_tok.kind.name != "KeywordEnd" and p_curr.has_error = false
                                                invariant p_curr.has_error = true or p_curr.has_error = false
                                            do
                                                res_stmt := parse_stmt(p_curr)
                                                p_curr := res_stmt.parser
                                            end while
                                        end while
                                        p_sc3 := expect_kind(p_curr, "KeywordEnd", "FH-PARSE-0002", "Expected 'end'")
                                        p_sc4 := expect_kind(p_sc3, "KeywordScope", "FH-PARSE-0002", "Expected 'scope'")
                                        if p_sc4.has_error then
                                            return ParserStmtResult { parser: p_sc4, node: empty_stmt }
                                        end if
                                        node_sc := make_stmt_node(p.curr_tok.span, "SCOPE", "", "", -1, -1, -1, 0, -1, 0, res_name.node.name, "")
                                        return ParserStmtResult { parser: p_sc4, node: node_sc }
                                    else
                                        if p.curr_tok.kind.name = "Identifier" and (p.peek_tok.kind.name = "Assign" or p.peek_tok.kind.name = "ColonEqual") then
                                            res_avar := parse_identifier(p)
                                            p_as1 := expect_kind(res_avar.parser, p.peek_tok.kind.name, "FH-PARSE-0002", "Expected ':='")
                                            res_aexpr := parse_expr(p_as1)
                                            if res_aexpr.parser.has_error then
                                                return ParserStmtResult { parser: res_aexpr.parser, node: empty_stmt }
                                            end if
                                            node_assign := make_stmt_node(p.curr_tok.span, "ASSIGN", res_avar.node.name, "", 0, -1, -1, 0, -1, 0, "", "")
                                            return ParserStmtResult { parser: res_aexpr.parser, node: node_assign }
                                        else
                                            err_msg := String.template("Expected statement, got ${lexeme}", lexeme: p.curr_tok.lexeme)
                                            err := make_parse_error("FH-PARSE-0004", err_msg, p.curr_tok.span)
                                            p_err := GeneralParser {
                                                lexer: p.lexer,
                                                curr_tok: p.curr_tok,
                                                peek_tok: p.peek_tok,
                                                has_error: true,
                                                issue: err,
                                                source_name: p.source_name
                                            }
                                            return ParserStmtResult { parser: p_err, node: empty_stmt }
                                        end if
                                    end if
                                end if
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end if
end parse_stmt

end Compiler.Core.Parser

