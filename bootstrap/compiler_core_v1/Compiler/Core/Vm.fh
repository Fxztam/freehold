            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
            VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
        ],
        element_count: 0
    }
end get_heap_obj

function update_heap_obj(heap: VmHeap, idx: Integer, val: VmHeapObject) returns VmHeap
is
    if idx >= 0 and idx < 32 then
        let updated_objs: Array<VmHeapObject, 32> = set_heap_obj(heap.objects, idx, val)
        return VmHeap {
            objects: updated_objs,
            object_count: heap.object_count
        }
    end if
    return heap
end update_heap_obj

function get_register(frame: ActivationFrame, name: String) returns VmValue
is
    let i: Integer = frame.register_count - frame.register_count
    let regs: Array<VmRegister, 32> = frame.registers
    while i < frame.register_count invariant i >= 0 and i <= frame.register_count do
        let reg: VmRegister = regs[i]
        if reg.name = name then
            return reg.reg_value
        end if
        i := i + 1
    end while
    return VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
end get_register

function update_register(frame: ActivationFrame, name: String, val: VmValue) returns ActivationFrame
is
    let i: Integer = frame.register_count - frame.register_count
    let found: Boolean = false
    let updated_regs: Array<VmRegister, 32> = frame.registers

    let regs: Array<VmRegister, 32> = frame.registers
    while i < frame.register_count invariant i >= 0 and i <= frame.register_count do
        let reg: VmRegister = regs[i]
        if reg.name = name then
            updated_regs := set_register(updated_regs, i, VmRegister { name: name, reg_value: val })
            found := true
        end if
        i := i + 1
    end while

    if not found then
        if frame.register_count < 32 then
            updated_regs := set_register(updated_regs, frame.register_count, VmRegister { name: name, reg_value: val })
            return ActivationFrame {
                registers: updated_regs,
                register_count: frame.register_count + 1,
                current_block_label: frame.current_block_label,
                ip: frame.ip,
                return_value: frame.return_value,
                has_returned: frame.has_returned
            }
        end if
    end if

    return ActivationFrame {
        registers: updated_regs,
        register_count: frame.register_count,
        current_block_label: frame.current_block_label,
        ip: frame.ip,
        return_value: frame.return_value,
        has_returned: frame.has_returned
    }
end update_register

function check_type_range(val: VmValue, type_idx: Integer, r: IrRoutine) returns Boolean
is
    if type_idx >= 0 and type_idx < 10 then
        let rtypes: Array<IrType, 10> = r.types
        let t: IrType = rtypes[type_idx]
        if t.has_range then
            if val.kind = "INTEGER" then
                if val.int_val < t.min_value or val.int_val > t.max_value then
                    return false
                end if
            end if
        end if
    end if
    return true
end check_type_range

function execute_instruction(inst: IrInstruction, state: VmState, r: IrRoutine) returns VmState
is
    if inst.kind = "ALLOCA" then
        if inst.op = "RECORD" then
            let obj: VmHeapObject = VmHeapObject {
                kind: "RECORD",
                field_names: ["","","","","","","","","",""],
                field_values: [
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                ],
                field_count: 0,
                elements: [
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                ],
                element_count: 0
            }
            let res: AllocResult = allocate_object(state.heap, obj)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "REF", int_val: 0, bool_val: false, str_val: "", ref_val: res.ref_idx })
            return VmState { heap: res.heap, frame: new_frame }
        else
            if inst.op = "ARRAY" then
                let obj: VmHeapObject = VmHeapObject {
                    kind: "ARRAY",
                    field_names: ["","","","","","","","","",""],
                    field_values: [
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    ],
                    field_count: 0,
                    elements: [
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                        VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    ],
                    element_count: 32
                }
                let res: AllocResult = allocate_object(state.heap, obj)
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "REF", int_val: 0, bool_val: false, str_val: "", ref_val: res.ref_idx })
                return VmState { heap: res.heap, frame: new_frame }
            else
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            end if
        end if
    end if

    if inst.kind = "GET_ELEMENT_PTR" then
        let base: VmValue = get_register(state.frame, inst.src_reg_left)
        if base.kind = "REF" then
            if inst.field_name != "" then
                let ptr: VmValue = VmValue { kind: "PTR", int_val: -1, bool_val: false, str_val: inst.field_name, ref_val: base.ref_val }
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, ptr)
                return VmState { heap: state.heap, frame: new_frame }
            else
                if inst.index_reg != "" then
                    let idx_val: VmValue = get_register(state.frame, inst.index_reg)
                    let base_obj: VmHeapObject = get_heap_obj(state.heap, base.ref_val)
                    if idx_val.int_val < 0 or idx_val.int_val >= base_obj.element_count then
                        call Std.IO.logf("RUNTIME ERROR: Array index out of bounds: index ${} is out of bounds for array of size ${}", idx_val.int_val, base_obj.element_count)
                        let error_frame: ActivationFrame = state.frame
                        error_frame.has_returned := true
                        error_frame.ip := 999999
                        return VmState { heap: state.heap, frame: error_frame }
                    end if
                    let ptr: VmValue = VmValue { kind: "PTR", int_val: idx_val.int_val, bool_val: false, str_val: "", ref_val: base.ref_val }
                    let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, ptr)
                    return VmState { heap: state.heap, frame: new_frame }
                end if
            end if
        end if
        return state
    end if

    if inst.kind = "LOAD" then
        let src_val: VmValue = get_register(state.frame, inst.src_reg_left)
        if src_val.kind = "PTR" then
            let obj: VmHeapObject = get_heap_obj(state.heap, src_val.ref_val)
            let loaded: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
            if src_val.str_val != "" then
                loaded := get_heap_field(obj, src_val.str_val)
            else
                if src_val.int_val >= 0 then
                    if src_val.int_val >= obj.element_count then
                        call Std.IO.logf("RUNTIME ERROR: Array index out of bounds: index ${} is out of bounds for array of size ${}", src_val.int_val, obj.element_count)
                        let error_frame: ActivationFrame = state.frame
                        error_frame.has_returned := true
                        error_frame.ip := 999999
                        return VmState { heap: state.heap, frame: error_frame }
                    end if
                    loaded := get_heap_element(obj, src_val.int_val)
                end if
            end if
            if not check_type_range(loaded, inst.type_idx, r) then
                let rtypes: Array<IrType, 10> = r.types
                let t: IrType = rtypes[inst.type_idx]
                call Std.IO.logf("RUNTIME ERROR: Value ${} is out of bounds for subtype ${} (range ${}..${})", loaded.int_val, t.name, t.min_value, t.max_value)
                let error_frame: ActivationFrame = state.frame
                error_frame.has_returned := true
                error_frame.ip := 999999
                return VmState { heap: state.heap, frame: error_frame }
            end if
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, loaded)
            return VmState { heap: state.heap, frame: new_frame }
        else
            if not check_type_range(src_val, inst.type_idx, r) then
                let rtypes: Array<IrType, 10> = r.types
                let t: IrType = rtypes[inst.type_idx]
                call Std.IO.logf("RUNTIME ERROR: Value ${} is out of bounds for subtype ${} (range ${}..${})", src_val.int_val, t.name, t.min_value, t.max_value)
                let error_frame: ActivationFrame = state.frame
                error_frame.has_returned := true
                error_frame.ip := 999999
                return VmState { heap: state.heap, frame: error_frame }
            end if
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, src_val)
            return VmState { heap: state.heap, frame: new_frame }
        end if
    end if

    if inst.kind = "STORE" then
        let val: VmValue = get_register(state.frame, inst.src_reg_left)
        let dest_val: VmValue = get_register(state.frame, inst.dest_reg)
        if not check_type_range(val, inst.type_idx, r) then
            let rtypes: Array<IrType, 10> = r.types
            let t: IrType = rtypes[inst.type_idx]
            call Std.IO.logf("RUNTIME ERROR: Value ${} is out of bounds for subtype ${} (range ${}..${})", val.int_val, t.name, t.min_value, t.max_value)
            let error_frame: ActivationFrame = state.frame
            error_frame.has_returned := true
            error_frame.ip := 999999
            return VmState { heap: state.heap, frame: error_frame }
        end if
        if dest_val.kind = "PTR" then
            let obj: VmHeapObject = get_heap_obj(state.heap, dest_val.ref_val)
            let updated_obj: VmHeapObject = obj
            if dest_val.str_val != "" then
                updated_obj := set_heap_field(obj, dest_val.str_val, val)
            else
                if dest_val.int_val >= 0 then
                    if dest_val.int_val >= obj.element_count then
                        call Std.IO.logf("RUNTIME ERROR: Array index out of bounds: index ${} is out of bounds for array of size ${}", dest_val.int_val, obj.element_count)
                        let error_frame: ActivationFrame = state.frame
                        error_frame.has_returned := true
                        error_frame.ip := 999999
                        return VmState { heap: state.heap, frame: error_frame }
                    end if
                    updated_obj := set_heap_element(obj, dest_val.int_val, val)
                end if
            end if
            let new_heap: VmHeap = update_heap_obj(state.heap, dest_val.ref_val, updated_obj)
            return VmState { heap: new_heap, frame: state.frame }
        else
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, val)
            return VmState { heap: state.heap, frame: new_frame }
        end if
    end if

    if inst.kind = "ASSIGN" then
        let val: VmValue = parse_literal(inst.literal_value)
        if not check_type_range(val, inst.type_idx, r) then
            let rtypes: Array<IrType, 10> = r.types
            let t: IrType = rtypes[inst.type_idx]
            call Std.IO.logf("RUNTIME ERROR: Value ${} is out of bounds for subtype ${} (range ${}..${})", val.int_val, t.name, t.min_value, t.max_value)
            let error_frame: ActivationFrame = state.frame
            error_frame.has_returned := true
            error_frame.ip := 999999
            return VmState { heap: state.heap, frame: error_frame }
        end if
        let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, val)
        return VmState { heap: state.heap, frame: new_frame }
    end if

    if inst.kind = "BINARY_OP" then
        let left: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
        if inst.src_reg_left != "" then
            left := get_register(state.frame, inst.src_reg_left)
        else
            if inst.literal_value != "" then
                left := parse_literal(inst.literal_value)
            end if
        end if

        let right: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
        if inst.src_reg_right != "" then
            right := get_register(state.frame, inst.src_reg_right)
        else
            if inst.literal_value != "" then
                right := parse_literal(inst.literal_value)
            end if
        end if

        let val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }

        if left.kind = "DOUBLE" or right.kind = "DOUBLE" then
            let l_dbl: Double = 0.0
            if left.kind = "DOUBLE" then
                l_dbl := parse_double(left.str_val)
            else
                l_dbl := to_double(left.int_val)
            end if

            let r_dbl: Double = 0.0
            if right.kind = "DOUBLE" then
                r_dbl := parse_double(right.str_val)
            else
                r_dbl := to_double(right.int_val)
            end if

            if inst.op = "+" then
                val := VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: l_dbl + r_dbl), ref_val: -1 }
            end if
            if inst.op = "-" then
                val := VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: l_dbl - r_dbl), ref_val: -1 }
            end if
            if inst.op = "*" then
                val := VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: l_dbl * r_dbl), ref_val: -1 }
            end if
            if inst.op = "/" then
                val := VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: l_dbl / r_dbl), ref_val: -1 }
            end if
            if inst.op = "<" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl < r_dbl, str_val: "", ref_val: -1 }
            end if
            if inst.op = "<=" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl <= r_dbl, str_val: "", ref_val: -1 }
            end if
            if inst.op = ">" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl > r_dbl, str_val: "", ref_val: -1 }
            end if
            if inst.op = ">=" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl >= r_dbl, str_val: "", ref_val: -1 }
            end if
            if inst.op = "=" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl = r_dbl, str_val: "", ref_val: -1 }
            end if
            if inst.op = "<>" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: l_dbl != r_dbl, str_val: "", ref_val: -1 }
            end if
        else
            if inst.op = "+" then
                val := VmValue { kind: "INTEGER", int_val: left.int_val + right.int_val, bool_val: false, str_val: "", ref_val: -1 }
            end if
            if inst.op = "-" then
                val := VmValue { kind: "INTEGER", int_val: left.int_val - right.int_val, bool_val: false, str_val: "", ref_val: -1 }
            end if
            if inst.op = "*" then
                val := VmValue { kind: "INTEGER", int_val: left.int_val * right.int_val, bool_val: false, str_val: "", ref_val: -1 }
            end if
            if inst.op = "/" then
                val := VmValue { kind: "INTEGER", int_val: left.int_val / right.int_val, bool_val: false, str_val: "", ref_val: -1 }
            end if
            if inst.op = "<" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.int_val < right.int_val, str_val: "", ref_val: -1 }
            end if
            if inst.op = "<=" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.int_val <= right.int_val, str_val: "", ref_val: -1 }
            end if
            if inst.op = ">" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.int_val > right.int_val, str_val: "", ref_val: -1 }
            end if
            if inst.op = ">=" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.int_val >= right.int_val, str_val: "", ref_val: -1 }
            end if
            if inst.op = "=" then
                let is_eq: Boolean = false
                if left.kind = "INTEGER" then is_eq := left.int_val = right.int_val end if
                if left.kind = "BOOLEAN" then is_eq := left.bool_val = right.bool_val end if
                if left.kind = "STRING" or left.kind = "BIG_INT" or left.kind = "BIG_FLOAT" then
                    is_eq := left.str_val = right.str_val
                end if
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: is_eq, str_val: "", ref_val: -1 }
            end if
            if inst.op = "<>" then
                let is_neq: Boolean = false
                if left.kind = "INTEGER" then is_neq := left.int_val != right.int_val end if
                if left.kind = "BOOLEAN" then is_neq := left.bool_val != right.bool_val end if
                if left.kind = "STRING" or left.kind = "BIG_INT" or left.kind = "BIG_FLOAT" then
                    is_neq := left.str_val != right.str_val
                end if
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: is_neq, str_val: "", ref_val: -1 }
            end if
            if inst.op = "and" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.bool_val and right.bool_val, str_val: "", ref_val: -1 }
            end if
            if inst.op = "or" then
                val := VmValue { kind: "BOOLEAN", int_val: 0, bool_val: left.bool_val or right.bool_val, str_val: "", ref_val: -1 }
            end if
        end if

        if not check_type_range(val, inst.type_idx, r) then
            let rtypes: Array<IrType, 10> = r.types
            let t: IrType = rtypes[inst.type_idx]
            call Std.IO.logf("RUNTIME ERROR: Value ${} is out of bounds for subtype ${} (range ${}..${})", val.int_val, t.name, t.min_value, t.max_value)
            let error_frame: ActivationFrame = state.frame
            error_frame.has_returned := true
            error_frame.ip := 999999
            return VmState { heap: state.heap, frame: error_frame }
        end if

        let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, val)
        return VmState { heap: state.heap, frame: new_frame }
    end if

    if inst.kind = "CALL_HOST" then
        if inst.op = "" then
            let val: VmValue = parse_literal(inst.literal_value)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, val)
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Std.IO.log" or inst.op = "Std.IO.println" or inst.op = "Std.IO.print" then
            let arg_val: VmValue = get_register(state.frame, inst.src_reg_left)
            let msg: String = ""
            if arg_val.kind = "STRING" then msg := arg_val.str_val end if
            if arg_val.kind = "INTEGER" then msg := String.template("${v}", v: arg_val.int_val) end if
            if arg_val.kind = "DOUBLE" or arg_val.kind = "BIG_INT" or arg_val.kind = "BIG_FLOAT" then msg := arg_val.str_val end if
            if arg_val.kind = "BOOLEAN" then
                if arg_val.bool_val then msg := "true" else msg := "false" end if
            end if
            call Std.IO.log(msg)
            return state
        end if

        -- Math functions
        if inst.op = "Math.sin" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Double = Math.sin(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.cos" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Double = Math.cos(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.tan" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Double = Math.tan(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.sqrt" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Double = Math.sqrt(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.pow" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: Double = Math.pow(parse_double(left.str_val), parse_double(right.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.floor" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Integer = Math.floor(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.ceil" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Integer = Math.ceil(parse_double(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Math.abs" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            if arg.kind = "INTEGER" then
                let val: Integer = arg.int_val
                if val < 0 then val := -val end if
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            else
                let val: Double = Math.abs(parse_double(arg.str_val))
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            end if
        end if
        if inst.op = "Math.min" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            if left.kind = "INTEGER" and right.kind = "INTEGER" then
                let val: Integer = left.int_val
                if right.int_val < val then val := right.int_val end if
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            else
                let val: Double = Math.min(parse_double(left.str_val), parse_double(right.str_val))
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            end if
        end if
        if inst.op = "Math.max" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            if left.kind = "INTEGER" and right.kind = "INTEGER" then
                let val: Integer = left.int_val
                if right.int_val > val then val := right.int_val end if
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            else
                let val: Double = Math.max(parse_double(left.str_val), parse_double(right.str_val))
                let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: String.template("${v}", v: val), ref_val: -1 })
                return VmState { heap: state.heap, frame: new_frame }
            end if
        end if

        -- Big library functions
        if inst.op = "Big.int" or inst.op = "Big.integer" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigInteger = Big.int(arg.str_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.fromInteger" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigInteger = Big.fromInteger(arg.int_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.float" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigFloat = Big.float(left.str_val, right.int_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: right.int_val, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.floatFromInteger" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigFloat = Big.floatFromInteger(Big.int(left.str_val), right.int_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: right.int_val, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.addInt" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigInteger = Big.addInt(Big.int(left.str_val), Big.int(right.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.subInt" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigInteger = Big.subInt(Big.int(left.str_val), Big.int(right.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.mulInt" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigInteger = Big.mulInt(Big.int(left.str_val), Big.int(right.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.divInt" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: BigInteger = Big.divInt(Big.int(left.str_val), Big.int(right.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.negInt" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigInteger = Big.negInt(Big.int(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.absInt" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigInteger = Big.absInt(Big.int(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_INT", int_val: 0, bool_val: false, str_val: Big.toString(val), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.signInt" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Integer = Big.signInt(Big.int(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.toString" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: String = Big.toString(Big.int(arg.str_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "STRING", int_val: 0, bool_val: false, str_val: val, ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.addFloat" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let prec: Integer = left.int_val
            if right.int_val > prec then prec := right.int_val end if
            let val: BigFloat = Big.addFloat(Big.float(left.str_val, left.int_val), Big.float(right.str_val, right.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: prec, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.subFloat" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let prec: Integer = left.int_val
            if right.int_val > prec then prec := right.int_val end if
            let val: BigFloat = Big.subFloat(Big.float(left.str_val, left.int_val), Big.float(right.str_val, right.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: prec, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.mulFloat" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let prec: Integer = left.int_val
            if right.int_val > prec then prec := right.int_val end if
            let val: BigFloat = Big.mulFloat(Big.float(left.str_val, left.int_val), Big.float(right.str_val, right.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: prec, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.divFloat" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let prec: Integer = left.int_val
            if right.int_val > prec then prec := right.int_val end if
            let val: BigFloat = Big.divFloat(Big.float(left.str_val, left.int_val), Big.float(right.str_val, right.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: prec, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.sqrt" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigFloat = Big.sqrt(Big.float(arg.str_val, arg.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: arg.int_val, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.absFloat" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: BigFloat = Big.absFloat(Big.float(arg.str_val, arg.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "BIG_FLOAT", int_val: arg.int_val, bool_val: false, str_val: Big.format(val, 50), ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.signFloat" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Integer = Big.signFloat(Big.float(arg.str_val, arg.int_val))
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "Big.format" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: String = Big.format(Big.float(left.str_val, left.int_val), right.int_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "STRING", int_val: 0, bool_val: false, str_val: val, ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if

        -- String functions
        if inst.op = "String.length" then
            let arg: VmValue = get_register(state.frame, inst.src_reg_left)
            let val: Integer = String.length(arg.str_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "String.concat" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: String = String.concat(left.str_val, right.str_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "STRING", int_val: 0, bool_val: false, str_val: val, ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
        if inst.op = "String.instr" then
            let left: VmValue = get_register(state.frame, inst.src_reg_left)
            let right: VmValue = get_register(state.frame, inst.src_reg_right)
            let val: Integer = String.instr(left.str_val, right.str_val)
            let new_frame: ActivationFrame = update_register(state.frame, inst.dest_reg, VmValue { kind: "INTEGER", int_val: val, bool_val: false, str_val: "", ref_val: -1 })
            return VmState { heap: state.heap, frame: new_frame }
        end if
    end if

    if inst.kind = "CHECK" then
        let cond: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
        if inst.src_reg_left != "" then
            cond := get_register(state.frame, inst.src_reg_left)
        else
            if inst.literal_value != "" then
                cond := parse_literal(inst.literal_value)
            end if
        end if
        if cond.kind != "BOOLEAN" or cond.bool_val = false then
            call Std.IO.logf("RUNTIME ERROR: Assertion failed (CHECK instruction failed)")
            let error_frame: ActivationFrame = state.frame
            error_frame.has_returned := true
            error_frame.ip := 999999
            return VmState { heap: state.heap, frame: error_frame }
        end if
        return state
    end if

    return state
end execute_instruction

function execute_routine(
    routine: IrRoutine,
    initial_state: VmState
) returns VmState
is
    let state: VmState = initial_state

    let current_label: String = "entry"
    let has_jumped: Boolean = true

    while has_jumped invariant has_jumped or not has_jumped do
        has_jumped := false

        let block_idx: Integer = routine.block_count - routine.block_count - 1
        let k: Integer = routine.block_count - routine.block_count
        let rblocks: Array<IrBasicBlock, 32> = routine.blocks
        while k < routine.block_count invariant k >= 0 and k <= routine.block_count do
            let blk: IrBasicBlock = rblocks[k]
            if blk.label = current_label then
                block_idx := k
            end if
            k := k + 1
        end while

        if block_idx >= 0 then
            let blk: IrBasicBlock = rblocks[block_idx]

            let i: Integer = blk.instruction_count - blk.instruction_count
            let binsts: Array<IrInstruction, 64> = blk.instructions
            while i < blk.instruction_count invariant i >= 0 and i <= blk.instruction_count do
                let inst: IrInstruction = binsts[i]
                state := execute_instruction(inst, state, routine)
                i := i + 1
            end while

            if blk.terminator_kind = "RETURN" then
                let ret_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                if blk.return_reg != "" then
                    ret_val := get_register(state.frame, blk.return_reg)
                end if
                state := VmState {
                    heap: state.heap,
                    frame: ActivationFrame {
                        registers: state.frame.registers,
                        register_count: state.frame.register_count,
                        current_block_label: "",
                        ip: 0,
                        return_value: ret_val,
                        has_returned: true
                    }
                }
            else
                if blk.terminator_kind = "JUMP" then
                    current_label := blk.target_block_label
                    has_jumped := true
                else
                    if blk.terminator_kind = "BRANCH_COND" then
                        let cond_val: VmValue = get_register(state.frame, blk.return_reg)
                        if cond_val.bool_val then
                            current_label := blk.true_block_label
                        else
                            current_label := blk.false_block_label
                        end if
                        has_jumped := true
                    end if
                end if
            end if
        end if
    end while

    return state
end execute_routine

type VmTask is record
    id: Integer
    routine: IrRoutine
    frame: ActivationFrame
    stack: Array<ActivationFrame, 8>
    stack_pointer: Integer
    routine_stack: Array<IrRoutine, 8>
    caller_dest_reg_stack: Array<String, 8>
    status: String           -- "READY", "BLOCKED", "DONE", "FREE"
    blocked_on_channel: Integer
    blocked_on_join: Integer
    blocked_reg: String
    blocked_val: VmValue
end record

function set_frame_stack(arr: Array<ActivationFrame, 8>, idx: Integer, val: ActivationFrame) returns Array<ActivationFrame, 8>
is
    let i0: ActivationFrame = arr[0]
    let i1: ActivationFrame = arr[1]
    let i2: ActivationFrame = arr[2]
    let i3: ActivationFrame = arr[3]
    let i4: ActivationFrame = arr[4]
    let i5: ActivationFrame = arr[5]
    let i6: ActivationFrame = arr[6]
    let i7: ActivationFrame = arr[7]

    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if

    return [ i0, i1, i2, i3, i4, i5, i6, i7 ]
end set_frame_stack

function set_routine_stack(arr: Array<IrRoutine, 8>, idx: Integer, val: IrRoutine) returns Array<IrRoutine, 8>
is
    let i0: IrRoutine = arr[0]
    let i1: IrRoutine = arr[1]
    let i2: IrRoutine = arr[2]
    let i3: IrRoutine = arr[3]
    let i4: IrRoutine = arr[4]
    let i5: IrRoutine = arr[5]
    let i6: IrRoutine = arr[6]
    let i7: IrRoutine = arr[7]

    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if

    return [ i0, i1, i2, i3, i4, i5, i6, i7 ]
end set_routine_stack

function set_string_stack(arr: Array<String, 8>, idx: Integer, val: String) returns Array<String, 8>
is
    let i0: String = arr[0]
    let i1: String = arr[1]
    let i2: String = arr[2]
    let i3: String = arr[3]
    let i4: String = arr[4]
    let i5: String = arr[5]
    let i6: String = arr[6]
    let i7: String = arr[7]

    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if

    return [ i0, i1, i2, i3, i4, i5, i6, i7 ]
end set_string_stack


type MultiTaskResult is record
    heap: VmHeap
    tasks: Array<VmTask, 16>
    task_count: Integer
    yielded: Boolean
end record


function set_task(arr: Array<VmTask, 16>, idx: Integer, val: VmTask) returns Array<VmTask, 16>
is
    let i0: VmTask = arr[0]
    let i1: VmTask = arr[1]
    let i2: VmTask = arr[2]
    let i3: VmTask = arr[3]
    let i4: VmTask = arr[4]
    let i5: VmTask = arr[5]
    let i6: VmTask = arr[6]
    let i7: VmTask = arr[7]
    let i8: VmTask = arr[8]
    let i9: VmTask = arr[9]
    let i10: VmTask = arr[10]
    let i11: VmTask = arr[11]
    let i12: VmTask = arr[12]
    let i13: VmTask = arr[13]
    let i14: VmTask = arr[14]
    let i15: VmTask = arr[15]

    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    if idx = 8 then i8 := val end if
    if idx = 9 then i9 := val end if
    if idx = 10 then i10 := val end if
    if idx = 11 then i11 := val end if
    if idx = 12 then i12 := val end if
    if idx = 13 then i13 := val end if
    if idx = 14 then i14 := val end if
    if idx = 15 then i15 := val end if

    return [
        i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15
    ]
end set_task

function execute_instruction_multitask(
    inst: IrInstruction,
    task_idx: Integer,
    heap: VmHeap,
    tasks: Array<VmTask, 16>,
    task_count: Integer,
    routines: Array<IrRoutine, 10>,
    routine_count: Integer
) returns MultiTaskResult
is
    let task: VmTask = tasks[task_idx]

    if inst.kind = "CALL" or inst.kind = "CALL_HOST" then
        if inst.op = "channel" then
            let capacity_val: VmValue = get_register(task.frame, inst.src_reg_left)
            let capacity: Integer = capacity_val.int_val
            let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
            let ch_obj: VmHeapObject = VmHeapObject {
                kind: "CHANNEL",
                field_names: [
                    "capacity", "count", "", "", "", "", "", "", "", ""
                ],
                field_values: [
                    VmValue { kind: "INTEGER", int_val: capacity, bool_val: false, str_val: "", ref_val: -1 },
                    VmValue { kind: "INTEGER", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val
                ],
                field_count: 2,
                elements: [
                    empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val,
                    empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val,
                    empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val,
                    empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val, empty_val
                ],
                element_count: 0
            }
            let alloc_res: AllocResult = allocate_object(heap, ch_obj)
            let new_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, VmValue { kind: "REF", int_val: alloc_res.ref_idx, bool_val: false, str_val: "", ref_val: alloc_res.ref_idx })
            let new_task: VmTask = VmTask {
                id: task.id,
                routine: task.routine,
                frame: new_frame,
                stack: task.stack,
                stack_pointer: task.stack_pointer,
                routine_stack: task.routine_stack,
                caller_dest_reg_stack: task.caller_dest_reg_stack,
                status: task.status,
                blocked_on_channel: task.blocked_on_channel,
                blocked_on_join: task.blocked_on_join,
                blocked_reg: task.blocked_reg,
                blocked_val: task.blocked_val
            }
            let new_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_task)
            return MultiTaskResult { heap: alloc_res.heap, tasks: new_tasks, task_count: task_count, yielded: false }
        end if

        if inst.op = "channel_sender" or inst.op = "channel_receiver" then
            let ch_ref: VmValue = get_register(task.frame, inst.src_reg_left)
            let new_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, ch_ref)
            let new_task: VmTask = VmTask {
                id: task.id,
                routine: task.routine,
                frame: new_frame,
                stack: task.stack,
                stack_pointer: task.stack_pointer,
                routine_stack: task.routine_stack,
                caller_dest_reg_stack: task.caller_dest_reg_stack,
                status: task.status,
                blocked_on_channel: task.blocked_on_channel,
                blocked_on_join: task.blocked_on_join,
                blocked_reg: task.blocked_reg,
                blocked_val: task.blocked_val
            }
            let new_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_task)
            return MultiTaskResult { heap: heap, tasks: new_tasks, task_count: task_count, yielded: false }
        end if

        if inst.op = "channel_send" then
            let chan_ref_val: VmValue = get_register(task.frame, inst.src_reg_left)
            let chan_ref: Integer = chan_ref_val.ref_val
            let val_to_send: VmValue = get_register(task.frame, inst.src_reg_right)

            let found_reader_idx: Integer = -1
            let j: Integer = 0
            while j < task_count invariant j >= 0 and j <= task_count do
                let t_other: VmTask = tasks[j]
                if t_other.status = "BLOCKED" and t_other.blocked_on_channel = chan_ref and t_other.blocked_reg != "" then
                    found_reader_idx := j
                end if
                j := j + 1
            end while

            if found_reader_idx >= 0 then
                let t_reader: VmTask = tasks[found_reader_idx]
                let r_frame: ActivationFrame = update_register(t_reader.frame, t_reader.blocked_reg, val_to_send)
                let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                let new_reader: VmTask = VmTask {
                    id: t_reader.id,
                    routine: t_reader.routine,
                    frame: r_frame,
                    stack: t_reader.stack,
                    stack_pointer: t_reader.stack_pointer,
                    routine_stack: t_reader.routine_stack,
                    caller_dest_reg_stack: t_reader.caller_dest_reg_stack,
                    status: "READY",
                    blocked_on_channel: -1,
                    blocked_on_join: t_reader.blocked_on_join,
                    blocked_reg: "",
                    blocked_val: empty_val
                }
                let next_tasks: Array<VmTask, 16> = set_task(tasks, found_reader_idx, new_reader)

                let s_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, VmValue { kind: "BOOLEAN", int_val: 0, bool_val: true, str_val: "", ref_val: -1 })
                let new_sender: VmTask = VmTask {
                    id: task.id,
                    routine: task.routine,
                    frame: s_frame,
                    stack: task.stack,
                    stack_pointer: task.stack_pointer,
                    routine_stack: task.routine_stack,
                    caller_dest_reg_stack: task.caller_dest_reg_stack,
                    status: task.status,
                    blocked_on_channel: task.blocked_on_channel,
                    blocked_on_join: task.blocked_on_join,
                    blocked_reg: task.blocked_reg,
                    blocked_val: task.blocked_val
                }
                next_tasks := set_task(next_tasks, task_idx, new_sender)
                return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: false }
            else
                let heap_objs: Array<VmHeapObject, 32> = heap.objects
                let ch_obj: VmHeapObject = heap_objs[chan_ref]
                let fvals: Array<VmValue, 10> = ch_obj.field_values
                let cap_val: VmValue = fvals[0]
                let capacity: Integer = cap_val.int_val
                let cnt_val: VmValue = fvals[1]
                let count: Integer = cnt_val.int_val

                if count < capacity then
                    let new_elements: Array<VmValue, 32> = set_value_32(ch_obj.elements, count, val_to_send)
                    let count_val: VmValue = VmValue { kind: "INTEGER", int_val: count + 1, bool_val: false, str_val: "", ref_val: -1 }
                    let new_field_values: Array<VmValue, 10> = set_value_10(ch_obj.field_values, 1, count_val)
                    let new_ch_obj: VmHeapObject = VmHeapObject {
                        kind: "CHANNEL",
                        field_names: ch_obj.field_names,
                        field_values: new_field_values,
                        field_count: ch_obj.field_count,
                        elements: new_elements,
                        element_count: count + 1
                    }
                    let next_heap_objs: Array<VmHeapObject, 32> = set_heap_obj(heap.objects, chan_ref, new_ch_obj)
                    let next_heap: VmHeap = VmHeap { objects: next_heap_objs, object_count: heap.object_count }

                    let s_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, VmValue { kind: "BOOLEAN", int_val: 0, bool_val: true, str_val: "", ref_val: -1 })
                    let new_sender: VmTask = VmTask {
                        id: task.id,
                        routine: task.routine,
                        frame: s_frame,
                        stack: task.stack,
                        stack_pointer: task.stack_pointer,
                        routine_stack: task.routine_stack,
                        caller_dest_reg_stack: task.caller_dest_reg_stack,
                        status: task.status,
                        blocked_on_channel: task.blocked_on_channel,
                        blocked_on_join: task.blocked_on_join,
                        blocked_reg: task.blocked_reg,
                        blocked_val: task.blocked_val
                    }
                    let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_sender)
                    return MultiTaskResult { heap: next_heap, tasks: next_tasks, task_count: task_count, yielded: false }
                else
                    let new_sender: VmTask = VmTask {
                        id: task.id,
                        routine: task.routine,
                        frame: task.frame,
                        stack: task.stack,
                        stack_pointer: task.stack_pointer,
                        routine_stack: task.routine_stack,
                        caller_dest_reg_stack: task.caller_dest_reg_stack,
                        status: "BLOCKED",
                        blocked_on_channel: chan_ref,
                        blocked_on_join: task.blocked_on_join,
                        blocked_reg: inst.dest_reg,
                        blocked_val: val_to_send
                    }
                    let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_sender)
                    return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: true }
                end if
            end if
        end if

        if inst.op = "channel_receive" then
            let chan_ref_val: VmValue = get_register(task.frame, inst.src_reg_left)
            let chan_ref: Integer = chan_ref_val.ref_val
            let heap_objs: Array<VmHeapObject, 32> = heap.objects
            let ch_obj: VmHeapObject = heap_objs[chan_ref]
            let fvals: Array<VmValue, 10> = ch_obj.field_values
            let cnt_val: VmValue = fvals[1]
            let count: Integer = cnt_val.int_val

            if count > 0 then
                let ch_elements: Array<VmValue, 32> = ch_obj.elements
                let val_received: VmValue = ch_elements[0]

                -- Shift remaining elements
                let next_elements: Array<VmValue, 32> = ch_obj.elements
                let k: Integer = 0
                while k < count - 1 invariant k >= 0 and k <= count do
                    next_elements := set_value_32(next_elements, k, ch_elements[k + 1])
                    k := k + 1
                end while

                let count_val: VmValue = VmValue { kind: "INTEGER", int_val: count - 1, bool_val: false, str_val: "", ref_val: -1 }
                let new_field_values: Array<VmValue, 10> = set_value_10(ch_obj.field_values, 1, count_val)
                let new_ch_obj: VmHeapObject = VmHeapObject {
                    kind: "CHANNEL",
                    field_names: ch_obj.field_names,
                    field_values: new_field_values,
                    field_count: ch_obj.field_count,
                    elements: next_elements,
                    element_count: count - 1
                }
                let next_heap_objs: Array<VmHeapObject, 32> = set_heap_obj(heap.objects, chan_ref, new_ch_obj)
                let next_heap: VmHeap = VmHeap { objects: next_heap_objs, object_count: heap.object_count }

                -- Check for blocked writers
                let found_writer_idx: Integer = -1
                let j: Integer = 0
                while j < task_count invariant j >= 0 and j <= task_count do
                    let t_other: VmTask = tasks[j]
                    if t_other.status = "BLOCKED" and t_other.blocked_on_channel = chan_ref and t_other.blocked_val.kind != "NONE" then
                        found_writer_idx := j
                    end if
                    j := j + 1
                end while

                let next_tasks: Array<VmTask, 16> = tasks
                if found_writer_idx >= 0 then
                    let t_writer: VmTask = tasks[found_writer_idx]
                    -- Append writer's value to channel
                    next_elements := set_value_32(next_elements, count - 1, t_writer.blocked_val)
                    count_val := VmValue { kind: "INTEGER", int_val: count, bool_val: false, str_val: "", ref_val: -1 }
                    new_field_values := set_value_10(ch_obj.field_values, 1, count_val)
                    new_ch_obj := VmHeapObject {
                        kind: "CHANNEL",
                        field_names: ch_obj.field_names,
                        field_values: new_field_values,
                        field_count: ch_obj.field_count,
                        elements: next_elements,
                        element_count: count
                    }
                    next_heap_objs := set_heap_obj(next_heap.objects, chan_ref, new_ch_obj)
                    next_heap := VmHeap { objects: next_heap_objs, object_count: heap.object_count }

                    -- Wake up writer
                    let w_frame: ActivationFrame = update_register(t_writer.frame, t_writer.blocked_reg, VmValue { kind: "BOOLEAN", int_val: 0, bool_val: true, str_val: "", ref_val: -1 })
                    let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    let new_writer: VmTask = VmTask {
                        id: t_writer.id,
                        routine: t_writer.routine,
                        frame: w_frame,
                        stack: t_writer.stack,
                        stack_pointer: t_writer.stack_pointer,
                        routine_stack: t_writer.routine_stack,
                        caller_dest_reg_stack: t_writer.caller_dest_reg_stack,
                        status: "READY",
                        blocked_on_channel: -1,
                        blocked_on_join: t_writer.blocked_on_join,
                        blocked_reg: "",
                        blocked_val: empty_val
                    }
                    next_tasks := set_task(next_tasks, found_writer_idx, new_writer)
                end if

                let r_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, val_received)
                let new_reader: VmTask = VmTask {
                    id: task.id,
                    routine: task.routine,
                    frame: r_frame,
                    stack: task.stack,
                    stack_pointer: task.stack_pointer,
                    routine_stack: task.routine_stack,
                    caller_dest_reg_stack: task.caller_dest_reg_stack,
                    status: task.status,
                    blocked_on_channel: task.blocked_on_channel,
                    blocked_on_join: task.blocked_on_join,
                    blocked_reg: task.blocked_reg,
                    blocked_val: task.blocked_val
                }
                next_tasks := set_task(next_tasks, task_idx, new_reader)
                return MultiTaskResult { heap: next_heap, tasks: next_tasks, task_count: task_count, yielded: false }
            else
                -- Check for blocked writer directly (e.g. unbuffered channel transfer)
                let found_writer_idx: Integer = -1
                let j: Integer = 0
                while j < task_count invariant j >= 0 and j <= task_count do
                    let t_other: VmTask = tasks[j]
                    if t_other.status = "BLOCKED" and t_other.blocked_on_channel = chan_ref and t_other.blocked_val.kind != "NONE" then
                        found_writer_idx := j
                    end if
                    j := j + 1
                end while

                if found_writer_idx >= 0 then
                    let t_writer: VmTask = tasks[found_writer_idx]

                    -- Wake up writer
                    let w_frame: ActivationFrame = update_register(t_writer.frame, t_writer.blocked_reg, VmValue { kind: "BOOLEAN", int_val: 0, bool_val: true, str_val: "", ref_val: -1 })
                    let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    let new_writer: VmTask = VmTask {
                        id: t_writer.id,
                        routine: t_writer.routine,
                        frame: w_frame,
                        stack: t_writer.stack,
                        stack_pointer: t_writer.stack_pointer,
                        routine_stack: t_writer.routine_stack,
                        caller_dest_reg_stack: t_writer.caller_dest_reg_stack,
                        status: "READY",
                        blocked_on_channel: -1,
                        blocked_on_join: t_writer.blocked_on_join,
                        blocked_reg: "",
                        blocked_val: empty_val
                    }
                    let next_tasks: Array<VmTask, 16> = set_task(tasks, found_writer_idx, new_writer)

                    -- Set reader's received value
                    let r_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, t_writer.blocked_val)
                    let new_reader: VmTask = VmTask {
                        id: task.id,
                        routine: task.routine,
                        frame: r_frame,
                        stack: task.stack,
                        stack_pointer: task.stack_pointer,
                        routine_stack: task.routine_stack,
                        caller_dest_reg_stack: task.caller_dest_reg_stack,
                        status: task.status,
                        blocked_on_channel: task.blocked_on_channel,
                        blocked_on_join: task.blocked_on_join,
                        blocked_reg: task.blocked_reg,
                        blocked_val: task.blocked_val
                    }
                    next_tasks := set_task(next_tasks, task_idx, new_reader)
                    return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: false }
                else
                    -- No writer, block!
                    let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                    let new_reader: VmTask = VmTask {
                        id: task.id,
                        routine: task.routine,
                        frame: task.frame,
                        stack: task.stack,
                        stack_pointer: task.stack_pointer,
                        routine_stack: task.routine_stack,
                        caller_dest_reg_stack: task.caller_dest_reg_stack,
                        status: "BLOCKED",
                        blocked_on_channel: chan_ref,
                        blocked_on_join: task.blocked_on_join,
                        blocked_reg: inst.dest_reg,
                        blocked_val: empty_val
                    }
                    let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_reader)
                    return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: true }
                end if
            end if
        end if

        if inst.op = "spawn" then
            let routine_idx: Integer = -1
            let k: Integer = 0
            while k < routine_count invariant k >= 0 and k <= routine_count do
                let r: IrRoutine = routines[k]
                if r.name = inst.literal_value then
                    routine_idx := k
                end if
                k := k + 1
            end while

            let spawned_routine: IrRoutine = routines[routine_idx]
            let empty_reg: VmRegister = VmRegister { name: "", reg_value: VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 } }
            let spawned_frame: ActivationFrame = ActivationFrame {
                registers: [
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
                ],
                register_count: 0,
                current_block_label: "entry",
                ip: 0,
                return_value: VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                has_returned: false
            }

            if inst.src_reg_left != "" then
                let arg0_val: VmValue = get_register(task.frame, inst.src_reg_left)
                spawned_frame := update_register(spawned_frame, "_arg0", arg0_val)
            end if

            if inst.src_reg_right != "" then
                let arg1_val: VmValue = get_register(task.frame, inst.src_reg_right)
                spawned_frame := update_register(spawned_frame, "_arg1", arg1_val)
            end if

            let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
            let empty_frame: ActivationFrame = ActivationFrame {
                registers: [
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                    empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
                ],
                register_count: 0,
                current_block_label: "entry",
                ip: 0,
                return_value: empty_val,
                has_returned: false
            }
            let empty_frame_stack: Array<ActivationFrame, 8> = [
                empty_frame, empty_frame, empty_frame, empty_frame,
                empty_frame, empty_frame, empty_frame, empty_frame
            ]
            let empty_routine_stack: Array<IrRoutine, 8> = [
                spawned_routine, spawned_routine, spawned_routine, spawned_routine,
                spawned_routine, spawned_routine, spawned_routine, spawned_routine
            ]
            let empty_string_stack: Array<String, 8> = [
                "", "", "", "", "", "", "", ""
            ]

            let spawned_task: VmTask = VmTask {
                id: task_count,
                routine: spawned_routine,
                frame: spawned_frame,
                stack: empty_frame_stack,
                stack_pointer: 0,
                routine_stack: empty_routine_stack,
                caller_dest_reg_stack: empty_string_stack,
                status: "READY",
                blocked_on_channel: -1,
                blocked_on_join: -1,
                blocked_reg: "",
                blocked_val: empty_val
            }
            let next_tasks: Array<VmTask, 16> = set_task(tasks, task_count, spawned_task)

            let new_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, VmValue { kind: "REF", int_val: task_count, bool_val: false, str_val: "", ref_val: task_count })
            let new_sender: VmTask = VmTask {
                id: task.id,
                routine: task.routine,
                frame: new_frame,
                stack: task.stack,
                stack_pointer: task.stack_pointer,
                routine_stack: task.routine_stack,
                caller_dest_reg_stack: task.caller_dest_reg_stack,
                status: task.status,
                blocked_on_channel: task.blocked_on_channel,
                blocked_on_join: task.blocked_on_join,
                blocked_reg: task.blocked_reg,
                blocked_val: task.blocked_val
            }
            next_tasks := set_task(next_tasks, task_idx, new_sender)
            return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count + 1, yielded: false }
        end if

        if inst.op = "join" then
            let target_id_val: VmValue = get_register(task.frame, inst.src_reg_left)
            let target_id: Integer = target_id_val.ref_val
            let t_target: VmTask = tasks[target_id]

            if t_target.status = "DONE" then
                let new_frame: ActivationFrame = update_register(task.frame, inst.dest_reg, t_target.frame.return_value)
                let new_task: VmTask = VmTask {
                    id: task.id,
                    routine: task.routine,
                    frame: new_frame,
                    stack: task.stack,
                    stack_pointer: task.stack_pointer,
                    routine_stack: task.routine_stack,
                    caller_dest_reg_stack: task.caller_dest_reg_stack,
                    status: task.status,
                    blocked_on_channel: task.blocked_on_channel,
                    blocked_on_join: task.blocked_on_join,
                    blocked_reg: task.blocked_reg,
                    blocked_val: task.blocked_val
                }
                let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_task)
                return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: false }
            else
                let new_task: VmTask = VmTask {
                    id: task.id,
                    routine: task.routine,
                    frame: task.frame,
                    stack: task.stack,
                    stack_pointer: task.stack_pointer,
                    routine_stack: task.routine_stack,
                    caller_dest_reg_stack: task.caller_dest_reg_stack,
                    status: "BLOCKED",
                    blocked_on_channel: task.blocked_on_channel,
                    blocked_on_join: target_id,
                    blocked_reg: inst.dest_reg,
                    blocked_val: task.blocked_val
                }
                let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_task)
                return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: true }
            end if
        end if

        -- Non-host CALL (nested function calls)
        if inst.kind = "CALL" then
            let routine_idx: Integer = -1
            let k: Integer = 0
            while k < routine_count invariant k >= 0 and k <= routine_count do
                let r: IrRoutine = routines[k]
                if r.name = inst.op then
                    routine_idx := k
                end if
                k := k + 1
            end while

            if routine_idx >= 0 then
                let callee_routine: IrRoutine = routines[routine_idx]

                -- Prepare callee frame
                let empty_reg: VmRegister = VmRegister { name: "", reg_value: VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 } }
                let callee_frame: ActivationFrame = ActivationFrame {
                    registers: [
                        empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                        empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                        empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
                        empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
                    ],
                    register_count: 0,
                    current_block_label: "entry",
                    ip: 0,
                    return_value: VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 },
                    has_returned: false
                }

                -- Bind arguments
                if inst.src_reg_left != "" then
                    let arg0_val: VmValue = get_register(task.frame, inst.src_reg_left)
                    callee_frame := update_register(callee_frame, "_arg0", arg0_val)
                end if
                if inst.src_reg_right != "" then
                    let arg1_val: VmValue = get_register(task.frame, inst.src_reg_right)
                    callee_frame := update_register(callee_frame, "_arg1", arg1_val)
                end if

                -- Caller frame with next IP (the instruction AFTER the CALL)
                let caller_frame: ActivationFrame = task.frame
                caller_frame.ip := task.frame.ip + 1

                -- Push onto task stack
                let sp: Integer = task.stack_pointer
                let new_stack: Array<ActivationFrame, 8> = set_frame_stack(task.stack, sp, caller_frame)
                let new_rot_stack: Array<IrRoutine, 8> = set_routine_stack(task.routine_stack, sp, task.routine)
                let new_dest_stack: Array<String, 8> = set_string_stack(task.caller_dest_reg_stack, sp, inst.dest_reg)

                let updated_task: VmTask = VmTask {
                    id: task.id,
                    routine: callee_routine,
                    frame: callee_frame,
                    stack: new_stack,
                    stack_pointer: sp + 1,
                    routine_stack: new_rot_stack,
                    caller_dest_reg_stack: new_dest_stack,
                    status: task.status,
                    blocked_on_channel: task.blocked_on_channel,
                    blocked_on_join: task.blocked_on_join,
                    blocked_reg: task.blocked_reg,
                    blocked_val: task.blocked_val
                }

                let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, updated_task)
                return MultiTaskResult { heap: heap, tasks: next_tasks, task_count: task_count, yielded: true }
            end if
        end if
    end if

    let old_state: VmState = VmState { heap: heap, frame: task.frame }
    let new_state: VmState = execute_instruction(inst, old_state, task.routine)
    let new_task: VmTask = VmTask {
        id: task.id,
        routine: task.routine,
        frame: new_state.frame,
        stack: task.stack,
        stack_pointer: task.stack_pointer,
        routine_stack: task.routine_stack,
        caller_dest_reg_stack: task.caller_dest_reg_stack,
        status: task.status,
        blocked_on_channel: task.blocked_on_channel,
        blocked_on_join: task.blocked_on_join,
        blocked_reg: task.blocked_reg,
        blocked_val: task.blocked_val
    }
    let next_tasks: Array<VmTask, 16> = set_task(tasks, task_idx, new_task)
    return MultiTaskResult { heap: new_state.heap, tasks: next_tasks, task_count: task_count, yielded: false }
end execute_instruction_multitask

function execute_task_slice(
    task_idx: Integer,
    heap: VmHeap,
    tasks: Array<VmTask, 16>,
    task_count: Integer,
    routines: Array<IrRoutine, 10>,
    routine_count: Integer
) returns MultiTaskResult
is
    let task: VmTask = tasks[task_idx]
    let routine: IrRoutine = task.routine
    let current_label: String = task.frame.current_block_label
    let has_jumped: Boolean = true
    let ip: Integer = task.frame.ip
    let current_heap: VmHeap = heap
    let current_tasks: Array<VmTask, 16> = tasks
    let current_task_count: Integer = task_count

    while has_jumped invariant has_jumped or not has_jumped do
        has_jumped := false

        let block_idx: Integer = routine.block_count - routine.block_count - 1
        let k: Integer = routine.block_count - routine.block_count
        let rblocks: Array<IrBasicBlock, 32> = routine.blocks
        while k < routine.block_count invariant k >= 0 and k <= routine.block_count do
            let blk: IrBasicBlock = rblocks[k]
            if blk.label = current_label then
                block_idx := k
            end if
            k := k + 1
        end while

        if block_idx >= 0 then
            let blk: IrBasicBlock = rblocks[block_idx]

            let i: Integer = ip
            let binsts: Array<IrInstruction, 64> = blk.instructions
            let yielded: Boolean = false

            while i < blk.instruction_count and not yielded invariant i >= 0 and i <= blk.instruction_count do
                let inst: IrInstruction = binsts[i]

                -- Save current state inside current task for execution
                let temp_task: VmTask = current_tasks[task_idx]
                temp_task.frame.current_block_label := current_label
                temp_task.frame.ip := i
                current_tasks := set_task(current_tasks, task_idx, temp_task)

                let res: MultiTaskResult = execute_instruction_multitask(inst, task_idx, current_heap, current_tasks, current_task_count, routines, routine_count)
                current_heap := res.heap
                current_tasks := res.tasks
                current_task_count := res.task_count
                yielded := res.yielded

                if yielded then
                    let t_yielded: VmTask = current_tasks[task_idx]
                    if t_yielded.stack_pointer = temp_task.stack_pointer then
                        t_yielded.frame.ip := i + 1
                        current_tasks := set_task(current_tasks, task_idx, t_yielded)
                    end if
                end if

                i := i + 1
            end while

            if yielded then
                return MultiTaskResult { heap: current_heap, tasks: current_tasks, task_count: current_task_count, yielded: true }
            end if

            -- Reset IP for subsequent blocks
            ip := 0

            if blk.terminator_kind = "RETURN" then
                let cur_t: VmTask = current_tasks[task_idx]
                let ret_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
                if blk.return_reg != "" then
                    ret_val := get_register(cur_t.frame, blk.return_reg)
                end if

                if cur_t.stack_pointer > 0 then
                    -- Pop caller context
                    let caller_sp: Integer = cur_t.stack_pointer - 1
                    let stack_arr: Array<ActivationFrame, 8> = cur_t.stack
                    let caller_frame: ActivationFrame = stack_arr[caller_sp]
                    let rot_stack: Array<IrRoutine, 8> = cur_t.routine_stack
                    let caller_routine: IrRoutine = rot_stack[caller_sp]
                    let dest_stack: Array<String, 8> = cur_t.caller_dest_reg_stack
                    let caller_dest_reg: String = dest_stack[caller_sp]

                    -- If caller expected a return value in a destination register, update it
                    if caller_dest_reg != "" then
                        caller_frame := update_register(caller_frame, caller_dest_reg, ret_val)
                    end if

                    cur_t.frame := caller_frame
                    cur_t.routine := caller_routine
                    cur_t.stack_pointer := caller_sp
                    current_tasks := set_task(current_tasks, task_idx, cur_t)

                    return MultiTaskResult { heap: current_heap, tasks: current_tasks, task_count: current_task_count, yielded: true }
                else
                    cur_t.status := "DONE"
                    cur_t.frame.return_value := ret_val
                    cur_t.frame.has_returned := true
                    cur_t.frame.current_block_label := ""
                    cur_t.frame.ip := 0
                    current_tasks := set_task(current_tasks, task_idx, cur_t)

                    -- When a task is DONE, unblock any tasks waiting to JOIN this task
                    let j: Integer = 0
                    while j < current_task_count invariant j >= 0 and j <= current_task_count do
                        let t_other: VmTask = current_tasks[j]
                        if t_other.status = "BLOCKED" and t_other.blocked_on_join = cur_t.id then
                            let other_frame: ActivationFrame = update_register(t_other.frame, t_other.blocked_reg, ret_val)
                            let new_other: VmTask = VmTask {
                                id: t_other.id,
                                routine: t_other.routine,
                                frame: other_frame,
                                stack: t_other.stack,
                                stack_pointer: t_other.stack_pointer,
                                routine_stack: t_other.routine_stack,
                                caller_dest_reg_stack: t_other.caller_dest_reg_stack,
                                status: "READY",
                                blocked_on_channel: t_other.blocked_on_channel,
                                blocked_on_join: -1,
                                blocked_reg: "",
                                blocked_val: t_other.blocked_val
                            }
                            current_tasks := set_task(current_tasks, j, new_other)
                        end if
                        j := j + 1
                    end while

                    return MultiTaskResult { heap: current_heap, tasks: current_tasks, task_count: current_task_count, yielded: false }
                end if
            else
                if blk.terminator_kind = "JUMP" then
                    current_label := blk.target_block_label
                    has_jumped := true
                else
                    if blk.terminator_kind = "BRANCH_COND" then
                        let cur_t_cond: VmTask = current_tasks[task_idx]
                        let cond_val: VmValue = get_register(cur_t_cond.frame, blk.return_reg)
                        if cond_val.bool_val then
                            current_label := blk.true_block_label
                        else
                            current_label := blk.false_block_label
                        end if
                        has_jumped := true
                    end if
                end if
            end if
        end if
    end while

    return MultiTaskResult { heap: current_heap, tasks: current_tasks, task_count: current_task_count, yielded: false }
end execute_task_slice

function as_integer(val: Integer) returns Integer
is
    return val
end as_integer

function execute_scheduler(
    routines: Array<IrRoutine, 10>,
    routine_count: Integer,
    main_routine: IrRoutine,
    initial_heap: VmHeap
) returns VmState
is
    let heap: VmHeap = initial_heap
    let empty_val: VmValue = VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
    let empty_reg: VmRegister = VmRegister { name: "", reg_value: empty_val }
    let empty_frame: ActivationFrame = ActivationFrame {
        registers: [
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
        ],
        register_count: 0,
        current_block_label: "",
        ip: 0,
        return_value: empty_val,
        has_returned: false
    }

    let empty_frame_stack: Array<ActivationFrame, 8> = [
        empty_frame, empty_frame, empty_frame, empty_frame,
        empty_frame, empty_frame, empty_frame, empty_frame
    ]
    let empty_routine_stack: Array<IrRoutine, 8> = [
        main_routine, main_routine, main_routine, main_routine,
        main_routine, main_routine, main_routine, main_routine
    ]
    let empty_string_stack: Array<String, 8> = [
        "", "", "", "", "", "", "", ""
    ]

    let empty_task: VmTask = VmTask {
        id: -1,
        routine: main_routine,
        frame: empty_frame,
        stack: empty_frame_stack,
        stack_pointer: 0,
        routine_stack: empty_routine_stack,
        caller_dest_reg_stack: empty_string_stack,
        status: "FREE",
        blocked_on_channel: -1,
        blocked_on_join: -1,
        blocked_reg: "",
        blocked_val: empty_val
    }

    let tasks: Array<VmTask, 16> = [
        empty_task, empty_task, empty_task, empty_task,
        empty_task, empty_task, empty_task, empty_task,
        empty_task, empty_task, empty_task, empty_task,
        empty_task, empty_task, empty_task, empty_task
    ]

    let main_frame: ActivationFrame = ActivationFrame {
        registers: [
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg,
            empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg, empty_reg
        ],
        register_count: 0,
        current_block_label: "entry",
        ip: 0,
        return_value: empty_val,
        has_returned: false
    }

    let main_task: VmTask = VmTask {
        id: 0,
        routine: main_routine,
        frame: main_frame,
        stack: empty_frame_stack,
        stack_pointer: 0,
        routine_stack: empty_routine_stack,
        caller_dest_reg_stack: empty_string_stack,
        status: "READY",
        blocked_on_channel: -1,
        blocked_on_join: -1,
        blocked_reg: "",
        blocked_val: empty_val
    }
    tasks := set_task(tasks, 0, main_task)


    let task_count: Integer = as_integer(1)
    let has_active: Boolean = true
    let loop_count: Integer = 0

    while has_active and loop_count < 200 invariant has_active or not has_active do
        has_active := false

        let j: Integer = 0
        let executed_any: Boolean = false

        while j < task_count invariant j >= 0 and j <= task_count do
            let t: VmTask = tasks[j]
            if t.status = "READY" then
                let res: MultiTaskResult = execute_task_slice(j, heap, tasks, task_count, routines, routine_count)
                heap := res.heap
                tasks := res.tasks
                task_count := res.task_count
                executed_any := true
            end if
            j := j + 1
        end while

        -- Check if there are active tasks
        let k: Integer = 0
        while k < task_count invariant k >= 0 and k <= task_count do
            let t: VmTask = tasks[k]
            if t.status != "DONE" then
                has_active := true
            end if
            k := k + 1
        end while

        -- Check deadlock: if has_active but we couldn't execute any task in this round
        if has_active and not executed_any then
            call Std.IO.logf("DEADLOCK DETECTED! Active tasks are blocked.")
            has_active := false
        end if

        loop_count := loop_count + 1
    end while

    let final_t: VmTask = tasks[0]
    return VmState {
        heap: heap,
        frame: final_t.frame
    }
end execute_scheduler

end Compiler.Core.Vm


