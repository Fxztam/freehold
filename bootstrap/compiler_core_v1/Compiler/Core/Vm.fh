function get_heap_field(obj: VmHeapObject, name: String) returns VmValue
is
    let i: Integer = obj.field_count - obj.field_count
    let names: Array<String, 10> = obj.field_names
    let vals: Array<VmValue, 10> = obj.field_values
    while i < obj.field_count invariant i >= 0 and i <= obj.field_count do
        let fname: String = names[i]
        if fname = name then
            return vals[i]
        end if
        i := i + 1
    end while
    return VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
end get_heap_field

function set_heap_field(obj: VmHeapObject, name: String, val: VmValue) returns VmHeapObject
is
    let i: Integer = obj.field_count - obj.field_count
    let found: Boolean = false
    let updated_names: Array<String, 10> = obj.field_names
    let updated_vals: Array<VmValue, 10> = obj.field_values

    while i < obj.field_count invariant i >= 0 and i <= obj.field_count do
        let fname: String = updated_names[i]
        if fname = name then
            updated_vals := set_value_10(updated_vals, i, val)
            found := true
        end if
        i := i + 1
    end while

    if not found then
        if obj.field_count < 10 then
            updated_names := set_string_10(updated_names, obj.field_count, name)
            updated_vals := set_value_10(updated_vals, obj.field_count, val)
            return VmHeapObject {
                kind: obj.kind,
                field_names: updated_names,
                field_values: updated_vals,
                field_count: obj.field_count + 1,
                elements: obj.elements,
                element_count: obj.element_count
            }
        end if
    end if

    return VmHeapObject {
        kind: obj.kind,
        field_names: updated_names,
        field_values: updated_vals,
        field_count: obj.field_count,
        elements: obj.elements,
        element_count: obj.element_count
    }
end set_heap_field

function get_heap_element(obj: VmHeapObject, idx: Integer) returns VmValue
is
    let elems: Array<VmValue, 32> = obj.elements
    if idx >= 0 and idx < 32 then
        return elems[idx]
    end if
    return VmValue { kind: "NONE", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
end get_heap_element

function set_heap_element(obj: VmHeapObject, idx: Integer, val: VmValue) returns VmHeapObject
is
    if idx >= 0 and idx < 32 then
        let updated_elems: Array<VmValue, 32> = set_value_32(obj.elements, idx, val)
        let new_count: Integer = obj.element_count
        if idx >= obj.element_count then
            new_count := idx + 1
        end if
        return VmHeapObject {
            kind: obj.kind,
            field_names: obj.field_names,
            field_values: obj.field_values,
            field_count: obj.field_count,
            elements: updated_elems,
            element_count: new_count
        }
    end if
    return obj
end set_heap_element

function get_heap_obj(heap: VmHeap, idx: Integer) returns VmHeapObject
