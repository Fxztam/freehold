module Compiler.Core.Vm

import Compiler.Core.Token exposing SourceSpan
import Compiler.Core.Ir exposing IrType, IrInstruction, IrBasicBlock, IrRoutine
import System
import Std.IO
import Math
import Big

type VmValue is record
    kind: String             -- "INTEGER", "BOOLEAN", "STRING", "REF", "PTR", "NONE"
    int_val: Integer
    bool_val: Boolean
    str_val: String
    ref_val: Integer         -- Address index in Heap or object ref
end record

type VmRegister is record
    name: String
    reg_value: VmValue
end record

type VmHeapObject is record
    kind: String             -- "RECORD", "ARRAY", "FREE"

    -- For records: field names and values
    field_names: Array<String, 10>
    field_values: Array<VmValue, 10>
    field_count: Integer

    -- For arrays: elements
    elements: Array<VmValue, 32>
    element_count: Integer
end record

type VmHeap is record
    objects: Array<VmHeapObject, 32>
    object_count: Integer
end record

type ActivationFrame is record
    registers: Array<VmRegister, 32>
    register_count: Integer

    current_block_label: String
    ip: Integer

    return_value: VmValue
    has_returned: Boolean
end record

type VmState is record
    heap: VmHeap
    frame: ActivationFrame
end record

type AllocResult is record
    heap: VmHeap
    ref_idx: Integer
end record

function char_to_int(c: String) returns Integer
is
    if c = "0" then return 0 end if
    if c = "1" then return 1 end if
    if c = "2" then return 2 end if
    if c = "3" then return 3 end if
    if c = "4" then return 4 end if
    if c = "5" then return 5 end if
    if c = "6" then return 6 end if
    if c = "7" then return 7 end if
    if c = "8" then return 8 end if
    if c = "9" then return 9 end if
    return -1
end char_to_int

function parse_int(s: String) returns Integer
is
    let len: Integer = String.length(s)
    if len = 0 then return 0 end if

    let is_neg: Boolean = false
    let start_idx: Integer = len - len
    let first: String = String.substr(s, 0, 1)
    if first = "-" then
        is_neg := true
        start_idx := len - len + 1
    end if

    let val: Integer = len - len
    let i: Integer = start_idx
    while i < len invariant i >= 0 and i <= len do
        let c: String = String.substr(s, i, 1)
        let d: Integer = char_to_int(c)
        if d >= 0 then
            val := val * 10 + d
        end if
        i := i + 1
    end while

    if is_neg then
        return -val
    end if
    return val
end parse_int

function parse_bool(s: String) returns Boolean
is
    if s = "true" then return true end if
    return false
end parse_bool

function parse_string_lit(s: String) returns String
is
    let len: Integer = String.length(s)
    if len >= 2 then
        let first: String = String.substr(s, 0, 1)
        let last: String = String.substr(s, len - 1, 1)
        if first = "\"" and last = "\"" then
            return String.substr(s, 1, len - 2)
        end if
    end if
    return s
end parse_string_lit

function to_double(n: Integer) returns Double
is
    if n >= 0 then
        return Math.max(n, 0.0)
    end if
    return Math.min(n, 0.0)
end to_double

function parse_double(s: String) returns Double
is
    let len: Integer = String.length(s)
    if len = 0 then return 0.0 end if

    let is_neg: Boolean = false
    let start_idx: Integer = len - len
    let first: String = String.substr(s, 0, 1)
    if first = "-" then
        is_neg := true
        start_idx := len - len + 1
    end if

    let dot_idx: Integer = String.instr(s, ".")
    let int_part_len: Integer = len
    if dot_idx >= 0 then
        int_part_len := dot_idx
    end if

    let val: Double = 0.0
    let i: Integer = start_idx
    while i < int_part_len invariant i >= 0 and i <= len do
        let c: String = String.substr(s, i, 1)
        let d: Integer = char_to_int(c)
        if d >= 0 then
            val := val * 10.0 + to_double(d)
        end if
        i := i + 1
    end while

    if dot_idx >= 0 then
        let frac_val: Double = 0.0
        let frac_div: Double = 1.0
        let j: Integer = dot_idx + 1
        while j < len invariant j >= 0 and j <= len do
            let c: String = String.substr(s, j, 1)
            let d: Integer = char_to_int(c)
            if d >= 0 then
                frac_div := frac_div * 10.0
                frac_val := frac_val + (to_double(d) / frac_div)
            end if
            j := j + 1
        end while
        val := val + frac_val
    end if

    if is_neg then
        return -val
    end if
    return val
end parse_double

function parse_literal(s: String) returns VmValue
is
    let len: Integer = String.length(s)
    if len = 0 then
        return VmValue { kind: "STRING", int_val: 0, bool_val: false, str_val: "", ref_val: -1 }
    end if

    let first: String = String.substr(s, 0, 1)
    if first = "\"" then
        return VmValue { kind: "STRING", int_val: 0, bool_val: false, str_val: parse_string_lit(s), ref_val: -1 }
    end if

    if s = "true" or s = "false" then
        return VmValue { kind: "BOOLEAN", int_val: 0, bool_val: parse_bool(s), str_val: "", ref_val: -1 }
    end if

    if String.instr(s, ".") >= 0 then
        return VmValue { kind: "DOUBLE", int_val: 0, bool_val: false, str_val: s, ref_val: -1 }
    end if

    return VmValue { kind: "INTEGER", int_val: parse_int(s), bool_val: false, str_val: "", ref_val: -1 }
end parse_literal

