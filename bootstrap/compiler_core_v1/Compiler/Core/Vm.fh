function allocate_object(heap: VmHeap, obj: VmHeapObject) returns AllocResult
is
    if heap.object_count < 32 then
        let new_objects: Array<VmHeapObject, 32> = set_heap_obj(heap.objects, heap.object_count, obj)
        return AllocResult {
            heap: VmHeap {
                objects: new_objects,
                object_count: heap.object_count + 1
            },
            ref_idx: heap.object_count
        }
    end if
    return AllocResult { heap: heap, ref_idx: -1 }
end allocate_object

