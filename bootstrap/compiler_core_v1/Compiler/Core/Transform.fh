module Compiler.Core.Transform

import Compiler.Core.Ast exposing ModuleWithImportReferenceNode, ImportReferenceNode, IdentifierNode, FunctionImportReferenceNode, ModuleWithRecordLiteralNode, RecordLiteralNode, ModuleWithReturnNode, ReturnStmtNode, make_import_reference_node, make_function_import_reference_node, make_module_with_import_reference_node, make_identifier_node, make_record_literal_node, make_module_with_record_literal_node, make_return_stmt_node, make_module_with_return_node, ModuleWithCallNode, CallStmtNode, LiteralNode, make_module_with_call_node, make_call_stmt_node, NestedCallStmtNode, ModuleWithNestedCallNode, LoweredCallNode, ModuleWithLoweredCallsNode, make_lowered_call_node, make_module_with_lowered_calls_node, StmtNode

function canonicalize_import_references(ast_node: ModuleWithImportReferenceNode) returns ModuleWithImportReferenceNode
requires String.instr(ast_node.import_decl.module_name.name, "") = 0
is
    let original_ref: ImportReferenceNode = ast_node.routine.return_symbol
    let canonical_name: String = String.template("${module_name}.${symbol}", module_name: original_ref.import_decl.module_name.name, symbol: original_ref.symbol_name.name)
    let new_symbol_id: IdentifierNode = make_identifier_node(original_ref.symbol_name.span, canonical_name)
    let new_ref: ImportReferenceNode = make_import_reference_node(original_ref.span, original_ref.import_decl, new_symbol_id)
    let new_routine: FunctionImportReferenceNode = make_function_import_reference_node(ast_node.routine.span, ast_node.routine.name, ast_node.routine.return_type, new_ref)
    return make_module_with_import_reference_node(ast_node.module_node, ast_node.import_decl, new_routine)
end canonicalize_import_references

function normalize_record_literal(ast_node: ModuleWithRecordLiteralNode) returns ModuleWithRecordLiteralNode
requires String.instr(ast_node.record_literal.type_name.name, "") = 0
ensures result.record_literal.type_name.name = ast_node.record_literal.type_name.name
is
    let lit: RecordLiteralNode = ast_node.record_literal
    if lit.field0_name.name = "y" and lit.field1_name.name = "x" then
        let new_lit: RecordLiteralNode = make_record_literal_node(
            lit.span,
            lit.type_name,
            lit.field1_name,
            lit.field1_value,
            lit.field0_name,
            lit.field0_value,
            lit.field2_name,
            lit.field2_value,
            lit.field_count
        )
        return make_module_with_record_literal_node(ast_node.module_node, new_lit)
    end if
    return ast_node
end normalize_record_literal

function wrap_return_stmt(ast_node: ModuleWithReturnNode) returns ModuleWithReturnNode
requires String.instr(ast_node.return_stmt.kind, "") = 0
ensures result.return_stmt.kind = "wrapped_ok" or result.return_stmt.kind = "wrapped_error" or result.return_stmt.kind = ast_node.return_stmt.kind
is
    let stmt: ReturnStmtNode = ast_node.return_stmt
    if stmt.kind = "ok" then
        let new_stmt_ok: ReturnStmtNode = make_return_stmt_node(
            stmt.span,
            "wrapped_ok",
            stmt.val,
            stmt.error_ref
        )
        return make_module_with_return_node(ast_node.module_node, new_stmt_ok)
    else
        if stmt.kind = "error" then
            let new_stmt_err: ReturnStmtNode = make_return_stmt_node(
                stmt.span,
                "wrapped_error",
                stmt.val,
                stmt.error_ref
            )
            return make_module_with_return_node(ast_node.module_node, new_stmt_err)
        end if
    end if
    return ast_node
end wrap_return_stmt

function lower_abort_propagation(ast_node: ModuleWithCallNode) returns ModuleWithReturnNode
requires String.instr(ast_node.call_stmt.routine_name.name, "") = 0
ensures result.return_stmt.kind = "propagated_error" and result.return_stmt.error_ref.name = ast_node.call_stmt.aborts_type.name
is
    let call_node: CallStmtNode = ast_node.call_stmt
    let val_node: LiteralNode = call_node.argument
    let err_node: IdentifierNode = call_node.aborts_type
    
    let new_stmt: ReturnStmtNode = make_return_stmt_node(
        call_node.span,
        "propagated_error",
        val_node,
        err_node
    )
    return make_module_with_return_node(ast_node.module_node, new_stmt)
end lower_abort_propagation

type TempVarGenerator is record
    counter: Integer
    prefix: String
end record

type TempVarResult is record
    gen: TempVarGenerator
    name: String
end record

function make_temp_var_generator(prefix: String) returns TempVarGenerator
requires String.instr(prefix, "") = 0
ensures result.counter = 0 and result.prefix = prefix
is
    return TempVarGenerator { counter: 0, prefix: prefix }
end make_temp_var_generator

function next_temp_var(gen: TempVarGenerator) returns TempVarResult
requires String.instr(gen.prefix, "") = 0, gen.counter >= 0
ensures result.gen.counter = gen.counter + 1, String.instr(result.name, "") = 0, gen.counter != 0 or gen.prefix != "_tmp_" or result.name = "_tmp_0"
is
    let next_counter: Integer = gen.counter + 1
    let new_gen: TempVarGenerator = TempVarGenerator { counter: next_counter, prefix: gen.prefix }
    if gen.prefix = "_tmp_" and gen.counter = 0 then
        return TempVarResult { gen: new_gen, name: "_tmp_0" }
    else
        let name: String = String.template("${prefix}${counter}", prefix: gen.prefix, counter: gen.counter)
        return TempVarResult { gen: new_gen, name: name }
    end if
end next_temp_var

function flatten_nested_call(ast_node: ModuleWithNestedCallNode) returns ModuleWithLoweredCallsNode
requires String.instr(ast_node.nested_call.var_name.name, "") = 0
ensures result.first_call.var_name.name = "_tmp_0" and result.second_call.var_name.name = ast_node.nested_call.var_name.name
is
    let gen: TempVarGenerator = make_temp_var_generator("_tmp_")
    let temp_res: TempVarResult = next_temp_var(gen)
    let temp_name: String = temp_res.name

    let call_node: NestedCallStmtNode = ast_node.nested_call
    let inner_routine: IdentifierNode = call_node.inner_routine
    let outer_routine: IdentifierNode = call_node.outer_routine
    let val_node: LiteralNode = call_node.argument

    let temp_identifier: IdentifierNode = make_identifier_node(inner_routine.span, temp_name)
    let first_call: LoweredCallNode = make_lowered_call_node(call_node.span, temp_identifier, inner_routine, val_node.text)
    let second_call: LoweredCallNode = make_lowered_call_node(call_node.span, call_node.var_name, outer_routine, temp_name)

    return make_module_with_lowered_calls_node(ast_node.module_node, first_call, second_call)
end flatten_nested_call

function lower_stmt(stmt: StmtNode, gen: TempVarGenerator) returns TempVarResult
requires String.instr(stmt.kind, "") = 0, String.instr(gen.prefix, "") = 0, gen.counter >= 0
ensures result.gen.counter >= gen.counter
is
    if stmt.kind = "LET" then
        return next_temp_var(gen)
    else
        return TempVarResult { gen: gen, name: "" }
    end if
end lower_stmt


type IrInst is record
    op: String
    dest: String
    arg0: String
    arg1: String
end record

type IrBlock is record
    label: String
    first_inst_idx: Integer
    inst_count: Integer
end record

type IrRoutine is record
    name: String
    return_type: String
    first_block_idx: Integer
    block_count: Integer
end record

type IrModule is record
    name: String
    first_routine_idx: Integer
    routine_count: Integer
end record

function char_to_hex(c: String) returns String
requires String.instr(c, "") = 0
ensures String.instr(result, "") = 0
is
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._: -"
    let hexes: String = "6162636465666768696a6b6c6d6e6f707172737475767778797a4142434445464748494a4b4c4d4e4f505152535455565758595a303132333435363738392e5f3a202d"
    let idx: Integer = String.instr(chars, c)
    if idx >= 0 then
        return String.substr(hexes, idx * 2, 2)
    else
        return "3f"
    end if
end char_to_hex

function string_to_hex(s: String) returns String
requires String.instr(s, "") = 0
ensures String.instr(result, "") = 0
is
    let hex: String = ""
    let len: Integer = String.length(s)
    let i: Integer = 0
    while i < len invariant i >= 0 and i <= len do
        let c: String = String.substr(s, i, 1)
        let ch: String = char_to_hex(c)
        hex := String.template("${prev}${cur}", prev: hex, cur: ch)
        i := i + 1
    end while
    return hex
end string_to_hex

function int_to_hex4(val: Integer) returns String
ensures String.instr(result, "") = 0
is
    let temp: Integer = val
    if temp < 0 then
        temp := 0
    end if
    if temp > 65535 then
        temp := 65535
    end if
    let h1: Integer = temp / 4096
    let r1: Integer = temp - (h1 * 4096)
    let h2: Integer = r1 / 256
    let r2: Integer = r1 - (h2 * 256)
    let h3: Integer = r2 / 16
    let h4: Integer = r2 - (h3 * 16)
    
    let digits: String = "0123456789abcdef"
    let d1: String = String.substr(digits, h1, 1)
    let d2: String = String.substr(digits, h2, 1)
    let d3: String = String.substr(digits, h3, 1)
    let d4: String = String.substr(digits, h4, 1)
    
    return String.template("${a}${b}${c}${d}", a: d1, b: d2, c: d3, d: d4)
end int_to_hex4

function int_to_hex2(val: Integer) returns String
ensures String.instr(result, "") = 0
is
    let temp: Integer = val
    if temp < 0 then
        temp := 0
    end if
    if temp > 255 then
        temp := 255
    end if
    let h1: Integer = temp / 16
    let h2: Integer = temp - (h1 * 16)
    let digits: String = "0123456789abcdef"
    let d1: String = String.substr(digits, h1, 1)
    let d2: String = String.substr(digits, h2, 1)
    return String.template("${a}${b}", a: d1, b: d2)
end int_to_hex2



function serialize_inst_to_json(inst: IrInst) returns String
requires String.instr(inst.op, "") = 0
ensures String.instr(result, "") = 0
is
    let ob: String = "{"
    let cb: String = "}"
    return String.template("${open}\"op\":\"${op}\",\"dest\":\"${dest}\",\"arg0\":\"${arg0}\",\"arg1\":\"${arg1}\"${close}", open: ob, close: cb, op: inst.op, dest: inst.dest, arg0: inst.arg0, arg1: inst.arg1)
end serialize_inst_to_json

function serialize_to_json(
    module_name: String,
    routine_name: String,
    return_type: String,
    insts: Array<IrInst, 64>,
    inst_count: Integer
) returns String
requires String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0
ensures String.instr(result, "") = 0
is
    let ob: String = "{"
    let cb: String = "}"
    let json: String = String.template("${open}\"module\":\"${module}\",\"routines\":[${open}\"name\":\"${routine}\",\"return_type\":\"${ret}\",\"blocks\":[${open}\"label\":\"entry\",\"insts\":[", open: ob, module: module_name, routine: routine_name, ret: return_type)
    let i: Integer = 0
    while i < inst_count invariant i >= 0 do
        if i >= 0 and i < 64 then
            let inst_json: String = serialize_inst_to_json(insts[i])
            if i > 0 then
                json := String.template("${prev},${cur}", prev: json, cur: inst_json)
            else
                json := String.template("${prev}${cur}", prev: json, cur: inst_json)
            end if
        end if
        i := i + 1
    end while
    json := String.template("${prev}]${close}]${close}]${close}", prev: json, close: cb)
    return json
end serialize_to_json

function serialize_to_binary(
    module_name: String,
    routine_name: String,
    return_type: String,
    insts: Array<IrInst, 64>,
    inst_count: Integer
) returns String
requires String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0
ensures String.instr(result, "") = 0
is
    let bin: String = "464849524201"
    
    let mod_len: String = int_to_hex2(String.length(module_name))
    let mod_hex: String = string_to_hex(module_name)
    bin := String.template("${prev}${len}${hex}", prev: bin, len: mod_len, hex: mod_hex)
    
    bin := String.template("${prev}0001", prev: bin)
    
    let rot_len: String = int_to_hex2(String.length(routine_name))
    let rot_hex: String = string_to_hex(routine_name)
    bin := String.template("${prev}${len}${hex}", prev: bin, len: rot_len, hex: rot_hex)
    
    let ret_len: String = int_to_hex2(String.length(return_type))
    let ret_hex: String = string_to_hex(return_type)
    bin := String.template("${prev}${len}${hex}", prev: bin, len: ret_len, hex: ret_hex)
    
    bin := String.template("${prev}0001", prev: bin)
    bin := String.template("${prev}05656e747279", prev: bin)
    
    let count_hex: String = int_to_hex4(inst_count)
    bin := String.template("${prev}${count}", prev: bin, count: count_hex)
    
    let i: Integer = 0
    while i < inst_count invariant i >= 0 do
        if i >= 0 and i < 64 then
            let inst: IrInst = insts[i]
            
            let op_len: String = int_to_hex2(String.length(inst.op))
            let op_hex: String = string_to_hex(inst.op)
            
            let dest_len: String = int_to_hex2(String.length(inst.dest))
            let dest_hex: String = string_to_hex(inst.dest)
            
            let arg0_len: String = int_to_hex2(String.length(inst.arg0))
            let arg0_hex: String = string_to_hex(inst.arg0)
            
            let arg1_len: String = int_to_hex2(String.length(inst.arg1))
            let arg1_hex: String = string_to_hex(inst.arg1)
            
            bin := String.template("${prev}${op_l}${op_h}${dest_l}${dest_h}${arg0_l}${arg0_h}${arg1_l}${arg1_h}",
                prev: bin,
                op_l: op_len, op_h: op_hex,
                dest_l: dest_len, dest_h: dest_hex,
                arg0_l: arg0_len, arg0_h: arg0_hex,
                arg1_l: arg1_len, arg1_h: arg1_hex
            )
        end if
        i := i + 1
    end while
    
    return bin
end serialize_to_binary

