module Compiler.Core.Diagnostics

import Compiler.Core.Names exposing ModuleName, SymbolName, make_module_name, make_symbol_name

type Diagnostic is record
    code: String
    message: String
    module_name: ModuleName
    symbol_name: SymbolName
end record

function make_diagnostic(code: String, message: String, module_name: ModuleName, symbol_name: SymbolName) returns Diagnostic
requires String.instr(code, "FH-") = 0
ensures result.code = code, result.message = message
is
    return Diagnostic { code: code, message: message, module_name: module_name, symbol_name: symbol_name }
end make_diagnostic

function diagnostic_key(diagnostic: Diagnostic) returns String
requires String.instr(diagnostic.code, "FH-") = 0
ensures String.instr(result, diagnostic.code) = 0
is
    return String.template("${code}:${module}.${symbol}", code: diagnostic.code, module: diagnostic.module_name.full, symbol: diagnostic.symbol_name.raw)
end diagnostic_key

function diagnostic_text(diagnostic: Diagnostic) returns String
requires String.instr(diagnostic.code, "FH-") = 0
ensures String.instr(result, diagnostic.message) >= 0
is
    return String.template("${key}:${message}", key: diagnostic_key(diagnostic), message: diagnostic.message)
end diagnostic_text

function make_unknown_exposed_symbol_diagnostic(import_module_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(import_module_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-REF-1001", result.module_name.full = import_module_full, result.symbol_name.raw = symbol_raw
is
    let module_name: ModuleName = make_module_name(import_module_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("unknown exposed symbol ${symbol} in ${module}", symbol: symbol_raw, module: import_module_full)
    return make_diagnostic("FH-REF-1001", message, module_name, symbol_name)
end make_unknown_exposed_symbol_diagnostic

end Compiler.Core.Diagnostics