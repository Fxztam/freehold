module Compiler.Core.Diagnostics

import Compiler.Core.Names exposing ModuleName, SymbolName, make_module_name, make_symbol_name

type Diagnostic is record
    code: String
    message: String
    module_name: ModuleName
    symbol_name: SymbolName
end record

function make_diagnostic(code: String, message: String, module_name: ModuleName, symbol_name: SymbolName) returns Diagnostic
requires String.instr(code, "FH-") = 0
ensures result.code = code, result.message = message, result.module_name.full = module_name.full, result.symbol_name.raw = symbol_name.raw
is
    return Diagnostic { code: code, message: message, module_name: module_name, symbol_name: symbol_name }
end make_diagnostic

function diagnostic_key(diagnostic: Diagnostic) returns String
requires String.instr(diagnostic.code, "FH-") = 0
ensures String.instr(result, diagnostic.code) = 0
is
    return String.template("${code}:${module_name}.${symbol}", code: diagnostic.code, module_name: diagnostic.module_name.full, symbol: diagnostic.symbol_name.raw)
end diagnostic_key

function diagnostic_text(diagnostic: Diagnostic) returns String
requires String.instr(diagnostic.code, "FH-") = 0
ensures String.instr(result, diagnostic.message) >= 0
is
    return String.template("${key}:${message}", key: diagnostic_key(diagnostic), message: diagnostic.message)
end diagnostic_text

function make_unknown_exposed_symbol_diagnostic(import_module_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(import_module_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-REF-1001", result.module_name.full = import_module_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(import_module_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("unknown exposed symbol ${symbol} in ${module_name}", symbol: symbol_raw, module_name: import_module_full)
    return make_diagnostic("FH-REF-1001", message, module_name, symbol_name)
end make_unknown_exposed_symbol_diagnostic

function make_type_mismatch_diagnostic(expected_type: String, got_type: String, mod_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(expected_type, "") = 0, String.instr(got_type, "") = 0, String.instr(mod_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-TYP-2007", result.module_name.full = mod_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(mod_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("type mismatch: expected ${expected}, got ${got}", expected: expected_type, got: got_type)
    return make_diagnostic("FH-TYP-2007", message, module_name, symbol_name)
end make_type_mismatch_diagnostic

function make_unknown_field_diagnostic(record_name: String, field_name: String, mod_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(record_name, "") = 0, String.instr(field_name, "") = 0, String.instr(mod_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-TYP-2009", result.module_name.full = mod_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(mod_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("unknown field ${field} on record ${record}", field: field_name, record: record_name)
    return make_diagnostic("FH-TYP-2009", message, module_name, symbol_name)
end make_unknown_field_diagnostic

function make_shadowing_diagnostic(var_name: String, mod_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(var_name, "") = 0, String.instr(mod_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-SEM-1005", result.module_name.full = mod_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(mod_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("variable shadowing or duplicate declaration: ${name}", name: var_name)
    return make_diagnostic("FH-SEM-1005", message, module_name, symbol_name)
end make_shadowing_diagnostic

function make_unknown_variable_diagnostic(var_name: String, mod_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(var_name, "") = 0, String.instr(mod_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-SEM-1006", result.module_name.full = mod_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(mod_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("unknown variable identifier: ${name}", name: var_name)
    return make_diagnostic("FH-SEM-1006", message, module_name, symbol_name)
end make_unknown_variable_diagnostic

function make_array_bounds_diagnostic(index: Integer, size: Integer, mod_full: String, symbol_raw: String) returns Diagnostic
requires String.instr(mod_full, "") = 0, String.instr(symbol_raw, "") = 0
ensures result.code = "FH-TYP-2011", result.module_name.full = mod_full, result.symbol_name.raw = symbol_raw, String.instr(result.code, "FH-") = 0
is
    let module_name: ModuleName = make_module_name(mod_full)
    let symbol_name: SymbolName = make_symbol_name(symbol_raw)
    let message: String = String.template("static array index out of bounds: index ${idx} for size ${sz}", idx: String.template("${index}", index: index), sz: String.template("${size}", size: size))
    return make_diagnostic("FH-TYP-2011", message, module_name, symbol_name)
end make_array_bounds_diagnostic

end Compiler.Core.Diagnostics