function skip_ws(json: String, ptr: Integer, len: Integer) returns Integer
is
    let i: Integer = ptr
    let done: Boolean = false
    while i < len and not done invariant i >= 0 and i <= len do
        let ch: String = String.substr(json, i, 1)
        if ch = " " or ch = "\n" or ch = "\r" or ch = "\t" then
            i := i + 1
        else
            done := true
        end if
    end while
    return i
end skip_ws

function expect_char(json: String, ptr: Integer, len: Integer, expected: String) returns Integer
is
    let i: Integer = skip_ws(json, ptr, len)
    return i + 1
end expect_char

function peek_char(json: String, ptr: Integer, len: Integer) returns String
is
    let i: Integer = skip_ws(json, ptr, len)
    if i >= len then
        return ""
    end if
    return String.substr(json, i, 1)
end peek_char

function advance_ptr(json: String, ptr: Integer, len: Integer) returns Integer
is
    return ptr + 1
end advance_ptr

function parse_str(json: String, ptr: Integer, len: Integer) returns StrParseResult
is
    let i: Integer = skip_ws(json, ptr, len)
    i := i + 1
    let val: String = ""
    let done: Boolean = false
    while i < len and not done invariant i >= 0 and i <= len do
        let ch: String = String.substr(json, i, 1)
        if ch = "\"" then
            done := true
            i := i + 1
        else
            if ch = "\\" then
                let next_ch: String = String.substr(json, i + 1, 1)
                val := String.concat(val, next_ch)
                i := i + 2
            else
                val := String.concat(val, ch)
                i := i + 1
            end if
        end if
    end while
    return StrParseResult { val: val, next_ptr: i }
end parse_str

function parse_manifest(manifest_content: String) returns ProjectManifest
is
    let manifest_len: Integer = String.length(manifest_content)
    let ptr: Integer = manifest_len - manifest_len
    
    let entry_module: String = ""
    let entry_routine: String = ""
    
    ptr := expect_char(manifest_content, ptr, manifest_len, "{")
    
    let done: Boolean = false
    while ptr < manifest_len and not done invariant ptr >= 0 do
        let peek: String = peek_char(manifest_content, ptr, manifest_len)
        if peek = "}" or peek = "" then
            done := true
            ptr := expect_char(manifest_content, ptr, manifest_len, "}")
        else
            let key_res: StrParseResult = parse_str(manifest_content, ptr, manifest_len)
            let key: String = key_res.val
            ptr := key_res.next_ptr
            
            ptr := expect_char(manifest_content, ptr, manifest_len, ":")
            
            let val_res: StrParseResult = parse_str(manifest_content, ptr, manifest_len)
            let val: String = val_res.val
            ptr := val_res.next_ptr
            
            if key = "entry_module" then
                entry_module := val
            else
                if key = "entry_routine" then
                    entry_routine := val
                end if
            end if
            
            let peek_next: String = peek_char(manifest_content, ptr, manifest_len)
            if peek_next = "," then
                ptr := expect_char(manifest_content, ptr, manifest_len, ",")
            end if
        end if
    end while
    
    return ProjectManifest {
        entry_module: entry_module,
        entry_routine: entry_routine
    }
end parse_manifest

function load_project_ir(json_content: String) returns LoadedProject
is
    let json_len: Integer = String.length(json_content)
    let ptr: Integer = json_len - json_len
    
    let routines: Array<IrRoutine, 10> = [
        empty_routine(), empty_routine(), empty_routine(), empty_routine(), empty_routine(),
        empty_routine(), empty_routine(), empty_routine(), empty_routine(), empty_routine()
    ]
    let routine_count: Integer = 0
    
    ptr := expect_char(json_content, ptr, json_len, "{")
    
    let done_main: Boolean = false
    while ptr < json_len and not done_main invariant ptr >= 0 and routine_count >= 0 and routine_count <= 10 do
        let peek: String = peek_char(json_content, ptr, json_len)
        if peek = "}" or peek = "" then
            done_main := true
            ptr := expect_char(json_content, ptr, json_len, "}")
        else
            let key_res: StrParseResult = parse_str(json_content, ptr, json_len)
            let key: String = key_res.val
            ptr := key_res.next_ptr
            
            ptr := expect_char(json_content, ptr, json_len, ":")
            
            if key = "routines" then
                ptr := expect_char(json_content, ptr, json_len, "[")
                
                let done_routines: Boolean = false
                while ptr < json_len and not done_routines invariant ptr >= 0 and routine_count >= 0 and routine_count <= 10 do
                    let peek_r: String = peek_char(json_content, ptr, json_len)
                    if peek_r = "]" or peek_r = "" then
                        done_routines := true
                        ptr := expect_char(json_content, ptr, json_len, "]")
                    else
                        ptr := expect_char(json_content, ptr, json_len, "{")
                        let current_routine: IrRoutine = empty_routine()
                        
                        let done_routine: Boolean = false
                        while ptr < json_len and not done_routine invariant ptr >= 0 do
                            let peek_f: String = peek_char(json_content, ptr, json_len)
                            if peek_f = "}" or peek_f = "" then
                                done_routine := true
                                ptr := expect_char(json_content, ptr, json_len, "}")
                            else
                                let fkey_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                let fkey: String = fkey_res.val
                                ptr := fkey_res.next_ptr
                                
                                ptr := expect_char(json_content, ptr, json_len, ":")
                                
                                if fkey = "name" then
                                    let rname_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                    current_routine.name := rname_res.val
                                    ptr := rname_res.next_ptr
                                else
                                    if fkey = "blocks" then
                                        ptr := expect_char(json_content, ptr, json_len, "[")
                                        
                                        let done_blocks: Boolean = false
                                        while ptr < json_len and not done_blocks invariant ptr >= 0 do
                                            let peek_b: String = peek_char(json_content, ptr, json_len)
                                            if peek_b = "]" or peek_b = "" then
                                                done_blocks := true
                                                ptr := expect_char(json_content, ptr, json_len, "]")
                                            else
                                                ptr := expect_char(json_content, ptr, json_len, "{")
                                                let current_block: IrBasicBlock = empty_block()
                                                
                                                let done_block: Boolean = false
                                                while ptr < json_len and not done_block invariant ptr >= 0 do
                                                    let peek_bf: String = peek_char(json_content, ptr, json_len)
                                                    if peek_bf = "} " or peek_bf = "}" or peek_bf = "" then
                                                        done_block := true
                                                        ptr := expect_char(json_content, ptr, json_len, "}")
                                                    else
                                                        let bfkey_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                                        let bfkey: String = bfkey_res.val
                                                        ptr := bfkey_res.next_ptr
                                                        
                                                        ptr := expect_char(json_content, ptr, json_len, ":")
                                                        
                                                        if bfkey = "label" then
                                                            let blabel_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                                            current_block.label := blabel_res.val
                                                            ptr := blabel_res.next_ptr
                                                        else
                                                            if bfkey = "insts" then
                                                                ptr := expect_char(json_content, ptr, json_len, "[")
                                                                
                                                                let done_insts: Boolean = false
                                                                while ptr < json_len and not done_insts invariant ptr >= 0 do
                                                                    let peek_i: String = peek_char(json_content, ptr, json_len)
                                                                    if peek_i = "]" or peek_i = "" then
                                                                        done_insts := true
                                                                        ptr := expect_char(json_content, ptr, json_len, "]")
                                                                    else
                                                                        ptr := expect_char(json_content, ptr, json_len, "{")
                                                                        
                                                                        let op: String = ""
                                                                        let dest: String = ""
                                                                        let arg0: String = ""
                                                                        let arg1: String = ""
                                                                        
                                                                        let done_inst: Boolean = false
                                                                        while ptr < json_len and not done_inst invariant ptr >= 0 do
                                                                            let peek_if: String = peek_char(json_content, ptr, json_len)
                                                                            if peek_if = "}" or peek_if = "" then
                                                                                done_inst := true
                                                                                ptr := expect_char(json_content, ptr, json_len, "}")
                                                                            else
                                                                                let ikey_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                                                                let ikey: String = ikey_res.val
                                                                                ptr := ikey_res.next_ptr
                                                                                
                                                                                ptr := expect_char(json_content, ptr, json_len, ":")
                                                                                
                                                                                let ival_res: StrParseResult = parse_str(json_content, ptr, json_len)
                                                                                let ival: String = ival_res.val
                                                                                ptr := ival_res.next_ptr
                                                                                
                                                                                if ikey = "op" then
                                                                                    op := ival
                                                                                else
                                                                                    if ikey = "dest" then
                                                                                        dest := ival
                                                                                    else
                                                                                        if ikey = "arg0" then
                                                                                            arg0 := ival
                                                                                        else
                                                                                            if ikey = "arg1" then
                                                                                                arg1 := ival
                                                                                            end if
                                                                                        end if
                                                                                    end if
                                                                                end if
                                                                                
                                                                                let peek_inext: String = peek_char(json_content, ptr, json_len)
                                                                                if peek_inext = "," then
                                                                                    ptr := expect_char(json_content, ptr, json_len, ",")
                                                                                end if
                                                                            end if
                                                                        end while
                                                                        
                                                                        if op = "RET" then
                                                                            current_block.terminator_kind := "RETURN"
                                                                            current_block.return_reg := arg0
                                                                        else
                                                                            let inst: IrInstruction = empty_instruction()
                                                                            inst.dest_reg := dest
                                                                            
                                                                            if op = "ASSIGN" then
                                                                                inst.kind := "ASSIGN"
                                                                                inst.literal_value := arg0
                                                                            else
                                                                                if op = "CALL" then
                                                                                    inst.kind := "CALL"
                                                                                    inst.op := arg0
                                                                                    inst.src_reg_left := arg1
                                                                                else
                                                                                    inst.kind := "BINARY_OP"
                                                                                    inst.op := op
                                                                                    inst.src_reg_left := arg0
                                                                                    let is_digit: Boolean = false
                                                                                    if String.length(arg1) > 0 then
                                                                                        let first_ch: String = String.substr(arg1, 0, 1)
                                                                                        if first_ch = "0" or first_ch = "1" or first_ch = "2" or first_ch = "3" or first_ch = "4" or first_ch = "5" or first_ch = "6" or first_ch = "7" or first_ch = "8" or first_ch = "9" then
                                                                                            is_digit := true
                                                                                        end if
                                                                                    end if
                                                                                    if is_digit then
                                                                                        inst.literal_value := arg1
                                                                                    else
                                                                                        inst.src_reg_right := arg1
                                                                                    end if
                                                                                end if
                                                                            end if
                                                                            
                                                                            let inst_idx: Integer = current_block.instruction_count
                                                                            if inst_idx >= 0 and inst_idx < 64 then
                                                                                current_block.instructions := set_instruction(current_block.instructions, inst_idx, inst)
                                                                                current_block.instruction_count := inst_idx + 1
                                                                            end if
                                                                        end if
                                                                        
                                                                        let peek_inext_list: String = peek_char(json_content, ptr, json_len)
                                                                        if peek_inext_list = "," then
                                                                            ptr := expect_char(json_content, ptr, json_len, ",")
                                                                        end if
                                                                    end if
                                                                end while
                                                            else
                                                                ptr := advance_ptr(json_content, ptr, json_len)
                                                            end if
                                                        end if
                                                        
                                                        let peek_bfnext: String = peek_char(json_content, ptr, json_len)
                                                        if peek_bfnext = "," then
                                                            ptr := expect_char(json_content, ptr, json_len, ",")
                                                        end if
                                                    end if
                                                end while
                                                
                                                let blk_idx: Integer = current_routine.block_count
                                                if blk_idx >= 0 and blk_idx < 32 then
                                                    current_routine.blocks := set_block(current_routine.blocks, blk_idx, current_block)
                                                    current_routine.block_count := blk_idx + 1
                                                end if
                                                
                                                let peek_bnext_list: String = peek_char(json_content, ptr, json_len)
                                                if peek_bnext_list = "," then
                                                    ptr := expect_char(json_content, ptr, json_len, ",")
                                                end if
                                            end if
                                        end while
                                    else
                                        ptr := advance_ptr(json_content, ptr, json_len)
                                    end if
                                end if
                                
                                let peek_rnext: String = peek_char(json_content, ptr, json_len)
                                if peek_rnext = "," then
                                    ptr := expect_char(json_content, ptr, json_len, ",")
                                end if
                            end if
                        end while
                        
                        if routine_count >= 0 and routine_count < 10 then
                            routines := set_routine(routines, routine_count, current_routine)
                            routine_count := routine_count + 1
                        end if
                        
                        let peek_rnext_list: String = peek_char(json_content, ptr, json_len)
                        if peek_rnext_list = "," then
                            ptr := expect_char(json_content, ptr, json_len, ",")
                        end if
                    end if
                  end while
              else
                  ptr := advance_ptr(json_content, ptr, json_len)
              end if
              
              let peek_mnext: String = peek_char(json_content, ptr, json_len)
              if peek_mnext = "," then
                  ptr := expect_char(json_content, ptr, json_len, ",")
              end if
          end if
      end while
      
      return LoadedProject {
          routine_count: routine_count,
          routines: routines
      }
end load_project_ir

end Compiler.Core.Loader_new
