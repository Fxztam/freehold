module Compiler.Core.Ast

import Compiler.Core.Token exposing SourceSpan

type AstNodeKind is record
    name: String
end record

type IdentifierNode is record
    span: SourceSpan
    name: String
end record

type LiteralNode is record
    span: SourceSpan
    literal_kind: String
    text: String
end record

type ModuleNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type RecordTypeNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type ModuleWithRecordNode is record
    module_node: ModuleNode
    record_type: RecordTypeNode
end record

type TypeDeclNode is record
    span: SourceSpan
    name: IdentifierNode
    base_type: IdentifierNode
    min_value: String
    max_value: String
end record

type ModuleWithTypeDeclNode is record
    module_node: ModuleNode
    type_decl: TypeDeclNode
end record

type FunctionNode is record
    span: SourceSpan
    name: IdentifierNode
    return_type: IdentifierNode
    return_literal: LiteralNode
end record

type ModuleWithFunctionNode is record
    module_node: ModuleNode
    routine: FunctionNode
end record

type ProcedureNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type ModuleWithProcedureNode is record
    module_node: ModuleNode
    routine: ProcedureNode
end record

type ImportNode is record
    span: SourceSpan
    module_name: IdentifierNode
    exposed_name: IdentifierNode
end record

type ModuleWithImportNode is record
    module_node: ModuleNode
    import_decl: ImportNode
end record

type ImportReferenceNode is record
    span: SourceSpan
    import_decl: ImportNode
    symbol_name: IdentifierNode
end record

type FunctionImportReferenceNode is record
    span: SourceSpan
    name: IdentifierNode
    return_type: IdentifierNode
    return_symbol: ImportReferenceNode
end record

type ModuleWithImportReferenceNode is record
    module_node: ModuleNode
    import_decl: ImportNode
    routine: FunctionImportReferenceNode
end record

type RecordLiteralNode is record
    span: SourceSpan
    type_name: IdentifierNode
    field0_name: IdentifierNode
    field0_value: LiteralNode
    field1_name: IdentifierNode
    field1_value: LiteralNode
    field2_name: IdentifierNode
    field2_value: LiteralNode
    field_count: Integer
end record

type ModuleWithRecordLiteralNode is record
    module_node: ModuleNode
    record_literal: RecordLiteralNode
end record

type ReturnStmtNode is record
    span: SourceSpan
    kind: String
    val: LiteralNode
    error_ref: IdentifierNode
end record

type ModuleWithReturnNode is record
    module_node: ModuleNode
    return_stmt: ReturnStmtNode
end record

type CallStmtNode is record
    span: SourceSpan
    routine_name: IdentifierNode
    argument: LiteralNode
    aborts_type: IdentifierNode
end record

type ModuleWithCallNode is record
    module_node: ModuleNode
    call_stmt: CallStmtNode
end record

type NestedCallStmtNode is record
    span: SourceSpan
    var_name: IdentifierNode
    outer_routine: IdentifierNode
    inner_routine: IdentifierNode
    argument: LiteralNode
end record

type ModuleWithNestedCallNode is record
    module_node: ModuleNode
    nested_call: NestedCallStmtNode
end record

type LoweredCallNode is record
    span: SourceSpan
    var_name: IdentifierNode
    routine_name: IdentifierNode
    argument_var: String
end record

type ModuleWithLoweredCallsNode is record
    module_node: ModuleNode
    first_call: LoweredCallNode
    second_call: LoweredCallNode
end record

type ExprNode is record
    span: SourceSpan
    kind: String
    literal_kind: String
    text: String
    op: String
    left_node_idx: Integer
    right_node_idx: Integer
    routine_name: String
    arg0_idx: Integer
    arg1_idx: Integer
    arg_count: Integer
    invariant_idx: Integer
end record

type StmtNode is record
    span: SourceSpan
    kind: String
    var_name: String
    var_type: String
    expr_idx: Integer
    cond_expr_idx: Integer
    then_block_start_idx: Integer
    then_block_len: Integer
    else_block_start_idx: Integer
    else_block_len: Integer
    routine_name: String
    aborts_type: String
end record

-- ============================================================
-- Modern AST Nodes with SourceSpans for full-strength module declarations
-- ============================================================

type FieldNode is record
    span: SourceSpan
    name: IdentifierNode
    type_ref: IdentifierNode
end record

type RecordTypeWithFieldsNode is record
    span: SourceSpan
    name: IdentifierNode
    fields: Array<FieldNode, 16>
    field_count: Integer
end record

type ModuleWithRecordWithFieldsNode is record
    module_node: ModuleNode
    record_type: RecordTypeWithFieldsNode
end record

type ParamNode is record
    span: SourceSpan
    name: IdentifierNode
    type_ref: IdentifierNode
end record

type AbortClauseNode is record
    span: SourceSpan
    error_name: IdentifierNode
end record

type DependsNode is record
    span: SourceSpan
    target: IdentifierNode
    sources: String
end record

type GlobalNode is record
    span: SourceSpan
    name: IdentifierNode
    mode: String
end record

type ErrorDeclNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type RoutineDeclNode is record
    span: SourceSpan
    name: IdentifierNode
    kind: String           -- "function" | "procedure"
    is_async: Boolean
    params: Array<ParamNode, 8>
    param_count: Integer
    return_type: IdentifierNode
    has_requires: Boolean
    has_ensures: Boolean
    abort_clauses: Array<AbortClauseNode, 8>
    aborts_count: Integer
    depends_specs: Array<DependsNode, 8>
    depends_count: Integer
    globals_specs: Array<GlobalNode, 8>
    globals_count: Integer
end record

type ModuleDeclNode is record
    span: SourceSpan
    name: IdentifierNode
    imports: Array<ImportNode, 16>
    import_count: Integer
    type_decls: Array<TypeDeclNode, 16>
    type_count: Integer
    record_decls: Array<RecordTypeWithFieldsNode, 16>
    record_count: Integer
    error_decls: Array<ErrorDeclNode, 16>
    error_count: Integer
    routines: Array<RoutineDeclNode, 32>
    routine_count: Integer
end record




function make_ast_node_kind(name: String) returns AstNodeKind
requires String.instr(name, "") = 0
ensures result.name = name
is
    return AstNodeKind { name: name }
end make_ast_node_kind

function make_identifier_node(span: SourceSpan, name: String) returns IdentifierNode
requires String.instr(name, "") = 0
ensures result.name = name
is
    return IdentifierNode { span: span, name: name }
end make_identifier_node

function make_literal_node(span: SourceSpan, literal_kind: String, text: String) returns LiteralNode
requires String.instr(literal_kind, "") = 0
ensures result.literal_kind = literal_kind, result.text = text
is
    return LiteralNode { span: span, literal_kind: literal_kind, text: text }
end make_literal_node

function make_module_node(span: SourceSpan, name: IdentifierNode) returns ModuleNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return ModuleNode { span: span, name: name }
end make_module_node

function make_record_type_node(span: SourceSpan, name: IdentifierNode) returns RecordTypeNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return RecordTypeNode { span: span, name: name }
end make_record_type_node

function make_module_with_record_node(module_node: ModuleNode, record_type: RecordTypeNode) returns ModuleWithRecordNode
requires String.instr(module_node.name.name, "") = 0, String.instr(record_type.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.record_type.name.name = record_type.name.name
is
    return ModuleWithRecordNode { module_node: module_node, record_type: record_type }
end make_module_with_record_node

function make_type_decl_node(span: SourceSpan, name: IdentifierNode, base_type: IdentifierNode, min_value: String, max_value: String) returns TypeDeclNode
requires String.instr(name.name, "") = 0, String.instr(base_type.name, "") = 0
ensures result.name.name = name.name, result.base_type.name = base_type.name, result.min_value = min_value, result.max_value = max_value
is
    return TypeDeclNode { span: span, name: name, base_type: base_type, min_value: min_value, max_value: max_value }
end make_type_decl_node

function make_module_with_type_decl_node(module_node: ModuleNode, type_decl: TypeDeclNode) returns ModuleWithTypeDeclNode
requires String.instr(module_node.name.name, "") = 0, String.instr(type_decl.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.type_decl.name.name = type_decl.name.name
is
    return ModuleWithTypeDeclNode { module_node: module_node, type_decl: type_decl }
end make_module_with_type_decl_node

function make_function_node(span: SourceSpan, name: IdentifierNode, return_type: IdentifierNode, return_literal: LiteralNode) returns FunctionNode
requires String.instr(name.name, "") = 0, String.instr(return_type.name, "") = 0
ensures result.name.name = name.name, result.return_type.name = return_type.name
is
    return FunctionNode { span: span, name: name, return_type: return_type, return_literal: return_literal }
end make_function_node

function make_module_with_function_node(module_node: ModuleNode, routine: FunctionNode) returns ModuleWithFunctionNode
requires String.instr(module_node.name.name, "") = 0, String.instr(routine.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.routine.name.name = routine.name.name
is
    return ModuleWithFunctionNode { module_node: module_node, routine: routine }
end make_module_with_function_node

function make_procedure_node(span: SourceSpan, name: IdentifierNode) returns ProcedureNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return ProcedureNode { span: span, name: name }
end make_procedure_node

function make_module_with_procedure_node(module_node: ModuleNode, routine: ProcedureNode) returns ModuleWithProcedureNode
requires String.instr(module_node.name.name, "") = 0, String.instr(routine.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.routine.name.name = routine.name.name
is
    return ModuleWithProcedureNode { module_node: module_node, routine: routine }
end make_module_with_procedure_node

function make_import_node(span: SourceSpan, module_name: IdentifierNode, exposed_name: IdentifierNode) returns ImportNode
requires String.instr(module_name.name, "") = 0, String.instr(exposed_name.name, "") = 0
ensures result.module_name.name = module_name.name, result.exposed_name.name = exposed_name.name
is
    return ImportNode { span: span, module_name: module_name, exposed_name: exposed_name }
end make_import_node

function make_module_with_import_node(module_node: ModuleNode, import_decl: ImportNode) returns ModuleWithImportNode
requires String.instr(module_node.name.name, "") = 0, String.instr(import_decl.module_name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.import_decl.module_name.name = import_decl.module_name.name
is
    return ModuleWithImportNode { module_node: module_node, import_decl: import_decl }
end make_module_with_import_node

function make_import_reference_node(span: SourceSpan, import_decl: ImportNode, symbol_name: IdentifierNode) returns ImportReferenceNode
requires String.instr(import_decl.module_name.name, "") = 0, String.instr(symbol_name.name, "") = 0
ensures result.import_decl.module_name.name = import_decl.module_name.name, result.symbol_name.name = symbol_name.name
is
    return ImportReferenceNode { span: span, import_decl: import_decl, symbol_name: symbol_name }
end make_import_reference_node

function make_function_import_reference_node(span: SourceSpan, name: IdentifierNode, return_type: IdentifierNode, return_symbol: ImportReferenceNode) returns FunctionImportReferenceNode
requires String.instr(name.name, "") = 0, String.instr(return_type.name, "") = 0, String.instr(return_symbol.symbol_name.name, "") = 0
ensures result.name.name = name.name, result.return_symbol.symbol_name.name = return_symbol.symbol_name.name
is
    return FunctionImportReferenceNode { span: span, name: name, return_type: return_type, return_symbol: return_symbol }
end make_function_import_reference_node

function make_module_with_import_reference_node(module_node: ModuleNode, import_decl: ImportNode, routine: FunctionImportReferenceNode) returns ModuleWithImportReferenceNode
requires String.instr(module_node.name.name, "") = 0, String.instr(import_decl.module_name.name, "") = 0, String.instr(routine.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.routine.name.name = routine.name.name, result.routine.return_symbol.symbol_name.name = routine.return_symbol.symbol_name.name
is
    return ModuleWithImportReferenceNode { module_node: module_node, import_decl: import_decl, routine: routine }
end make_module_with_import_reference_node

function identifier_key(identifier: IdentifierNode) returns String
requires String.instr(identifier.name, "") = 0
ensures String.instr(result, identifier.name) >= 0
is
    return String.template("Identifier@${source}:${line}:${column}:${name}", source: identifier.span.source_name, line: identifier.span.start_line, column: identifier.span.start_column, name: identifier.name)
end identifier_key

function literal_text(literal: LiteralNode) returns String
requires String.instr(literal.literal_kind, "") = 0
ensures String.instr(result, literal.text) >= 0
is
    return String.template("Literal.${kind}:${text}", kind: literal.literal_kind, text: literal.text)
end literal_text

function module_key(module_node: ModuleNode) returns String
requires String.instr(module_node.name.name, "") = 0
ensures String.instr(result, module_node.name.name) >= 0
is
    return String.template("Module:${name}@${source}:${line}:${column}", name: module_node.name.name, source: module_node.span.source_name, line: module_node.span.start_line, column: module_node.span.start_column)
end module_key

function module_text(module_node: ModuleNode) returns String
requires String.instr(module_node.name.name, "") = 0
ensures String.instr(result, module_node.name.name) >= 0
is
    return String.template("${key}:identifier=${identifier}", key: module_key(module_node), identifier: identifier_key(module_node.name))
end module_text

function record_type_text(record_type: RecordTypeNode) returns String
requires String.instr(record_type.name.name, "") = 0
ensures String.instr(result, record_type.name.name) >= 0
is
    return String.template("RecordType:${name}@${source}:${line}:${column}", name: record_type.name.name, source: record_type.span.source_name, line: record_type.span.start_line, column: record_type.span.start_column)
end record_type_text

function module_with_record_text(module_node: ModuleWithRecordNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.record_type.name.name, "") = 0
ensures String.instr(result, module_node.record_type.name.name) >= 0
is
    return String.template("${module_name}:record=${record_val}", module_name: module_text(module_node.module_node), record_val: record_type_text(module_node.record_type))
end module_with_record_text

function type_decl_text(type_decl: TypeDeclNode) returns String
requires String.instr(type_decl.name.name, "") = 0, String.instr(type_decl.base_type.name, "") = 0
ensures String.instr(result, type_decl.name.name) >= 0
is
    return String.template("TypeDecl:${name}@${source}:${line}:${column}:base=${base}:range=${min_val}..${max_val}",
        name: type_decl.name.name,
        source: type_decl.span.source_name,
        line: type_decl.span.start_line,
        column: type_decl.span.start_column,
        base: type_decl.base_type.name,
        min_val: type_decl.min_value,
        max_val: type_decl.max_value
    )
end type_decl_text

function module_with_type_decl_text(module_node: ModuleWithTypeDeclNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.type_decl.name.name, "") = 0
ensures String.instr(result, module_node.type_decl.name.name) >= 0
is
    return String.template("${module_name}:type_decl=${type_decl_val}", module_name: module_text(module_node.module_node), type_decl_val: type_decl_text(module_node.type_decl))
end module_with_type_decl_text

function function_text(routine: FunctionNode) returns String
requires String.instr(routine.name.name, "") = 0, String.instr(routine.return_type.name, "") = 0
ensures String.instr(result, routine.name.name) >= 0
is
    return String.template("Function:${name}@${source}:${line}:${column}:returns=${return_type}:return=${literal}", name: routine.name.name, source: routine.span.source_name, line: routine.span.start_line, column: routine.span.start_column, return_type: routine.return_type.name, literal: literal_text(routine.return_literal))
end function_text

function module_with_function_text(module_node: ModuleWithFunctionNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.routine.name.name, "") = 0
ensures String.instr(result, module_node.routine.name.name) >= 0
is
    return String.template("${module_name}:function=${routine}", module_name: module_text(module_node.module_node), routine: function_text(module_node.routine))
end module_with_function_text

function procedure_text(routine: ProcedureNode) returns String
requires String.instr(routine.name.name, "") = 0
ensures String.instr(result, routine.name.name) >= 0
is
    return String.template("Procedure:${name}@${source}:${line}:${column}", name: routine.name.name, source: routine.span.source_name, line: routine.span.start_line, column: routine.span.start_column)
end procedure_text

function module_with_procedure_text(module_node: ModuleWithProcedureNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.routine.name.name, "") = 0
ensures String.instr(result, module_node.routine.name.name) >= 0
is
    return String.template("${module_name}:procedure=${routine}", module_name: module_text(module_node.module_node), routine: procedure_text(module_node.routine))
end module_with_procedure_text

function import_text(import_decl: ImportNode) returns String
requires String.instr(import_decl.module_name.name, "") = 0, String.instr(import_decl.exposed_name.name, "") = 0
ensures String.instr(result, import_decl.exposed_name.name) >= 0
is
    return String.template("Import:${module_name}@${source}:${line}:${column}:exposing=${exposed}", module_name: import_decl.module_name.name, source: import_decl.span.source_name, line: import_decl.span.start_line, column: import_decl.span.start_column, exposed: import_decl.exposed_name.name)
end import_text

function module_with_import_text(module_node: ModuleWithImportNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.import_decl.module_name.name, "") = 0
ensures String.instr(result, module_node.import_decl.module_name.name) >= 0
is
    return String.template("${module_name}:import=${import_decl}", module_name: module_text(module_node.module_node), import_decl: import_text(module_node.import_decl))
end module_with_import_text

function import_reference_text(import_reference: ImportReferenceNode) returns String
requires String.instr(import_reference.import_decl.module_name.name, "") = 0, String.instr(import_reference.symbol_name.name, "") = 0
ensures String.instr(result, import_reference.symbol_name.name) >= 0
is
    return String.template("ImportRef:${symbol}@${source}:${line}:${column}:from=${module_name}", symbol: import_reference.symbol_name.name, source: import_reference.span.source_name, line: import_reference.span.start_line, column: import_reference.span.start_column, module_name: import_reference.import_decl.module_name.name)
end import_reference_text

function function_import_reference_text(routine: FunctionImportReferenceNode) returns String
requires String.instr(routine.name.name, "") = 0, String.instr(routine.return_type.name, "") = 0
ensures String.instr(result, routine.return_symbol.symbol_name.name) >= 0
is
    return String.template("Function:${name}@${source}:${line}:${column}:returns=${return_type}:return=${symbol}", name: routine.name.name, source: routine.span.source_name, line: routine.span.start_line, column: routine.span.start_column, return_type: routine.return_type.name, symbol: import_reference_text(routine.return_symbol))
end function_import_reference_text

function module_with_import_reference_text(module_node: ModuleWithImportReferenceNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.routine.name.name, "") = 0
ensures String.instr(result, module_node.routine.return_symbol.symbol_name.name) >= 0
is
    return String.template("${module_name}:import=${import_decl}:function=${routine}", module_name: module_text(module_node.module_node), import_decl: import_text(module_node.import_decl), routine: function_import_reference_text(module_node.routine))
end module_with_import_reference_text

function make_record_literal_node(span: SourceSpan, type_name: IdentifierNode, field0_name: IdentifierNode, field0_value: LiteralNode, field1_name: IdentifierNode, field1_value: LiteralNode, field2_name: IdentifierNode, field2_value: LiteralNode, field_count: Integer) returns RecordLiteralNode
requires String.instr(type_name.name, "") = 0
ensures result.type_name.name = type_name.name, result.field_count = field_count
is
    return RecordLiteralNode {
        span: span,
        type_name: type_name,
        field0_name: field0_name,
        field0_value: field0_value,
        field1_name: field1_name,
        field1_value: field1_value,
        field2_name: field2_name,
        field2_value: field2_value,
        field_count: field_count
    }
end make_record_literal_node

function make_module_with_record_literal_node(module_node: ModuleNode, record_literal: RecordLiteralNode) returns ModuleWithRecordLiteralNode
requires String.instr(module_node.name.name, "") = 0, String.instr(record_literal.type_name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.record_literal.type_name.name = record_literal.type_name.name
is
    return ModuleWithRecordLiteralNode { module_node: module_node, record_literal: record_literal }
end make_module_with_record_literal_node

function make_return_stmt_node(span: SourceSpan, kind: String, val: LiteralNode, error_ref: IdentifierNode) returns ReturnStmtNode
requires String.instr(kind, "") = 0
ensures result.kind = kind, result.error_ref.name = error_ref.name
is
    return ReturnStmtNode { span: span, kind: kind, val: val, error_ref: error_ref }
end make_return_stmt_node

function make_module_with_return_node(module_node: ModuleNode, return_stmt: ReturnStmtNode) returns ModuleWithReturnNode
requires String.instr(module_node.name.name, "") = 0, String.instr(return_stmt.kind, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.return_stmt.kind = return_stmt.kind, result.return_stmt.error_ref.name = return_stmt.error_ref.name
is
    return ModuleWithReturnNode { module_node: module_node, return_stmt: return_stmt }
end make_module_with_return_node

function make_call_stmt_node(span: SourceSpan, routine_name: IdentifierNode, argument: LiteralNode, aborts_type: IdentifierNode) returns CallStmtNode
requires String.instr(routine_name.name, "") = 0
ensures result.routine_name.name = routine_name.name
is
    return CallStmtNode {
        span: span,
        routine_name: routine_name,
        argument: argument,
        aborts_type: aborts_type
    }
end make_call_stmt_node

function make_module_with_call_node(module_node: ModuleNode, call_stmt: CallStmtNode) returns ModuleWithCallNode
requires String.instr(module_node.name.name, "") = 0, String.instr(call_stmt.routine_name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.call_stmt.routine_name.name = call_stmt.routine_name.name
is
    return ModuleWithCallNode { module_node: module_node, call_stmt: call_stmt }
end make_module_with_call_node


function record_literal_text(record_literal: RecordLiteralNode) returns String
requires String.instr(record_literal.type_name.name, "") = 0
ensures String.instr(result, record_literal.type_name.name) >= 0
is
    return String.template("RecordLiteral:${type_name}:fields=${count}", type_name: record_literal.type_name.name, count: record_literal.field_count)
end record_literal_text

function module_with_record_literal_text(module_node: ModuleWithRecordLiteralNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.record_literal.type_name.name, "") = 0
ensures String.instr(result, module_node.record_literal.type_name.name) >= 0
is
    return String.template("${module_name}:literal=${literal}", module_name: module_text(module_node.module_node), literal: record_literal_text(module_node.record_literal))
end module_with_record_literal_text

function return_stmt_text(return_stmt: ReturnStmtNode) returns String
requires String.instr(return_stmt.kind, "") = 0
ensures String.instr(result, return_stmt.kind) >= 0
is
    return String.template("ReturnStmt:${kind}", kind: return_stmt.kind)
end return_stmt_text

function module_with_return_text(module_node: ModuleWithReturnNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.return_stmt.kind, "") = 0
ensures String.instr(result, module_node.return_stmt.kind) >= 0
is
    return String.template("${module_name}:return=${ret}", module_name: module_text(module_node.module_node), ret: return_stmt_text(module_node.return_stmt))
end module_with_return_text

function call_stmt_text(call_stmt: CallStmtNode) returns String
requires String.instr(call_stmt.routine_name.name, "") = 0
ensures String.instr(result, call_stmt.routine_name.name) >= 0
is
    return String.template("CallStmt:${name}:aborts=${err}", name: call_stmt.routine_name.name, err: call_stmt.aborts_type.name)
end call_stmt_text

function module_with_call_text(module_node: ModuleWithCallNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.call_stmt.routine_name.name, "") = 0
ensures String.instr(result, module_node.call_stmt.routine_name.name) >= 0
is
    return String.template("${module_name}:call=${call_val}", module_name: module_text(module_node.module_node), call_val: call_stmt_text(module_node.call_stmt))
end module_with_call_text

function make_nested_call_stmt_node(span: SourceSpan, var_name: IdentifierNode, outer_routine: IdentifierNode, inner_routine: IdentifierNode, argument: LiteralNode) returns NestedCallStmtNode
requires String.instr(var_name.name, "") = 0
ensures result.var_name.name = var_name.name
is
    return NestedCallStmtNode { span: span, var_name: var_name, outer_routine: outer_routine, inner_routine: inner_routine, argument: argument }
end make_nested_call_stmt_node

function make_module_with_nested_call_node(module_node: ModuleNode, nested_call: NestedCallStmtNode) returns ModuleWithNestedCallNode
requires String.instr(module_node.name.name, "") = 0, String.instr(nested_call.var_name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.nested_call.var_name.name = nested_call.var_name.name
is
    return ModuleWithNestedCallNode { module_node: module_node, nested_call: nested_call }
end make_module_with_nested_call_node

function make_lowered_call_node(span: SourceSpan, var_name: IdentifierNode, routine_name: IdentifierNode, argument_var: String) returns LoweredCallNode
requires String.instr(var_name.name, "") = 0
ensures result.var_name.name = var_name.name
is
    return LoweredCallNode { span: span, var_name: var_name, routine_name: routine_name, argument_var: argument_var }
end make_lowered_call_node

function make_module_with_lowered_calls_node(module_node: ModuleNode, first_call: LoweredCallNode, second_call: LoweredCallNode) returns ModuleWithLoweredCallsNode
requires String.instr(module_node.name.name, "") = 0, String.instr(first_call.var_name.name, "") = 0, String.instr(second_call.var_name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.first_call.var_name.name = first_call.var_name.name, result.second_call.var_name.name = second_call.var_name.name
is
    return ModuleWithLoweredCallsNode { module_node: module_node, first_call: first_call, second_call: second_call }
end make_module_with_lowered_calls_node

function nested_call_stmt_text(nested_call: NestedCallStmtNode) returns String
requires String.instr(nested_call.var_name.name, "") = 0
ensures String.instr(result, nested_call.var_name.name) >= 0
is
    return String.template("NestedCallStmt:var=${var}:outer=${outer}:inner=${inner}:arg=${arg}",
        var: nested_call.var_name.name,
        outer: nested_call.outer_routine.name,
        inner: nested_call.inner_routine.name,
        arg: nested_call.argument.text
    )
end nested_call_stmt_text

function module_with_nested_call_text(module_node: ModuleWithNestedCallNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.nested_call.var_name.name, "") = 0
ensures String.instr(result, module_node.nested_call.var_name.name) >= 0
is
    return String.template("${module_name}:nested_call=${call_val}", module_name: module_text(module_node.module_node), call_val: nested_call_stmt_text(module_node.nested_call))
end module_with_nested_call_text

function lowered_call_text(lowered: LoweredCallNode) returns String
requires String.instr(lowered.var_name.name, "") = 0
ensures String.instr(result, lowered.var_name.name) >= 0
is
    return String.template("LoweredCall:var=${var}:routine=${routine}:arg=${arg}",
        var: lowered.var_name.name,
        routine: lowered.routine_name.name,
        arg: lowered.argument_var
    )
end lowered_call_text

function module_with_lowered_calls_text(module_node: ModuleWithLoweredCallsNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.first_call.var_name.name, "") = 0, String.instr(module_node.second_call.var_name.name, "") = 0
ensures String.instr(result, module_node.first_call.var_name.name) >= 0
is
    return String.template("${module_name}:first=${first}:second=${second}",
        module_name: module_text(module_node.module_node),
        first: lowered_call_text(module_node.first_call),
        second: lowered_call_text(module_node.second_call)
    )
end module_with_lowered_calls_text

function make_expr_node(span: SourceSpan, kind: String, literal_kind: String, text: String, op: String, left_node_idx: Integer, right_node_idx: Integer, routine_name: String, arg0_idx: Integer, arg1_idx: Integer, arg_count: Integer, invariant_idx: Integer) returns ExprNode
requires String.instr(kind, "") = 0
ensures result.kind = kind
is
    return ExprNode {
        span: span,
        kind: kind,
        literal_kind: literal_kind,
        text: text,
        op: op,
        left_node_idx: left_node_idx,
        right_node_idx: right_node_idx,
        routine_name: routine_name,
        arg0_idx: arg0_idx,
        arg1_idx: arg1_idx,
        arg_count: arg_count,
        invariant_idx: invariant_idx
    }
end make_expr_node

function make_stmt_node(span: SourceSpan, kind: String, var_name: String, var_type: String, expr_idx: Integer, cond_expr_idx: Integer, then_block_start_idx: Integer, then_block_len: Integer, else_block_start_idx: Integer, else_block_len: Integer, routine_name: String, aborts_type: String) returns StmtNode
requires String.instr(kind, "") = 0
ensures result.kind = kind
is
    return StmtNode {
        span: span,
        kind: kind,
        var_name: var_name,
        var_type: var_type,
        expr_idx: expr_idx,
        cond_expr_idx: cond_expr_idx,
        then_block_start_idx: then_block_start_idx,
        then_block_len: then_block_len,
        else_block_start_idx: else_block_start_idx,
        else_block_len: else_block_len,
        routine_name: routine_name,
        aborts_type: aborts_type
    }
end make_stmt_node

type RpcDeclNode is record
    span: SourceSpan
    name: IdentifierNode
    request_type: IdentifierNode
    response_type: IdentifierNode
    request_stream: Boolean
    response_stream: Boolean
end record

type ServiceDeclNode is record
    span: SourceSpan
    name: IdentifierNode
    rpc_count: Integer
end record

type ChannelTypeNode is record
    span: SourceSpan
    element_type: IdentifierNode
end record

type SpawnStmtNode is record
    span: SourceSpan
    scope_name: IdentifierNode
    routine_name: IdentifierNode
    argument_name: String
end record

type JoinStmtNode is record
    span: SourceSpan
    scope_name: IdentifierNode
    handle_var_name: String
end record

function make_rpc_decl_node(
    span: SourceSpan,
    name: IdentifierNode,
    request_type: IdentifierNode,
    response_type: IdentifierNode,
    request_stream: Boolean,
    response_stream: Boolean
) returns RpcDeclNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name, result.request_stream = request_stream, result.response_stream = response_stream
is
    return RpcDeclNode {
        span: span,
        name: name,
        request_type: request_type,
        response_type: response_type,
        request_stream: request_stream,
        response_stream: response_stream
    }
end make_rpc_decl_node

function make_service_decl_node(span: SourceSpan, name: IdentifierNode, rpc_count: Integer) returns ServiceDeclNode
requires String.instr(name.name, "") = 0, rpc_count >= 0
ensures result.name.name = name.name
is
    return ServiceDeclNode { span: span, name: name, rpc_count: rpc_count }
end make_service_decl_node

function make_channel_type_node(span: SourceSpan, element_type: IdentifierNode) returns ChannelTypeNode
requires String.instr(element_type.name, "") = 0
ensures result.element_type.name = element_type.name
is
    return ChannelTypeNode { span: span, element_type: element_type }
end make_channel_type_node

function make_spawn_stmt_node(span: SourceSpan, scope_name: IdentifierNode, routine_name: IdentifierNode, argument_name: String) returns SpawnStmtNode
requires String.instr(scope_name.name, "") = 0, String.instr(routine_name.name, "") = 0
ensures result.scope_name.name = scope_name.name
is
    return SpawnStmtNode { span: span, scope_name: scope_name, routine_name: routine_name, argument_name: argument_name }
end make_spawn_stmt_node

function make_join_stmt_node(span: SourceSpan, scope_name: IdentifierNode, handle_var_name: String) returns JoinStmtNode
requires String.instr(scope_name.name, "") = 0
ensures result.scope_name.name = scope_name.name
is
    return JoinStmtNode { span: span, scope_name: scope_name, handle_var_name: handle_var_name }
end make_join_stmt_node

-- ============================================================
-- Modern AST constructors with SourceSpans
-- ============================================================

function make_field_node(span: SourceSpan, name: IdentifierNode, type_ref: IdentifierNode) returns FieldNode
requires String.instr(name.name, "") = 0, String.instr(type_ref.name, "") = 0
ensures result.name.name = name.name
is
    return FieldNode { span: span, name: name, type_ref: type_ref }
end make_field_node

function make_empty_field_node(source_name: String) returns FieldNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_ident: IdentifierNode = make_identifier_node(empty_span, "")
    return FieldNode { span: empty_span, name: empty_ident, type_ref: empty_ident }
end make_empty_field_node

function make_record_type_with_fields_node(span: SourceSpan, name: IdentifierNode, fields: Array<FieldNode, 16>, field_count: Integer) returns RecordTypeWithFieldsNode
requires String.instr(name.name, "") = 0, field_count >= 0
ensures result.name.name = name.name, result.field_count = field_count
is
    return RecordTypeWithFieldsNode { span: span, name: name, fields: fields, field_count: field_count }
end make_record_type_with_fields_node

function make_empty_record_type_with_fields_node(source_name: String) returns RecordTypeWithFieldsNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    let empty_f: FieldNode = make_empty_field_node(source_name)
    return RecordTypeWithFieldsNode {
        span: empty_span,
        name: empty_id,
        fields: [empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f, empty_f],
        field_count: 0
    }
end make_empty_record_type_with_fields_node

function make_module_with_record_with_fields_node(module_node: ModuleNode, record_type: RecordTypeWithFieldsNode) returns ModuleWithRecordWithFieldsNode
requires String.instr(module_node.name.name, "") = 0, String.instr(record_type.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.record_type.name.name = record_type.name.name
is
    return ModuleWithRecordWithFieldsNode { module_node: module_node, record_type: record_type }
end make_module_with_record_with_fields_node

function make_param_node(span: SourceSpan, name: IdentifierNode, type_ref: IdentifierNode) returns ParamNode
requires String.instr(name.name, "") = 0, String.instr(type_ref.name, "") = 0
ensures result.name.name = name.name, result.type_ref.name = type_ref.name
is
    return ParamNode { span: span, name: name, type_ref: type_ref }
end make_param_node

function make_empty_param_node(source_name: String) returns ParamNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    return ParamNode { span: empty_span, name: empty_id, type_ref: empty_id }
end make_empty_param_node

function make_abort_clause_node(span: SourceSpan, error_name: IdentifierNode) returns AbortClauseNode
requires String.instr(error_name.name, "") = 0
ensures result.error_name.name = error_name.name
is
    return AbortClauseNode { span: span, error_name: error_name }
end make_abort_clause_node

function make_empty_abort_clause_node(source_name: String) returns AbortClauseNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    return AbortClauseNode { span: empty_span, error_name: empty_id }
end make_empty_abort_clause_node

function make_depends_node(span: SourceSpan, target: IdentifierNode, sources: String) returns DependsNode
requires String.instr(target.name, "") = 0
ensures result.target.name = target.name
is
    return DependsNode { span: span, target: target, sources: sources }
end make_depends_node

function make_empty_depends_node(source_name: String) returns DependsNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    return DependsNode { span: empty_span, target: empty_id, sources: "" }
end make_empty_depends_node

function make_global_node(span: SourceSpan, name: IdentifierNode, mode: String) returns GlobalNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return GlobalNode { span: span, name: name, mode: mode }
end make_global_node

function make_empty_global_node(source_name: String) returns GlobalNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    return GlobalNode { span: empty_span, name: empty_id, mode: "" }
end make_empty_global_node

function make_error_decl_node(span: SourceSpan, name: IdentifierNode) returns ErrorDeclNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return ErrorDeclNode { span: span, name: name }
end make_error_decl_node

function make_empty_error_decl_node(source_name: String) returns ErrorDeclNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    return ErrorDeclNode { span: empty_span, name: empty_id }
end make_empty_error_decl_node

function make_routine_decl_node(
    span: SourceSpan,
    name: IdentifierNode,
    kind: String,
    is_async: Boolean,
    params: Array<ParamNode, 8>,
    param_count: Integer,
    return_type: IdentifierNode,
    has_requires: Boolean,
    has_ensures: Boolean,
    abort_clauses: Array<AbortClauseNode, 8>,
    aborts_count: Integer,
    depends_specs: Array<DependsNode, 8>,
    depends_count: Integer,
    globals_specs: Array<GlobalNode, 8>,
    globals_count: Integer
) returns RoutineDeclNode
requires String.instr(name.name, "") = 0, param_count >= 0
ensures result.name.name = name.name
is
    return RoutineDeclNode {
        span: span,
        name: name,
        kind: kind,
        is_async: is_async,
        params: params,
        param_count: param_count,
        return_type: return_type,
        has_requires: has_requires,
        has_ensures: has_ensures,
        abort_clauses: abort_clauses,
        aborts_count: aborts_count,
        depends_specs: depends_specs,
        depends_count: depends_count,
        globals_specs: globals_specs,
        globals_count: globals_count
    }
end make_routine_decl_node

function make_empty_routine_decl_node(source_name: String) returns RoutineDeclNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    let p: ParamNode = make_empty_param_node(source_name)
    let a: AbortClauseNode = make_empty_abort_clause_node(source_name)
    let d: DependsNode = make_empty_depends_node(source_name)
    let g: GlobalNode = make_empty_global_node(source_name)
    return RoutineDeclNode {
        span: empty_span,
        name: empty_id,
        kind: "",
        is_async: false,
        params: [p, p, p, p, p, p, p, p],
        param_count: 0,
        return_type: empty_id,
        has_requires: false,
        has_ensures: false,
        abort_clauses: [a, a, a, a, a, a, a, a],
        aborts_count: 0,
        depends_specs: [d, d, d, d, d, d, d, d],
        depends_count: 0,
        globals_specs: [g, g, g, g, g, g, g, g],
        globals_count: 0
    }
end make_empty_routine_decl_node

function make_empty_module_decl_node(source_name: String) returns ModuleDeclNode
requires String.instr(source_name, "") = 0
is
    let empty_span: SourceSpan = SourceSpan { source_name: source_name, start_line: 1, start_column: 1, end_line: 1, end_column: 1 }
    let empty_id: IdentifierNode = make_identifier_node(empty_span, "")
    let imp: ImportNode = ImportNode { span: empty_span, module_name: empty_id, exposed_name: empty_id }
    let td: TypeDeclNode = TypeDeclNode { span: empty_span, name: empty_id, base_type: empty_id, min_value: "", max_value: "" }
    let rd: RecordTypeWithFieldsNode = make_empty_record_type_with_fields_node(source_name)
    let ed: ErrorDeclNode = make_empty_error_decl_node(source_name)
    let rt: RoutineDeclNode = make_empty_routine_decl_node(source_name)

    return ModuleDeclNode {
        span: empty_span,
        name: empty_id,
        imports: [imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp],
        import_count: 0,
        type_decls: [td, td, td, td, td, td, td, td, td, td, td, td, td, td, td, td],
        type_count: 0,
        record_decls: [rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd],
        record_count: 0,
        error_decls: [ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed],
        error_count: 0,
        routines: [rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt],
        routine_count: 0
    }
end make_empty_module_decl_node

-- ============================================================
-- Functional setter helpers for Arrays
-- ============================================================

function set_fields(arr: Array<FieldNode, 16>, idx: Integer, val: FieldNode) returns Array<FieldNode, 16>
requires idx >= 0, idx < 16
is
    let i0: FieldNode = arr[0]
    let i1: FieldNode = arr[1]
    let i2: FieldNode = arr[2]
    let i3: FieldNode = arr[3]
    let i4: FieldNode = arr[4]
    let i5: FieldNode = arr[5]
    let i6: FieldNode = arr[6]
    let i7: FieldNode = arr[7]
    let i8: FieldNode = arr[8]
    let i9: FieldNode = arr[9]
    let i10: FieldNode = arr[10]
    let i11: FieldNode = arr[11]
    let i12: FieldNode = arr[12]
    let i13: FieldNode = arr[13]
    let i14: FieldNode = arr[14]
    let i15: FieldNode = arr[15]
    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    if idx = 8 then i8 := val end if
    if idx = 9 then i9 := val end if
    if idx = 10 then i10 := val end if
    if idx = 11 then i11 := val end if
    if idx = 12 then i12 := val end if
    if idx = 13 then i13 := val end if
    if idx = 14 then i14 := val end if
    if idx = 15 then i15 := val end if
    return [i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15]
end set_fields

function set_params(arr: Array<ParamNode, 8>, idx: Integer, val: ParamNode) returns Array<ParamNode, 8>
requires idx >= 0, idx < 8
is
    let i0: ParamNode = arr[0]
    let i1: ParamNode = arr[1]
    let i2: ParamNode = arr[2]
    let i3: ParamNode = arr[3]
    let i4: ParamNode = arr[4]
    let i5: ParamNode = arr[5]
    let i6: ParamNode = arr[6]
    let i7: ParamNode = arr[7]
    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    return [i0, i1, i2, i3, i4, i5, i6, i7]
end set_params

function set_abort_clauses(arr: Array<AbortClauseNode, 8>, idx: Integer, val: AbortClauseNode) returns Array<AbortClauseNode, 8>
requires idx >= 0, idx < 8
is
    let i0: AbortClauseNode = arr[0]
    let i1: AbortClauseNode = arr[1]
    let i2: AbortClauseNode = arr[2]
    let i3: AbortClauseNode = arr[3]
    let i4: AbortClauseNode = arr[4]
    let i5: AbortClauseNode = arr[5]
    let i6: AbortClauseNode = arr[6]
    let i7: AbortClauseNode = arr[7]
    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    return [i0, i1, i2, i3, i4, i5, i6, i7]
end set_abort_clauses

function set_depends_specs(arr: Array<DependsNode, 8>, idx: Integer, val: DependsNode) returns Array<DependsNode, 8>
requires idx >= 0, idx < 8
is
    let i0: DependsNode = arr[0]
    let i1: DependsNode = arr[1]
    let i2: DependsNode = arr[2]
    let i3: DependsNode = arr[3]
    let i4: DependsNode = arr[4]
    let i5: DependsNode = arr[5]
