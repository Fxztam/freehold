module Compiler.Core.Ast

import Compiler.Core.Token exposing SourceSpan

type AstNodeKind is record
    name: String
end record

type IdentifierNode is record
    span: SourceSpan
    name: String
end record

type LiteralNode is record
    span: SourceSpan
    literal_kind: String
    text: String
end record

type ModuleNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type RecordTypeNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type ModuleWithRecordNode is record
    module_node: ModuleNode
    record_type: RecordTypeNode
end record

type FunctionNode is record
    span: SourceSpan
    name: IdentifierNode
    return_type: IdentifierNode
    return_literal: LiteralNode
end record

type ModuleWithFunctionNode is record
    module_node: ModuleNode
    routine: FunctionNode
end record

type ProcedureNode is record
    span: SourceSpan
    name: IdentifierNode
end record

type ModuleWithProcedureNode is record
    module_node: ModuleNode
    routine: ProcedureNode
end record

function make_ast_node_kind(name: String) returns AstNodeKind
requires String.instr(name, "") = 0
ensures result.name = name
is
    return AstNodeKind { name: name }
end make_ast_node_kind

function make_identifier_node(span: SourceSpan, name: String) returns IdentifierNode
requires String.instr(name, "") = 0
ensures result.name = name
is
    return IdentifierNode { span: span, name: name }
end make_identifier_node

function make_literal_node(span: SourceSpan, literal_kind: String, text: String) returns LiteralNode
requires String.instr(literal_kind, "") = 0
ensures result.literal_kind = literal_kind, result.text = text
is
    return LiteralNode { span: span, literal_kind: literal_kind, text: text }
end make_literal_node

function make_module_node(span: SourceSpan, name: IdentifierNode) returns ModuleNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return ModuleNode { span: span, name: name }
end make_module_node

function make_record_type_node(span: SourceSpan, name: IdentifierNode) returns RecordTypeNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return RecordTypeNode { span: span, name: name }
end make_record_type_node

function make_module_with_record_node(module_node: ModuleNode, record_type: RecordTypeNode) returns ModuleWithRecordNode
requires String.instr(module_node.name.name, "") = 0, String.instr(record_type.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.record_type.name.name = record_type.name.name
is
    return ModuleWithRecordNode { module_node: module_node, record_type: record_type }
end make_module_with_record_node

function make_function_node(span: SourceSpan, name: IdentifierNode, return_type: IdentifierNode, return_literal: LiteralNode) returns FunctionNode
requires String.instr(name.name, "") = 0, String.instr(return_type.name, "") = 0
ensures result.name.name = name.name, result.return_type.name = return_type.name
is
    return FunctionNode { span: span, name: name, return_type: return_type, return_literal: return_literal }
end make_function_node

function make_module_with_function_node(module_node: ModuleNode, routine: FunctionNode) returns ModuleWithFunctionNode
requires String.instr(module_node.name.name, "") = 0, String.instr(routine.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.routine.name.name = routine.name.name
is
    return ModuleWithFunctionNode { module_node: module_node, routine: routine }
end make_module_with_function_node

function make_procedure_node(span: SourceSpan, name: IdentifierNode) returns ProcedureNode
requires String.instr(name.name, "") = 0
ensures result.name.name = name.name
is
    return ProcedureNode { span: span, name: name }
end make_procedure_node

function make_module_with_procedure_node(module_node: ModuleNode, routine: ProcedureNode) returns ModuleWithProcedureNode
requires String.instr(module_node.name.name, "") = 0, String.instr(routine.name.name, "") = 0
ensures result.module_node.name.name = module_node.name.name, result.routine.name.name = routine.name.name
is
    return ModuleWithProcedureNode { module_node: module_node, routine: routine }
end make_module_with_procedure_node

function identifier_key(identifier: IdentifierNode) returns String
requires String.instr(identifier.name, "") = 0
ensures String.instr(result, identifier.name) >= 0
is
    return String.template("Identifier@${source}:${line}:${column}:${name}", source: identifier.span.source_name, line: identifier.span.start_line, column: identifier.span.start_column, name: identifier.name)
end identifier_key

function literal_text(literal: LiteralNode) returns String
requires String.instr(literal.literal_kind, "") = 0
ensures String.instr(result, literal.text) >= 0
is
    return String.template("Literal.${kind}:${text}", kind: literal.literal_kind, text: literal.text)
end literal_text

function module_key(module_node: ModuleNode) returns String
requires String.instr(module_node.name.name, "") = 0
ensures String.instr(result, module_node.name.name) >= 0
is
    return String.template("Module:${name}@${source}:${line}:${column}", name: module_node.name.name, source: module_node.span.source_name, line: module_node.span.start_line, column: module_node.span.start_column)
end module_key

function module_text(module_node: ModuleNode) returns String
requires String.instr(module_node.name.name, "") = 0
ensures String.instr(result, module_node.name.name) >= 0
is
    return String.template("${key}:identifier=${identifier}", key: module_key(module_node), identifier: identifier_key(module_node.name))
end module_text

function record_type_text(record_type: RecordTypeNode) returns String
requires String.instr(record_type.name.name, "") = 0
ensures String.instr(result, record_type.name.name) >= 0
is
    return String.template("RecordType:${name}@${source}:${line}:${column}", name: record_type.name.name, source: record_type.span.source_name, line: record_type.span.start_line, column: record_type.span.start_column)
end record_type_text

function module_with_record_text(module_node: ModuleWithRecordNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.record_type.name.name, "") = 0
ensures String.instr(result, module_node.record_type.name.name) >= 0
is
    return String.template("${module}:record=${record}", module: module_text(module_node.module_node), record: record_type_text(module_node.record_type))
end module_with_record_text

function function_text(routine: FunctionNode) returns String
requires String.instr(routine.name.name, "") = 0, String.instr(routine.return_type.name, "") = 0
ensures String.instr(result, routine.name.name) >= 0
is
    return String.template("Function:${name}@${source}:${line}:${column}:returns=${return_type}:return=${literal}", name: routine.name.name, source: routine.span.source_name, line: routine.span.start_line, column: routine.span.start_column, return_type: routine.return_type.name, literal: literal_text(routine.return_literal))
end function_text

function module_with_function_text(module_node: ModuleWithFunctionNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.routine.name.name, "") = 0
ensures String.instr(result, module_node.routine.name.name) >= 0
is
    return String.template("${module}:function=${routine}", module: module_text(module_node.module_node), routine: function_text(module_node.routine))
end module_with_function_text

function procedure_text(routine: ProcedureNode) returns String
requires String.instr(routine.name.name, "") = 0
ensures String.instr(result, routine.name.name) >= 0
is
    return String.template("Procedure:${name}@${source}:${line}:${column}", name: routine.name.name, source: routine.span.source_name, line: routine.span.start_line, column: routine.span.start_column)
end procedure_text

function module_with_procedure_text(module_node: ModuleWithProcedureNode) returns String
requires String.instr(module_node.module_node.name.name, "") = 0, String.instr(module_node.routine.name.name, "") = 0
ensures String.instr(result, module_node.routine.name.name) >= 0
is
    return String.template("${module}:procedure=${routine}", module: module_text(module_node.module_node), routine: procedure_text(module_node.routine))
end module_with_procedure_text

end Compiler.Core.Ast