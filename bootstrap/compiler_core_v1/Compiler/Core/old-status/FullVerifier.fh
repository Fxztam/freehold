module Compiler.Core.FullVerifier

-- Real declaration-level semantic checker for full Freehold modules.
-- Replaces the SMT-only Verifier for structural/naming checks.
-- Pipeline: source String -> parse_full_module -> check_full_module -> FullVerificationResult

import Compiler.Core.FullAst exposing FullParamNode, FullFieldNode, FullAbortClauseNode, FullDependsNode, FullGlobalNode, FullImportDecl, FullTypeDecl, FullRecordDecl, FullErrorDecl, FullRoutineDecl, FullModuleDecl, FullParseResult, make_empty_full_routine_decl, make_empty_full_module_decl, name_in_csv
import Compiler.Core.FullParser exposing parse_full_module
import Compiler.Core.FullSemanticChecker exposing FullSemanticError, FullSemanticResult, FullSymbolTable, build_symbol_table, check_full_module, make_empty_semantic_result, semantic_result_summary

-- ============================================================
-- Combined verification result
-- ============================================================

type FullVerificationResult is record
    is_ok: Boolean
    phase: String               -- "ok" | "parse" | "semantic"
    parse_error: String
    module_decl: FullModuleDecl
    semantic: FullSemanticResult
    symbol_table: FullSymbolTable
end record

-- Routine lookup helper (linear search by name)
type FVRoutineLookup is record
    found: Boolean
    routine: FullRoutineDecl
end record

-- ============================================================
-- Empty / error constructors
-- ============================================================

function make_empty_symbol_table() returns FullSymbolTable
is
    return FullSymbolTable {
        type_names: "",
        routine_names: "",
        error_names: "",
        import_names: ""
    }
end make_empty_symbol_table

function make_failed_parse_result(src_name: String, err: String) returns FullVerificationResult
is
    let empty_mod: FullModuleDecl = make_empty_full_module_decl()
    let empty_sem: FullSemanticResult = make_empty_semantic_result()
    let empty_sym: FullSymbolTable = make_empty_symbol_table()
    return FullVerificationResult {
        is_ok: false,
        phase: "parse",
        parse_error: err,
        module_decl: empty_mod,
        semantic: empty_sem,
        symbol_table: empty_sym
    }
end make_failed_parse_result

-- ============================================================
-- Main entry point: parse + semantic check
-- ============================================================

function verify_module_source(src: String, src_name: String) returns FullVerificationResult
is
    -- Phase 1: parse
    let parse_res: FullParseResult = parse_full_module(src, src_name)
    if not parse_res.is_ok then
        return make_failed_parse_result(src_name, parse_res.error_message)
    end if

    let module_decl: FullModuleDecl = parse_res.module_decl

    -- Phase 2: semantic checks
    let sem_res: FullSemanticResult = check_full_module(module_decl)
    let sym: FullSymbolTable = build_symbol_table(module_decl)

    let phase: String = "ok"
    if not sem_res.is_ok then
        phase := "semantic"
    end if

    return FullVerificationResult {
        is_ok: sem_res.is_ok,
        phase: phase,
        parse_error: "",
        module_decl: module_decl,
        semantic: sem_res,
        symbol_table: sym
    }
end verify_module_source

-- ============================================================
-- Query helpers
-- ============================================================

function fv_find_routine(res: FullVerificationResult, name: String) returns FVRoutineLookup
is
    let empty: FullRoutineDecl = make_empty_full_routine_decl()
    let mod: FullModuleDecl = res.module_decl
    let mod_routines: Array<FullRoutineDecl, 32> = mod.routines
    let i: Integer = 0
    while i < mod.routine_count
        invariant i >= 0 and i <= mod.routine_count
    do
        let rt: FullRoutineDecl = mod_routines[i]
        if rt.name = name then
            return FVRoutineLookup { found: true, routine: rt }
        end if
        i := i + 1
    end while
    return FVRoutineLookup { found: false, routine: empty }
end fv_find_routine

function fv_routine_exists(res: FullVerificationResult, name: String) returns Boolean
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    return lk.found
end fv_routine_exists

function fv_routine_return_type(res: FullVerificationResult, name: String) returns String
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.return_type
    else
        return ""
    end if
end fv_routine_return_type

function fv_routine_kind(res: FullVerificationResult, name: String) returns String
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.kind
    else
        return ""
    end if
end fv_routine_kind

function fv_routine_is_async(res: FullVerificationResult, name: String) returns Boolean
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.is_async
    else
        return false
    end if
end fv_routine_is_async

function fv_routine_param_count(res: FullVerificationResult, name: String) returns Integer
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.param_count
    else
        return 0
    end if
end fv_routine_param_count

function fv_routine_has_requires(res: FullVerificationResult, name: String) returns Boolean
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.has_requires
    else
        return false
    end if
end fv_routine_has_requires

function fv_routine_has_ensures(res: FullVerificationResult, name: String) returns Boolean
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.has_ensures
    else
        return false
    end if
end fv_routine_has_ensures

function fv_routine_aborts_count(res: FullVerificationResult, name: String) returns Integer
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.aborts_count
    else
        return 0
    end if
end fv_routine_aborts_count

function fv_routine_depends_count(res: FullVerificationResult, name: String) returns Integer
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.depends_count
    else
        return 0
    end if
end fv_routine_depends_count

function fv_routine_globals_count(res: FullVerificationResult, name: String) returns Integer
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return lk.routine.globals_count
    else
        return 0
    end if
end fv_routine_globals_count

-- Type namespace queries

function fv_type_exists(res: FullVerificationResult, name: String) returns Boolean
is
    return name_in_csv(res.symbol_table.type_names, name)
end fv_type_exists

function fv_error_exists(res: FullVerificationResult, name: String) returns Boolean
is
    return name_in_csv(res.symbol_table.error_names, name)
end fv_error_exists

function fv_import_exists(res: FullVerificationResult, module_name: String) returns Boolean
is
    return name_in_csv(res.symbol_table.import_names, module_name)
end fv_import_exists

-- Module-level counts

function fv_routine_count(res: FullVerificationResult) returns Integer
is
    return res.module_decl.routine_count
end fv_routine_count

function fv_record_count(res: FullVerificationResult) returns Integer
is
    return res.module_decl.record_count
end fv_record_count

function fv_type_count(res: FullVerificationResult) returns Integer
is
    return res.module_decl.type_count
end fv_type_count

function fv_error_count(res: FullVerificationResult) returns Integer
is
    return res.module_decl.error_count
end fv_error_count

function fv_import_count(res: FullVerificationResult) returns Integer
is
    return res.module_decl.import_count
end fv_import_count

function fv_module_name(res: FullVerificationResult) returns String
is
    return res.module_decl.module_name
end fv_module_name

-- ============================================================
-- Human-readable summary
-- ============================================================

function fv_summary(res: FullVerificationResult) returns String
is
    if res.phase = "parse" then
        return String.concat("PARSE ERROR: ", res.parse_error)
    else
        if res.phase = "semantic" then
            return String.concat("SEMANTIC: ", semantic_result_summary(res.semantic))
        else
            return String.template("OK: module ${mod} — ${rt} routines, ${rec} records, ${tp} types, ${err} errors",
                mod: res.module_decl.module_name,
                rt: res.module_decl.routine_count,
                rec: res.module_decl.record_count,
                tp: res.module_decl.type_count,
                err: res.module_decl.error_count)
        end if
    end if
end fv_summary

-- ============================================================
-- Routine contract snapshot (for diagnostic output)
-- ============================================================

type FVContractSnapshot is record
    routine_name: String
    kind: String
    param_count: Integer
    return_type: String
    has_requires: Boolean
    has_ensures: Boolean
    aborts_count: Integer
    depends_count: Integer
    globals_count: Integer
end record

function fv_contract_snapshot(res: FullVerificationResult, name: String) returns FVContractSnapshot
is
    let lk: FVRoutineLookup = fv_find_routine(res, name)
    if lk.found then
        return FVContractSnapshot {
            routine_name: lk.routine.name,
            kind: lk.routine.kind,
            param_count: lk.routine.param_count,
            return_type: lk.routine.return_type,
            has_requires: lk.routine.has_requires,
            has_ensures: lk.routine.has_ensures,
            aborts_count: lk.routine.aborts_count,
            depends_count: lk.routine.depends_count,
            globals_count: lk.routine.globals_count
        }
    else
        return FVContractSnapshot {
            routine_name: name,
            kind: "",
            param_count: 0,
            return_type: "",
            has_requires: false,
            has_ensures: false,
            aborts_count: 0,
            depends_count: 0,
            globals_count: 0
        }
    end if
end fv_contract_snapshot

function fv_contract_snapshot_summary(snap: FVContractSnapshot) returns String
is
    let req_str: String = "no"
    if snap.has_requires then
        req_str := "yes"
    end if
    let ens_str: String = "no"
    if snap.has_ensures then
        ens_str := "yes"
    end if
    return String.template("${kind} ${name}(${pc} params) -> ${rt} | requires:${req} ensures:${ens} aborts:${ab} depends:${dep} global:${gl}",
        kind: snap.kind,
        name: snap.routine_name,
        pc: snap.param_count,
        rt: snap.return_type,
        req: req_str,
        ens: ens_str,
        ab: snap.aborts_count,
        dep: snap.depends_count,
        gl: snap.globals_count)
end fv_contract_snapshot_summary

end Compiler.Core.FullVerifier
