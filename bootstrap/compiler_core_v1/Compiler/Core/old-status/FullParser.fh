module Compiler.Core.FullParser

import Compiler.Core.FullAst exposing FullParamNode, FullFieldNode, FullAbortClauseNode, FullDependsNode, FullGlobalNode, FullImportDecl, FullTypeDecl, FullRecordDecl, FullErrorDecl, FullRoutineDecl, FullModuleDecl, FullParseResult, make_empty_full_param_node, make_empty_full_field_node, make_empty_full_abort_clause_node, make_empty_full_depends_node, make_empty_full_global_node, make_empty_full_import_decl, make_empty_full_type_decl, make_empty_full_record_decl, make_empty_full_error_decl, make_empty_full_routine_decl, make_empty_full_module_decl, set_full_field, set_full_param, set_full_abort, set_full_depends, set_full_global, full_module_set_name, full_module_add_import, full_module_add_type_decl, full_module_add_record_decl, full_module_add_error_decl, full_module_add_routine
import Compiler.Core.Lexer exposing ScanResult, scan_next, keyword_kind

-- ============================================================
-- Parser cursor — carries scanner position + one-token lookahead
-- ============================================================

type FPCursor is record
    src: String
    src_name: String
    pos: Integer
    line: Integer
    col: Integer
    has_err: Boolean
    err_msg: String
    -- one-token lookahead
    has_peek: Boolean
    pk_kind: String
    pk_lexeme: String
    pk_pos: Integer
    pk_line: Integer
    pk_col: Integer
end record

-- ============================================================
-- Per-parse-function result types
-- ============================================================

type FPTokenResult is record
    cursor: FPCursor
    kind: String
    lexeme: String
end record

type FPNameResult is record
    cursor: FPCursor
    name: String
    is_ok: Boolean
end record

type FPImportResult is record
    cursor: FPCursor
    decl: FullImportDecl
    is_ok: Boolean
end record

type FPTypeDeclResult is record
    cursor: FPCursor
    decl: FullTypeDecl
    is_ok: Boolean
end record

type FPRecordDeclResult is record
    cursor: FPCursor
    decl: FullRecordDecl
    is_ok: Boolean
end record

type FPErrorDeclResult is record
    cursor: FPCursor
    decl: FullErrorDecl
    is_ok: Boolean
end record

type FPParamListResult is record
    cursor: FPCursor
    params: Array<FullParamNode, 8>
    count: Integer
    is_ok: Boolean
end record

type FPContractResult is record
    cursor: FPCursor
    has_requires: Boolean
    has_ensures: Boolean
    abort_clauses: Array<FullAbortClauseNode, 8>
    aborts_count: Integer
    depends_specs: Array<FullDependsNode, 8>
    depends_count: Integer
    globals_specs: Array<FullGlobalNode, 8>
    globals_count: Integer
    is_ok: Boolean
end record

type FPRoutineDeclResult is record
    cursor: FPCursor
    decl: FullRoutineDecl
    is_ok: Boolean
end record

type FPCursorResult is record
    cursor: FPCursor
    is_ok: Boolean
end record

-- ============================================================
-- Cursor constructors and operations
-- ============================================================

function make_fp_cursor(src: String, src_name: String) returns FPCursor
is
    return FPCursor {
        src: src,
        src_name: src_name,
        pos: 0,
        line: 1,
        col: 1,
        has_err: false,
        err_msg: "",
        has_peek: false,
        pk_kind: "",
        pk_lexeme: "",
        pk_pos: 0,
        pk_line: 1,
        pk_col: 1
    }
end make_fp_cursor

function fp_error_cursor(cursor: FPCursor, msg: String) returns FPCursor
is
    return FPCursor {
        src: cursor.src,
        src_name: cursor.src_name,
        pos: cursor.pos,
        line: cursor.line,
        col: cursor.col,
        has_err: true,
        err_msg: msg,
        has_peek: cursor.has_peek,
        pk_kind: cursor.pk_kind,
        pk_lexeme: cursor.pk_lexeme,
        pk_pos: cursor.pk_pos,
        pk_line: cursor.pk_line,
        pk_col: cursor.pk_col
    }
end fp_error_cursor

-- Populate lookahead without advancing position
function fp_fill_peek(cursor: FPCursor) returns FPCursor
is
    if cursor.has_peek then
        return cursor
    end if
    let scan: ScanResult = scan_next(cursor.src, cursor.pos, cursor.line, cursor.col)
    return FPCursor {
        src: cursor.src,
        src_name: cursor.src_name,
        pos: cursor.pos,
        line: cursor.line,
        col: cursor.col,
        has_err: cursor.has_err,
        err_msg: cursor.err_msg,
        has_peek: true,
        pk_kind: scan.kind,
        pk_lexeme: scan.lexeme,
        pk_pos: scan.new_pos,
        pk_line: scan.new_line,
        pk_col: scan.new_col
    }
end fp_fill_peek

-- Peek at next token; returns FPTokenResult with (maybe-updated) cursor
function fp_peek(cursor: FPCursor) returns FPTokenResult
is
    let c2: FPCursor = fp_fill_peek(cursor)
    return FPTokenResult { cursor: c2, kind: c2.pk_kind, lexeme: c2.pk_lexeme }
end fp_peek

-- Consume the peeked token and advance position
function fp_advance(cursor: FPCursor) returns FPCursor
is
    let c2: FPCursor = fp_fill_peek(cursor)
    return FPCursor {
        src: c2.src,
        src_name: c2.src_name,
        pos: c2.pk_pos,
        line: c2.pk_line,
        col: c2.pk_col,
        has_err: c2.has_err,
        err_msg: c2.err_msg,
        has_peek: false,
        pk_kind: "",
        pk_lexeme: "",
        pk_pos: 0,
        pk_line: 0,
        pk_col: 0
    }
end fp_advance

-- Expect a specific token kind; advance if found, set error if not
function fp_expect(cursor: FPCursor, expected_kind: String) returns FPTokenResult
is
    let pk: FPTokenResult = fp_peek(cursor)
    if pk.kind = expected_kind then
        let adv: FPCursor = fp_advance(pk.cursor)
        return FPTokenResult { cursor: adv, kind: pk.kind, lexeme: pk.lexeme }
    else
        let msg: String = String.template("Expected ${exp}, got ${got} ('${lex}')",
            exp: expected_kind, got: pk.kind, lex: pk.lexeme)
        let err_c: FPCursor = fp_error_cursor(pk.cursor, msg)
        return FPTokenResult { cursor: err_c, kind: pk.kind, lexeme: pk.lexeme }
    end if
end fp_expect

-- ============================================================
-- Dotted name parser: IDENT ("." IDENT)*
-- ============================================================

function parse_dotted_name(cursor: FPCursor) returns FPNameResult
is
    let empty_decl: FullImportDecl = make_empty_full_import_decl()
    let pk: FPTokenResult = fp_peek(cursor)
    if pk.kind != "IDENT" then
        let msg: String = String.concat("Expected identifier, got: ", pk.kind)
        return FPNameResult { cursor: fp_error_cursor(pk.cursor, msg), name: "", is_ok: false }
    end if
    let c: FPCursor = fp_advance(pk.cursor)
    let name: String = pk.lexeme

    -- Collect ".IDENT" continuations
    let done: Boolean = false
    while not done
        invariant true
    do
        let pk2: FPTokenResult = fp_peek(c)
        if pk2.kind = "OP_DOT" then
            let c2: FPCursor = fp_advance(pk2.cursor)
            let pk3: FPTokenResult = fp_peek(c2)
            if pk3.kind = "IDENT" then
                c := fp_advance(pk3.cursor)
                name := String.concat(name, String.concat(".", pk3.lexeme))
            else
                done := true
            end if
        else
            done := true
        end if
    end while

    return FPNameResult { cursor: c, name: name, is_ok: true }
end parse_dotted_name

-- ============================================================
-- Skip expression: consume tokens until a stopping keyword
-- or until paren/bracket depth returns to zero
-- Used to skip requires/ensures conditions and body expressions
-- ============================================================

function skip_expr_in_list(cursor: FPCursor) returns FPCursorResult
is
    -- Stop at: , (at depth 0), requires, ensures, aborts, depends, global, is, end, EOF
    let c: FPCursor = cursor
    let depth: Integer = 0
    let done: Boolean = false

    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)
        let k: String = pk.kind
        if k = "EOF" then
            done := true
        else
            if k = "OP_LPAREN" or k = "OP_LBRACKET" or k = "OP_LBRACE" then
                depth := depth + 1
                c := fp_advance(pk.cursor)
            else
                if k = "OP_RPAREN" or k = "OP_RBRACKET" or k = "OP_RBRACE" then
                    if depth > 0 then
                        depth := depth - 1
                        c := fp_advance(pk.cursor)
                    else
                        done := true
                    end if
                else
                    if depth = 0 then
                        if k = "OP_COMMA" or k = "KW_REQUIRES" or k = "KW_ENSURES" or k = "KW_ABORTS" or k = "KW_DEPENDS" or k = "KW_GLOBAL" or k = "KW_IS" or k = "KW_END" then
                            done := true
                        else
                            c := fp_advance(pk.cursor)
                        end if
                    else
                        c := fp_advance(pk.cursor)
                    end if
                end if
            end if
        end if
    end while

    return FPCursorResult { cursor: c, is_ok: not c.has_err }
end skip_expr_in_list

-- Skip a comma-separated list of expressions (e.g., requires A, B, C)
function skip_expr_list(cursor: FPCursor) returns FPCursorResult
is
    let c: FPCursor = cursor
    let done: Boolean = false

    while not done and not c.has_err
        invariant true
    do
        let skip1: FPCursorResult = skip_expr_in_list(c)
        c := skip1.cursor
        let pk: FPTokenResult = fp_peek(c)
        if pk.kind = "OP_COMMA" then
            c := fp_advance(pk.cursor)
        else
            done := true
        end if
    end while

    return FPCursorResult { cursor: c, is_ok: not c.has_err }
end skip_expr_list

-- ============================================================
-- Import declaration parser
-- "import" dotted_name "exposing" IDENT ("," IDENT)*
-- ============================================================

function parse_import_decl(cursor: FPCursor) returns FPImportResult
is
    let empty: FullImportDecl = make_empty_full_import_decl()

    -- consume "import"
    let c: FPCursor = fp_advance(cursor)

    -- module name
    let name_res: FPNameResult = parse_dotted_name(c)
    c := name_res.cursor
    if not name_res.is_ok then
        return FPImportResult { cursor: c, decl: empty, is_ok: false }
    end if
    let mod_name: String = name_res.name

    -- "exposing"
    let pk_exp: FPTokenResult = fp_peek(c)
    if pk_exp.kind != "KW_EXPOSING" then
        -- import without exposing — just record the module name
        return FPImportResult {
            cursor: c,
            decl: FullImportDecl { module_name: mod_name, exposed_names: "" },
            is_ok: true
        }
    end if
    c := fp_advance(pk_exp.cursor)

    -- Collect exposed names
    let exposed: String = ""
    let done: Boolean = false

    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)
        if pk.kind = "IDENT" then
            c := fp_advance(pk.cursor)
            if exposed = "" then
                exposed := pk.lexeme
            else
                exposed := String.concat(exposed, String.concat(",", pk.lexeme))
            end if
            -- check for comma continuation
            let pk2: FPTokenResult = fp_peek(c)
            if pk2.kind = "OP_COMMA" then
                c := fp_advance(pk2.cursor)
            else
                done := true
            end if
        else
            done := true
        end if
    end while

    return FPImportResult {
        cursor: c,
        decl: FullImportDecl { module_name: mod_name, exposed_names: exposed },
        is_ok: true
    }
end parse_import_decl

-- ============================================================
-- Type reference as string (for param/field types)
-- Handles: IDENT, IDENT<IDENT,INT>, Result<IDENT,IDENT>
-- Returns the type string, consuming tokens
-- ============================================================

function parse_type_ref_str(cursor: FPCursor) returns FPNameResult
is
    let pk: FPTokenResult = fp_peek(cursor)
    if pk.kind != "IDENT" then
        return FPNameResult { cursor: fp_error_cursor(pk.cursor, "Expected type name"), name: "", is_ok: false }
    end if
    let c: FPCursor = fp_advance(pk.cursor)
    let type_str: String = pk.lexeme

    -- Check for generic: < ... >
    let pk2: FPTokenResult = fp_peek(c)
    if pk2.kind = "OP_LT" then
        c := fp_advance(pk2.cursor)
        type_str := String.concat(type_str, "<")
        -- collect until >
        let depth: Integer = 1
        let done: Boolean = false
        while not done and not c.has_err
            invariant true
        do
            let pk3: FPTokenResult = fp_peek(c)
            c := fp_advance(pk3.cursor)
            if pk3.kind = "OP_LT" then
                depth := depth + 1
                type_str := String.concat(type_str, "<")
            else
                if pk3.kind = "OP_GT" then
                    depth := depth - 1
                    if depth = 0 then
                        type_str := String.concat(type_str, ">")
                        done := true
                    else
                        type_str := String.concat(type_str, ">")
                    end if
                else
                    if pk3.kind = "EOF" then
                        done := true
                    else
                        type_str := String.concat(type_str, pk3.lexeme)
                    end if
                end if
            end if
        end while
    end if

    return FPNameResult { cursor: c, name: type_str, is_ok: true }
end parse_type_ref_str

-- ============================================================
-- Type declaration: "type" IDENT "is" (record | base [range min..max])
-- ============================================================

function parse_record_body(cursor: FPCursor, type_name: String) returns FPRecordDeclResult
is
    -- cursor is after "record" keyword
    let c: FPCursor = cursor
    let decl: FullRecordDecl = make_empty_full_record_decl()
    decl := FullRecordDecl { name: type_name, fields: decl.fields, field_count: 0 }

    let done: Boolean = false
    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)
        if pk.kind = "KW_END" then
            -- consume "end record"
            c := fp_advance(pk.cursor)
            let pk2: FPTokenResult = fp_peek(c)
            if pk2.kind = "KW_RECORD" then
                c := fp_advance(pk2.cursor)
            end if
            done := true
        else
            if pk.kind = "IDENT" then
                -- field: IDENT ":" type_ref
                let field_name: String = pk.lexeme
                c := fp_advance(pk.cursor)
                let pk_colon: FPTokenResult = fp_expect(c, "OP_COLON")
                c := pk_colon.cursor
                let type_res: FPNameResult = parse_type_ref_str(c)
                c := type_res.cursor
                if type_res.is_ok and decl.field_count < 16 then
                    let new_field: FullFieldNode = FullFieldNode { name: field_name, type_ref: type_res.name, json_name: "" }
                    let new_fields: Array<FullFieldNode, 16> = set_full_field(decl.fields, decl.field_count, new_field)
                    decl := FullRecordDecl { name: decl.name, fields: new_fields, field_count: decl.field_count + 1 }
                end if
            else
                if pk.kind = "EOF" then
                    done := true
                else
                    -- skip unknown token
                    c := fp_advance(pk.cursor)
                end if
            end if
        end if
    end while

    return FPRecordDeclResult { cursor: c, decl: decl, is_ok: not c.has_err }
end parse_record_body

function parse_type_decl(cursor: FPCursor) returns FPTypeDeclResult
is
    -- cursor is on "type" keyword — consume it
    let c: FPCursor = fp_advance(cursor)
    let empty_td: FullTypeDecl = make_empty_full_type_decl()
    let empty_rd: FullRecordDecl = make_empty_full_record_decl()

    -- type name
    let pk_name: FPTokenResult = fp_peek(c)
    if pk_name.kind != "IDENT" then
        return FPTypeDeclResult { cursor: fp_error_cursor(pk_name.cursor, "Expected type name"), decl: empty_td, is_ok: false }
    end if
    let type_name: String = pk_name.lexeme
    c := fp_advance(pk_name.cursor)

    -- "is"
    let pk_is: FPTokenResult = fp_expect(c, "KW_IS")
    c := pk_is.cursor

    -- check what follows: "record" or base type
    let pk_next: FPTokenResult = fp_peek(c)

    if pk_next.kind = "KW_RECORD" then
        -- record type — delegate to parse_record_body (already handled in type_decl)
        -- We'll return a FullTypeDecl with name but no range; record goes to FullRecordDecl
        -- To keep this function returning only FullTypeDecl, we skip the record body here
        -- and signal to caller via is_range=false with base_type="record"
        c := fp_advance(pk_next.cursor)
        -- skip record body
        let depth: Integer = 1
        let done2: Boolean = false
        while not done2 and not c.has_err
            invariant true
        do
            let pk3: FPTokenResult = fp_peek(c)
            c := fp_advance(pk3.cursor)
            if pk3.kind = "KW_RECORD" then
                depth := depth + 1
            else
                if pk3.kind = "KW_END" then
                    depth := depth - 1
                    if depth = 0 then
                        -- consume "record" after end
                        let pk4: FPTokenResult = fp_peek(c)
                        if pk4.kind = "KW_RECORD" then
                            c := fp_advance(pk4.cursor)
                        end if
                        done2 := true
                    end if
                else
                    if pk3.kind = "EOF" then
                        done2 := true
                    end if
                end if
            end if
        end while
        let td: FullTypeDecl = FullTypeDecl { name: type_name, base_type: "record", min_value: "", max_value: "", is_range: false }
        return FPTypeDeclResult { cursor: c, decl: td, is_ok: true }
    else
        -- range or alias: base_type [range min..max]
        let base_res: FPNameResult = parse_type_ref_str(c)
        c := base_res.cursor
        let base_type: String = base_res.name
        let min_val: String = ""
        let max_val: String = ""
        let is_range: Boolean = false

        let pk_range: FPTokenResult = fp_peek(c)
        if pk_range.kind = "KW_RANGE" then
            c := fp_advance(pk_range.cursor)
            is_range := true
            -- min value
            let pk_min: FPTokenResult = fp_peek(c)
            if pk_min.kind = "OP_MINUS" then
                c := fp_advance(pk_min.cursor)
                let pk_minv: FPTokenResult = fp_peek(c)
                min_val := String.concat("-", pk_minv.lexeme)
                c := fp_advance(pk_minv.cursor)
            else
                min_val := pk_min.lexeme
                c := fp_advance(pk_min.cursor)
            end if
            -- ".."
            let pk_dots: FPTokenResult = fp_peek(c)
            if pk_dots.kind = "OP_DOTDOT" then
                c := fp_advance(pk_dots.cursor)
            end if
            -- max value
            let pk_max: FPTokenResult = fp_peek(c)
            if pk_max.kind = "OP_MINUS" then
                c := fp_advance(pk_max.cursor)
                let pk_maxv: FPTokenResult = fp_peek(c)
                max_val := String.concat("-", pk_maxv.lexeme)
                c := fp_advance(pk_maxv.cursor)
            else
                max_val := pk_max.lexeme
                c := fp_advance(pk_max.cursor)
            end if
        end if

        let td: FullTypeDecl = FullTypeDecl { name: type_name, base_type: base_type, min_value: min_val, max_value: max_val, is_range: is_range }
        return FPTypeDeclResult { cursor: c, decl: td, is_ok: true }
    end if
end parse_type_decl

-- ============================================================
-- Error declaration: "error" IDENT
-- ============================================================

function parse_error_decl(cursor: FPCursor) returns FPErrorDeclResult
is
    -- cursor is on "error" keyword
    let c: FPCursor = fp_advance(cursor)
    let empty: FullErrorDecl = make_empty_full_error_decl()
    let pk: FPTokenResult = fp_peek(c)
    if pk.kind != "IDENT" then
        return FPErrorDeclResult { cursor: fp_error_cursor(pk.cursor, "Expected error name"), decl: empty, is_ok: false }
    end if
    c := fp_advance(pk.cursor)
    return FPErrorDeclResult {
        cursor: c,
        decl: FullErrorDecl { name: pk.lexeme },
        is_ok: true
    }
end parse_error_decl

-- ============================================================
-- Parameter list: "(" (IDENT ":" type_ref ("," ...)*)? ")"
-- ============================================================

function parse_param_list(cursor: FPCursor) returns FPParamListResult
is
    let empty_p: FullParamNode = make_empty_full_param_node()
    let params: Array<FullParamNode, 8> = [empty_p, empty_p, empty_p, empty_p, empty_p, empty_p, empty_p, empty_p]
    let count: Integer = 0
    let c: FPCursor = cursor

    -- expect "("
    let pk_lp: FPTokenResult = fp_expect(c, "OP_LPAREN")
    c := pk_lp.cursor
    if c.has_err then
        return FPParamListResult { cursor: c, params: params, count: 0, is_ok: false }
    end if

    -- check for empty param list
    let pk2: FPTokenResult = fp_peek(c)
    if pk2.kind = "OP_RPAREN" then
        c := fp_advance(pk2.cursor)
        return FPParamListResult { cursor: c, params: params, count: 0, is_ok: true }
    end if

    -- parse param pairs
    let done: Boolean = false
    while not done and not c.has_err
        invariant true
    do
        -- param name
        let pk_name: FPTokenResult = fp_peek(c)
        if pk_name.kind != "IDENT" then
            done := true
        else
            c := fp_advance(pk_name.cursor)
            let p_name: String = pk_name.lexeme
            -- ":"
            let pk_colon: FPTokenResult = fp_expect(c, "OP_COLON")
            c := pk_colon.cursor
            -- type ref
            let type_res: FPNameResult = parse_type_ref_str(c)
            c := type_res.cursor
            if type_res.is_ok and count < 8 then
                let new_param: FullParamNode = FullParamNode { name: p_name, type_ref: type_res.name }
                params := set_full_param(params, count, new_param)
                count := count + 1
            end if
            -- "," or ")"
            let pk_sep: FPTokenResult = fp_peek(c)
            if pk_sep.kind = "OP_COMMA" then
                c := fp_advance(pk_sep.cursor)
            else
                done := true
            end if
        end if
    end while

    -- expect ")"
    let pk_rp: FPTokenResult = fp_expect(c, "OP_RPAREN")
    c := pk_rp.cursor

    return FPParamListResult { cursor: c, params: params, count: count, is_ok: not c.has_err }
end parse_param_list

-- ============================================================
-- Contract blocks: requires / ensures / aborts / depends / global
-- ============================================================

function parse_contract_blocks(cursor: FPCursor) returns FPContractResult
is
    let empty_a: FullAbortClauseNode = make_empty_full_abort_clause_node()
    let empty_d: FullDependsNode = make_empty_full_depends_node()
    let empty_g: FullGlobalNode = make_empty_full_global_node()
    let abort_list: Array<FullAbortClauseNode, 8> = [empty_a, empty_a, empty_a, empty_a, empty_a, empty_a, empty_a, empty_a]
    let deps: Array<FullDependsNode, 8> = [empty_d, empty_d, empty_d, empty_d, empty_d, empty_d, empty_d, empty_d]
    let globs: Array<FullGlobalNode, 8> = [empty_g, empty_g, empty_g, empty_g, empty_g, empty_g, empty_g, empty_g]
    let aborts_count: Integer = 0
    let deps_count: Integer = 0
    let globs_count: Integer = 0
    let has_req: Boolean = false
    let has_ens: Boolean = false
    let c: FPCursor = cursor
    let done: Boolean = false

    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)

        if pk.kind = "KW_REQUIRES" then
            has_req := true
            c := fp_advance(pk.cursor)
            let skip1: FPCursorResult = skip_expr_list(c)
            c := skip1.cursor

        else
            if pk.kind = "KW_ENSURES" then
                has_ens := true
                c := fp_advance(pk.cursor)
                let skip2: FPCursorResult = skip_expr_list(c)
                c := skip2.cursor

            else
                if pk.kind = "KW_ABORTS" then
                    c := fp_advance(pk.cursor)
                    -- error name
                    let pk_err: FPTokenResult = fp_peek(c)
                    if pk_err.kind = "IDENT" then
                        c := fp_advance(pk_err.cursor)
                        let err_name: String = pk_err.lexeme
                        -- optional "when EXPR"
                        let pk_when: FPTokenResult = fp_peek(c)
                        if pk_when.kind = "KW_WHEN" then
                            c := fp_advance(pk_when.cursor)
                            let skip3: FPCursorResult = skip_expr_in_list(c)
                            c := skip3.cursor
                        end if
                        if aborts_count < 8 then
                            let new_abort: FullAbortClauseNode = FullAbortClauseNode { error_name: err_name }
                            abort_list := set_full_abort(abort_list, aborts_count, new_abort)
                            aborts_count := aborts_count + 1
                        end if
                    end if

                else
                    if pk.kind = "KW_DEPENDS" then
                        c := fp_advance(pk.cursor)
                        -- target IDENT or KW_RESULT
                        let pk_tgt: FPTokenResult = fp_peek(c)
                        if pk_tgt.kind = "IDENT" or pk_tgt.kind = "KW_RESULT" then
                            c := fp_advance(pk_tgt.cursor)
                            let target: String = pk_tgt.lexeme
                            -- "=>"
                            let pk_arrow: FPTokenResult = fp_peek(c)
                            if pk_arrow.kind = "OP_ARROW" then
                                c := fp_advance(pk_arrow.cursor)
                            end if
                            -- "(" sources ")"
                            let pk_lp: FPTokenResult = fp_peek(c)
                            if pk_lp.kind = "OP_LPAREN" then
                                c := fp_advance(pk_lp.cursor)
                            end if
                            let sources: String = ""
                            let sdone: Boolean = false
                            while not sdone and not c.has_err
                                invariant true
                            do
                                let pk_src: FPTokenResult = fp_peek(c)
                                if pk_src.kind = "IDENT" then
                                    c := fp_advance(pk_src.cursor)
                                    if sources = "" then
                                        sources := pk_src.lexeme
                                    else
                                        sources := String.concat(sources, String.concat(",", pk_src.lexeme))
                                    end if
                                    let pk_sc: FPTokenResult = fp_peek(c)
                                    if pk_sc.kind = "OP_COMMA" then
                                        c := fp_advance(pk_sc.cursor)
                                    else
                                        sdone := true
                                    end if
                                else
                                    sdone := true
                                end if
                            end while
                            let pk_rp: FPTokenResult = fp_peek(c)
                            if pk_rp.kind = "OP_RPAREN" then
                                c := fp_advance(pk_rp.cursor)
                            end if
                            if deps_count < 8 then
                                let new_dep: FullDependsNode = FullDependsNode { target: target, sources: sources }
                                deps := set_full_depends(deps, deps_count, new_dep)
                                deps_count := deps_count + 1
                            end if
                        end if

                    else
                        if pk.kind = "KW_GLOBAL" then
                            c := fp_advance(pk.cursor)
                            -- mode: Input | Output | In_Out
                            let pk_mode: FPTokenResult = fp_peek(c)
                            let mode_str: String = ""
                            if pk_mode.kind = "KW_INPUT" then
                                mode_str := "Input"
                                c := fp_advance(pk_mode.cursor)
                            else
                                if pk_mode.kind = "KW_OUTPUT" then
                                    mode_str := "Output"
                                    c := fp_advance(pk_mode.cursor)
                                else
                                    if pk_mode.kind = "KW_INOUT" then
                                        mode_str := "In_Out"
                                        c := fp_advance(pk_mode.cursor)
                                    end if
                                end if
                            end if
                            -- variable name
                            let pk_gname: FPTokenResult = fp_peek(c)
                            if pk_gname.kind = "IDENT" and mode_str != "" then
                                c := fp_advance(pk_gname.cursor)
                                if globs_count < 8 then
                                    let new_glob: FullGlobalNode = FullGlobalNode { name: pk_gname.lexeme, mode: mode_str }
                                    globs := set_full_global(globs, globs_count, new_glob)
                                    globs_count := globs_count + 1
                                end if
                            end if

                        else
                            -- Not a contract keyword — stop
                            done := true
                        end if
                    end if
                end if
            end if
        end if
    end while

    return FPContractResult {
        cursor: c,
        has_requires: has_req,
        has_ensures: has_ens,
        abort_clauses: abort_list,
        aborts_count: aborts_count,
        depends_specs: deps,
        depends_count: deps_count,
        globals_specs: globs,
        globals_count: globs_count,
        is_ok: not c.has_err
    }
end parse_contract_blocks

-- ============================================================
-- Body skipper: consume tokens until "end ROUTINE_NAME"
-- Tracks nesting depth for if/while/case/scope/record blocks
-- ============================================================

function skip_routine_body(cursor: FPCursor, routine_name: String) returns FPCursorResult
is
    let c: FPCursor = cursor
    let depth: Integer = 0
    let done: Boolean = false

    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)
        c := fp_advance(pk.cursor)

        if pk.kind = "KW_IF" or pk.kind = "KW_WHILE" or pk.kind = "KW_CASE" or pk.kind = "KW_SCOPE" then
            depth := depth + 1
        else
            if pk.kind = "KW_END" then
                -- peek at what follows
                let pk2: FPTokenResult = fp_peek(c)
                if pk2.kind = "IDENT" then
                    if pk2.lexeme = routine_name and depth = 0 then
                        -- consume the name
                        c := fp_advance(pk2.cursor)
                        done := true
                    else
                        -- nested end
                        if depth > 0 then
                            depth := depth - 1
                        end if
                        c := fp_advance(pk2.cursor)
                    end if
                else
                    -- "end if", "end while", etc.
                    if depth > 0 then
                        depth := depth - 1
                    end if
                    c := fp_advance(pk2.cursor)
                end if
            else
                if pk.kind = "EOF" then
                    done := true
                end if
            end if
        end if
    end while

    return FPCursorResult { cursor: c, is_ok: not c.has_err }
end skip_routine_body

-- ============================================================
-- Routine declaration parser
-- ============================================================

function parse_routine_decl(cursor: FPCursor) returns FPRoutineDeclResult
is
    let empty: FullRoutineDecl = make_empty_full_routine_decl()
    let c: FPCursor = cursor

    -- optional "async"
    let is_async: Boolean = false
    let pk0: FPTokenResult = fp_peek(c)
    if pk0.kind = "KW_ASYNC" then
        is_async := true
        c := fp_advance(pk0.cursor)
    end if

    -- "function" or "procedure"
    let pk_kw: FPTokenResult = fp_peek(c)
    let kind: String = ""
    if pk_kw.kind = "KW_FUNCTION" then
        kind := "function"
        c := fp_advance(pk_kw.cursor)
    else
        if pk_kw.kind = "KW_PROCEDURE" then
            kind := "procedure"
            c := fp_advance(pk_kw.cursor)
        else
            return FPRoutineDeclResult { cursor: fp_error_cursor(c, "Expected function or procedure"), decl: empty, is_ok: false }
        end if
    end if

    -- routine name
    let pk_name: FPTokenResult = fp_peek(c)
    if pk_name.kind != "IDENT" then
        return FPRoutineDeclResult { cursor: fp_error_cursor(pk_name.cursor, "Expected routine name"), decl: empty, is_ok: false }
    end if
    let r_name: String = pk_name.lexeme
    c := fp_advance(pk_name.cursor)

    -- optional type params [A, B] — skip them
    let pk_tp: FPTokenResult = fp_peek(c)
    if pk_tp.kind = "OP_LBRACKET" then
        c := fp_advance(pk_tp.cursor)
        let tpdone: Boolean = false
        while not tpdone and not c.has_err
            invariant true
        do
            let pk_tpe: FPTokenResult = fp_peek(c)
            c := fp_advance(pk_tpe.cursor)
            if pk_tpe.kind = "OP_RBRACKET" or pk_tpe.kind = "EOF" then
                tpdone := true
            end if
        end while
    end if

    -- parameter list
    let param_res: FPParamListResult = parse_param_list(c)
    c := param_res.cursor

    -- optional "returns TYPE"
    let return_type: String = ""
    let pk_ret: FPTokenResult = fp_peek(c)
    if pk_ret.kind = "KW_RETURNS" then
        c := fp_advance(pk_ret.cursor)
        let ret_type_res: FPNameResult = parse_type_ref_str(c)
        c := ret_type_res.cursor
        return_type := ret_type_res.name
    end if

    -- contract blocks (requires, ensures, aborts, depends, global)
    let contract_res: FPContractResult = parse_contract_blocks(c)
    c := contract_res.cursor

    -- "is"
    let pk_is: FPTokenResult = fp_expect(c, "KW_IS")
    c := pk_is.cursor

    -- skip body until "end r_name"
    let skip_res: FPCursorResult = skip_routine_body(c, r_name)
    c := skip_res.cursor

    let decl: FullRoutineDecl = FullRoutineDecl {
        name: r_name,
        kind: kind,
        is_async: is_async,
        params: param_res.params,
        param_count: param_res.count,
        return_type: return_type,
        has_requires: contract_res.has_requires,
        has_ensures: contract_res.has_ensures,
        abort_clauses: contract_res.abort_clauses,
        aborts_count: contract_res.aborts_count,
        depends_specs: contract_res.depends_specs,
        depends_count: contract_res.depends_count,
        globals_specs: contract_res.globals_specs,
        globals_count: contract_res.globals_count
    }

    return FPRoutineDeclResult { cursor: c, decl: decl, is_ok: not c.has_err }
end parse_routine_decl

-- ============================================================
-- Record declaration (from type T is record ...)
-- Used when parse_type_decl detects "record" — returns FullRecordDecl
-- ============================================================

function parse_record_decl_after_is(cursor: FPCursor, type_name: String) returns FPRecordDeclResult
is
    -- cursor is after "record" keyword
    return parse_record_body(cursor, type_name)
end parse_record_decl_after_is

-- ============================================================
-- Full module parser — entry point
-- ============================================================

function parse_full_module(src: String, src_name: String) returns FullParseResult
is
    let c: FPCursor = make_fp_cursor(src, src_name)
    let module_decl: FullModuleDecl = make_empty_full_module_decl()

    -- "module"
    let pk_mod: FPTokenResult = fp_peek(c)
    if pk_mod.kind != "KW_MODULE" then
        return FullParseResult { is_ok: false, module_decl: module_decl, error_message: "Expected 'module' keyword" }
    end if
    c := fp_advance(pk_mod.cursor)

    -- module name
    let name_res: FPNameResult = parse_dotted_name(c)
    c := name_res.cursor
    if not name_res.is_ok then
        return FullParseResult { is_ok: false, module_decl: module_decl, error_message: name_res.name }
    end if
    module_decl := full_module_set_name(module_decl, name_res.name)

    -- Declaration loop
    let done: Boolean = false
    while not done and not c.has_err
        invariant true
    do
        let pk: FPTokenResult = fp_peek(c)

        if pk.kind = "KW_IMPORT" then
            c := pk.cursor   -- don't advance yet — parse_import_decl expects cursor on "import"
            let imp_res: FPImportResult = parse_import_decl(c)
            c := imp_res.cursor
            if imp_res.is_ok then
                module_decl := full_module_add_import(module_decl, imp_res.decl)
            end if

        else
            if pk.kind = "KW_TYPE" then
                -- Distinguish record from type/alias: peek two tokens ahead
                -- parse_type_decl handles both; for record it signals via base_type="record"
                -- We need to additionally capture the record fields for FullRecordDecl
                -- Approach: scan ahead to check if "record" follows "is"
                let c_save: FPCursor = pk.cursor  -- cursor after "type" peek, still un-advanced

                -- advance past "type"
                let c2: FPCursor = fp_advance(pk.cursor)
                -- skip name
                let c3: FPCursor = c2
                let pk_n: FPTokenResult = fp_peek(c3)
                if pk_n.kind = "IDENT" then
                    c3 := fp_advance(pk_n.cursor)
                end if
                let type_name_save: String = pk_n.lexeme
                -- skip type params if present
                let pk_tp2: FPTokenResult = fp_peek(c3)
                if pk_tp2.kind = "OP_LBRACKET" then
                    let bk: Boolean = false
                    c3 := fp_advance(pk_tp2.cursor)
                    while not bk and not c3.has_err
                        invariant true
                    do
                        let pk_tpe2: FPTokenResult = fp_peek(c3)
                        c3 := fp_advance(pk_tpe2.cursor)
                        if pk_tpe2.kind = "OP_RBRACKET" or pk_tpe2.kind = "EOF" then
                            bk := true
                        end if
                    end while
                end if
                -- "is"
                let pk_is2: FPTokenResult = fp_peek(c3)
                if pk_is2.kind = "KW_IS" then
                    c3 := fp_advance(pk_is2.cursor)
                end if
                -- check "record"
                let pk_rk: FPTokenResult = fp_peek(c3)
                if pk_rk.kind = "KW_RECORD" then
                    -- Parse as record declaration
                    c3 := fp_advance(pk_rk.cursor)
                    let rd_res: FPRecordDeclResult = parse_record_body(c3, type_name_save)
                    c := rd_res.cursor
                    if rd_res.is_ok then
                        module_decl := full_module_add_record_decl(module_decl, rd_res.decl)
                    end if
                else
                    -- Parse as type/alias declaration (starting from original "type" position)
                    let td_res: FPTypeDeclResult = parse_type_decl(pk.cursor)
                    c := td_res.cursor
                    if td_res.is_ok then
                        module_decl := full_module_add_type_decl(module_decl, td_res.decl)
                    end if
                end if

            else
                if pk.kind = "KW_ERROR" then
                    c := pk.cursor
                    let ed_res: FPErrorDeclResult = parse_error_decl(c)
                    c := ed_res.cursor
                    if ed_res.is_ok then
                        module_decl := full_module_add_error_decl(module_decl, ed_res.decl)
                    end if

                else
                    if pk.kind = "KW_FUNCTION" or pk.kind = "KW_PROCEDURE" or pk.kind = "KW_ASYNC" then
                        c := pk.cursor
                        let rt_res: FPRoutineDeclResult = parse_routine_decl(c)
                        c := rt_res.cursor
                        if rt_res.is_ok then
                            module_decl := full_module_add_routine(module_decl, rt_res.decl)
                        end if

                    else
                        if pk.kind = "KW_SERVICE" then
                            -- skip service declaration (not stored in FullModuleDecl yet)
                            c := fp_advance(pk.cursor)
                            let sdepth: Integer = 0
                            let sdone: Boolean = false
                            while not sdone and not c.has_err
                                invariant true
                            do
                                let pk_s: FPTokenResult = fp_peek(c)
                                c := fp_advance(pk_s.cursor)
                                if pk_s.kind = "KW_SERVICE" then
                                    sdepth := sdepth + 1
                                else
                                    if pk_s.kind = "KW_END" then
                                        if sdepth = 0 then
                                            -- consume name after end
                                            let pk_sn: FPTokenResult = fp_peek(c)
                                            c := fp_advance(pk_sn.cursor)
                                            sdone := true
                                        else
                                            sdepth := sdepth - 1
                                        end if
                                    else
                                        if pk_s.kind = "EOF" then
                                            sdone := true
                                        end if
                                    end if
                                end if
                            end while

                        else
                            if pk.kind = "KW_END" or pk.kind = "EOF" then
                                done := true
                            else
                                -- skip unrecognised token
                                c := fp_advance(pk.cursor)
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end while

    return FullParseResult {
        is_ok: not c.has_err,
        module_decl: module_decl,
        error_message: c.err_msg
    }
end parse_full_module

end Compiler.Core.FullParser
