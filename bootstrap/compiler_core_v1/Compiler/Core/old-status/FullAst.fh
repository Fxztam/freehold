module Compiler.Core.FullAst

-- ============================================================
-- Atomic contract/param nodes
-- ============================================================

type FullParamNode is record
    name: String
    type_ref: String
end record

type FullFieldNode is record
    name: String
    type_ref: String
    json_name: String
end record

type FullAbortClauseNode is record
    error_name: String
end record

-- depends target => (src1, src2, ...)
-- sources is comma-separated: "src1,src2,src3"
type FullDependsNode is record
    target: String
    sources: String
end record

-- global Input|Output|In_Out varname
type FullGlobalNode is record
    name: String
    mode: String
end record

-- ============================================================
-- Declaration nodes
-- ============================================================

-- import Module.Name exposing X, Y, Z
-- exposed_names is comma-separated: "X,Y,Z"
type FullImportDecl is record
    module_name: String
    exposed_names: String
end record

-- type T is Base range min..max  OR  type T is Base (alias)
type FullTypeDecl is record
    name: String
    base_type: String
    min_value: String
    max_value: String
    is_range: Boolean
end record

-- type Rec is record ... end record
type FullRecordDecl is record
    name: String
    fields: Array<FullFieldNode, 16>
    field_count: Integer
end record

-- error Foo
type FullErrorDecl is record
    name: String
end record

-- Full routine declaration — body is parsed but not stored
type FullRoutineDecl is record
    name: String
    kind: String           -- "function" | "procedure"
    is_async: Boolean
    params: Array<FullParamNode, 8>
    param_count: Integer
    return_type: String
    has_requires: Boolean
    has_ensures: Boolean
    abort_clauses: Array<FullAbortClauseNode, 8>
    aborts_count: Integer
    depends_specs: Array<FullDependsNode, 8>
    depends_count: Integer
    globals_specs: Array<FullGlobalNode, 8>
    globals_count: Integer
end record

-- Complete module — all top-level declarations
type FullModuleDecl is record
    module_name: String
    imports: Array<FullImportDecl, 16>
    import_count: Integer
    type_decls: Array<FullTypeDecl, 16>
    type_count: Integer
    record_decls: Array<FullRecordDecl, 16>
    record_count: Integer
    error_decls: Array<FullErrorDecl, 16>
    error_count: Integer
    routines: Array<FullRoutineDecl, 32>
    routine_count: Integer
end record

-- Parse result wrapper
type FullParseResult is record
    is_ok: Boolean
    module_decl: FullModuleDecl
    error_message: String
end record

-- ============================================================
-- Empty constructors
-- ============================================================

function make_empty_full_param_node() returns FullParamNode
ensures result.name = "", result.type_ref = ""
is
    return FullParamNode { name: "", type_ref: "" }
end make_empty_full_param_node

function make_empty_full_field_node() returns FullFieldNode
ensures result.name = ""
is
    return FullFieldNode { name: "", type_ref: "", json_name: "" }
end make_empty_full_field_node

function make_empty_full_abort_clause_node() returns FullAbortClauseNode
ensures result.error_name = ""
is
    return FullAbortClauseNode { error_name: "" }
end make_empty_full_abort_clause_node

function make_empty_full_depends_node() returns FullDependsNode
ensures result.target = ""
is
    return FullDependsNode { target: "", sources: "" }
end make_empty_full_depends_node

function make_empty_full_global_node() returns FullGlobalNode
ensures result.name = ""
is
    return FullGlobalNode { name: "", mode: "" }
end make_empty_full_global_node

function make_empty_full_import_decl() returns FullImportDecl
ensures result.module_name = ""
is
    return FullImportDecl { module_name: "", exposed_names: "" }
end make_empty_full_import_decl

function make_empty_full_type_decl() returns FullTypeDecl
ensures result.name = ""
is
    return FullTypeDecl { name: "", base_type: "", min_value: "", max_value: "", is_range: false }
end make_empty_full_type_decl

function make_empty_full_record_decl() returns FullRecordDecl
ensures result.name = "", result.field_count = 0
is
    let f: FullFieldNode = make_empty_full_field_node()
    return FullRecordDecl {
        name: "",
        fields: [f, f, f, f, f, f, f, f, f, f, f, f, f, f, f, f],
        field_count: 0
    }
end make_empty_full_record_decl

function make_empty_full_error_decl() returns FullErrorDecl
ensures result.name = ""
is
    return FullErrorDecl { name: "" }
end make_empty_full_error_decl

function make_empty_full_routine_decl() returns FullRoutineDecl
ensures result.name = "", result.param_count = 0
is
    let p: FullParamNode = make_empty_full_param_node()
    let a: FullAbortClauseNode = make_empty_full_abort_clause_node()
    let d: FullDependsNode = make_empty_full_depends_node()
    let g: FullGlobalNode = make_empty_full_global_node()
    return FullRoutineDecl {
        name: "",
        kind: "",
        is_async: false,
        params: [p, p, p, p, p, p, p, p],
        param_count: 0,
        return_type: "",
        has_requires: false,
        has_ensures: false,
        abort_clauses: [a, a, a, a, a, a, a, a],
        aborts_count: 0,
        depends_specs: [d, d, d, d, d, d, d, d],
        depends_count: 0,
        globals_specs: [g, g, g, g, g, g, g, g],
        globals_count: 0
    }
end make_empty_full_routine_decl

function make_empty_full_module_decl() returns FullModuleDecl
ensures result.module_name = "", result.import_count = 0, result.routine_count = 0
is
    let imp: FullImportDecl = make_empty_full_import_decl()
    let td: FullTypeDecl = make_empty_full_type_decl()
    let rd: FullRecordDecl = make_empty_full_record_decl()
    let ed: FullErrorDecl = make_empty_full_error_decl()
    let rt: FullRoutineDecl = make_empty_full_routine_decl()
    return FullModuleDecl {
        module_name: "",
        imports: [imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp, imp],
        import_count: 0,
        type_decls: [td, td, td, td, td, td, td, td, td, td, td, td, td, td, td, td],
        type_count: 0,
        record_decls: [rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd, rd],
        record_count: 0,
        error_decls: [ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed, ed],
        error_count: 0,
        routines: [rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt,
                   rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt, rt],
        routine_count: 0
    }
end make_empty_full_module_decl

-- ============================================================
-- Functional array setters (unpack-update-repack pattern)
-- ============================================================

function set_full_field(arr: Array<FullFieldNode, 16>, idx: Integer, val: FullFieldNode) returns Array<FullFieldNode, 16>
requires idx >= 0, idx < 16
is
    let i0: FullFieldNode = arr[0]
    let i1: FullFieldNode = arr[1]
    let i2: FullFieldNode = arr[2]
    let i3: FullFieldNode = arr[3]
    let i4: FullFieldNode = arr[4]
    let i5: FullFieldNode = arr[5]
    let i6: FullFieldNode = arr[6]
    let i7: FullFieldNode = arr[7]
    let i8: FullFieldNode = arr[8]
    let i9: FullFieldNode = arr[9]
    let i10: FullFieldNode = arr[10]
    let i11: FullFieldNode = arr[11]
    let i12: FullFieldNode = arr[12]
    let i13: FullFieldNode = arr[13]
    let i14: FullFieldNode = arr[14]
    let i15: FullFieldNode = arr[15]
    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    if idx = 8 then i8 := val end if
    if idx = 9 then i9 := val end if
    if idx = 10 then i10 := val end if
    if idx = 11 then i11 := val end if
    if idx = 12 then i12 := val end if
    if idx = 13 then i13 := val end if
    if idx = 14 then i14 := val end if
    if idx = 15 then i15 := val end if
    return [i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15]
end set_full_field

