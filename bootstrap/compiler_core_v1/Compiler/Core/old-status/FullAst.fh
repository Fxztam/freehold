-- ============================================================
-- Module builder helpers — functional update of FullModuleDecl
-- ============================================================

function full_module_set_name(m: FullModuleDecl, name: String) returns FullModuleDecl
is
    return FullModuleDecl {
        module_name: name,
        imports: m.imports,
        import_count: m.import_count,
        type_decls: m.type_decls,
        type_count: m.type_count,
        record_decls: m.record_decls,
        record_count: m.record_count,
        error_decls: m.error_decls,
        error_count: m.error_count,
        routines: m.routines,
        routine_count: m.routine_count
    }
end full_module_set_name

function full_module_add_import(m: FullModuleDecl, imp: FullImportDecl) returns FullModuleDecl
is
    if m.import_count >= 16 then
        return m
    end if
    return FullModuleDecl {
        module_name: m.module_name,
        imports: set_full_import(m.imports, m.import_count, imp),
        import_count: m.import_count + 1,
        type_decls: m.type_decls,
        type_count: m.type_count,
        record_decls: m.record_decls,
        record_count: m.record_count,
        error_decls: m.error_decls,
        error_count: m.error_count,
        routines: m.routines,
        routine_count: m.routine_count
    }
end full_module_add_import

function full_module_add_type_decl(m: FullModuleDecl, td: FullTypeDecl) returns FullModuleDecl
is
    if m.type_count >= 16 then
        return m
    end if
    return FullModuleDecl {
        module_name: m.module_name,
        imports: m.imports,
        import_count: m.import_count,
        type_decls: set_full_type_decl(m.type_decls, m.type_count, td),
        type_count: m.type_count + 1,
        record_decls: m.record_decls,
        record_count: m.record_count,
        error_decls: m.error_decls,
        error_count: m.error_count,
        routines: m.routines,
        routine_count: m.routine_count
    }
end full_module_add_type_decl

function full_module_add_record_decl(m: FullModuleDecl, rd: FullRecordDecl) returns FullModuleDecl
is
    if m.record_count >= 16 then
        return m
    end if
    return FullModuleDecl {
        module_name: m.module_name,
        imports: m.imports,
        import_count: m.import_count,
        type_decls: m.type_decls,
        type_count: m.type_count,
        record_decls: set_full_record_decl(m.record_decls, m.record_count, rd),
        record_count: m.record_count + 1,
        error_decls: m.error_decls,
        error_count: m.error_count,
        routines: m.routines,
        routine_count: m.routine_count
    }
end full_module_add_record_decl

function full_module_add_error_decl(m: FullModuleDecl, ed: FullErrorDecl) returns FullModuleDecl
is
    if m.error_count >= 16 then
        return m
    end if
    return FullModuleDecl {
        module_name: m.module_name,
        imports: m.imports,
        import_count: m.import_count,
        type_decls: m.type_decls,
        type_count: m.type_count,
        record_decls: m.record_decls,
        record_count: m.record_count,
        error_decls: set_full_error_decl(m.error_decls, m.error_count, ed),
        error_count: m.error_count + 1,
        routines: m.routines,
        routine_count: m.routine_count
    }
end full_module_add_error_decl

function full_module_add_routine(m: FullModuleDecl, rt: FullRoutineDecl) returns FullModuleDecl
is
    if m.routine_count >= 32 then
        return m
    end if
    return FullModuleDecl {
        module_name: m.module_name,
        imports: m.imports,
        import_count: m.import_count,
        type_decls: m.type_decls,
        type_count: m.type_count,
        record_decls: m.record_decls,
        record_count: m.record_count,
        error_decls: m.error_decls,
        error_count: m.error_count,
        routines: set_full_routine(m.routines, m.routine_count, rt),
        routine_count: m.routine_count + 1
    }
end full_module_add_routine

-- ============================================================
-- Query helpers
-- ============================================================

-- Check if a name appears in a comma-separated list (e.g., exposed_names)
function name_in_csv(csv: String, name: String) returns Boolean
requires String.instr(name, "") = 0
ensures result = true or result = false
is
    let search: String = String.concat(",", String.concat(name, ","))
    let padded: String = String.concat(",", String.concat(csv, ","))
    if String.instr(padded, search) >= 0 then
        return true
    else
        return false
    end if
end name_in_csv

function exposed_contains(decl: FullImportDecl, name: String) returns Boolean
requires String.instr(name, "") = 0
ensures result = true or result = false
is
    return name_in_csv(decl.exposed_names, name)
end exposed_contains

function depends_has_source(dep: FullDependsNode, name: String) returns Boolean
requires String.instr(name, "") = 0
ensures result = true or result = false
is
    return name_in_csv(dep.sources, name)
end depends_has_source

end Compiler.Core.FullAst
