module Compiler.Core.FullSemanticChecker

import Compiler.Core.FullAst exposing FullParamNode, FullFieldNode, FullAbortClauseNode, FullDependsNode, FullGlobalNode, FullImportDecl, FullTypeDecl, FullRecordDecl, FullErrorDecl, FullRoutineDecl, FullModuleDecl, FullParseResult, name_in_csv, depends_has_source, exposed_contains

-- ============================================================
-- Result types
-- ============================================================

type FullSemanticError is record
    message: String
end record

type FullSemanticResult is record
    is_ok: Boolean
    error_count: Integer
    errors: Array<FullSemanticError, 16>
end record

-- ============================================================
-- Symbol table — comma-separated name registries
-- ============================================================

type FullSymbolTable is record
    type_names: String
    routine_names: String
    error_names: String
    import_names: String
end record

-- ============================================================
-- Error array setter (16 elements — functional unpack pattern)
-- ============================================================

function make_empty_semantic_error() returns FullSemanticError
is
    return FullSemanticError { message: "" }
end make_empty_semantic_error

function make_empty_semantic_result() returns FullSemanticResult
is
    let e: FullSemanticError = make_empty_semantic_error()
    return FullSemanticResult {
        is_ok: true,
        error_count: 0,
        errors: [e, e, e, e, e, e, e, e, e, e, e, e, e, e, e, e]
    }
end make_empty_semantic_result

function set_semantic_error(arr: Array<FullSemanticError, 16>, idx: Integer, val: FullSemanticError) returns Array<FullSemanticError, 16>
is
    let i0: FullSemanticError = arr[0]
    let i1: FullSemanticError = arr[1]
    let i2: FullSemanticError = arr[2]
    let i3: FullSemanticError = arr[3]
    let i4: FullSemanticError = arr[4]
    let i5: FullSemanticError = arr[5]
    let i6: FullSemanticError = arr[6]
    let i7: FullSemanticError = arr[7]
    let i8: FullSemanticError = arr[8]
    let i9: FullSemanticError = arr[9]
    let i10: FullSemanticError = arr[10]
    let i11: FullSemanticError = arr[11]
    let i12: FullSemanticError = arr[12]
    let i13: FullSemanticError = arr[13]
    let i14: FullSemanticError = arr[14]
    let i15: FullSemanticError = arr[15]
    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    if idx = 8 then i8 := val end if
    if idx = 9 then i9 := val end if
    if idx = 10 then i10 := val end if
    if idx = 11 then i11 := val end if
    if idx = 12 then i12 := val end if
    if idx = 13 then i13 := val end if
    if idx = 14 then i14 := val end if
    if idx = 15 then i15 := val end if
    return [i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15]
end set_semantic_error

-- ============================================================
-- Result builder helpers
-- ============================================================

function result_add_error(res: FullSemanticResult, msg: String) returns FullSemanticResult
is
    if res.error_count >= 16 then
        return res
    end if
    let new_err: FullSemanticError = FullSemanticError { message: msg }
    let new_errors: Array<FullSemanticError, 16> = set_semantic_error(res.errors, res.error_count, new_err)
    return FullSemanticResult { is_ok: false, error_count: res.error_count + 1, errors: new_errors }
end result_add_error

function result_merge(a: FullSemanticResult, b: FullSemanticResult) returns FullSemanticResult
is
    let r: FullSemanticResult = a
    let b_errors: Array<FullSemanticError, 16> = b.errors
    let i: Integer = 0
    while i < b.error_count and r.error_count < 16
        invariant i >= 0 and i <= b.error_count
    do
        let b_err: FullSemanticError = b_errors[i]
        r := result_add_error(r, b_err.message)
        i := i + 1
    end while
    return r
end result_merge

-- ============================================================
-- CSV name registry helpers
-- ============================================================

function csv_add_name(csv: String, name: String) returns String
is
    if csv = "" then
        return name
    else
        return String.concat(csv, String.concat(",", name))
    end if
end csv_add_name

-- ============================================================
-- Builtin type check
-- ============================================================

function is_builtin_type(type_ref: String) returns Boolean
is
    if type_ref = "Integer" then return true end if
    if type_ref = "Boolean" then return true end if
    if type_ref = "String" then return true end if
    if type_ref = "Float" then return true end if
    if type_ref = "Void" then return true end if
    if String.instr(type_ref, "Array<") = 0 then return true end if
    if String.instr(type_ref, "Result<") = 0 then return true end if
    if String.instr(type_ref, "Optional<") = 0 then return true end if
    if String.instr(type_ref, "Channel<") = 0 then return true end if
    return false
end is_builtin_type

function is_valid_type_ref(sym: FullSymbolTable, type_ref: String) returns Boolean
is
    if type_ref = "" then return true end if
    if is_builtin_type(type_ref) then return true end if
    if name_in_csv(sym.type_names, type_ref) then return true end if
    return false
end is_valid_type_ref

-- ============================================================
-- Symbol table builder
-- ============================================================

function build_symbol_table(mod_decl: FullModuleDecl) returns FullSymbolTable
is
    let type_names: String = ""
    let routine_names: String = ""
    let error_names: String = ""
    let import_names: String = ""

    -- collect import names
    let module_imports: Array<FullImportDecl, 16> = mod_decl.imports
    let i: Integer = 0
    while i < mod_decl.import_count
        invariant i >= 0 and i <= mod_decl.import_count
    do
        let imp: FullImportDecl = module_imports[i]
        import_names := csv_add_name(import_names, imp.module_name)
        i := i + 1
    end while

    -- collect type names
    let module_type_decls: Array<FullTypeDecl, 16> = mod_decl.type_decls
    let j: Integer = 0
    while j < mod_decl.type_count
        invariant j >= 0 and j <= mod_decl.type_count
    do
        let td: FullTypeDecl = module_type_decls[j]
        type_names := csv_add_name(type_names, td.name)
        j := j + 1
    end while

    -- collect record names (also in type namespace)
    let module_record_decls: Array<FullRecordDecl, 16> = mod_decl.record_decls
    let k: Integer = 0
    while k < mod_decl.record_count
        invariant k >= 0 and k <= mod_decl.record_count
    do
        let rd: FullRecordDecl = module_record_decls[k]
        type_names := csv_add_name(type_names, rd.name)
        k := k + 1
    end while

    -- collect error names (also in type namespace)
    let module_error_decls: Array<FullErrorDecl, 16> = mod_decl.error_decls
    let l: Integer = 0
    while l < mod_decl.error_count
        invariant l >= 0 and l <= mod_decl.error_count
    do
        let ed: FullErrorDecl = module_error_decls[l]
        type_names := csv_add_name(type_names, ed.name)
        error_names := csv_add_name(error_names, ed.name)
        l := l + 1
    end while

    -- collect routine names
    let module_routines: Array<FullRoutineDecl, 32> = mod_decl.routines
    let m: Integer = 0
    while m < mod_decl.routine_count
        invariant m >= 0 and m <= mod_decl.routine_count
    do
        let rt: FullRoutineDecl = module_routines[m]
        routine_names := csv_add_name(routine_names, rt.name)
        m := m + 1
    end while

    return FullSymbolTable {
        type_names: type_names,
        routine_names: routine_names,
        error_names: error_names,
        import_names: import_names
    }
end build_symbol_table

-- ============================================================
-- Duplicate detection helpers
-- ============================================================

function check_no_duplicate_types(mod_decl: FullModuleDecl) returns FullSemanticResult
is
    let res: FullSemanticResult = make_empty_semantic_result()
    let seen: String = ""

    let module_type_decls: Array<FullTypeDecl, 16> = mod_decl.type_decls
    let i: Integer = 0
    while i < mod_decl.type_count
        invariant i >= 0 and i <= mod_decl.type_count
    do
        let td: FullTypeDecl = module_type_decls[i]
        if name_in_csv(seen, td.name) then
            let msg: String = String.concat("Duplicate type name: ", td.name)
            res := result_add_error(res, msg)
        else
            seen := csv_add_name(seen, td.name)
        end if
        i := i + 1
    end while

    let module_record_decls: Array<FullRecordDecl, 16> = mod_decl.record_decls
    let j: Integer = 0
    while j < mod_decl.record_count
        invariant j >= 0 and j <= mod_decl.record_count
    do
        let rd: FullRecordDecl = module_record_decls[j]
        if name_in_csv(seen, rd.name) then
            let msg: String = String.concat("Duplicate type/record name: ", rd.name)
            res := result_add_error(res, msg)
        else
            seen := csv_add_name(seen, rd.name)
        end if
        j := j + 1
    end while

    let module_error_decls: Array<FullErrorDecl, 16> = mod_decl.error_decls
    let k: Integer = 0
    while k < mod_decl.error_count
        invariant k >= 0 and k <= mod_decl.error_count
    do
        let ed: FullErrorDecl = module_error_decls[k]
        if name_in_csv(seen, ed.name) then
            let msg: String = String.concat("Duplicate error/type name: ", ed.name)
            res := result_add_error(res, msg)
        else
            seen := csv_add_name(seen, ed.name)
        end if
        k := k + 1
    end while

    return res
end check_no_duplicate_types

function check_no_duplicate_routines(mod_decl: FullModuleDecl) returns FullSemanticResult
is
    let res: FullSemanticResult = make_empty_semantic_result()
    let seen: String = ""

    let module_routines: Array<FullRoutineDecl, 32> = mod_decl.routines
    let i: Integer = 0
    while i < mod_decl.routine_count
        invariant i >= 0 and i <= mod_decl.routine_count
    do
        let rt: FullRoutineDecl = module_routines[i]
        if name_in_csv(seen, rt.name) then
            let msg: String = String.concat("Duplicate routine name: ", rt.name)
            res := result_add_error(res, msg)
        else
            seen := csv_add_name(seen, rt.name)
        end if
        i := i + 1
    end while

    return res
end check_no_duplicate_routines

-- ============================================================
-- Type reference validation across declarations
-- ============================================================

function check_record_fields(sym: FullSymbolTable, rd: FullRecordDecl) returns FullSemanticResult
is
    let res: FullSemanticResult = make_empty_semantic_result()
    let rd_fields: Array<FullFieldNode, 16> = rd.fields
    let i: Integer = 0
    while i < rd.field_count
        invariant i >= 0 and i <= rd.field_count
    do
        let f: FullFieldNode = rd_fields[i]
        if not is_valid_type_ref(sym, f.type_ref) then
            let msg: String = String.template("Record ${rec}: unknown type '${t}' for field '${f}'",
                rec: rd.name, t: f.type_ref, f: f.name)
            res := result_add_error(res, msg)
        end if
        i := i + 1
    end while
    return res
end check_record_fields

function check_routine_type_refs(sym: FullSymbolTable, rt: FullRoutineDecl) returns FullSemanticResult
is
    let res: FullSemanticResult = make_empty_semantic_result()

    -- Check param types
    let rt_params: Array<FullParamNode, 8> = rt.params
    let i: Integer = 0
    while i < rt.param_count
        invariant i >= 0 and i <= rt.param_count
    do
        let p: FullParamNode = rt_params[i]
        if not is_valid_type_ref(sym, p.type_ref) then
            let msg: String = String.template("Routine ${r}: unknown type '${t}' for param '${p}'",
                r: rt.name, t: p.type_ref, p: p.name)
            res := result_add_error(res, msg)
        end if
        i := i + 1
    end while

    -- Check return type
    if rt.return_type != "" then
        if not is_valid_type_ref(sym, rt.return_type) then
            let msg: String = String.template("Routine ${r}: unknown return type '${t}'",
                r: rt.name, t: rt.return_type)
            res := result_add_error(res, msg)
        end if
    end if

    -- Check aborts error names
    let rt_aborts: Array<FullAbortClauseNode, 8> = rt.abort_clauses
    let j: Integer = 0
    while j < rt.aborts_count
        invariant j >= 0 and j <= rt.aborts_count
    do
        let a: FullAbortClauseNode = rt_aborts[j]
        if not name_in_csv(sym.error_names, a.error_name) then
            let msg: String = String.template("Routine ${r}: aborts references undeclared error '${e}'",
                r: rt.name, e: a.error_name)
            res := result_add_error(res, msg)
        end if
        j := j + 1
    end while

    return res
end check_routine_type_refs

-- ============================================================
-- Full module checker — entry point
-- ============================================================

function check_full_module(mod_decl: FullModuleDecl) returns FullSemanticResult
is
    let res: FullSemanticResult = make_empty_semantic_result()

    let dup_type_res: FullSemanticResult = check_no_duplicate_types(mod_decl)
    res := result_merge(res, dup_type_res)

    let dup_rt_res: FullSemanticResult = check_no_duplicate_routines(mod_decl)
    res := result_merge(res, dup_rt_res)

    let sym: FullSymbolTable = build_symbol_table(mod_decl)

    let module_record_decls: Array<FullRecordDecl, 16> = mod_decl.record_decls
    let i: Integer = 0
    while i < mod_decl.record_count
        invariant i >= 0 and i <= mod_decl.record_count
    do
        let rd: FullRecordDecl = module_record_decls[i]
        let rd_res: FullSemanticResult = check_record_fields(sym, rd)
        res := result_merge(res, rd_res)
        i := i + 1
    end while

    let module_routines: Array<FullRoutineDecl, 32> = mod_decl.routines
    let j: Integer = 0
    while j < mod_decl.routine_count
        invariant j >= 0 and j <= mod_decl.routine_count
    do
        let rt: FullRoutineDecl = module_routines[j]
        let rt_res: FullSemanticResult = check_routine_type_refs(sym, rt)
        res := result_merge(res, rt_res)
        j := j + 1
    end while

    return res
end check_full_module

-- ============================================================
-- Human-readable summary
-- ============================================================

function semantic_result_summary(res: FullSemanticResult) returns String
is
    if res.is_ok then
        return "OK"
    else
        let msg: String = String.template("${n} semantic error(s):", n: res.error_count)
        let result_errors: Array<FullSemanticError, 16> = res.errors
        let i: Integer = 0
        while i < res.error_count
            invariant i >= 0 and i <= res.error_count
        do
            let e: FullSemanticError = result_errors[i]
            msg := String.concat(msg, String.concat(" | ", e.message))
            i := i + 1
        end while
        return msg
    end if
end semantic_result_summary

end Compiler.Core.FullSemanticChecker
