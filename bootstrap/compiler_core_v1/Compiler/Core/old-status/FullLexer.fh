module Compiler.Core.FullLexer

-- On-demand character-level scanner for full Freehold source files.
-- Produces one token per call; caller manages position state.

-- ============================================================
-- Result type
-- ============================================================

type ScanResult is record
    kind: String       -- token kind constant or "EOF" / "ERROR"
    lexeme: String     -- raw text of the token
    new_pos: Integer   -- source position after this token
    new_line: Integer
    new_col: Integer
    is_ok: Boolean        -- false only on unrecognised character
end record

-- ============================================================
-- Character predicates
-- ============================================================

function is_alpha(ch: String) returns Boolean
ensures result = true or result = false
is
    if String.instr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch) >= 0 then
        return true
    else
        return false
    end if
end is_alpha

function is_digit(ch: String) returns Boolean
ensures result = true or result = false
is
    if String.instr("0123456789", ch) >= 0 then
        return true
    else
        return false
    end if
end is_digit

function is_alnum(ch: String) returns Boolean
ensures result = true or result = false
is
    if is_alpha(ch) then
        return true
    else
        return is_digit(ch)
    end if
end is_alnum

function is_space(ch: String) returns Boolean
ensures result = true or result = false
is
    if ch = " " or ch = "\t" or ch = "\r" then
        return true
    else
        return false
    end if
end is_space

-- ============================================================
-- Keyword map — returns token kind for a word, or "IDENT"
-- ============================================================

function keyword_kind(word: String) returns String
requires String.instr(word, "") = 0
ensures String.instr(result, "") = 0
is
    if word = "module" then return "KW_MODULE" end if
    if word = "import" then return "KW_IMPORT" end if
    if word = "exposing" then return "KW_EXPOSING" end if
    if word = "type" then return "KW_TYPE" end if
    if word = "is" then return "KW_IS" end if
    if word = "record" then return "KW_RECORD" end if
    if word = "end" then return "KW_END" end if
    if word = "function" then return "KW_FUNCTION" end if
    if word = "procedure" then return "KW_PROCEDURE" end if
    if word = "returns" then return "KW_RETURNS" end if
    if word = "requires" then return "KW_REQUIRES" end if
    if word = "ensures" then return "KW_ENSURES" end if
    if word = "aborts" then return "KW_ABORTS" end if
    if word = "depends" then return "KW_DEPENDS" end if
    if word = "global" then return "KW_GLOBAL" end if
    if word = "return" then return "KW_RETURN" end if
    if word = "abort" then return "KW_ABORT" end if
    if word = "check" then return "KW_CHECK" end if
    if word = "let" then return "KW_LET" end if
    if word = "if" then return "KW_IF" end if
    if word = "then" then return "KW_THEN" end if
    if word = "else" then return "KW_ELSE" end if
    if word = "while" then return "KW_WHILE" end if
    if word = "invariant" then return "KW_INVARIANT" end if
    if word = "do" then return "KW_DO" end if
    if word = "case" then return "KW_CASE" end if
    if word = "when" then return "KW_WHEN" end if
    if word = "default" then return "KW_DEFAULT" end if
    if word = "scope" then return "KW_SCOPE" end if
    if word = "spawn" then return "KW_SPAWN" end if
    if word = "join" then return "KW_JOIN" end if
    if word = "result" then return "KW_RESULT" end if
    if word = "await" then return "KW_AWAIT" end if
    if word = "async" then return "KW_ASYNC" end if
    if word = "service" then return "KW_SERVICE" end if
    if word = "rpc" then return "KW_RPC" end if
    if word = "proto" then return "KW_PROTO" end if
    if word = "not" then return "KW_NOT" end if
    if word = "and" then return "KW_AND" end if
    if word = "or" then return "KW_OR" end if
    if word = "true" then return "KW_TRUE" end if
    if word = "false" then return "KW_FALSE" end if
    if word = "ok" then return "KW_OK" end if
    if word = "error" then return "KW_ERROR" end if
    if word = "call" then return "KW_CALL" end if
    if word = "range" then return "KW_RANGE" end if
    if word = "mod" then return "KW_MOD" end if
    if word = "when" then return "KW_WHEN" end if
    if word = "Input" then return "KW_INPUT" end if
    if word = "Output" then return "KW_OUTPUT" end if
    if word = "In_Out" then return "KW_INOUT" end if
    if word = "forall" then return "KW_FORALL" end if
    if word = "exists" then return "KW_EXISTS" end if
    if word = "variant" then return "KW_VARIANT" end if
    return "IDENT"
end keyword_kind

-- ============================================================
-- Result constructors
-- ============================================================

function make_scan_ok(kind: String, lexeme: String, pos: Integer, line: Integer, col: Integer) returns ScanResult
is
    return ScanResult { kind: kind, lexeme: lexeme, new_pos: pos, new_line: line, new_col: col, is_ok: true }
end make_scan_ok

function make_scan_eof(pos: Integer, line: Integer, col: Integer) returns ScanResult
is
    return ScanResult { kind: "EOF", lexeme: "", new_pos: pos, new_line: line, new_col: col, is_ok: true }
end make_scan_eof

function make_scan_error(pos: Integer, line: Integer, col: Integer, msg: String) returns ScanResult
is
    return ScanResult { kind: "ERROR", lexeme: msg, new_pos: pos, new_line: line, new_col: col, is_ok: false }
end make_scan_error

-- ============================================================
-- Identifier / keyword scanner
-- ============================================================

function scan_word(src: String, pos: Integer, line: Integer, col: Integer) returns ScanResult
requires pos >= 0, pos <= String.length(src)
is
    let len: Integer = String.length(src)
    let start: Integer = pos
    let cur: Integer = pos
    let word: String = ""
    let done: Boolean = false

    while cur < len and not done
        invariant cur >= start and cur <= len
    do
        let ch: String = String.substr(src, cur, 1)
        if is_alnum(ch) then
            word := String.concat(word, ch)
            cur := cur + 1
        else
            done := true
        end if
    end while

    let kind: String = keyword_kind(word)
    return make_scan_ok(kind, word, cur, line, col + (cur - start))
end scan_word

-- ============================================================
-- Integer literal scanner
-- ============================================================

function scan_integer(src: String, pos: Integer, line: Integer, col: Integer) returns ScanResult
requires pos >= 0, pos <= String.length(src)
is
    let len: Integer = String.length(src)
    let start: Integer = pos
    let cur: Integer = pos
    let num: String = ""
    let done: Boolean = false

    while cur < len and not done
        invariant cur >= start and cur <= len
    do
        let ch: String = String.substr(src, cur, 1)
        if is_digit(ch) then
            num := String.concat(num, ch)
            cur := cur + 1
        else
            done := true
        end if
    end while

    return make_scan_ok("INT", num, cur, line, col + (cur - start))
end scan_integer

-- ============================================================
-- String literal scanner  "..." (no escape processing needed)
-- ============================================================

function scan_string_lit(src: String, pos: Integer, line: Integer, col: Integer) returns ScanResult
requires pos >= 0, pos < String.length(src)
is
    let len: Integer = String.length(src)
    let start: Integer = pos
    let cur: Integer = pos + 1   -- skip opening quote
    let lit: String = "\""
    let done: Boolean = false

    while cur < len and not done
        invariant cur >= pos and cur <= len
    do
        let ch: String = String.substr(src, cur, 1)
        lit := String.concat(lit, ch)
        cur := cur + 1
        if ch = "\"" then
            done := true
        end if
    end while

    return make_scan_ok("STR", lit, cur, line, col + (cur - start))
end scan_string_lit

-- ============================================================
-- Main scanner — skip whitespace/comments, return next token
-- ============================================================

function scan_next(src: String, pos: Integer, line: Integer, col: Integer) returns ScanResult
requires pos >= 0
is
    let len: Integer = String.length(src)
    let cur: Integer = pos
    let cur_line: Integer = line
    let cur_col: Integer = col

    -- Skip whitespace and line comments
    let skipping: Boolean = true
    while cur < len and skipping
        invariant cur >= pos and cur <= len
    do
        let ch: String = String.substr(src, cur, 1)
        if ch = "\n" then
            cur := cur + 1
            cur_line := cur_line + 1
            cur_col := 1
        else
            if is_space(ch) then
                cur := cur + 1
                cur_col := cur_col + 1
            else
                if ch = "-" and cur + 1 < len then
                    let nxt: String = String.substr(src, cur + 1, 1)
                    if nxt = "-" then
                        -- line comment: skip to end of line
                        let cdone: Boolean = false
                        while cur < len and not cdone
                            invariant cur >= 0 and cur <= len
                        do
                            let cc: String = String.substr(src, cur, 1)
                            if cc = "\n" then
                                cdone := true
                            else
                                cur := cur + 1
                                cur_col := cur_col + 1
                            end if
                        end while
                    else
                        skipping := false
                    end if
                else
                    skipping := false
                end if
            end if
        end if
    end while

    -- EOF
    if cur >= len then
        return make_scan_eof(cur, cur_line, cur_col)
    end if

    let ch: String = String.substr(src, cur, 1)

    -- Identifier or keyword (includes In_Out which starts with uppercase I)
    if is_alpha(ch) then
        return scan_word(src, cur, cur_line, cur_col)
    end if

    -- Negative integer: - followed by digit (vs operator -)
    -- We treat "-" as OP_MINUS; parser handles negation

    -- Integer literal
    if is_digit(ch) then
        return scan_integer(src, cur, cur_line, cur_col)
    end if

    -- String literal
    if ch = "\"" then
        return scan_string_lit(src, cur, cur_line, cur_col)
    end if

    -- Two-character operators first
    if cur + 1 < len then
        let nxt: String = String.substr(src, cur + 1, 1)

        if ch = ":" and nxt = "=" then
            return make_scan_ok("OP_ASSIGN", ":=", cur + 2, cur_line, cur_col + 2)
        end if
        if ch = "=" and nxt = ">" then
            return make_scan_ok("OP_ARROW", "=>", cur + 2, cur_line, cur_col + 2)
        end if
        if ch = "!" and nxt = "=" then
            return make_scan_ok("OP_NEQ", "!=", cur + 2, cur_line, cur_col + 2)
        end if
        if ch = "<" and nxt = "=" then
            return make_scan_ok("OP_LEQ", "<=", cur + 2, cur_line, cur_col + 2)
        end if
        if ch = ">" and nxt = "=" then
            return make_scan_ok("OP_GEQ", ">=", cur + 2, cur_line, cur_col + 2)
        end if
        if ch = "." and nxt = "." then
            return make_scan_ok("OP_DOTDOT", "..", cur + 2, cur_line, cur_col + 2)
        end if
    end if

    -- Single-character operators
    if ch = "=" then return make_scan_ok("OP_EQ", "=", cur + 1, cur_line, cur_col + 1) end if
    if ch = "<" then return make_scan_ok("OP_LT", "<", cur + 1, cur_line, cur_col + 1) end if
    if ch = ">" then return make_scan_ok("OP_GT", ">", cur + 1, cur_line, cur_col + 1) end if
    if ch = ":" then return make_scan_ok("OP_COLON", ":", cur + 1, cur_line, cur_col + 1) end if
    if ch = "." then return make_scan_ok("OP_DOT", ".", cur + 1, cur_line, cur_col + 1) end if
    if ch = "," then return make_scan_ok("OP_COMMA", ",", cur + 1, cur_line, cur_col + 1) end if
    if ch = "(" then return make_scan_ok("OP_LPAREN", "(", cur + 1, cur_line, cur_col + 1) end if
    if ch = ")" then return make_scan_ok("OP_RPAREN", ")", cur + 1, cur_line, cur_col + 1) end if
    if ch = "[" then return make_scan_ok("OP_LBRACKET", "[", cur + 1, cur_line, cur_col + 1) end if
    if ch = "]" then return make_scan_ok("OP_RBRACKET", "]", cur + 1, cur_line, cur_col + 1) end if
    if ch = "{" then return make_scan_ok("OP_LBRACE", "{", cur + 1, cur_line, cur_col + 1) end if
    if ch = "}" then return make_scan_ok("OP_RBRACE", "}", cur + 1, cur_line, cur_col + 1) end if
    if ch = "+" then return make_scan_ok("OP_PLUS", "+", cur + 1, cur_line, cur_col + 1) end if
    if ch = "-" then return make_scan_ok("OP_MINUS", "-", cur + 1, cur_line, cur_col + 1) end if
    if ch = "*" then return make_scan_ok("OP_TIMES", "*", cur + 1, cur_line, cur_col + 1) end if
    if ch = "/" then return make_scan_ok("OP_DIVIDE", "/", cur + 1, cur_line, cur_col + 1) end if

    return make_scan_error(cur + 1, cur_line, cur_col + 1,
        String.concat("Unexpected character: ", ch))
end scan_next

end Compiler.Core.FullLexer
