function mini_nested_call_module_lexer_summary(tokens: MiniNestedCallModuleTokens) returns String
requires String.instr(tokens.var_name.lexeme, "") = 0
ensures String.instr(result, tokens.var_name.lexeme) >= 0
is
    return String.template("${module_kw}|${module_name}|${let_kw}|${var}|${assign}|${outer}|${open0}|${inner}|${open1}|${arg}|${close1}|${close0}|${end_kw}|${end_name}",
        module_kw: token_text(tokens.module_keyword),
        module_name: token_text(tokens.module_name),
