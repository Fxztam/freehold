    let argument_token: Token = make_token(literal_string, make_source_span(source_name, 2, 21, 2, 24), argument)
    let close_paren1: Token = make_token(paren_close, make_source_span(source_name, 2, 25, 2, 26), ")")
    let close_paren0: Token = make_token(paren_close, make_source_span(source_name, 2, 27, 2, 28), ")")
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 3, 1, 3, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 3, 5, 3, 9), module_name)

    return MiniNestedCallModuleTokens {
