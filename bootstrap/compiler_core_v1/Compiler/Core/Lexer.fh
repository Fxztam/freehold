module Compiler.Core.Lexer

import Compiler.Core.Token exposing SourceSpan, Token, TokenKind, make_source_span, make_token, make_token_kind, token_text
import File

type MiniModuleTokens is record
    module_keyword: Token
    module_name: Token
    end_keyword: Token
    end_name: Token
end record

type MiniRecordModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_keyword: Token
    type_name: Token
    is_keyword: Token
    record_keyword: Token
    record_end_keyword: Token
    record_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniSubtypeRangeModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_keyword: Token
    type_name: Token
    is_keyword: Token
    base_type: Token
    range_keyword: Token
    min_value: Token
    double_dot: Token
    max_value: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniFunctionModuleTokens is record
    module_keyword: Token
    module_name: Token
    function_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    returns_keyword: Token
    return_type: Token
    is_keyword: Token
    return_keyword: Token
    return_literal: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniProcedureModuleTokens is record
    module_keyword: Token
    module_name: Token
    procedure_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    is_keyword: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniImportModuleTokens is record
    import_keyword: Token
    import_module_name: Token
    exposing_keyword: Token
    exposed_name: Token
    module_keyword: Token
    module_name: Token
    end_keyword: Token
    end_name: Token
end record

type MiniImportReferenceModuleTokens is record
    import_keyword: Token
    import_module_name: Token
    exposing_keyword: Token
    exposed_name: Token
    module_keyword: Token
    module_name: Token
    function_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    returns_keyword: Token
    return_type: Token
    is_keyword: Token
    return_keyword: Token
    return_symbol: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniRecordLiteralModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_name: Token
    open_brace: Token
    field0_name: Token
    colon0: Token
    field0_value: Token
    comma0: Token
    field1_name: Token
    colon1: Token
    field1_value: Token
    close_brace: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniReturnStmtModuleTokens is record
    module_keyword: Token
    module_name: Token
    return_keyword: Token
    return_kind: Token
    val: Token
    error_ref: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniCallModuleTokens is record
    module_keyword: Token
    module_name: Token
    call_keyword: Token
    routine_name: Token
    open_paren: Token
    argument: Token
    close_paren: Token
    aborts_keyword: Token
    error_type: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniNestedCallModuleTokens is record
    module_keyword: Token
    module_name: Token
    let_keyword: Token
    var_name: Token
    assign_symbol: Token
    outer_routine: Token
    open_paren0: Token
    inner_routine: Token
    open_paren1: Token
    argument: Token
    close_paren1: Token
    close_paren0: Token
    module_end_keyword: Token
    module_end_name: Token
end record

function lex_file_tokens_30(source_name: String) returns Array<Token, 30>
requires String.instr(source_name, "") = 0
is
    let file_res: Result<String, String> = File.read_to_string(source_name)
    let content: String = file_res.value
    let lex: Lexer = make_lexer(source_name, content)
    
    let t0: LexerResult = lex_next_token(lex)
    let t1: LexerResult = lex_next_token(t0.lexer)
    let t2: LexerResult = lex_next_token(t1.lexer)
    let t3: LexerResult = lex_next_token(t2.lexer)
    let t4: LexerResult = lex_next_token(t3.lexer)
    let t5: LexerResult = lex_next_token(t4.lexer)
    let t6: LexerResult = lex_next_token(t5.lexer)
    let t7: LexerResult = lex_next_token(t6.lexer)
    let t8: LexerResult = lex_next_token(t7.lexer)
    let t9: LexerResult = lex_next_token(t8.lexer)
    let t10: LexerResult = lex_next_token(t9.lexer)
    let t11: LexerResult = lex_next_token(t10.lexer)
    let t12: LexerResult = lex_next_token(t11.lexer)
    let t13: LexerResult = lex_next_token(t12.lexer)
    let t14: LexerResult = lex_next_token(t13.lexer)
    let t15: LexerResult = lex_next_token(t14.lexer)
    let t16: LexerResult = lex_next_token(t15.lexer)
    let t17: LexerResult = lex_next_token(t16.lexer)
    let t18: LexerResult = lex_next_token(t17.lexer)
    let t19: LexerResult = lex_next_token(t18.lexer)
    let t20: LexerResult = lex_next_token(t19.lexer)
    let t21: LexerResult = lex_next_token(t20.lexer)
    let t22: LexerResult = lex_next_token(t21.lexer)
    let t23: LexerResult = lex_next_token(t22.lexer)
    let t24: LexerResult = lex_next_token(t23.lexer)
    let t25: LexerResult = lex_next_token(t24.lexer)
    let t26: LexerResult = lex_next_token(t25.lexer)
    let t27: LexerResult = lex_next_token(t26.lexer)
    let t28: LexerResult = lex_next_token(t27.lexer)
    let t29: LexerResult = lex_next_token(t28.lexer)

    return [
        t0.token, t1.token, t2.token, t3.token, t4.token, t5.token, t6.token, t7.token, t8.token, t9.token,
        t10.token, t11.token, t12.token, t13.token, t14.token, t15.token, t16.token, t17.token, t18.token, t19.token,
        t20.token, t21.token, t22.token, t23.token, t24.token, t25.token, t26.token, t27.token, t28.token, t29.token
    ]
end lex_file_tokens_30

function lex_mini_module(source_name: String, module_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0
is
    return lex_mini_module_pair(source_name, module_name, module_name)
end lex_mini_module

function lex_mini_module_pair(source_name: String, module_name: String, end_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(end_name, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        end_keyword: t[2],
        end_name: t[3]
    }
end lex_mini_module_pair

function mini_module_token_count(tokens: MiniModuleTokens) returns Integer
ensures result = 4
is
    return 4
end mini_module_token_count

function mini_module_lexer_summary(tokens: MiniModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0
ensures String.instr(result, tokens.module_name.lexeme) >= 0
is
    return String.template("${first}|${name}|${end_kw}|${end_name}", first: token_text(tokens.module_keyword), name: token_text(tokens.module_name), end_kw: token_text(tokens.end_keyword), end_name: token_text(tokens.end_name))
end mini_module_lexer_summary

function lex_mini_record_module(source_name: String, module_name: String, record_name: String) returns MiniRecordModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(record_name, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniRecordModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        type_keyword: t[2],
        type_name: t[3],
        is_keyword: t[4],
        record_keyword: t[5],
        record_end_keyword: t[6],
        record_end_name: t[7],
        module_end_keyword: t[8],
        module_end_name: t[9]
    }
end lex_mini_record_module

function mini_record_module_token_count(tokens: MiniRecordModuleTokens) returns Integer
ensures result = 10
is
    return 10
end mini_record_module_token_count

function mini_record_module_lexer_summary(tokens: MiniRecordModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.type_name.lexeme, "") = 0
ensures String.instr(result, tokens.type_name.lexeme) >= 0
is
    return String.template("${module_val}|${name}|${type_kw}|${type_name}|${is_kw}|${record_kw}|${record_end}|${record_end_name}|${module_end}|${module_end_name}", module_val: token_text(tokens.module_keyword), name: token_text(tokens.module_name), type_kw: token_text(tokens.type_keyword), type_name: token_text(tokens.type_name), is_kw: token_text(tokens.is_keyword), record_kw: token_text(tokens.record_keyword), record_end: token_text(tokens.record_end_keyword), record_end_name: token_text(tokens.record_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_record_module_lexer_summary

