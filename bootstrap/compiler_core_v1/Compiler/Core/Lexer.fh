module Compiler.Core.Lexer

import Compiler.Core.Token exposing Token, TokenKind, make_source_span, make_token, make_token_kind, token_text

type MiniModuleTokens is record
    module_keyword: Token
    module_name: Token
    end_keyword: Token
    end_name: Token
end record

type MiniRecordModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_keyword: Token
    type_name: Token
    is_keyword: Token
    record_keyword: Token
    record_end_keyword: Token
    record_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

function lex_mini_module(source_name: String, module_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name
is
    return lex_mini_module_pair(source_name, module_name, module_name)
end lex_mini_module

function lex_mini_module_pair(source_name: String, module_name: String, end_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(end_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.end_name.lexeme = end_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 2, 1, 2, 4), "end")
    let end_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 5, 2, 10), end_name)

    return MiniModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        end_keyword: end_keyword,
        end_name: end_name_token
    }
end lex_mini_module_pair

function mini_module_token_count(tokens: MiniModuleTokens) returns Integer
ensures result = 4
is
    return 4
end mini_module_token_count

function mini_module_lexer_summary(tokens: MiniModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0
ensures String.instr(result, tokens.module_name.lexeme) >= 0
is
    return String.template("${first}|${name}|${end}|${end_name}", first: token_text(tokens.module_keyword), name: token_text(tokens.module_name), end: token_text(tokens.end_keyword), end_name: token_text(tokens.end_name))
end mini_module_lexer_summary

function lex_mini_record_module(source_name: String, module_name: String, record_name: String) returns MiniRecordModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(record_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.type_name.lexeme = record_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_type: TokenKind = make_token_kind("KeywordType")
    let keyword_is: TokenKind = make_token_kind("KeywordIs")
    let keyword_record: TokenKind = make_token_kind("KeywordRecord")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let type_keyword: Token = make_token(keyword_type, make_source_span(source_name, 2, 1, 2, 5), "type")
    let type_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 6, 2, 7), record_name)
    let is_keyword: Token = make_token(keyword_is, make_source_span(source_name, 2, 8, 2, 10), "is")
    let record_keyword: Token = make_token(keyword_record, make_source_span(source_name, 2, 11, 2, 17), "record")
    let record_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 3, 1, 3, 4), "end")
    let record_end_name: Token = make_token(keyword_record, make_source_span(source_name, 3, 5, 3, 11), "record")
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 4, 1, 4, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 4, 5, 4, 9), module_name)

    return MiniRecordModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        type_keyword: type_keyword,
        type_name: type_name_token,
        is_keyword: is_keyword,
        record_keyword: record_keyword,
        record_end_keyword: record_end_keyword,
        record_end_name: record_end_name,
        module_end_keyword: module_end_keyword,
        module_end_name: module_end_name
    }
end lex_mini_record_module

function mini_record_module_token_count(tokens: MiniRecordModuleTokens) returns Integer
ensures result = 10
is
    return 10
end mini_record_module_token_count

function mini_record_module_lexer_summary(tokens: MiniRecordModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.type_name.lexeme, "") = 0
ensures String.instr(result, tokens.type_name.lexeme) >= 0
is
    return String.template("${module}|${name}|${type_kw}|${type_name}|${is_kw}|${record_kw}|${record_end}|${record_end_name}|${module_end}|${module_end_name}", module: token_text(tokens.module_keyword), name: token_text(tokens.module_name), type_kw: token_text(tokens.type_keyword), type_name: token_text(tokens.type_name), is_kw: token_text(tokens.is_keyword), record_kw: token_text(tokens.record_keyword), record_end: token_text(tokens.record_end_keyword), record_end_name: token_text(tokens.record_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_record_module_lexer_summary

end Compiler.Core.Lexer