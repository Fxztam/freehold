function mini_subtype_range_module_lexer_summary(tokens: MiniSubtypeRangeModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.type_name.lexeme, "") = 0
ensures String.instr(result, tokens.type_name.lexeme) >= 0
is
    return String.template("${module_val}|${name}|${type_kw}|${type_name}|${is_kw}|${base_type}|${range_kw}|${min_val}|${double_dot}|${max_val}|${module_end}|${module_end_name}",
        module_val: token_text(tokens.module_keyword),
        name: token_text(tokens.module_name),
        type_kw: token_text(tokens.type_keyword),
        type_name: token_text(tokens.type_name),
        is_kw: token_text(tokens.is_keyword),
        base_type: token_text(tokens.base_type),
        range_kw: token_text(tokens.range_keyword),
        min_val: token_text(tokens.min_value),
        double_dot: token_text(tokens.double_dot),
        max_val: token_text(tokens.max_value),
        module_end: token_text(tokens.module_end_keyword),
        module_end_name: token_text(tokens.module_end_name)
    )
end mini_subtype_range_module_lexer_summary

function lex_mini_function_module(source_name: String, module_name: String, routine_name: String) returns MiniFunctionModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniFunctionModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        function_keyword: t[2],
        routine_name: t[3],
        open_paren: t[4],
        close_paren: t[5],
        returns_keyword: t[6],
        return_type: t[7],
        is_keyword: t[8],
        return_keyword: t[9],
        return_literal: t[10],
        routine_end_keyword: t[11],
        routine_end_name: t[12],
        module_end_keyword: t[13],
        module_end_name: t[14]
    }
end lex_mini_function_module

function mini_function_module_token_count(tokens: MiniFunctionModuleTokens) returns Integer
ensures result = 15
is
    return 15
end mini_function_module_token_count

