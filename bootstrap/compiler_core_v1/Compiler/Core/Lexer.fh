function mini_record_literal_module_lexer_summary(tokens: MiniRecordLiteralModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0
ensures String.instr(result, tokens.module_name.lexeme) >= 0
is
    return String.template("${module_kw}|${module_name}|${type}|${open_b}|${f0_name}|${colon0}|${f0_val}|${comma0}|${f1_name}|${colon1}|${f1_val}|${close_b}|${end_kw}|${end_name}",
        module_kw: token_text(tokens.module_keyword),
        module_name: token_text(tokens.module_name),
        type: token_text(tokens.type_name),
        open_b: token_text(tokens.open_brace),
        f0_name: token_text(tokens.field0_name),
        colon0: token_text(tokens.colon0),
        f0_val: token_text(tokens.field0_value),
        comma0: token_text(tokens.comma0),
        f1_name: token_text(tokens.field1_name),
        colon1: token_text(tokens.colon1),
        f1_val: token_text(tokens.field1_value),
        close_b: token_text(tokens.close_brace),
        end_kw: token_text(tokens.module_end_keyword),
        end_name: token_text(tokens.module_end_name)
    )
end mini_record_literal_module_lexer_summary

function lex_mini_return_stmt_module(source_name: String, module_name: String, return_kind: String, val: String, error_ref: String) returns MiniReturnStmtModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(return_kind, "") = 0, String.instr(val, "") = 0, String.instr(error_ref, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniReturnStmtModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        return_keyword: t[2],
        return_kind: t[3],
        val: t[4],
        error_ref: t[5],
        module_end_keyword: t[6],
        module_end_name: t[7]
    }
end lex_mini_return_stmt_module

function mini_return_stmt_module_token_count(tokens: MiniReturnStmtModuleTokens) returns Integer
ensures result = 8
is
    return 8
end mini_return_stmt_module_token_count

function mini_return_stmt_module_lexer_summary(tokens: MiniReturnStmtModuleTokens) returns String
requires String.instr(tokens.return_kind.lexeme, "") = 0, String.instr(tokens.val.lexeme, "") = 0
ensures String.instr(result, tokens.return_kind.lexeme) >= 0
is
    return String.template("${module_kw}|${module_name}|${return_kw}|${kind}|${val}|${err}|${end_kw}|${end_name}",
        module_kw: token_text(tokens.module_keyword),
        module_name: token_text(tokens.module_name),
        return_kw: token_text(tokens.return_keyword),
        kind: token_text(tokens.return_kind),
        val: token_text(tokens.val),
        err: token_text(tokens.error_ref),
        end_kw: token_text(tokens.module_end_keyword),
        end_name: token_text(tokens.module_end_name)
    )
end mini_return_stmt_module_lexer_summary

function lex_mini_call_module(source_name: String, module_name: String, routine_name: String, argument: String, error_type: String) returns MiniCallModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0, String.instr(argument, "") = 0, String.instr(error_type, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniCallModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        call_keyword: t[2],
        routine_name: t[3],
        open_paren: t[4],
        argument: t[5],
        close_paren: t[6],
        aborts_keyword: t[7],
        error_type: t[8],
        module_end_keyword: t[9],
        module_end_name: t[10]
    }
end lex_mini_call_module

function mini_call_module_token_count(tokens: MiniCallModuleTokens) returns Integer
ensures result = 11
is
    return 11
end mini_call_module_token_count

function mini_call_module_lexer_summary(tokens: MiniCallModuleTokens) returns String
requires String.instr(tokens.routine_name.lexeme, "") = 0, String.instr(tokens.error_type.lexeme, "") = 0
ensures String.instr(result, tokens.routine_name.lexeme) >= 0
is
    return String.template("${module_kw}|${module_name}|${call_kw}|${name}|${open_p}|${arg}|${close_p}|${aborts_kw}|${err}|${end_kw}|${end_name}", module_kw: token_text(tokens.module_keyword), module_name: token_text(tokens.module_name), call_kw: token_text(tokens.call_keyword), name: token_text(tokens.routine_name), open_p: token_text(tokens.open_paren), arg: token_text(tokens.argument), close_p: token_text(tokens.close_paren), aborts_kw: token_text(tokens.aborts_keyword), err: token_text(tokens.error_type), end_kw: token_text(tokens.module_end_keyword), end_name: token_text(tokens.module_end_name))
end mini_call_module_lexer_summary

function lex_mini_nested_call_module(source_name: String, module_name: String, var_name: String, outer: String, inner: String, argument: String) returns MiniNestedCallModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(var_name, "") = 0, String.instr(outer, "") = 0, String.instr(inner, "") = 0, String.instr(argument, "") = 0
