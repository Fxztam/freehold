module Compiler.Core.Lexer

import Compiler.Core.Token exposing Token, TokenKind, make_source_span, make_token, make_token_kind, token_text

type MiniModuleTokens is record
    module_keyword: Token
    module_name: Token
    end_keyword: Token
    end_name: Token
end record

type MiniRecordModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_keyword: Token
    type_name: Token
    is_keyword: Token
    record_keyword: Token
    record_end_keyword: Token
    record_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniFunctionModuleTokens is record
    module_keyword: Token
    module_name: Token
    function_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    returns_keyword: Token
    return_type: Token
    is_keyword: Token
    return_keyword: Token
    return_literal: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniProcedureModuleTokens is record
    module_keyword: Token
    module_name: Token
    procedure_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    is_keyword: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniImportModuleTokens is record
    import_keyword: Token
    import_module_name: Token
    exposing_keyword: Token
    exposed_name: Token
    module_keyword: Token
    module_name: Token
    end_keyword: Token
    end_name: Token
end record

type MiniImportReferenceModuleTokens is record
    import_keyword: Token
    import_module_name: Token
    exposing_keyword: Token
    exposed_name: Token
    module_keyword: Token
    module_name: Token
    function_keyword: Token
    routine_name: Token
    open_paren: Token
    close_paren: Token
    returns_keyword: Token
    return_type: Token
    is_keyword: Token
    return_keyword: Token
    return_symbol: Token
    routine_end_keyword: Token
    routine_end_name: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniRecordLiteralModuleTokens is record
    module_keyword: Token
    module_name: Token
    type_name: Token
    open_brace: Token
    field0_name: Token
    colon0: Token
    field0_value: Token
    comma0: Token
    field1_name: Token
    colon1: Token
    field1_value: Token
    close_brace: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniReturnStmtModuleTokens is record
    module_keyword: Token
    module_name: Token
    return_keyword: Token
    return_kind: Token
    val: Token
    error_ref: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniCallModuleTokens is record
    module_keyword: Token
    module_name: Token
    call_keyword: Token
    routine_name: Token
    open_paren: Token
    argument: Token
    close_paren: Token
    aborts_keyword: Token
    error_type: Token
    module_end_keyword: Token
    module_end_name: Token
end record

type MiniNestedCallModuleTokens is record
    module_keyword: Token
    module_name: Token
    let_keyword: Token
    var_name: Token
    assign_symbol: Token
    outer_routine: Token
    open_paren0: Token
    inner_routine: Token
    open_paren1: Token
    argument: Token
    close_paren1: Token
    close_paren0: Token
    module_end_keyword: Token
    module_end_name: Token
end record



function lex_mini_module(source_name: String, module_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name
is
    return lex_mini_module_pair(source_name, module_name, module_name)
end lex_mini_module

function lex_mini_module_pair(source_name: String, module_name: String, end_name: String) returns MiniModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(end_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.end_name.lexeme = end_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 2, 1, 2, 4), "end")
    let end_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 5, 2, 10), end_name)

    return MiniModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        end_keyword: end_keyword,
        end_name: end_name_token
    }
end lex_mini_module_pair

function mini_module_token_count(tokens: MiniModuleTokens) returns Integer
ensures result = 4
is
    return 4
end mini_module_token_count

function mini_module_lexer_summary(tokens: MiniModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0
ensures String.instr(result, tokens.module_name.lexeme) >= 0
is
    return String.template("${first}|${name}|${end_kw}|${end_name}", first: token_text(tokens.module_keyword), name: token_text(tokens.module_name), end_kw: token_text(tokens.end_keyword), end_name: token_text(tokens.end_name))
end mini_module_lexer_summary

function lex_mini_record_module(source_name: String, module_name: String, record_name: String) returns MiniRecordModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(record_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.type_name.lexeme = record_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_type: TokenKind = make_token_kind("KeywordType")
    let keyword_is: TokenKind = make_token_kind("KeywordIs")
    let keyword_record: TokenKind = make_token_kind("KeywordRecord")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let type_keyword: Token = make_token(keyword_type, make_source_span(source_name, 2, 1, 2, 5), "type")
    let type_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 6, 2, 7), record_name)
    let is_keyword: Token = make_token(keyword_is, make_source_span(source_name, 2, 8, 2, 10), "is")
    let record_keyword: Token = make_token(keyword_record, make_source_span(source_name, 2, 11, 2, 17), "record")
    let record_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 3, 1, 3, 4), "end")
    let record_end_name: Token = make_token(keyword_record, make_source_span(source_name, 3, 5, 3, 11), "record")
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 4, 1, 4, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 4, 5, 4, 9), module_name)

    return MiniRecordModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        type_keyword: type_keyword,
        type_name: type_name_token,
        is_keyword: is_keyword,
        record_keyword: record_keyword,
        record_end_keyword: record_end_keyword,
        record_end_name: record_end_name,
        module_end_keyword: module_end_keyword,
        module_end_name: module_end_name
    }
end lex_mini_record_module

function mini_record_module_token_count(tokens: MiniRecordModuleTokens) returns Integer
ensures result = 10
is
    return 10
end mini_record_module_token_count

function mini_record_module_lexer_summary(tokens: MiniRecordModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.type_name.lexeme, "") = 0
ensures String.instr(result, tokens.type_name.lexeme) >= 0
is
    return String.template("${module_val}|${name}|${type_kw}|${type_name}|${is_kw}|${record_kw}|${record_end}|${record_end_name}|${module_end}|${module_end_name}", module_val: token_text(tokens.module_keyword), name: token_text(tokens.module_name), type_kw: token_text(tokens.type_keyword), type_name: token_text(tokens.type_name), is_kw: token_text(tokens.is_keyword), record_kw: token_text(tokens.record_keyword), record_end: token_text(tokens.record_end_keyword), record_end_name: token_text(tokens.record_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_record_module_lexer_summary

function lex_mini_function_module(source_name: String, module_name: String, routine_name: String) returns MiniFunctionModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.routine_name.lexeme = routine_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_function: TokenKind = make_token_kind("KeywordFunction")
    let keyword_returns: TokenKind = make_token_kind("KeywordReturns")
    let keyword_is: TokenKind = make_token_kind("KeywordIs")
    let keyword_return: TokenKind = make_token_kind("KeywordReturn")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")
    let type_name: TokenKind = make_token_kind("TypeName")
    let integer_literal: TokenKind = make_token_kind("IntegerLiteral")
    let open_paren_kind: TokenKind = make_token_kind("SymbolOpenParen")
    let close_paren_kind: TokenKind = make_token_kind("SymbolCloseParen")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let function_keyword: Token = make_token(keyword_function, make_source_span(source_name, 2, 1, 2, 9), "function")
    let routine_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 10, 2, 16), routine_name)
    let open_paren: Token = make_token(open_paren_kind, make_source_span(source_name, 2, 16, 2, 17), "(")
    let close_paren: Token = make_token(close_paren_kind, make_source_span(source_name, 2, 17, 2, 18), ")")
    let returns_keyword: Token = make_token(keyword_returns, make_source_span(source_name, 2, 19, 2, 26), "returns")
    let return_type_token: Token = make_token(type_name, make_source_span(source_name, 2, 27, 2, 34), "Integer")
    let is_keyword: Token = make_token(keyword_is, make_source_span(source_name, 2, 35, 2, 37), "is")
    let return_keyword: Token = make_token(keyword_return, make_source_span(source_name, 3, 1, 3, 7), "return")
    let return_literal: Token = make_token(integer_literal, make_source_span(source_name, 3, 8, 3, 10), "42")
    let routine_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 4, 1, 4, 4), "end")
    let routine_end_name: Token = make_token(identifier, make_source_span(source_name, 4, 5, 4, 11), routine_name)
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 5, 1, 5, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 5, 5, 5, 9), module_name)

    return MiniFunctionModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        function_keyword: function_keyword,
        routine_name: routine_name_token,
        open_paren: open_paren,
        close_paren: close_paren,
        returns_keyword: returns_keyword,
        return_type: return_type_token,
        is_keyword: is_keyword,
        return_keyword: return_keyword,
        return_literal: return_literal,
        routine_end_keyword: routine_end_keyword,
        routine_end_name: routine_end_name,
        module_end_keyword: module_end_keyword,
        module_end_name: module_end_name
    }
end lex_mini_function_module

function mini_function_module_token_count(tokens: MiniFunctionModuleTokens) returns Integer
ensures result = 15
is
    return 15
end mini_function_module_token_count

function mini_function_module_lexer_summary(tokens: MiniFunctionModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.routine_name.lexeme, "") = 0
ensures String.instr(result, tokens.routine_name.lexeme) >= 0
is
    return String.template("${module_val}|${name}|${function_kw}|${routine}|${open_paren}|${close_paren}|${returns_kw}|${return_type}|${is_kw}|${return_kw}|${literal}|${routine_end}|${routine_end_name}|${module_end}|${module_end_name}", module_val: token_text(tokens.module_keyword), name: token_text(tokens.module_name), function_kw: token_text(tokens.function_keyword), routine: token_text(tokens.routine_name), open_paren: token_text(tokens.open_paren), close_paren: token_text(tokens.close_paren), returns_kw: token_text(tokens.returns_keyword), return_type: token_text(tokens.return_type), is_kw: token_text(tokens.is_keyword), return_kw: token_text(tokens.return_keyword), literal: token_text(tokens.return_literal), routine_end: token_text(tokens.routine_end_keyword), routine_end_name: token_text(tokens.routine_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_function_module_lexer_summary

function lex_mini_procedure_module(source_name: String, module_name: String, routine_name: String) returns MiniProcedureModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(routine_name, "") = 0
ensures result.module_keyword.lexeme = "module", result.module_name.lexeme = module_name, result.routine_name.lexeme = routine_name
is
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_procedure: TokenKind = make_token_kind("KeywordProcedure")
    let keyword_is: TokenKind = make_token_kind("KeywordIs")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")
    let open_paren_kind: TokenKind = make_token_kind("SymbolOpenParen")
    let close_paren_kind: TokenKind = make_token_kind("SymbolCloseParen")

    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 1, 1, 1, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 8, 1, 12), module_name)
    let procedure_keyword: Token = make_token(keyword_procedure, make_source_span(source_name, 2, 1, 2, 10), "procedure")
    let routine_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 11, 2, 14), routine_name)
    let open_paren: Token = make_token(open_paren_kind, make_source_span(source_name, 2, 14, 2, 15), "(")
    let close_paren: Token = make_token(close_paren_kind, make_source_span(source_name, 2, 15, 2, 16), ")")
    let is_keyword: Token = make_token(keyword_is, make_source_span(source_name, 2, 17, 2, 19), "is")
    let routine_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 3, 1, 3, 4), "end")
    let routine_end_name: Token = make_token(identifier, make_source_span(source_name, 3, 5, 3, 8), routine_name)
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 4, 1, 4, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 4, 5, 4, 9), module_name)

    return MiniProcedureModuleTokens {
        module_keyword: module_keyword,
        module_name: module_name_token,
        procedure_keyword: procedure_keyword,
        routine_name: routine_name_token,
        open_paren: open_paren,
        close_paren: close_paren,
        is_keyword: is_keyword,
        routine_end_keyword: routine_end_keyword,
        routine_end_name: routine_end_name,
        module_end_keyword: module_end_keyword,
        module_end_name: module_end_name
    }
end lex_mini_procedure_module

function mini_procedure_module_token_count(tokens: MiniProcedureModuleTokens) returns Integer
ensures result = 11
is
    return 11
end mini_procedure_module_token_count

function mini_procedure_module_lexer_summary(tokens: MiniProcedureModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.routine_name.lexeme, "") = 0
ensures String.instr(result, tokens.routine_name.lexeme) >= 0
is
    return String.template("${module_val}|${name}|${procedure_kw}|${routine}|${open_paren}|${close_paren}|${is_kw}|${routine_end}|${routine_end_name}|${module_end}|${module_end_name}", module_val: token_text(tokens.module_keyword), name: token_text(tokens.module_name), procedure_kw: token_text(tokens.procedure_keyword), routine: token_text(tokens.routine_name), open_paren: token_text(tokens.open_paren), close_paren: token_text(tokens.close_paren), is_kw: token_text(tokens.is_keyword), routine_end: token_text(tokens.routine_end_keyword), routine_end_name: token_text(tokens.routine_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_procedure_module_lexer_summary

function lex_mini_import_module(source_name: String, module_name: String, import_module_name: String, exposed_name: String) returns MiniImportModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0
ensures result.import_keyword.lexeme = "import", result.module_name.lexeme = module_name, result.import_module_name.lexeme = import_module_name
is
    let keyword_import: TokenKind = make_token_kind("KeywordImport")
    let keyword_exposing: TokenKind = make_token_kind("KeywordExposing")
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")
    let qualified_name: TokenKind = make_token_kind("QualifiedName")

    let import_keyword: Token = make_token(keyword_import, make_source_span(source_name, 1, 1, 1, 7), "import")
    let import_module_name_token: Token = make_token(qualified_name, make_source_span(source_name, 1, 8, 1, 20), import_module_name)
    let exposing_keyword: Token = make_token(keyword_exposing, make_source_span(source_name, 1, 21, 1, 29), "exposing")
    let exposed_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 30, 1, 36), exposed_name)
    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 2, 1, 2, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 8, 2, 12), module_name)
    let end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 3, 1, 3, 4), "end")
    let end_name_token: Token = make_token(identifier, make_source_span(source_name, 3, 5, 3, 9), module_name)

    return MiniImportModuleTokens {
        import_keyword: import_keyword,
        import_module_name: import_module_name_token,
        exposing_keyword: exposing_keyword,
        exposed_name: exposed_name_token,
        module_keyword: module_keyword,
        module_name: module_name_token,
        end_keyword: end_keyword,
        end_name: end_name_token
    }
end lex_mini_import_module

function mini_import_module_token_count(tokens: MiniImportModuleTokens) returns Integer
ensures result = 8
is
    return 8
end mini_import_module_token_count

function mini_import_module_lexer_summary(tokens: MiniImportModuleTokens) returns String
requires String.instr(tokens.import_module_name.lexeme, "") = 0, String.instr(tokens.exposed_name.lexeme, "") = 0
ensures String.instr(result, tokens.import_module_name.lexeme) >= 0
is
    return String.template("${import_kw}|${import_module}|${exposing_kw}|${exposed}|${module_kw}|${module_name}|${end_kw}|${end_name}", import_kw: token_text(tokens.import_keyword), import_module: token_text(tokens.import_module_name), exposing_kw: token_text(tokens.exposing_keyword), exposed: token_text(tokens.exposed_name), module_kw: token_text(tokens.module_keyword), module_name: token_text(tokens.module_name), end_kw: token_text(tokens.end_keyword), end_name: token_text(tokens.end_name))
end mini_import_module_lexer_summary

function lex_mini_import_reference_module(source_name: String, module_name: String, import_module_name: String, exposed_name: String, routine_name: String) returns MiniImportReferenceModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0, String.instr(routine_name, "") = 0
ensures result.import_keyword.lexeme = "import", result.return_symbol.lexeme = exposed_name, result.routine_name.lexeme = routine_name
is
    return lex_mini_import_reference_module_pair(source_name, module_name, import_module_name, exposed_name, routine_name, exposed_name)
end lex_mini_import_reference_module

function lex_mini_import_reference_module_pair(source_name: String, module_name: String, import_module_name: String, exposed_name: String, routine_name: String, return_symbol_name: String) returns MiniImportReferenceModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0, String.instr(routine_name, "") = 0, String.instr(return_symbol_name, "") = 0
ensures result.import_keyword.lexeme = "import", result.exposed_name.lexeme = exposed_name, result.return_symbol.lexeme = return_symbol_name, result.routine_name.lexeme = routine_name
is
    let keyword_import: TokenKind = make_token_kind("KeywordImport")
    let keyword_exposing: TokenKind = make_token_kind("KeywordExposing")
    let keyword_module: TokenKind = make_token_kind("KeywordModule")
    let keyword_function: TokenKind = make_token_kind("KeywordFunction")
    let keyword_returns: TokenKind = make_token_kind("KeywordReturns")
    let keyword_is: TokenKind = make_token_kind("KeywordIs")
    let keyword_return: TokenKind = make_token_kind("KeywordReturn")
    let keyword_end: TokenKind = make_token_kind("KeywordEnd")
    let identifier: TokenKind = make_token_kind("Identifier")
    let qualified_name: TokenKind = make_token_kind("QualifiedName")
    let type_name: TokenKind = make_token_kind("TypeName")
    let open_paren_kind: TokenKind = make_token_kind("SymbolOpenParen")
    let close_paren_kind: TokenKind = make_token_kind("SymbolCloseParen")

    let import_keyword: Token = make_token(keyword_import, make_source_span(source_name, 1, 1, 1, 7), "import")
    let import_module_name_token: Token = make_token(qualified_name, make_source_span(source_name, 1, 8, 1, 20), import_module_name)
    let exposing_keyword: Token = make_token(keyword_exposing, make_source_span(source_name, 1, 21, 1, 29), "exposing")
    let exposed_name_token: Token = make_token(identifier, make_source_span(source_name, 1, 30, 1, 36), exposed_name)
    let module_keyword: Token = make_token(keyword_module, make_source_span(source_name, 2, 1, 2, 7), "module")
    let module_name_token: Token = make_token(identifier, make_source_span(source_name, 2, 8, 2, 12), module_name)
    let function_keyword: Token = make_token(keyword_function, make_source_span(source_name, 3, 1, 3, 9), "function")
    let routine_name_token: Token = make_token(identifier, make_source_span(source_name, 3, 10, 3, 13), routine_name)
    let open_paren: Token = make_token(open_paren_kind, make_source_span(source_name, 3, 13, 3, 14), "(")
    let close_paren: Token = make_token(close_paren_kind, make_source_span(source_name, 3, 14, 3, 15), ")")
    let returns_keyword: Token = make_token(keyword_returns, make_source_span(source_name, 3, 16, 3, 23), "returns")
    let return_type_token: Token = make_token(type_name, make_source_span(source_name, 3, 24, 3, 31), "Integer")
    let is_keyword: Token = make_token(keyword_is, make_source_span(source_name, 3, 32, 3, 34), "is")
    let return_keyword: Token = make_token(keyword_return, make_source_span(source_name, 4, 1, 4, 7), "return")
    let return_symbol: Token = make_token(identifier, make_source_span(source_name, 4, 8, 4, 14), return_symbol_name)
    let routine_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 5, 1, 5, 4), "end")
    let routine_end_name: Token = make_token(identifier, make_source_span(source_name, 5, 5, 5, 8), routine_name)
    let module_end_keyword: Token = make_token(keyword_end, make_source_span(source_name, 6, 1, 6, 4), "end")
    let module_end_name: Token = make_token(identifier, make_source_span(source_name, 6, 5, 6, 9), module_name)

    return MiniImportReferenceModuleTokens {
        import_keyword: import_keyword,
