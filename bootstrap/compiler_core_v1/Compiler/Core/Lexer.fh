function lex_mini_import_module(source_name: String, module_name: String, import_module_name: String, exposed_name: String) returns MiniImportModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    let t1: Token = t[1]
    let t3: Token = t[3]
    let q_kind: TokenKind = make_token_kind("QualifiedName")
    let q_span: SourceSpan = make_source_span(source_name, t1.span.start_line, t1.span.start_column, t3.span.end_line, t3.span.end_column)
    let q_lexeme: String = String.template("${a}.${b}", a: t1.lexeme, b: t3.lexeme)
    let import_module_name_token: Token = make_token(q_kind, q_span, q_lexeme)
    
    return MiniImportModuleTokens {
        import_keyword: t[0],
        import_module_name: import_module_name_token,
        exposing_keyword: t[4],
        exposed_name: t[5],
        module_keyword: t[6],
        module_name: t[7],
        end_keyword: t[8],
        end_name: t[9]
    }
end lex_mini_import_module

function mini_import_module_token_count(tokens: MiniImportModuleTokens) returns Integer
ensures result = 8
is
    return 8
end mini_import_module_token_count

function mini_import_module_lexer_summary(tokens: MiniImportModuleTokens) returns String
requires String.instr(tokens.module_name.lexeme, "") = 0, String.instr(tokens.import_module_name.lexeme, "") = 0
ensures String.instr(result, tokens.import_module_name.lexeme) >= 0
is
    return String.template("${import_kw}|${import_module}|${exposing_kw}|${exposed}|${module_kw}|${module_name}|${end_kw}|${end_name}", import_kw: token_text(tokens.import_keyword), import_module: token_text(tokens.import_module_name), exposing_kw: token_text(tokens.exposing_keyword), exposed: token_text(tokens.exposed_name), module_kw: token_text(tokens.module_keyword), module_name: token_text(tokens.module_name), end_kw: token_text(tokens.end_keyword), end_name: token_text(tokens.end_name))
end mini_import_module_lexer_summary

function lex_mini_import_reference_module(source_name: String, module_name: String, import_module_name: String, exposed_name: String, routine_name: String) returns MiniImportReferenceModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0, String.instr(routine_name, "") = 0
is
    return lex_mini_import_reference_module_pair(source_name, module_name, import_module_name, exposed_name, routine_name, exposed_name)
end lex_mini_import_reference_module

function lex_mini_import_reference_module_pair(source_name: String, module_name: String, import_module_name: String, exposed_name: String, routine_name: String, return_symbol_name: String) returns MiniImportReferenceModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(import_module_name, "") = 0, String.instr(exposed_name, "") = 0, String.instr(routine_name, "") = 0, String.instr(return_symbol_name, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    let t1: Token = t[1]
    let t3: Token = t[3]
    let q_kind: TokenKind = make_token_kind("QualifiedName")
    let q_span: SourceSpan = make_source_span(source_name, t1.span.start_line, t1.span.start_column, t3.span.end_line, t3.span.end_column)
    let q_lexeme: String = String.template("${a}.${b}", a: t1.lexeme, b: t3.lexeme)
    let import_module_name_token: Token = make_token(q_kind, q_span, q_lexeme)

    return MiniImportReferenceModuleTokens {
        import_keyword: t[0],
        import_module_name: import_module_name_token,
        exposing_keyword: t[4],
        exposed_name: t[5],
        module_keyword: t[6],
        module_name: t[7],
        function_keyword: t[8],
        routine_name: t[9],
        open_paren: t[10],
        close_paren: t[11],
        returns_keyword: t[12],
        return_type: t[13],
        is_keyword: t[14],
        return_keyword: t[15],
        return_symbol: t[16],
        routine_end_keyword: t[17],
        routine_end_name: t[18],
        module_end_keyword: t[19],
        module_end_name: t[20]
    }
end lex_mini_import_reference_module_pair

function mini_import_reference_module_token_count(tokens: MiniImportReferenceModuleTokens) returns Integer
ensures result = 19
is
    return 19
end mini_import_reference_module_token_count

function mini_import_reference_module_lexer_summary(tokens: MiniImportReferenceModuleTokens) returns String
requires String.instr(tokens.import_module_name.lexeme, "") = 0, String.instr(tokens.return_symbol.lexeme, "") = 0
ensures String.instr(result, tokens.return_symbol.lexeme) >= 0
is
    return String.template("${import_kw}|${import_module}|${exposing_kw}|${exposed}|${module_kw}|${module_name}|${function_kw}|${routine}|${open_paren}|${close_paren}|${returns_kw}|${return_type}|${is_kw}|${return_kw}|${return_symbol}|${routine_end}|${routine_end_name}|${module_end}|${module_end_name}", import_kw: token_text(tokens.import_keyword), import_module: token_text(tokens.import_module_name), exposing_kw: token_text(tokens.exposing_keyword), exposed: token_text(tokens.exposed_name), module_kw: token_text(tokens.module_keyword), module_name: token_text(tokens.module_name), function_kw: token_text(tokens.function_keyword), routine: token_text(tokens.routine_name), open_paren: token_text(tokens.open_paren), close_paren: token_text(tokens.close_paren), returns_kw: token_text(tokens.returns_keyword), return_type: token_text(tokens.return_type), is_kw: token_text(tokens.is_keyword), return_kw: token_text(tokens.return_keyword), return_symbol: token_text(tokens.return_symbol), routine_end: token_text(tokens.routine_end_keyword), routine_end_name: token_text(tokens.routine_end_name), module_end: token_text(tokens.module_end_keyword), module_end_name: token_text(tokens.module_end_name))
end mini_import_reference_module_lexer_summary

function lex_mini_record_literal_module(source_name: String, module_name: String, type_name: String, field0_name: String, field0_value: String, field1_name: String, field1_value: String) returns MiniRecordLiteralModuleTokens
requires String.instr(source_name, "") = 0, String.instr(module_name, "") = 0, String.instr(type_name, "") = 0, String.instr(field0_name, "") = 0, String.instr(field0_value, "") = 0, String.instr(field1_name, "") = 0, String.instr(field1_value, "") = 0
is
    let t: Array<Token, 30> = lex_file_tokens_30(source_name)
    return MiniRecordLiteralModuleTokens {
        module_keyword: t[0],
        module_name: t[1],
        type_name: t[2],
        open_brace: t[3],
        field0_name: t[4],
        colon0: t[5],
        field0_value: t[6],
        comma0: t[7],
        field1_name: t[8],
        colon1: t[9],
        field1_value: t[10],
        close_brace: t[11],
        module_end_keyword: t[12],
        module_end_name: t[13]
    }
end lex_mini_record_literal_module

function mini_record_literal_module_token_count(tokens: MiniRecordLiteralModuleTokens) returns Integer
ensures result = 14
is
