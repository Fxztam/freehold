type Lexer is record
    source_name: String
    source: String
    length: Integer
    offset: Integer
    line: Integer
    column: Integer
end record

type LexerResult is record
    token: Token
    lexer: Lexer
    has_more: Boolean
end record

function make_lexer(source_name: String, source: String) returns Lexer
requires String.instr(source_name, "") = 0, String.instr(source, "") = 0
is
    return Lexer {
        source_name: source_name,
        source: source,
        length: String.length(source),
        offset: 0,
        line: 1,
        column: 1
    }
end make_lexer

function is_digit(c: String) returns Boolean
is
    return String.length(c) = 1 and String.instr("0123456789", c) >= 0
end is_digit

function is_alpha(c: String) returns Boolean
is
    return String.length(c) = 1 and String.instr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0
end is_alpha

function keyword_kind_name(lexeme: String) returns String
is
    case lexeme is
        when "module" => return "KeywordModule"
        when "import" => return "KeywordImport"
        when "exposing" => return "KeywordExposing"
        when "function" => return "KeywordFunction"
        when "procedure" => return "KeywordProcedure"
        when "record" => return "KeywordRecord"
        when "is" => return "KeywordIs"
        when "end" => return "KeywordEnd"
        when "type" => return "KeywordType"
        when "returns" => return "KeywordReturns"
        when "return" => return "KeywordReturn"
        when "let" => return "KeywordLet"
        when "if" => return "KeywordIf"
        when "then" => return "KeywordThen"
        when "else" => return "KeywordElse"
        when "while" => return "KeywordWhile"
        when "case" => return "KeywordCase"
        when "when" => return "KeywordWhen"
        when "default" => return "KeywordDefault"
        when "abort" => return "KeywordAbort"
        when "check" => return "KeywordCheck"
        when "scope" => return "KeywordScope"
        when "spawn" => return "KeywordSpawn"
        when "join" => return "KeywordJoin"
        when "invariant" => return "KeywordInvariant"
        when "variant" => return "KeywordVariant"
        when "do" => return "KeywordDo"
        when "not" => return "KeywordNot"
        when "and" => return "KeywordAnd"
        when "or" => return "KeywordOr"
        when "await" => return "KeywordAwait"
        when "call" => return "KeywordCall"
        when "range" => return "KeywordRange"
        when "requires" => return "KeywordRequires"
        when "aborts" => return "KeywordAborts"
        when "ensures" => return "KeywordEnsures"
        when "ok" => return "KeywordOk"
        when "true" => return "KeywordTrue"
        when "false" => return "KeywordFalse"
        when "success" => return "KeywordSuccess"
        when "failure" => return "KeywordFailure"
        when "value" => return "KeywordValue"
        when "async" => return "KeywordAsync"
        when "service" => return "KeywordService"
        when "rpc" => return "KeywordRpc"
        when "proto" => return "KeywordProto"
        when "result" => return "KeywordResult"
        when "error" => return "KeywordError"
        default => return "Identifier"
    end case
end keyword_kind_name

function peek_char(lexer: Lexer) returns String
is
    if lexer.offset >= lexer.length then
        return ""
    else
        return String.substr(lexer.source, lexer.offset, 1)
    end if
end peek_char

function peek_next_char(lexer: Lexer) returns String
is
    if lexer.offset + 1 >= lexer.length then
        return ""
    else
        return String.substr(lexer.source, lexer.offset + 1, 1)
    end if
end peek_next_char

function advance_lexer(lexer: Lexer) returns Lexer
is
    if lexer.offset >= lexer.length then
        return lexer
    end if
    
    let c: String = String.substr(lexer.source, lexer.offset, 1)
    let next_offset: Integer = lexer.offset + 1
    let next_line: Integer = lexer.line
    let next_column: Integer = lexer.column
    
    if c = "\n" then
        next_line := lexer.line + 1
        next_column := 1
    else
        next_column := lexer.column + 1
    end if
    
    return Lexer {
        source_name: lexer.source_name,
        source: lexer.source,
        length: lexer.length,
        offset: next_offset,
        line: next_line,
        column: next_column
    }
end advance_lexer

function skip_whitespace_and_comments(lexer: Lexer) returns Lexer
is
    let state: Lexer = lexer
    while state.offset < state.length
        invariant state.offset >= 0
        invariant state.offset <= state.length
        variant state.length - state.offset
    do
        let c: String = peek_char(state)
        if c = " " or c = "\t" or c = "\r" or c = "\n" then
            state := advance_lexer(state)
        else
            if c = "-" and peek_next_char(state) = "-" then
                state := advance_lexer(state)
                state := advance_lexer(state)
                while state.offset < state.length and peek_char(state) != "\n"
                    invariant state.offset >= 0
                    invariant state.offset <= state.length
                    variant state.length - state.offset
                do
                    state := advance_lexer(state)
                end while
            else
                if c = "/" and peek_next_char(state) = "*" then
                    state := advance_lexer(state)
                    state := advance_lexer(state)
                    while state.offset < state.length
                        invariant state.offset >= 0
                        invariant state.offset <= state.length
                        variant state.length - state.offset
                    do
                        if peek_char(state) = "*" and peek_next_char(state) = "/" then
                            state := advance_lexer(state) -- skip *
                            state := advance_lexer(state) -- skip /
                            return skip_whitespace_and_comments(state)
                        end if
                        state := advance_lexer(state)
                    end while
                else
                    return state
                end if
            end if
        end if
    end while
    return state
end skip_whitespace_and_comments

function lex_string(lexer: Lexer) returns LexerResult
is
    let state: Lexer = advance_lexer(lexer) -- skip "
    let start_line: Integer = lexer.line
    let start_column: Integer = lexer.column
    let lexeme: String = ""
    
    while state.offset < state.length
        invariant state.offset >= 0
        invariant state.offset <= state.length
        variant state.length - state.offset
    do
        let c: String = peek_char(state)
        if c = "\"" then
            state := advance_lexer(state) -- skip closing "
            let str_span: SourceSpan = make_source_span(lexer.source_name, start_line, start_column, state.line, state.column)
            let str_token: Token = make_token(make_token_kind("StringLiteral"), str_span, lexeme)
            return LexerResult { token: str_token, lexer: state, has_more: true }
        else
            if c = "\\" then
                state := advance_lexer(state)
                if state.offset < state.length then
                    let esc: String = peek_char(state)
                    state := advance_lexer(state)
                    lexeme := String.concat(lexeme, String.concat("\\", esc))
                end if
            else
                state := advance_lexer(state)
                lexeme := String.concat(lexeme, c)
            end if
        end if
    end while
    
    let err_span: SourceSpan = make_source_span(lexer.source_name, start_line, start_column, state.line, state.column)
    let err_token: Token = make_token(make_token_kind("Error"), err_span, lexeme)
    return LexerResult { token: err_token, lexer: state, has_more: false }
end lex_string

function lex_next_token(lexer: Lexer) returns LexerResult
is
    let state: Lexer = skip_whitespace_and_comments(lexer)
    if state.offset >= state.length then
        let eof_span: SourceSpan = make_source_span(state.source_name, state.line, state.column, state.line, state.column)
        let eof_token: Token = make_token(make_token_kind("EOF"), eof_span, "")
        return LexerResult { token: eof_token, lexer: state, has_more: false }
    end if
    
    let start_line: Integer = state.line
    let start_column: Integer = state.column
    let c: String = peek_char(state)
    
    if c = "\"" then
        return lex_string(state)
    end if
    
    if is_alpha(c) then
        let alpha_lexeme: String = ""
        while state.offset < state.length and (is_alpha(peek_char(state)) or is_digit(peek_char(state)))
            invariant state.offset >= 0
            invariant state.offset <= state.length
            variant state.length - state.offset
        do
            alpha_lexeme := String.concat(alpha_lexeme, peek_char(state))
            state := advance_lexer(state)
        end while
        
        let kind_name: String = keyword_kind_name(alpha_lexeme)
        let alpha_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let alpha_token: Token = make_token(make_token_kind(kind_name), alpha_span, alpha_lexeme)
        return LexerResult { token: alpha_token, lexer: state, has_more: true }
    end if
    
    if is_digit(c) then
        let digit_lexeme: String = ""
        while state.offset < state.length and is_digit(peek_char(state))
            invariant state.offset >= 0
            invariant state.offset <= state.length
            variant state.length - state.offset
        do
            digit_lexeme := String.concat(digit_lexeme, peek_char(state))
            state := advance_lexer(state)
        end while
        
        if state.offset < state.length and peek_char(state) = "." and peek_next_char(state) != "." then
            digit_lexeme := String.concat(digit_lexeme, ".")
            state := advance_lexer(state)
            while state.offset < state.length and is_digit(peek_char(state))
                invariant state.offset >= 0
                invariant state.offset <= state.length
                variant state.length - state.offset
            do
                digit_lexeme := String.concat(digit_lexeme, peek_char(state))
                state := advance_lexer(state)
            end while
            let double_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
            let double_token: Token = make_token(make_token_kind("DoubleLiteral"), double_span, digit_lexeme)
            return LexerResult { token: double_token, lexer: state, has_more: true }
        else
            let num_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
            let num_token: Token = make_token(make_token_kind("NumberLiteral"), num_span, digit_lexeme)
            return LexerResult { token: num_token, lexer: state, has_more: true }
        end if
    end if
    
    let next: String = peek_next_char(state)
    if c = ":" and next = "=" then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let assign_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let assign_token: Token = make_token(make_token_kind("Assign"), assign_span, ":=")
        return LexerResult { token: assign_token, lexer: state, has_more: true }
    end if
    
    if c = "!" and next = "=" then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let ne_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let ne_token: Token = make_token(make_token_kind("NotEqual"), ne_span, "!=")
        return LexerResult { token: ne_token, lexer: state, has_more: true }
    end if
    
    if c = "<" and next = "=" then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let le_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let le_token: Token = make_token(make_token_kind("LessThanOrEqual"), le_span, "<=")
        return LexerResult { token: le_token, lexer: state, has_more: true }
    end if
    
    if c = ">" and next = "=" then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let ge_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let ge_token: Token = make_token(make_token_kind("GreaterThanOrEqual"), ge_span, ">=")
        return LexerResult { token: ge_token, lexer: state, has_more: true }
    end if
    
    if c = "=" and next = ">" then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let arrow_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let arrow_token: Token = make_token(make_token_kind("CaseArrow"), arrow_span, "=>")
        return LexerResult { token: arrow_token, lexer: state, has_more: true }
    end if
    
    if c = "." and next = "." then
        state := advance_lexer(state)
        state := advance_lexer(state)
        let dot_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
        let dot_token: Token = make_token(make_token_kind("DoubleDot"), dot_span, "..")
        return LexerResult { token: dot_token, lexer: state, has_more: true }
    end if
    
    state := advance_lexer(state)
    let op_span: SourceSpan = make_source_span(state.source_name, start_line, start_column, state.line, state.column)
    let op_kind: String = ""
    case c is
        when "=" => op_kind := "Equal"
        when "<" => op_kind := "LessThan"
        when ">" => op_kind := "GreaterThan"
        when "+" => op_kind := "Plus"
        when "-" => op_kind := "Minus"
        when "*" => op_kind := "Star"
        when "/" => op_kind := "Slash"
        when "." => op_kind := "Dot"
        when "," => op_kind := "Comma"
        when ":" => op_kind := "Colon"
        when "(" => op_kind := "OpenParen"
        when ")" => op_kind := "CloseParen"
        when "[" => op_kind := "OpenBracket"
        when "]" => op_kind := "CloseBracket"
        when "{" => op_kind := "OpenBrace"
        when "}" => op_kind := "CloseBrace"
        default => op_kind := "Unknown"
    end case
    
    let op_token: Token = make_token(make_token_kind(op_kind), op_span, c)
    return LexerResult { token: op_token, lexer: state, has_more: true }
end lex_next_token

end Compiler.Core.Lexer