module Compiler.Core.Lowering

import Compiler.Core.Token exposing SourceSpan
import Compiler.Core.Ast exposing ExprNode, StmtNode
import Compiler.Core.Ir exposing IrType, IrInstruction, IrBasicBlock, IrRoutine

type IrBuilder is record
    blocks: Array<IrBasicBlock, 32>
    block_count: Integer
    
    current_block_label: String
    current_instructions: Array<IrInstruction, 64>
    current_instruction_count: Integer
    
    current_terminator_kind: String
    current_target_block_label: String
    current_true_block_label: String
    current_false_block_label: String
    current_return_reg: String
    current_abort_error: String

    temp_counter: Integer
    block_counter: Integer
    types: Array<IrType, 10>
    type_count: Integer
end record

type LowerExprResult is record
    builder: IrBuilder
    dest_reg: String
end record

function set_type(arr: Array<IrType, 10>, idx: Integer, val: IrType) returns Array<IrType, 10>
is
    let i0: IrType = arr[0]
    let i1: IrType = arr[1]
    let i2: IrType = arr[2]
    let i3: IrType = arr[3]
    let i4: IrType = arr[4]
    let i5: IrType = arr[5]
    let i6: IrType = arr[6]
    let i7: IrType = arr[7]
    let i8: IrType = arr[8]
    let i9: IrType = arr[9]

    if idx = 0 then i0 := val end if
    if idx = 1 then i1 := val end if
    if idx = 2 then i2 := val end if
    if idx = 3 then i3 := val end if
    if idx = 4 then i4 := val end if
    if idx = 5 then i5 := val end if
    if idx = 6 then i6 := val end if
    if idx = 7 then i7 := val end if
    if idx = 8 then i8 := val end if
    if idx = 9 then i9 := val end if

    return [i0, i1, i2, i3, i4, i5, i6, i7, i8, i9]
end set_type

