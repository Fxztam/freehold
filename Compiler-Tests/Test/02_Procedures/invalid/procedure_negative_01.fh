-- Purpose: Negative test – Calling a procedure without the mandatory 'call' keyword.
-- Failure Category: Invalid procedure call statement
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 6.4 (Make Effects Visible), SPECIFICATION-FUNCTION-PROCEDURE-VERIFY.md, Section 1 (Routine Kinds)
-- Expected Result: Parser Failure
--   Routines that do not return values (procedures) must be invoked with 'call'.

module ProcedureNegative01

procedure log_something()
is
    check true
end log_something

procedure main()
is
    log_something()
end main

end ProcedureNegative01
