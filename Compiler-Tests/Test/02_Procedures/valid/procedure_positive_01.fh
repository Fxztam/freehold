-- Purpose: Positive test – Procedure without contracts and multiple simple statements.
-- Referenced Specification: SPECIFICATION-FUNCTION-PROCEDURE-VERIFY.md, Section 1 (Routine Kinds)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module ProcedurePositive01

import Std.IO

procedure do_nothing()
is
    check true
end do_nothing

procedure main()
is
    call do_nothing()
end main

end ProcedurePositive01
