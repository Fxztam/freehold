-- Purpose: Demonstrate a simple procedure structure without parameters and an explicit call.
-- Referenced Specification: SPECIFICATION-FUNCTION-PROCEDURE-VERIFY.md, Section 1 (Routine Kinds)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module ProcedureDemo01

import Std.IO

procedure log_startup()
is
    call Std.IO.log("System startup initiated")
end log_startup

procedure main()
is
    call log_startup()
end main

end ProcedureDemo01
