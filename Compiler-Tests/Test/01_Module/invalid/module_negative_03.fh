-- Purpose: Negative test – the same module is imported twice in the same file.
-- Failure Category: Duplicate import (treated as invalid module structure)
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 5.2 (No Duplicate Imports)
-- Expected Result: Verifier Failure
--   Importing `Banking.Proofs` twice is explicitly rejected.

module App.DuplicateImport

import Banking.Proofs
import Banking.Proofs

procedure main()
is
    check true
end main

end App.DuplicateImport
