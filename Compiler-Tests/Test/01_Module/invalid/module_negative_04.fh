-- Purpose: Negative test – module attempts to import itself (self-import).
-- Failure Category: Invalid import / self-import
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 5.1 (No Self Imports)
-- Expected Result: Verifier Failure
--   A module cannot name itself in an import declaration.

module App.Self

import App.Self

procedure main()
is
    check true
end main

end App.Self
