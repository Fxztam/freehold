-- Purpose: Demonstrate a qualified (dotted) module name with a plain import and a Std.IO call.
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 2.1 (Qualified Module Names),
--                           Section 4.1 (Plain Import), Section 4.5 (Runtime and Standard Modules)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module App.Main

import Std.IO

procedure main()
is
    call Std.IO.log("hello from App.Main")
end main

end App.Main
