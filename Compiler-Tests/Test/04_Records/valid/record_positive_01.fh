-- Purpose: Positive test – Valid declaration and basic instantiation of a record with multiple scalar fields.
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 3.2
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module RecordPositive01

type Point is record
    x: Integer
    y: Integer
    active: Boolean
end record

procedure main()
is
    let p: Point = Point { x: 10, y: -20, active: true }
    check p.x = 10
    check p.active
end main

end RecordPositive01
