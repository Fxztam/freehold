-- Purpose: Negative test – Declaring a record containing duplicate field names.
-- Failure Category: Duplicate record field names
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 3.2
-- Expected Result: Parser Failure or Verifier Failure
--   An error must be raised due to overlapping fields inside a single record structure.

module RecordNegative01

type Duplicated is record
    val: Integer
    val: String
end record

procedure main()
is
    check true
end main

end RecordNegative01
