-- Purpose: Demonstrate a simple Freehold record type declaration, instantiation, and field dot-access.
-- Referenced Specification: SPECIFICATION-FH-BASICS.md, Section 3.2 (Recommended Declaration Order), Section 8.1 (Minimal Project Example)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module RecordDemo01

type Item is record
    id: Integer
    price: Integer
end record

procedure main()
is
    let my_item: Item = Item { id: 101, price: 250 }
    check my_item.id = 101
    check my_item.price = 250
end main

end RecordDemo01
