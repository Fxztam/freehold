-- Purpose: Rad: Demonstrate a pure mathematical function and its assignments.
-- Referenced Specification: SPECIFICATION-FUNCTION-PROCEDURE-VERIFY.md, Section 1 (Routine Kinds), Section 3.1 (Preconditions Meaning)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module FunctionDemo01

function add(a: Integer, b: Integer) returns Integer
is
    return a + b
end add

procedure main()
is
    let sum: Integer = add(5, 7)
    check sum = 12
end main

end FunctionDemo01
