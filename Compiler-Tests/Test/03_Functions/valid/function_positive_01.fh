-- Purpose: Positive test – Check simple identity pure function with contract.
-- Referenced Specification: SPECIFICATION-FUNCTION-PROCEDURE-VERIFY.md, Section 1 (Routine Kinds)
-- Expected Result: Parser Success, Verifier Success, Runtime Success

module FunctionPositive01

function identity(x: Integer) returns Integer
ensures result = x
is
    return x
end identity

procedure main()
is
    let value: Integer = identity(42)
    check value = 42
end main

end FunctionPositive01
