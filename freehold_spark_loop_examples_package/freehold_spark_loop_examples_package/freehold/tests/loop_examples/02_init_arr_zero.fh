module Loop_Init_Arr_Zero

-- Initialization loop.
-- Explanation: every element already visited by the loop has the target value.

procedure init_arr_zero(a: Array<Integer, 1..1000>) -> Array<Integer, 1..1000>
ensures forall j in 1..1000 => result[j] == 0
do
    let i: Integer := 1
    let b: Array<Integer, 1..1000> := a

    while i <= 1000
    invariant i >= 1
    invariant i <= 1001
    invariant forall k in 1..i-1 => b[k] == 0
    variant 1001 - i
    do
        b[i] := 0
        i := i + 1
    end while

    return b
end init_arr_zero

end Loop_Init_Arr_Zero
