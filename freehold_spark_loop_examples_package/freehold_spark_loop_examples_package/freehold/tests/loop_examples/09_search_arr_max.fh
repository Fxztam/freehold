module Loop_Search_Arr_Max

record MaxResult
    pos: Integer
    max: Integer
end MaxResult

-- Maximize loop.
-- Explanation: pos remains a valid index; max dominates visited cells; some visited cell equals max; pos names one maximum.

procedure search_arr_max(a: Array<Integer, 1..1000>) -> MaxResult
requires forall j in 1..1000 => a[j] >= 0
ensures forall j in 1..1000 => a[j] <= result.max
ensures exists j in 1..1000 => a[j] == result.max
ensures a[result.pos] == result.max
do
    let i: Integer := 2
    let pos: Integer := 1
    let max: Integer := a[1]

    while i <= 1000
    invariant i >= 2
    invariant i <= 1001
    invariant pos >= 1
    invariant pos <= 1000
    invariant forall k in 1..i-1 => a[k] <= max
    invariant exists k in 1..i-1 => a[k] == max
    invariant a[pos] == max
    variant 1001 - i
    do
        if a[i] > max then
            max := a[i]
            pos := i
        end if
        i := i + 1
    end while

    return MaxResult { pos: pos, max: max }
end search_arr_max

end Loop_Search_Arr_Max
