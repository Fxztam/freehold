module Loop_Update_Arr_Zero

-- Conditional update loop.
-- Explanation: visited cells have been transformed according to the threshold rule; unvisited cells keep their loop-entry value.

procedure update_arr_zero(a: Array<Integer, 1..1000>, threshold: Integer) -> Array<Integer, 1..1000>
ensures forall j in 1..1000 => (if a[j] <= threshold then result[j] == 0 else result[j] == a[j] end if)
do
    let i: Integer := 1
    let b: Array<Integer, 1..1000> := a

    while i <= 1000
    invariant i >= 1
    invariant i <= 1001
    invariant forall k in 1..i-1 => (if a[k] <= threshold then b[k] == 0 else b[k] == a[k] end if)
    invariant forall k in i..1000 => b[k] == a[k]
    variant 1001 - i
    do
        if b[i] <= threshold then
            b[i] := 0
        end if
        i := i + 1
    end while

    return b
end update_arr_zero

end Loop_Update_Arr_Zero
