module Pos_Increment_Guarded

procedure increment_guarded(x: Integer)
requires x < Integer.Last
do
    -- The precondition proves x + 1 fits in Integer.
    x := x + 1
end increment_guarded

procedure main()
let x: Integer := 0
call increment_guarded(x)
check x == 1
end main

end Pos_Increment_Guarded
