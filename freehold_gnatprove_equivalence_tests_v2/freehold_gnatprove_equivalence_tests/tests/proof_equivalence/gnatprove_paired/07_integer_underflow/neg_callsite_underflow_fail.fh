module Neg_Callsite_Underflow_Fail

type Int is Integer range -2147483648..2147483647

function bounded_decrement(x: Int) returns Int
requires x > -2147483648
ensures result = x - 1
is
    return x - 1
end bounded_decrement

procedure main()
is
    let x: Int = bounded_decrement(-2147483648)
end main

end Neg_Callsite_Underflow_Fail
