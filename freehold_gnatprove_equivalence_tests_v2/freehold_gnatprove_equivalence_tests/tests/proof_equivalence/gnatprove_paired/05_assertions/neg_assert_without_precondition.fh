module Neg_Assert_Without_Precondition

type Int is Integer range -2147483648..2147483647

procedure assert_twice_bad(x: Int)
is
    let dummy: Int = 0
    check x > 0
    check x > 0
end assert_twice_bad

procedure main()
is
    call assert_twice_bad(10)
end main

end Neg_Assert_Without_Precondition
