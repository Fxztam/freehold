  "source_snippet": "module AliasRecordResultUsage\r\n\r\ntype AccountId is String\r\ntype Money is Integer\r\n\r\ntype Account is record\r\n    id: AccountId\r\n    balance: Money\r\nend record\r\n\r\nerror MissingAccount\r\n\r\nfunction load(id: AccountId) returns Result\u003cAccount, MissingAccount\u003e\r\nis\r\n    return ok Account { id: id, balance: 10 }\r\nend load\r\n\r\nprocedure main()\r\nis\r\n    let account: Result\u003cAccount, MissingAccount\u003e = load(\"acct-1\")\r\n    check account.value.id = \"acct-1\"\r\n    check account.value.balance = 10\r\nend main\r\n\r\nend AliasRecordResultUsage",
