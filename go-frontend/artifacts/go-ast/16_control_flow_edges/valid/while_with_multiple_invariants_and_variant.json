  "source_snippet": "module Matrix.WhileInvariantsVariant\r\n\r\nprocedure main()\r\nis\r\n    let amount: Integer = 3\r\n    let seen: Integer = 0\r\n    while amount \u003e 0\r\n        invariant amount \u003e= 0\r\n        invariant seen \u003e= 0\r\n        invariant amount + seen = 3\r\n        variant amount\r\n    do\r\n        amount := amount - 1\r\n        seen := seen + 1\r\n    end while\r\n    check seen = 3\r\nend main\r\n\r\nend Matrix.WhileInvariantsVariant",
